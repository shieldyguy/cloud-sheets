{
 "sheet": 1,
 "name": "MAX6355LSUT+T",
 "kind": "supervisor",
 "manufacturer": "Analog Devices (Maxim Integrated)",
 "title": "Dual/triple-voltage µP supervisory circuits",
 "source": {
  "document": "19-1508",
  "revision": "Rev 7, 5/14",
  "pages": 11
 },
 "summary": "The MAX6351 to MAX6360 are microprocessor supervisors that watch two supply rails against factory-set thresholds and pull their reset outputs low when either rail sags, holding them low for at least 100 ms after recovery. All have a debounced manual-reset input; the MAX6355, MAX6356 and MAX6357 add an adjustable 1.22 V comparator input for a third rail, and the MAX6358, MAX6359 and MAX6360 add a watchdog with a long start-up timeout. Outputs are open drain or push-pull, in 5- and 6-pin SOT23.",
 "key_figures": [
  [
   "Supply voltage",
   "1.2 V to 5.5 V (1.0 V at 0 °C to +70 °C)"
  ],
  [
   "Supply current",
   "20 µA typ, 50 µA max"
  ],
  [
   "Reset timeout period",
   "100 ms min, 180 ms typ, 280 ms max"
  ],
  [
   "VCC1 thresholds",
   "4.63, 4.38, 3.08, 2.93, 2.78, 2.63 V"
  ],
  [
   "VCC2 thresholds",
   "3.08, 2.93, 2.63, 2.32, 2.19, 1.67, 1.58 V"
  ],
  [
   "RSTIN threshold",
   "1.22 V typ"
  ],
  [
   "Watchdog timeout",
   "46.4 s typ start-up, 2.9 s typ normal"
  ],
  [
   "Temperature range",
   "-40 °C to +85 °C"
  ]
 ],
