 "circuits": [
  {
   "id": "third-voltage",
   "title": "Monitoring a third voltage",
   "page": 7,
   "description": "A two-resistor divider from the extra rail VEXT feeds RSTIN, so reset trips when VEXT falls to 1.22 V × (R1 + R2) / R2. RSTIN draws its power from VCC1, so the divided voltage must stay at or under VCC1.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "MAX6355/MAX6356/MAX6357"
    },
    {
     "ref": "R1",
