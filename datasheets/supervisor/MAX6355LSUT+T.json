     "value": "R1",
     "note": "upper divider resistor"
    },
    {
     "ref": "R2",
     "type": "resistor",
     "value": "R2",
     "note": "lower divider resistor"
    },
    {
     "ref": "J_VEXT",
     "type": "terminal",
     "value": "VEXT"
    }
   ],
   "notes": [
    "VCC1 ≥ VRSTIN."
   ]
