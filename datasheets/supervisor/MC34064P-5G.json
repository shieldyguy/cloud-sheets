 "equations": [
  {
   "name": "Reset delay",
   "expr": "tDLY = R × CDLY × ln(1 / (1 − Vth(MPU) / Vin))",
   "where": {
    "tDLY": "time reset stays low after the supply passes the threshold",
    "R": "pull-up from the supply to Reset",
    "CDLY": "capacitor from Reset to ground",
    "Vth(MPU)": "reset input threshold of the microprocessor",
    "Vin": "supply voltage"
   },
   "note": "Low voltage reset circuit.",
   "page": 4
  },
  {
   "name": "Added hysteresis",
   "expr": "VH ≈ 4.6 × RH / RL + 0.02",
   "where": {
    "VH": "hysteresis, V",
    "RH": "series input resistor, Ω",
    "RL": "pull-up from the device side of RH to Reset, Ω"
   },
   "note": "Reset-with-hysteresis circuit. Within ±10 % for RH under 150 Ω and RL from 1.5 kΩ to 10 kΩ. It leaves out the change in input current as the supply crosses the threshold.",
   "page": 4
  },
  {
   "name": "Lower threshold shift",
   "expr": "ΔVth(lower) ≈ 340 × RH × 10^-6",
   "where": {
    "ΔVth(lower)": "rise of the lower threshold, V",
    "RH": "series input resistor, Ω"
   },
   "note": "From the input current, about 340 µA at 4.59 V, flowing in RH.",
   "page": 4
  }
 ],
 "operation": [
  {
   "topic": "Inside the part",
   "page": 1,
   "text": "A resistor divider from Input feeds the inverting input of a comparator with hysteresis; its other input is a 1.2 V reference. The comparator drives an NPN transistor whose collector is the Reset pin and whose emitter is ground, so the output only sinks current. A diode from Reset to Input (anode at Reset) clamps the output and lets a delay capacitor on Reset discharge into the input. The chip has 21 active transistors."
  },
  {
   "topic": "Threshold and hysteresis",
   "page": 2,
   "text": "Reset goes low as Input falls through VIL, 4.59 V typical, and releases as Input rises through VIH, 4.61 V typical; both lie between 4.5 V and 4.7 V across the rated temperature range. The 0.02 V typical hysteresis prevents erratic reset."
  },
  {
   "topic": "Low supply",
   "page": 2,
   "text": "The output stays low and defined down to 1.0 V input: at Vin = 1.0 V it saturates at 0.1 V or less while sinking 0.1 mA. With a 10 k pull-up to Vin at 25 °C, the output reaches about 0.5 V at an input near 0.5 V and is held at 0 V from about 0.6 V input up to the threshold."
  },
  {
   "topic": "Output above the operating range",
   "page": 3,
   "text": "With a 10 k pull-up to Vin at 25 °C, the output follows Vin above the threshold up to about 9.1 V, then falls to near 1 V and to 0 V between about 9.2 V and 9.5 V input."
  },
  {
   "topic": "Output drive",
   "page": 2,
   "text": "The open-collector output sinks at least 10 mA (27 mA typical) at 4.0 V and its sink current is limited inside the part. Off-state leakage is 0.5 µA at most. The reset output voltage is rated to 10 V."
  }
 ],
