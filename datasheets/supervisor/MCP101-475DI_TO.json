{
 "sheet": 1,
 "name": "MCP101-475DI_TO",
 "kind": "supervisor",
 "manufacturer": "Microchip",
 "title": "MCP100/MCP101 microcontroller supervisor with push-pull reset output",
 "source": {
  "document": "DS11187F",
  "revision": "DS11187F, 2001",
  "pages": 16
 },
 "summary": "A three-pin voltage supervisor that keeps a microcontroller in reset until its supply is up and steady, and resets it when the supply falls below a fixed trip point. The MCP100 has an active-low reset and the MCP101 an active-high one, both push-pull; seven trip points from 2.625 V to 4.725 V typical suit 3 V, 3.3 V and 5 V rails. After the supply recovers the reset is held for 350 ms typical. MCP101-475DI/TO is the active-high, 4.625 V typical part in TO-92 with the D pinout.",
 "key_figures": [
