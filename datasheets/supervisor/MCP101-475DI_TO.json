   "4.50 V min, 4.625 V typ, 4.75 V max"
  ],
  [
   "Trip voltage options",
   "2.625, 2.925, 3.075, 4.375, 4.475, 4.625, 4.725 V typ"
  ],
  [
   "Operating voltage",
   "1.0 V to 5.5 V"
  ],
  [
   "Reset valid down to",
