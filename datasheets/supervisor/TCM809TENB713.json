 "circuits": [
  {
   "id": "typical",
   "title": "Typical application circuit",
   "page": 1,
   "description": "The TCM809 runs from the same VDD rail as the PIC microcontroller and its pin 2 goes straight to the controller's active-low reset input; no other part is used. The controller is held in reset whenever VDD sits below the threshold and released once the timeout has run after VDD returns.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "TCM809"
    },
    {
     "ref": "U2",
     "type": "ic",
     "value": "PIC microcontroller",
     "external": true
    },
    {
     "ref": "J1",
     "type": "terminal",
     "value": "VDD"
    }
   ],
   "notes": [
    "U2's RESET_INPUT is active low."
   ]
  },
  {
   "id": "pull-down",
   "title": "Reset output kept valid down to VDD = 0 V",
   "page": 5,
   "description": "A 100 kΩ resistor from the TCM809's /RESET to ground drains stray capacitance on the reset line and holds it low after VDD drops under 1.0 V, where the output no longer sinks current. The exact value matters little, provided the resistor does not load the output during normal operation.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "TCM809"
    },
    {
     "ref": "R1",
     "type": "resistor",
     "value": "100 kΩ"
    },
    {
     "ref": "J1",
     "type": "terminal",
     "value": "VDD"
    },
    {
     "ref": "J2",
     "type": "terminal",
     "value": "/RESET out"
    }
   ],
   "notes": [
    "For the TCM810 the matching part is a pull-up resistor from RESET to VDD, which keeps RESET high below VDD = 1.0 V."
   ]
  },
  {
   "id": "bidirectional-reset",
   "title": "Interface to a bidirectional reset I/O",
   "page": 6,
   "description": "A 4.7 kΩ series resistor sits between the TCM809's /RESET and a microcontroller reset pin that can also drive, so that a clash between the two outputs cannot leave the line at an undefined level. Other circuits that need reset take it through a buffer rather than loading the line; with the buffer input on the controller side of the resistor they follow the controller's own reset pin.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "TCM809"
    },
    {
     "ref": "R1",
