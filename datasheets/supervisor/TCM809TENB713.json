{
 "sheet": 1,
 "name": "TCM809TENB713",
 "kind": "supervisor",
 "manufacturer": "Microchip",
 "title": "TCM809/TCM810: 3-pin microcontroller reset monitors with push-pull output",
 "source": {
  "document": "DS21661E",
  "revision": "Revision E, December 2012",
  "pages": 16
 },
 "summary": "Three-pin voltage supervisors that watch VDD and hold a processor in reset while the rail is under a fixed factory threshold, then keep reset asserted for at least 140 ms after the rail recovers. The TCM809 drives an active-low push-pull /RESET that stays valid down to VDD = 1.0 V; the TCM810 drives an active-high push-pull RESET. Seven thresholds from 2.32 V to 4.63 V suit 2.5 V, 3.0 V, 3.3 V and 5.0 V rails, with no external parts and 9 µA typical supply current. TCM809TENB713 is the active-low 3.08 V part in SOT-23B, -40 °C to +85 °C, on tape and reel.",
 "key_figures": [
  [
   "Reset thresholds VTH (typ)",
   "4.63, 4.38, 4.00, 3.08, 2.93, 2.63, 2.32 V (L, M, J, T, S, R, Z)"
  ],
  [
   "TCM8xxT threshold",
   "3.04 / 3.08 / 3.11 V min/typ/max at +25 °C; 3.00 to 3.15 V over -40 °C to +125 °C"
  ],
  [
   "Reset active timeout",
   "140 ms min, 320 ms typ, 560 ms max"
  ],
  [
   "VDD to reset delay",
   "65 µs typ, VDD from VTH to VTH - 100 mV"
  ],
  [
   "Supply current ICC",
   "9 µA typ, 25 µA max (R/S/T/Z, VDD < 3.6 V); 12 µA typ, 30 µA max (L/M/J, VDD < 5.5 V)"
  ],
  [
   "VDD range",
   "1.0 V to 5.5 V (0 °C to +70 °C); 1.2 V to 5.5 V (-40 °C to +125 °C)"
  ],
  [
   "Output",
   "push-pull; TCM809 /RESET active low, TCM810 RESET active high"
  ],
  [
   "Threshold tempco",
   "30 ppm/°C typ"
  ],
