{
 "sheet": 1,
 "name": "MAX6369KA+T",
 "kind": "supervisor",
 "manufacturer": "Analog Devices (Maxim Integrated)",
 "title": "MAX6369-MAX6374: watchdog timers with pin-set startup delay and timeout, 8-pin SOT23",
 "source": {
  "document": "19-1676",
  "revision": "Rev 7, 1/16",
  "pages": 11
 },
 "summary": "Six stand-alone watchdog timers that need no external timing parts. A processor must change the level on WDI inside the selected timeout; if it misses, WDO pulses low, which can reset the processor or raise an interrupt. Three SET pins choose both the timeout and the delay before it begins (or turn the watchdog off) and can be changed while running. MAX6369KA+T is the open-drain, 100 ms pulse member with startup delay equal to the timeout, lead(Pb)-free, on tape and reel.",
 "key_figures": [
  [
   "Supply range",
   "2.5 V to 5.5 V"
  ],
  [
   "Supply current",
   "8 µA typ, 20 µA max (-40°C to +85°C, no load)"
  ],
  [
   "Timeout tWD (MAX6369/70)",
   "1 ms to 60 s minimum, eight pin settings, one of them disable"
  ],
  [
   "WDO pulse width",
   "100 ms min (open drain) or 1 ms min (push-pull)"
  ],
  [
   "WDI minimum pulse width",
   "100 ns"
  ],
  [
   "Internal setup time",
   "300 µs max"
  ],
  [
   "Operating temperature",
   "-40°C to +125°C"
  ],
  [
   "Package",
