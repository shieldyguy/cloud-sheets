   "Every part ships on tape and reel only, in multiples of 2,500.",
   "MAX6369/70: startup delay equals the timeout, both pin-set from 1 ms to 60 s. MAX6371/72: 60 s fixed startup delay, timeout pin-set from 1 ms to 60 s. MAX6373/74: startup delay 200 µs to 60 s or until the first WDI edge, timeout 30 µs to 10 s.",
   "A + in the part number is lead(Pb)-free, a - is leaded; /V marks the automotive-qualified part."
  ]
 },
 "pins": [
  {
   "package": "8 SOT23",
   "page": 5,
   "pins": [
    {
     "pin": "1",
     "name": "WDI",
     "type": "input",
     "function": "Watchdog input. Any rising or falling edge clears the internal timer, as does a WDO pulse. Held at one level for longer than tWD, WDO pulses."
    },
    {
     "pin": "2",
     "name": "GND",
     "type": "ground",
     "function": "Ground."
    },
    {
     "pin": "3",
     "name": "N.C.",
     "type": "no connect",
     "function": "Not connected. Make no connection to this pin."
    },
    {
     "pin": "4",
     "name": "SET0",
     "type": "input",
     "function": "Timing select bit 0. With SET1 and SET2 it sets the startup delay and timeout (Table 1)."
    },
    {
     "pin": "5",
     "name": "SET1",
     "type": "input",
     "function": "Timing select bit 1. With SET0 and SET2 it sets the startup delay and timeout (Table 1)."
    },
    {
     "pin": "6",
     "name": "SET2",
     "type": "input",
     "function": "Timing select bit 2. With SET0 and SET1 it sets the startup delay and timeout (Table 1)."
    },
    {
     "pin": "7",
     "name": "WDO",
     "type": "output",
     "function": "Watchdog output, active low. Goes low for tWDO each time the timer expires. Open drain on MAX6369/71/73, which need a pull-up resistor; push-pull on MAX6370/72/74."
    },
    {
     "pin": "8",
     "name": "VCC",
     "type": "power in",
     "function": "Supply, +2.5 V to +5.5 V."
    }
   ]
  }
 ],
