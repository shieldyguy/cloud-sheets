     "type": "no connect",
     "function": "Not connected; make no connection to it."
    },
    {
     "pin": "4",
     "name": "SET0",
     "type": "input",
     "function": "Timing select bit 0. With SET1 and SET2 it picks the startup delay and timeout (Table 1)."
    },
    {
     "pin": "5",
     "name": "SET1",
     "type": "input",
     "function": "Timing select bit 1. With SET0 and SET2 it picks the startup delay and timeout (Table 1)."
    },
    {
     "pin": "6",
     "name": "SET2",
     "type": "input",
     "function": "Timing select bit 2. With SET0 and SET1 it picks the startup delay and timeout (Table 1)."
    },
    {
     "pin": "7",
     "name": "WDO",
     "type": "output",
     "function": "Active-low watchdog output, low for tWDO each time the timer runs out. Open drain on MAX6369/MAX6371/MAX6373, needing a pullup; push-pull on MAX6370/MAX6372/MAX6374."
    },
    {
     "pin": "8",
     "name": "VCC",
     "type": "power in",
     "function": "Supply, +2.5 V to +5.5 V."
    }
   ]
  }
