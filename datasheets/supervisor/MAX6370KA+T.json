{
 "sheet": 1,
 "name": "MAX6370KA+T",
 "kind": "supervisor",
 "manufacturer": "Analog Devices (Maxim Integrated)",
 "title": "MAX6369–MAX6374 pin-selectable watchdog timers, 2.5 V to 5.5 V, 8-pin SOT23",
 "source": {
  "document": "19-1676",
  "revision": "Rev 8, 7/17",
  "pages": 11
 },
 "summary": "Six watchdog timers in an 8-pin SOT23 that watch a processor for a stalled program. The processor must change the level on WDI within each timeout period; if it misses, WDO goes low for a fixed pulse. Three SET pins choose the startup delay and the timeout from eight settings, one of which turns the watchdog off. Odd numbers (MAX6369/71/73) have an open-drain WDO with a 100 ms minimum pulse; even numbers (MAX6370/72/74) have a push-pull WDO with a 1 ms minimum pulse. MAX6370KA+T is the push-pull part with startup delay equal to the timeout, both selectable from 1 ms to 60 s minimum, lead-free, on tape and reel.",
 "key_figures": [
  [
   "Supply voltage",
   "2.5 V to 5.5 V"
  ],
  [
   "Supply current",
   "8 µA typ, 20 µA max, no load, TA = -40 °C to +85 °C"
  ],
  [
   "Watchdog timeout (MAX6369/MAX6370)",
   "1 ms to 60 s minimum, selectable, or disabled"
  ],
  [
   "Startup delay (MAX6369/MAX6370)",
   "equal to the selected timeout"
  ],
  [
   "WDO pulse width",
   "100 ms to 300 ms (MAX6369/71/73); 1 ms to 3 ms (MAX6370/72/74)"
  ],
  [
   "WDO output",
   "open drain (MAX6369/71/73) or push-pull (MAX6370/72/74), active low"
  ],
  [
   "WDI minimum pulse width",
   "100 ns"
  ],
