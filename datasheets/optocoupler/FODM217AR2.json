 "operation": [
  {
   "topic": "Input types",
   "page": 1,
   "text": "FODM217 parts carry a single GaAs infrared LED, anode at pin 1 and cathode at pin 2. FODM214 parts carry two GaAs infrared LEDs in inverse parallel between pins 1 and 2, for AC operation; their CTR is specified at IF = ±1 mA."
  },
  {
   "topic": "CTR grades",
   "page": 1,
   "text": "The letter after FODM217 selects the CTR bin at IF = 5 mA, VCE = 5 V: A 80-160 %, B 130-260 %, C 200-400 %, D 300-600 %. FODM214 spans 20-400 % and FODM214A 50-250 % at IF = ±1 mA, VCE = 5 V."
  },
  {
   "topic": "Ordering suffixes",
   "page": 7,
   "text": "No suffix is a tube of 100; R2 is tape and reel of 3000; V adds the DIN EN/IEC60747-5-5 option; R2V is both."
  },
  {
   "topic": "Approvals",
   "page": 1,
   "text": "UL1577: 3750 VAC rms for 1 minute. DIN EN/IEC60747-5-5: working insulation voltage 565 V peak. Infrared reflow at 260 °C is allowed."
  },
  {
   "topic": "Derating",
   "page": 4,
   "text": "Collector power dissipation is 150 mW up to 25 °C ambient and falls in a straight line to 30 mW at 110 °C. LED power dissipation is 70 mW up to 25 °C and falls to 14 mW at 110 °C."
  },
  {
   "topic": "Marking",
   "page": 1,
   "text": "The top carries the onsemi logo, a device number 21xx, a V when the DIN EN/IEC60747-5-5 option is fitted, a one-digit year code X, a two-digit work week YY and an assembly package code R1."
  },
  {
   "topic": "Applications named",
   "page": 1,
   "text": "DC-DC converters, ground loop and signal-to-noise isolation, adapters and chargers, appliances and set top boxes, power supplies, motor control and programmable logic controllers."
  }
 ],
