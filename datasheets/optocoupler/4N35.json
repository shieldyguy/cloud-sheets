   "Current transfer ratio",
   "100 % min at IF = 10 mA, VCE = 10 V; 40 % min, 50 % typ over -55 °C to +100 °C"
  ],
  [
   "Collector emitter voltage",
   "VCEO 70 V abs max; BVCEO 30 V min at IC = 1 mA"
  ],
  [
   "LED forward current",
   "50 mA abs max; VF 1.3 V typ, 1.5 V max at 10 mA"
  ],
  [
