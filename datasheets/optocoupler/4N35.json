 "sheet": 1,
 "name": "4N35",
 "kind": "optocoupler",
 "manufacturer": "Vishay",
 "title": "4N35, 4N36, 4N37: phototransistor optocoupler with base pin, DIP-6",
 "source": {
  "document": "81181",
  "revision": "Rev. 1.2, 07-Jan-10",
  "pages": 7
 },
 "summary": "A single-channel optocoupler: a gallium arsenide infrared emitter facing a silicon NPN phototransistor whose base is brought out on pin 6. The two sides are tested to 5000 Vrms of isolation, with 7 mm or more of creepage and clearance and at least 0.4 mm of insulation between emitter and detector. At IF = 10 mA and VCE = 10 V the current transfer ratio is 100 % minimum at 25 °C and 40 % minimum over -55 °C to +100 °C. The 4N35, 4N36 and 4N37 have the same ratings and characteristics.",
 "key_figures": [
  [
   "Isolation test voltage",
   "5000 VRMS"
  ],
