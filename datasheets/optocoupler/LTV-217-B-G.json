 "operation": [
  {
   "topic": "CTR ranks",
   "page": 7,
   "text": "The CTR rank letter is A, B, C or D, set by CTR at IF = 5 mA, VCE = 5 V, Ta = 25 °C: A 80-160 %, B 130-260 %, C 200-400 %, D 300-600 %. A part may or may not carry its rank mark; across all marks and no mark, CTR is 50-600 %."
  },
  {
   "topic": "Options",
   "page": 4,
   "text": "Two tape orientations are offered, LTV-217 and LTV-217-TP1, 3000 parts to a reel. The V ordering option adds VDE approval and a VDE mark on the top."
  },
  {
   "topic": "Approvals and construction",
   "page": 2,
   "text": "UL, cUL, CSA, FIMKO and VDE approvals; VDE needs the V option. Double transfer mold construction. RoHS compliant and halogen free."
  },
  {
   "topic": "Marking",
   "page": 3,
   "text": "The top carries L217, a solid dot as the halogen-free mark, a round mark beside pin 1, a three-digit date code, the CTR rank (which may be left off) and, on V-option parts, the VDE mark."
  },
  {
   "topic": "Derating",
   "page": 8,
   "text": "Collector power dissipation is 150 mW up to 25 °C and falls in a straight line to 30 mW at 110 °C. Forward current is 50 mA up to 25 °C and falls in a straight line to about 10 mA at 110 °C."
  },
  {
   "topic": "Soldering",
   "page": 11,
   "text": "One reflow pass within the IR profile, or wave soldering at 260 °C for 10 s. With an infrared lamp or another local heat source the mold can heat unevenly, and the package should stay inside the reflow profile. Immersing the package in solder paste is advised against."
  },
  {
   "topic": "Applications named",
   "page": 2,
   "text": "High-density mounting on hybrid substrates, programmable controllers, system appliances and measuring instruments."
  }
