 "operation": [
  {
   "topic": "Servo principle",
   "page": 1,
   "text": "Both photodiodes see the same LED. Holding IP1 constant with a loop round the LED drive corrects for the LED's nonlinearity and its drift with time and temperature. Because the two PIN photodiodes are matched, IP2 tracks IP1, and the ratio K3 stays stable with time and temperature."
  },
  {
   "topic": "Signals and uses",
   "page": 1,
   "text": "The part passes both DC and AC signals and has low input-output capacitance. Uses named: power supply voltage or current feedback, medical sensor isolation, audio interfaces, isolated process control transducers and digital telephone isolation."
  },
  {
   "topic": "Insulation and approvals",
   "page": 1,
   "text": "Internal insulation distance is more than 0.4 mm. Approvals: UL 1577, cUL, BSI, FIMKO, CQC, and DIN EN 60747-5-5 (VDE 0884-5) with option 1."
  },
  {
   "topic": "Switching time measurement",
   "page": 3,
   "text": "The LED current steps from 10 mA to 12 mA and back. Rise time tr and fall time tf are each taken between the 10 % and 90 % points of the output step."
  },
  {
   "topic": "Reflow soldering (SMD)",
   "page": 7,
   "text": "J-STD-020 lead (Pb)-free profile: ramp up at most 3 °C/s; preheat from 150 °C to 200 °C in at most 120 s; at most 100 s above 217 °C; peak at most 260 °C, with reference levels marked at 255 °C, 245 °C and 240 °C and at most 30 s at the peak; ramp down at most 6 °C/s."
  },
  {
   "topic": "Wave soldering (DIP)",
   "page": 7,
   "text": "J-STD-020 double wave profile, lead temperature: preheat to 100 °C to 130 °C at about 2 K/s; into the first wave at about 200 K/s; wave peak 235 °C to 260 °C, the two waves within 5 s; cooling at about 2 K/s and then about 5 K/s, with forced cooling."
  },
  {
   "topic": "Marking",
   "page": 6,
   "text": "The top carries the part number (for example IL300-F on an IL300-F-X001), the UL mark and a dot, and a line with V, the lot marking code XXXX and 68. A circle marks pin 1."
  }
 ],
