 "operation": [
  {
   "topic": "Structure",
   "page": 3,
   "text": "One infrared LED (anode pin 1, cathode pin 2) faces one NPN phototransistor (emitter pin 3, collector pin 4) across the isolation gap. The base of the transistor has no pin."
  },
  {
   "topic": "CTR ranks",
   "page": 10,
   "text": "Parts are binned by CTR at IF = 5 mA, VCE = 5 V, 25 °C into L (50-100 %), A (80-160 %), B (130-260 %), C (200-400 %) and D (300-600 %). The rank may or may not be marked on the body."
  },
  {
   "topic": "Derating",
   "page": 11,
   "text": "The LED current limit is 50 mA up to about 55 °C and falls linearly to about 10 mA at 110 °C. The collector dissipation limit is 150 mW up to 25 °C and falls linearly to about 18 mW at 110 °C."
  },
  {
   "topic": "Temperature behaviour",
   "page": 12,
   "text": "Relative CTR (at IF = 5 mA, VCE = 5 V) stays near 100 % from -30 °C to about 25 °C, peaking slightly above it near 0 °C, and falls to about 56 % at 110 °C. Dark current at VCE = 20 V rises about one decade per 25 °C, from about 10^-11 A at -25 °C to a few µA at 110 °C."
  },
  {
   "topic": "Speed against load",
   "page": 12,
   "text": "At VCE = 2 V and IC = 2 mA, rise and fall times grow with RL: about 5-6 µs at 100 Ω, about 20 µs at 1 kΩ and 125-140 µs at 10 kΩ. In the frequency response the -3 dB point is about 80 kHz at 100 Ω, about 25 kHz at 1 kΩ and about 4 kHz at 10 kΩ."
  },
  {
   "topic": "Body marking",
   "page": 3,
   "text": "The top carries an L logo, a one-digit year code, a two-digit work week, 817 with the rank letter, a factory letter (Y for Thailand, W for China-CZ) and a dot by pin 1, the anode."
  }
 ],
