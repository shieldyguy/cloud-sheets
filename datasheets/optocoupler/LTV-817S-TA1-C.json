{
 "sheet": 1,
 "name": "LTV-817S-TA1-C",
 "kind": "optocoupler",
 "manufacturer": "Lite-On",
 "title": "LTV-817 series (LTV-817, -817M, -817S, -817S-TA, -817S-TA1, -817S-TP): phototransistor optocoupler, 4-pin, 5000 Vrms",
 "source": {
  "document": "DS70-2012-0050",
  "revision": "Revision B, effective 12/12/2013",
  "pages": 17
 },
 "summary": "A single-channel optocoupler in a 4-pin package: an infrared LED on pins 1 and 2 shines on an NPN phototransistor with collector on pin 4 and emitter on pin 3, with no base connection. At IF = 5 mA and VCE = 5 V the current transfer ratio is 50 % to 600 %, sold in five rank bins, L, A, B, C and D; rank C, as in LTV-817S-TA1-C, is 200 % to 400 %. The collector-emitter rating is 35 V and the isolation test voltage 5000 Vrms for one minute. It comes as a 7.62 mm through-hole DIP (LTV-817), a 10.16 mm wide-lead DIP (LTV-817M) and a gull-wing surface-mount form (LTV-817S), the last also on 16 mm tape in three orientations (-TA, -TA1, -TP).",
 "key_figures": [
  [
   "CTR",
   "50 % to 600 % at IF = 5 mA, VCE = 5 V; rank C 200 % to 400 %"
  ],
  [
   "Collector-emitter voltage",
   "VCEO 35 V; BVCEO 35 V min"
  ],
  [
   "LED forward current",
   "50 mA max; VF 1.2 V typ, 1.4 V max at 20 mA"
  ],
  [
   "Collector current",
   "50 mA max"
  ],
  [
   "Saturation voltage",
   "0.1 V typ, 0.2 V max at IF = 20 mA, IC = 1 mA"
  ],
  [
   "Dark current",
   "100 nA max at VCE = 20 V"
  ],
  [
   "Response time",
   "tr 4 µs typ, tf 3 µs typ (18 µs max) at VCE = 2 V, IC = 2 mA, RL = 100 Ω"
  ],
  [
   "Cut-off frequency",
   "80 kHz typ at VCE = 5 V, IC = 2 mA, RL = 100 Ω"
  ],
