{
 "sheet": 1,
 "name": "H11L1SR2M",
 "kind": "optocoupler",
 "manufacturer": "onsemi",
 "title": "H11L1M, H11L2M, H11L3M: 6-pin Schmitt trigger output optocouplers",
 "source": {
  "revision": "Rev. 1.0.7, September 2014",
  "pages": 12
 },
 "summary": "An infrared LED coupled to a detector IC with a Schmitt trigger and open-collector output, in a 6-pin DIP or surface-mount package, isolated to 4170 VACrms. The output goes low when LED current passes a guaranteed threshold (1.6, 10 or 5 mA for H11L1M, H11L2M, H11L3M) and releases with built-in hysteresis. It runs from 3 V to 15 V and switches in about 1 µs. H11L1SR2M is the 1.6 mA grade in the lead-bend SMT package on 1000-piece reels.",
 "key_figures": [
