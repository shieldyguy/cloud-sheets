 "operation": [
  {
   "topic": "Output stage",
   "page": 1,
   "text": "Each channel's detector is a Darlington pair with a resistor from the output transistor's base to its emitter, and a diode across the collector and emitter, anode at the emitter. The base is not brought out to a pin."
  },
  {
   "topic": "Derating",
   "page": 2,
   "text": "Forward current falls from 60 mA by 0.7 mA/°C above 39 °C on TLP627 and from 50 mA by 0.5 mA/°C above 25 °C on TLP627-2 and -4. TLP627 may dissipate 300 mW in the collector (320 mW in total) when IF is kept to 20 mA or less."
  },
  {
   "topic": "Production",
   "page": 1,
   "text": "Commercial production started in August 1984."
  }
 ],
