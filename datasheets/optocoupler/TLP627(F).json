{
 "sheet": 1,
 "name": "TLP627(F)",
 "kind": "optocoupler",
 "manufacturer": "Toshiba",
 "title": "TLP627, TLP627-2, TLP627-4: GaAs infrared LED to Darlington phototransistor couplers, 300 V output",
 "source": {
  "revision": "2017-05-16",
  "pages": 8
 },
 "summary": "A family of photocouplers in which a gallium arsenide infrared LED drives a Darlington phototransistor; the output carries a built-in base-emitter resistor for switching speed and high-temperature behaviour. The output holds off 300 V and gives a current transfer ratio of at least 1000 % at IF = 1 mA. TLP627 is one channel in a 4-pin DIP, TLP627-2 two channels in an 8-pin DIP and TLP627-4 four channels in a 16-pin DIP, each channel isolated. Named uses are programmable controllers, DC output modules and telecom equipment; Toshiba marks the series not recommended for new design.",
 "key_figures": [
  [
   "Collector-emitter voltage VCEO",
   "300 V"
  ],
  [
   "Current transfer ratio",
   "1000 % min, 4000 % typ at IF = 1 mA, VCE = 1 V"
  ],
  [
   "Collector current IC",
   "150 mA abs max, 120 mA recommended max"
  ],
  [
   "Isolation voltage BVS",
   "5000 Vrms, AC 60 s"
  ],
  [
   "Forward voltage VF",
