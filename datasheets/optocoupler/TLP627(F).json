 "circuits": [
  {
   "id": "switching-test",
   "title": "Switching time test circuit",
   "page": 4,
   "description": "Test set-up for tON, ts and tOFF. A current step IF is fed into the LED anode; the cathode returns to ground through a series resistor. The output works as a common-emitter switch: the emitter is grounded, RL ties the collector up to VCC, and VCE is measured at the collector. tON runs from the IF rising edge until VCE has fallen to 1 V; ts runs from the IF falling edge until VCE climbs back through 1 V; tOFF runs from the IF falling edge until VCE reaches 9 V. The table conditions are RL = 180 Ω, VCC = 10 V, IF = 16 mA.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "TLP627"
    },
