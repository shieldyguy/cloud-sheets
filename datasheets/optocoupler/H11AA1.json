 "circuits": [
  {
   "id": "switching-test",
   "title": "Switching schematic",
   "page": 5,
   "description": "The circuit the switching times are measured in. A 10 mA pulse is forced through the input LEDs. The phototransistor works as a common-emitter switch: its collector is pulled up to 5 V through the load resistor RL and its emitter goes to ground, so VO at the collector falls while the input is on. The base pin is left open.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "H11AA1"
    },
    {
     "ref": "I1",
     "type": "source",
     "value": "IF = 10 mA",
     "note": "input current pulse"
    },
    {
     "ref": "RL",
     "type": "resistor",
     "value": "RL",
     "note": "load resistor"
    },
    {
     "ref": "J_VCC",
     "type": "terminal",
