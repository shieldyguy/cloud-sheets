{
 "sheet": 1,
 "name": "H11AA1",
 "kind": "optocoupler",
 "manufacturer": "Vishay Semiconductors",
 "title": "AC-input optocoupler with NPN phototransistor output and base pin, 6-pin DIP",
 "source": {
  "document": "83608",
  "revision": "Rev. 2.0, 24-Mar-2026",
  "pages": 7
 },
 "summary": "The H11AA1 couples an input of two infrared LEDs, wired anti-parallel so that current in either direction lights one of them, to an NPN silicon phototransistor whose base has its own pin. Its listed uses are telephone line detection, AC line motors, PLCs and instrumentation. The current transfer ratio is at least 20 % at ±10 mA input and 10 V collector-emitter, the isolation withstand is 5000 VRMS for one minute, and the collector-emitter rating is 80 V. It comes in a 6-pin DIP with 7.62 mm row spacing, a 10.16 mm (400 mil) wide-lead option and a surface-mount gull-wing option.",
 "key_figures": [
  [
   "Input",
   "two anti-parallel infrared LEDs, IF ±40 mA max"
  ],
  [
   "Forward voltage",
   "1.2 V typ, 1.5 V max at IF = ±10 mA"
  ],
  [
   "Current transfer ratio",
   "20 % min at IF = ±10 mA, VCE = 10 V"
  ],
  [
   "Collector-emitter breakdown",
   "80 V min"
  ],
  [
   "Dark current",
