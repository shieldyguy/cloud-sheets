{
 "sheet": 1,
 "name": "MIC4427YM-TR",
 "kind": "motor_driver",
 "manufacturer": "Microchip",
 "title": "MIC4426/4427/4428: dual 1.5 A-peak low-side MOSFET drivers, 4.5 V to 18 V",
 "source": {
  "document": "DS20006202A",
  "revision": "Revision A, May 2019",
  "pages": 20
 },
 "summary": "Two independent low-side drivers in one 8-pin package, each turning a TTL/CMOS logic input into a rail-to-rail output that sources or sinks 1.5 A peak from a 4.5 V to 18 V supply. MIC4426 has two inverting channels, MIC4427 two non-inverting, MIC4428 one of each. A 1000 pF load switches in about 25 ns with delays under 40 ns typical. MIC4427YM-TR is the dual non-inverting part, -40 °C to +85 °C, in SOIC-8 on a 2,500-piece reel.",
 "key_figures": [
  [
   "Supply voltage VS",
   "4.5 V to 18 V operating, 22 V absolute maximum"
  ],
  [
   "Peak output current IPK",
   "1.5 A typ"
  ],
  [
   "Output resistance RO",
   "6 Ω typ, 10 Ω max at 25 °C (IOUT = 10 mA, VS = 18 V)"
  ],
  [
   "Rise / fall time, 1000 pF, 18 V",
   "18 / 15 ns typ at 25 °C"
  ],
  [
   "Delay tD1 / tD2",
   "17 / 23 ns typ at 25 °C"
  ],
  [
   "Input thresholds",
   "VIH 2.4 V min, VIL 0.8 V max"
  ],
  [
   "Supply current",
   "1.4 mA typ inputs high, 0.18 mA typ inputs low"
  ],
  [
   "Latch-up",
   ">500 mA reverse current withstood"
  ],
  [
   "Junction range",
   "-40 °C to +85 °C (Y), 0 °C to +70 °C (Z)"
  ]
 ],
