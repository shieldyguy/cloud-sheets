{
 "sheet": 1,
 "name": "MAX626CSA+T",
 "kind": "motor_driver",
 "manufacturer": "Maxim Integrated",
 "title": "Dual power MOSFET drivers",
 "source": {
  "revision": "19-0863; Rev 1; 8/96",
  "pages": 5
 },
 "summary": "MAX626, MAX627 and MAX628 are dual gate drivers that turn TTL or CMOS logic inputs into rail-to-rail outputs able to source and sink 2 A peaks, for switching power MOSFETs quickly. The MAX626 has two inverting drivers, the MAX627 two non-inverting drivers and the MAX628 one of each. They run from 4.5 V to 18 V and switch a 1000 pF load in about 20 ns. The family is an improved second source for the TSC426/7/8, whose limits differ in output resistance, peak current and some switching times.",
 "key_figures": [
  [
   "Supply voltage",
   "4.5 V to 18 V"
  ],
  [
   "Peak output current",
   "2 A typ at VDD = 18 V (MAX626/7/8)"
  ],
  [
   "Output resistance",
   "4 Ω typ at VDD = 18 V, 25°C"
  ],
  [
   "Rise and fall time",
   "20 ns typ, 30 ns max at 25°C"
  ],
  [
   "Delay time",
   "tD1 20 ns typ, tD2 25 ns typ at 25°C (MAX626/7/8)"
  ],
  [
   "Supply current",
   "0.4 mA max inputs low, 8 mA max inputs high, 25°C"
  ],
  [
   "Logic thresholds",
   "VIH 2.4 V min, VIL 0.8 V max"
  ]
 ],
