{
 "sheet": 1,
 "name": "HIP2100IBZT",
 "kind": "motor_driver",
 "manufacturer": "Renesas",
 "title": "HIP2100: 100 V, 2 A peak half-bridge N-channel MOSFET driver",
 "source": {
  "document": "FN4022",
  "revision": "Rev.16.00, Aug 8, 2019",
  "pages": 14
 },
 "summary": "A gate driver for a half bridge of N-channel MOSFETs with the bridge running up to 100 V. The high-side and low-side drivers have separate inputs with CMOS thresholds and delays matched within 8 ns, sink and source 2 A peak, and carry their own undervoltage lockouts. The chip includes the bootstrap diode. HIP2100IBZT is the 8-lead SOIC on tape and reel.",
 "key_figures": [
  [
   "HS voltage, recommended",
   "-1 V to 100 V (repetitive transient -5 V to 105 V)"
  ],
  [
   "HB voltage, absolute maximum",
   "+118 V"
  ],
  [
   "VDD, recommended",
   "+9 V to 14.0 V"
  ],
  [
   "Peak output current",
   "2 A pullup and pulldown, typ"
  ],
  [
   "Propagation delay",
   "20 ns typ, 45 ns max over temperature"
  ],
  [
   "Delay matching",
   "2 ns typ, 8 ns max at +25 °C"
  ],
  [
   "Rise/fall time, 1000 pF",
   "10 ns typ"
  ],
  [
   "Bootstrap diode",
   "0.7 V typ at 100 mA, 0.8 Ω dynamic resistance typ"
  ],
  [
   "VDD quiescent current",
   "0.1 mA typ"
  ],
  [
   "Temperature range",
   "-40 °C to +125 °C"
  ]
 ],
