    },
    {
     "pin": "3",
     "name": "IN1",
     "type": "I",
     "function": "Bridge control input with an internal pulldown; together with IN2 it picks the output state (H-bridge control table)."
    },
    {
     "pin": "4",
     "name": "VREF",
     "type": "I",
     "function": "Analog level, 0.3 V to 5 V, that sets the current-regulation trip point with the ISEN resistor."
    },
    {
     "pin": "5",
     "name": "VM",
     "type": "PWR",
     "function": "Supply, 6.5 V to 45 V. Needs a 0.1 µF bypass capacitor to ground plus enough bulk capacitance rated for VM."
    },
    {
     "pin": "6",
     "name": "OUT1",
     "type": "O",
     "function": "Bridge output; wire straight to the motor or other inductive load."
    },
    {
     "pin": "7",
     "name": "ISEN",
     "type": "PWR",
     "function": "Return path for the bridge current. For current regulation a low-value sense resistor with a high power rating runs from ISEN to ground; without regulation the pin goes straight to ground."
    },
    {
     "pin": "8",
     "name": "OUT2",
     "type": "O",
     "function": "Bridge output; wire straight to the motor or other inductive load."
    },
    {
     "pin": "9",
     "name": "PAD",
     "type": "—",
     "function": "Exposed thermal pad, tied to board ground. Heat leaves best through large ground planes on several layers joined by many vias close to the pad."
    }
   ]
  }
