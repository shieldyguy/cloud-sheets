 "equations": [
  {
   "name": "Current regulation trip point",
   "expr": "ITRIP (A) = VREF (V) / (AV × RISEN (Ω)) = VREF (V) / (10 × RISEN (Ω))",
   "where": {
    "ITRIP": "output current at which the bridge starts a slow-decay off period",
    "VREF": "voltage on the VREF pin",
    "AV": "ISEN gain, 10 V/V typ",
    "RISEN": "sense resistor from ISEN to ground"
   },
   "note": "Worked case: VREF = 3.3 V with 0.15 Ω holds the motor to 2.2 A whatever the load torque.",
   "page": 9
  },
  {
   "name": "Bridge conduction loss",
   "expr": "PD = I² × (RDS(on)Source + RDS(on)Sink)",
   "where": {
    "I": "output current",
    "RDS(on)Source": "on resistance of the conducting high-side FET",
    "RDS(on)Sink": "on resistance of the conducting low-side FET"
   },
   "note": "",
   "page": 12
  },
  {
   "name": "Sense resistor dissipation",
   "expr": "P = IRMS² × R",
   "where": {
    "IRMS": "RMS motor current",
    "R": "sense resistance"
   },
   "note": "Worked case: 3 A peak, 1.5 A RMS through 0.2 Ω dissipates 0.45 W.",
   "page": 12
  },
  {
   "name": "Power dissipation from RMS current",
   "expr": "Power ≈ IRMS² × (High-side RDS(ON) + Low-side RDS(ON))",
   "where": {
    "IRMS": "RMS motor current",
    "High-side RDS(ON)": "high-side FET on resistance",
    "Low-side RDS(ON)": "low-side FET on resistance"
   },
   "note": "Worked case: at 58°C ambient the summed RDS(ON) is about 0.72 Ω, so 0.8 A gives 0.8² × 0.72 = 0.46 W.",
   "page": 16
  },
  {
   "name": "Junction temperature",
   "expr": "TJ = TA + (PD × RθJA)",
   "where": {
    "TJ": "junction temperature",
    "TA": "ambient temperature",
    "PD": "dissipated power",
    "RθJA": "effective junction-to-ambient thermal resistance"
   },
   "note": "Worked case: 58°C + (0.46 W × 48°C/W) = 80°C, with an effective RθJA of 48°C/W on the example board.",
   "page": 16
  }
