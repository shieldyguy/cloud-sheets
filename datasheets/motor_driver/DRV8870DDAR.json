{
 "sheet": 1,
 "name": "DRV8870DDAR",
 "kind": "motor_driver",
 "manufacturer": "Texas Instruments",
 "title": "DRV8870: 3.6 A brushed DC motor driver, PWM inputs, with current regulation",
 "source": {
  "document": "SLVSCY8B",
  "revision": "Revision B, July 2016",
  "pages": 28
 },
 "summary": "A single full H-bridge of four N-channel FETs for one brushed DC motor, one stepper winding or a similar load, working from 6.5 V to 45 V and carrying up to 3.6 A peak. Two logic pins, IN1 and IN2, set the bridge state and accept PWM for speed control; holding both low drops the part into a microamp sleep state. A sense resistor on ISEN and an analog VREF level set a chopping current limit, and undervoltage, overcurrent and overtemperature faults all clear on their own. DRV8870DDAR is the 8-pin HSOP with exposed pad on a 2500-piece reel.",
 "key_figures": [
  [
   "Supply VM",
   "6.5 V to 45 V (50 V absolute maximum)"
  ],
  [
   "Peak output current",
   "3.6 A"
  ],
  [
   "RMS current",
   "2 A at 25°C on standard FR-4"
  ],
  [
   "RDS(on), high side + low side",
   "565 mΩ typ (307 + 258 mΩ at VM = 24 V, 1 A)"
  ],
  [
   "Current regulation",
   "ITRIP = VREF / (10 × RISEN); AV 10 V/V typ"
  ],
  [
   "Sleep current",
   "10 µA max at VM = 12 V"
  ],
  [
   "Overcurrent trip",
   "3.7 A min, 4.5 A typ, 6.4 A max"
  ],
  [
   "PWM input frequency",
   "0 to 200 kHz"
  ],
  [
   "Ambient temperature",
   "-40°C to 125°C"
  ],
  [
   "Package",
   "HSOP-8 PowerPAD (DDA), 4.90 mm × 6.00 mm"
  ]
 ],
