{
 "sheet": 1,
 "name": "L298N",
 "kind": "motor_driver",
 "manufacturer": "STMicroelectronics",
 "title": "L298: dual full-bridge driver, 46 V, 4 A total DC",
 "source": {
  "revision": "January 2000",
  "pages": 13
 },
 "summary": "The L298 holds two bipolar full bridges for inductive loads: relays, solenoids, DC motors and stepper motors. Its inputs and enables accept TTL levels, and its logic runs from a separate, lower supply pin. The two lower emitters of each bridge come out on a sense pin for an external current-sense resistor. The output supply runs up to 46 V and the two bridges together carry up to 4 A DC. The L298N is the vertical Multiwatt15 version; the L298HN is the horizontal Multiwatt15 and the L298P the PowerSO20.",
 "key_figures": [
  [
   "Output supply VS",
   "up to 46 V operating, 50 V absolute maximum"
  ],
  [
   "Logic supply VSS",
   "4.5 V to 7 V, 5 V typical"
  ],
  [
   "Output current, each channel",
   "2 A DC, 2.5 A repetitive, 3 A non-repetitive (100 µs)"
  ],
  [
   "Total DC current",
   "up to 4 A"
  ],
  [
   "Total drop at 1 A",
   "3.2 V max"
  ],
  [
   "Input low level",
   "up to 1.5 V"
  ],
  [
   "Commutation frequency",
   "25 kHz typ, 40 kHz max at IL = 2 A"
  ],
  [
   "Total power dissipation",
   "25 W at Tcase = 75 °C"
  ],
  [
   "Junction operating temperature",
   "–25 °C to 130 °C"
  ]
 ],
