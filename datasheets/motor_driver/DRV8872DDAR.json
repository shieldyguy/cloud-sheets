{
 "sheet": 1,
 "name": "DRV8872DDAR",
 "kind": "motor_driver",
 "manufacturer": "Texas Instruments",
 "title": "DRV8872: 3.6 A peak brushed DC motor H-bridge, 6.5 V to 45 V, PWM inputs, current regulation and nFAULT output",
 "source": {
  "document": "SLVSCZ0C",
  "revision": "Revision C, July 2016",
  "pages": 27
 },
 "summary": "One full bridge of four N-channel MOSFETs for a brushed DC motor, one winding of a stepper or another load, running from a single 6.5 V to 45 V supply with a built-in charge pump for the high-side gates. Two logic inputs, IN1 and IN2, pick forward, reverse, brake or coast and may be pulse-width modulated; holding both low for about 1 ms puts it to sleep. A resistor from ISEN to ground sets a chopping current (0.35 V across it trips a 25 µs slow-decay off time), and undervoltage, overcurrent and overtemperature faults switch the bridge off, pull the open-drain nFAULT pin low and clear by themselves. Package: 8-pin HSOP PowerPAD (DDA), 4.90 mm × 6.00 mm body.",
 "key_figures": [
  [
   "Supply VM",
   "6.5 V to 45 V (50 V absolute maximum)"
  ],
  [
   "Peak output current",
   "3.6 A"
  ],
  [
   "RMS output current",
   "2 A at 25 °C on standard FR-4"
  ],
  [
   "RDS(on)",
   "565 mΩ typ high side + low side (307 mΩ + 258 mΩ at VM = 24 V, 1 A)"
  ],
  [
   "Current regulation",
   "VTRIP 0.35 V typ on ISEN, tOFF 25 µs"
  ],
  [
   "PWM frequency",
   "0 to 200 kHz"
  ],
  [
   "Sleep current",
   "10 µA max at VM = 12 V"
  ],
  [
   "Logic thresholds",
   "VIL 0.5 V max, VIH 1.5 V min"
  ],
  [
   "Overcurrent trip",
   "3.7 A min, 4.5 A typ; retry after 3 ms"
  ],
  [
   "Thermal shutdown",
   "150 °C min, 175 °C typ, 40 °C hysteresis"
  ],
  [
   "RθJA",
   "41.1 °C/W"
  ],
  [
   "Package",
   "HSOP-8 PowerPAD (DDA), 4.90 mm × 6.00 mm"
  ]
 ],
