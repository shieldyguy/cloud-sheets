    },
    {
     "pin": "4",
     "name": "nFAULT",
     "type": "open-drain output",
     "function": "Fault flag: pulled low during undervoltage lockout, overcurrent or thermal shutdown. Needs a pullup resistor."
    },
    {
     "pin": "5",
     "name": "VM",
     "type": "power",
     "function": "Supply for the chip and the motor, 6.5 V to 45 V. Decouple to ground with 0.1 µF plus enough bulk capacitance, both rated for VM."
    },
    {
     "pin": "6",
     "name": "OUT1",
     "type": "output",
     "function": "Bridge output; goes straight to one side of the motor or other inductive load."
    },
    {
     "pin": "7",
     "name": "ISEN",
     "type": "power",
     "function": "Low-side return of the bridge, the high-current ground path. With current regulation, a low-value resistor of adequate power rating runs from ISEN to ground; without it, ISEN is tied straight to ground."
    },
    {
     "pin": "8",
     "name": "OUT2",
     "type": "output",
     "function": "Bridge output; goes straight to the other side of the motor or load."
    },
    {
     "pin": "—",
     "name": "PAD",
     "type": "thermal pad",
     "function": "Exposed thermal pad, tied to board ground. Large ground planes on several layers, stitched with many vias close to the pad, carry the heat away."
    }
   ]
  }
 ],
