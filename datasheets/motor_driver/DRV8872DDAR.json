 "circuits": [
  {
   "id": "typical",
   "title": "Typical connections: brushed DC motor",
   "page": 11,
   "description": "A brushed DC motor sits across OUT1 and OUT2 and is run from a 6.5 V to 45 V supply on VM, decoupled to ground by a 0.1 µF capacitor and a 47 µF bulk capacitor. A controller powered from 3.3 V drives IN1 and IN2 and reads nFAULT through its own pullup. A 0.2 Ω resistor from ISEN to ground sets the chopping current. GND and the thermal pad go to ground.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "DRV8872"
    },
    {
     "ref": "U2",
     "type": "ic",
     "value": "Controller",
     "external": true,
     "note": "holds the pullup (PU) on its nFAULT input"
    },
    {
     "ref": "R1",
     "type": "resistor",
     "value": "0.2 Ω",
     "note": "current sense resistor on ISEN"
    },
