 "pins": [
  {
   "package": "8 Lead PDIP (IR2153D)",
   "page": 5,
   "pins": [
    {
     "pin": "1",
     "name": "VCC",
     "type": "power in",
     "function": "Supply for the logic and the low-side gate drive, referred to COM. An internal 15.6 V zener clamps it, so it may be fed from a current-limited source; it starts the part once it rises past VCCUV+."
    },
    {
     "pin": "2",
     "name": "RT",
     "type": "analog",
     "function": "Oscillator timing-resistor pin. It swings near VCC and near COM, high while LO is the active output, and charges or discharges the timing capacitor through RT."
    },
    {
     "pin": "3",
     "name": "CT",
     "type": "analog",
     "function": "Oscillator timing-capacitor pin; its ramp runs between about 1/3 and 2/3 of VCC. Pulled below VCTSD (about 1/6 of VCC) it turns both outputs off. Held low by a pulldown during undervoltage lockout."
    },
    {
     "pin": "4",
     "name": "COM",
     "type": "ground",
     "function": "Ground for the supply, the signals and the low-side driver."
    },
    {
     "pin": "5",
     "name": "LO",
     "type": "output",
     "function": "Gate drive for the low-side switch, swinging COM to VCC; on in step with RT high."
    },
    {
     "pin": "6",
     "name": "VS",
     "type": "power",
     "function": "Return of the floating high-side supply; joins the half-bridge midpoint and can sit at up to 600 V."
    },
    {
     "pin": "7",
     "name": "HO",
     "type": "output",
     "function": "Gate drive for the high-side switch, swinging VS to VB."
    },
    {
     "pin": "8",
     "name": "VB",
     "type": "power in",
     "function": "Floating supply of the high-side driver, normally a bootstrap capacitor to VS charged from VCC. The IR2153D has the charging diode inside, from VCC to VB."
    }
   ]
  },
