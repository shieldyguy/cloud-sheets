{
 "sheet": 1,
 "name": "STGAP2SCMTR",
 "kind": "motor_driver",
 "manufacturer": "STMicroelectronics",
 "title": "STGAP2S: galvanically isolated 4 A single gate driver in SO-8",
 "source": {
  "document": "DS12541",
  "revision": "Rev 3, July 2022",
  "pages": 23
 },
 "summary": "A single-channel gate driver with galvanic isolation between a 3.1 to 5.5 V logic side and a gate side supplied with up to 26 V, rated for a high-voltage rail of up to 1700 V. Its output sinks and sources 4 A, rail to rail, with 75 ns typical input-to-output delay and at least 100 V/ns common-mode transient immunity. It comes in two pinouts: STGAP2SM with separate source (GON) and sink (GOFF) pins, and STGAP2SC with one output (GOUT) and an active Miller clamp pin. UVLO on VH, thermal shutdown, an input deglitch filter, a standby mode and two inputs of opposite polarity are built in. STGAP2SCMTR is the Miller clamp version on tape and reel.",
 "key_figures": [
  [
   "High-voltage rail",
   "up to 1700 V (VISO-OP, DC or peak)"
  ],
  [
   "Output current",
   "4 A source and sink typ at TJ = 25 °C"
  ],
  [
   "Propagation delay",
   "75 ns typ, 90 ns max"
  ],
  [
   "CMTI",
   "100 V/ns min at VCM = 1500 V"
  ],
  [
   "Gate supply VH",
   "9.6 to 26 V"
  ],
  [
   "Logic supply VDD",
   "3.1 to 5.5 V"
  ],
  [
   "VH UVLO",
   "9.1 V on, 8.4 V off typ"
  ],
  [
   "Output resistance",
   "1.125 Ω source, 0.96 Ω sink typ"
  ],
  [
   "Isolation (UL 1577)",
   "2828 Vrms / 4000 Vpeak for 1 min"
  ],
  [
   "Package",
   "SO-8 narrow body"
  ]
 ],
