{
 "sheet": 1,
 "name": "LM66100DCKR",
 "kind": "power_switch",
 "manufacturer": "Texas Instruments",
 "title": "LM66100: 1.5 A, 79 mΩ ideal diode for 1.5 V to 5.5 V, reverse-polarity and reverse-current blocking, low quiescent current",
 "source": {
  "document": "SLVSEZ8A",
  "revision": "Revision A, June 2019 (original March 2019)",
  "pages": 23
 },
 "summary": "A one-channel ideal diode built round an integrated P-channel MOSFET, for 1.5 V to 5.5 V and up to 1.5 A continuous. A comparator between the active-low CE pin and VIN switches it, and an open-drain ST pin reports its state. VIN withstands –6 V and a reversed input is blocked; with CE tied to VOUT it blocks reverse current, and pairs of devices OR two supplies. It draws 150 nA quiescent and 120 nA in shutdown at 3.6 V, in a 6-pin SC-70.",
 "key_figures": [
