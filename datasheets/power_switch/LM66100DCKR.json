 "equations": [
  {
   "name": "Power dissipation, OFF state",
   "expr": "P = IOUT × VFWD",
   "where": {
    "IOUT": "output current, carried by the body diode",
    "VFWD": "body diode forward voltage"
   },
   "note": "",
   "page": 10
  },
  {
   "name": "Power dissipation, ON state",
   "expr": "P = IOUT² × RON",
   "where": {
    "IOUT": "output current",
    "RON": "ON-state resistance of the P-channel MOSFET"
   },
   "note": "",
   "page": 10
  }
