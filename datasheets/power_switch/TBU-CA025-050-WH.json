{
 "sheet": 1,
 "name": "TBU-CA025-050-WH",
 "kind": "power_switch",
 "manufacturer": "Bourns",
 "title": "TBU-CA series: bidirectional MOSFET high-speed protectors, 250 V to 850 V impulse, 50 mA to 500 mA trigger, DFN",
 "source": {
  "revision": "REV. 07/25",
  "pages": 7
 },
 "summary": "A TBU is a two-terminal series protector built from MOSFETs that passes line current with a few ohms of resistance and, once the current climbs past its trigger level, switches within about 1 µs into a blocking state that holds both overcurrent and overvoltage away from the equipment behind it. It works in either direction, has low capacitance, and resets by itself when the voltage across it drops under Vreset. The series comes in five impulse ratings (250 to 850 V) and five trigger currents (50 to 500 mA) in a 6.5 × 4 mm surface-mount DFN. TBU-CA025-050-WH is the 250 V, 100 Vrms, 50 mA part with 13.3 Ω typical series resistance.",
 "key_figures": [
