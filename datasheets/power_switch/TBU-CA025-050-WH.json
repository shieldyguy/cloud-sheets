 "circuits": [
  {
   "id": "line-pair",
   "title": "Reference application: two-wire line protection",
   "page": 3,
   "description": "A protector for a two-wire line entering equipment. Each wire runs through its own TBU, pin 1 (Line In/Out) toward the line and pin 3 (Line Out/In) toward the equipment. On the line side of the TBUs, an overvoltage protector runs from each wire to ground and limits the voltage across the TBUs to below their maximum rating. The two OVPs are MOVs, or a GDT takes their place on bandwidth-sensitive lines.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "TBU-CA025-050-WH"
    },
    {
     "ref": "U2",
     "type": "ic",
     "value": "TBU-CA025-050-WH"
    },
    {
     "ref": "OVP1",
     "type": "other",
     "value": "OVP",
     "note": "MOV, or GDT for bandwidth-sensitive lines"
    },
    {
     "ref": "OVP2",
     "type": "other",
     "value": "OVP",
     "note": "MOV, or GDT for bandwidth-sensitive lines"
    },
    {
     "ref": "LINE_A",
     "type": "terminal",
     "value": "Line"
    },
    {
     "ref": "LINE_B",
