{
 "sheet": 1,
 "name": "BTS462TATMA1",
 "kind": "power_switch",
 "manufacturer": "Infineon",
 "title": "Protected single-channel high-side switch, 5 to 34 V, 100 mΩ, PG-TO-252",
 "source": {
  "revision": "V1.1, 2007-05-29",
  "pages": 18
 },
 "summary": "BTS462T is a one-channel smart high-side switch: an N-channel vertical power MOSFET with its own charge pump, driven from a ground-referenced input that accepts CMOS levels. It switches resistive, capacitive and inductive loads on 12 V and 24 V supplies and replaces relays. Built in are current limiting, thermal shutdown with automatic restart, an overvoltage and inductive-load clamp near 47 V, ESD protection and protection against lost ground or lost supply; reverse battery is survived with a resistor in the ground lead. It is AEC qualified and comes in the green PG-TO-252 package.",
 "key_figures": [
