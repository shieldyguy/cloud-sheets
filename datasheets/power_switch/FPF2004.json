 "equations": [
  {
   "name": "Maximum output capacitance",
   "expr": "COUT(max) = ILIM(max) × tBLANK(min) / VIN",
   "where": {
    "ILIM(max)": "maximum current limit",
    "tBLANK(min)": "minimum over-current blanking time",
    "VIN": "input voltage"
   },
   "note": "Applies to FPF2000 to FPF2002 and FPF2004 to FPF2006; more output capacitance than this trips an over-current shutdown at turn-on.",
   "page": 11
  },
  {
   "name": "Dissipation in normal operation",
   "expr": "P = (ILIM)² × RDS = (0.2)² × 0.7 = 28 mW",
   "where": {
    "ILIM": "current limit, 0.2 A for the 100 mA parts",
    "RDS": "switch on-resistance, 0.7 Ω"
   },
   "note": "",
   "page": 11
  },
  {
   "name": "Maximum dissipation with auto-restart into a short",
   "expr": "P(max) = tBLANK / (tRESTART + tBLANK) × VIN(max) × ILIM(max) = 10 / (80 + 10) × 5.5 × 0.2 = 1.22 mW",
   "where": {
    "tBLANK": "over-current blanking time, 10 ms",
    "tRESTART": "auto-restart time, 80 ms",
    "VIN(max)": "maximum input voltage, 5.5 V",
    "ILIM(max)": "maximum current limit, 0.2 A"
   },
   "note": "Misprint: the result should be 0.122 W (122 mW).",
   "page": 11
  }
 ],
 "operation": [
  {
   "topic": "Overview",
   "page": 10,
   "text": "Each part is a 0.7 Ω P-channel switch with a controller that works from 1.8 V to 5.5 V. The controller provides current limiting, undervoltage lockout and thermal shutdown. The limit is fixed at 50 mA or 100 mA minimum depending on part number."
  },
  {
   "topic": "On/off control",
   "page": 10,
   "text": "ON turns the switch on and keeps it on while no fault is present. FPF2001 and FPF2005 are active low; the others are active high. On every part, VIN below the UVLO threshold or a die temperature above 150 °C turns the switch off whatever the state of ON."
  },
  {
   "topic": "Current limiting",
   "page": 10,
   "text": "The limit never falls below its minimum nor rises above its maximum: 50 mA to 100 mA for FPF2000 to FPF2003, 100 mA to 200 mA for FPF2004 to FPF2007. On FPF2000 to FPF2002 and FPF2004 to FPF2006, the switch runs as a constant-current source for a blanking time of nominally 10 ms; if the over-current lasts that long, the switch turns off and FLAGB goes low. FPF2000, FPF2001, FPF2004 and FPF2005 then turn the switch back on after 80 ms. FPF2002 and FPF2006 stay off until ON is toggled. FPF2003 and FPF2007 have no blanking: FLAGB goes low at once and the switch stays in constant current until ON is released or thermal shutdown acts."
  },
  {
   "topic": "Response time",
   "page": 1,
   "text": "The limit responds to a moderate over-current in about 3 µs and to a hard short in about 20 ns."
  },
  {
   "topic": "Fault reporting",
   "page": 10,
   "text": "FLAGB pulls low on over-current, input undervoltage or over-temperature. On parts with blanking it falls when the blanking time ends; on FPF2003 and FPF2007 it falls at once and returns high as soon as the fault ends. On auto-restart parts it stays low through the restart time. On FPF2002 and FPF2006 it latches low until ON is toggled. FLAGB is an open-drain transistor and needs a pull-up resistor to VIN; its pull-down is disabled in shutdown to save supply current."
  },
  {
   "topic": "Reverse voltage",
   "page": 10,
   "text": "The part controls current from VIN to VOUT only. With VOUT above VIN, large currents can flow and permanently damage it."
  },
  {
   "topic": "Undervoltage lockout",
   "page": 10,
   "text": "The switch turns off when VIN falls below the UVLO threshold. With ON active, VIN rising past the threshold starts a controlled turn-on that limits current overshoot."
  },
  {
   "topic": "Thermal shutdown",
   "page": 10,
   "text": "Excessive die temperature, from inside or outside, turns the switch off and pulls FLAGB low. The switch turns back on by itself once the die cools below the threshold."
  },
  {
   "topic": "Input capacitor",
   "page": 11,
   "text": "A capacitor from VIN to GND limits the dip in the supply caused by in-rush current when the switch closes onto a discharged load capacitance or a short. A 4.7 µF ceramic placed close to VIN is called for; more capacitance reduces the dip further with large capacitive loads."
  },
  {
   "topic": "Output capacitor",
   "page": 11,
   "text": "A 0.1 µF capacitor from VOUT to GND keeps board inductance from pulling VOUT below ground at turn-off. On FPF2000 to FPF2002 and FPF2004 to FPF2006, total output capacitance must stay under COUT(max) or charging it at turn-on registers as an over-current and shuts the switch off. Because of the PMOS body diode, CIN should be larger than COUT: a larger COUT can hold VOUT above VIN when the supply is removed and drive current back through the diode into VIN."
  },
  {
   "topic": "Power dissipation",
   "page": 11,
   "text": "As a closed switch the part dissipates little: 28 mW at most, on the 100 mA parts. In current limit the worst case is a shorted output. On auto-restart parts the dissipation is scaled by the ratio of blanking time to restart plus blanking time. On FPF2002 and FPF2006, re-enabling repeatedly into a short at a high duty cycle heats the die up to the thermal shutdown threshold, after which ON cannot turn the switch on until it cools. On FPF2003 and FPF2007 a short keeps the part in constant current, dissipating the eq. 3 worst case until thermal shutdown, then cycling in and out of shutdown while ON stays active and the short remains."
  },
  {
   "topic": "Layout",
   "page": 11,
   "text": "Keep all traces short and place the input and output capacitors near the part, so trace inductance has little effect in normal and short-circuit operation. Wide VIN, VOUT and GND traces reduce parasitic effects and the case-to-ambient thermal resistance."
  }
 ],
