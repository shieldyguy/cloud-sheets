{
 "sheet": 1,
 "name": "FPF2004",
 "kind": "power_switch",
 "manufacturer": "onsemi",
 "title": "FPF2000 to FPF2007: current-limited P-channel load switches, 1.8 V to 5.5 V, in SC-70-5",
 "source": {
  "document": "FPF2001/D",
  "revision": "Rev. 9, October 2024",
  "pages": 13
 },
 "summary": "A family of small load switches built round a 0.7 Ω P-channel MOSFET, for rails from 1.8 V to 5.5 V. Each part limits the switch current to a fixed value (50 mA minimum on FPF2000 to FPF2003, 100 mA minimum on FPF2004 to FPF2007), and has undervoltage lockout, thermal shutdown and an open-drain fault flag. The members differ in ON polarity, whether a long over-current shuts the switch off, and whether it then restarts by itself. FPF2004 is the 100 mA part with active-high ON, 10 ms blanking and 80 ms auto-restart.",
 "key_figures": [
  [
   "Input voltage range",
   "1.8 V to 5.5 V"
  ],
  [
   "On-resistance RON",
   "0.7 Ω typ, 1 Ω max at VIN = 3.3 V, IOUT = 20 mA, 25 °C"
  ],
  [
   "Current limit ILIM",
   "50 / 75 / 100 mA (FPF2000-2003); 100 / 150 / 200 mA (FPF2004-2007), min / typ / max"
  ],
  [
   "Over-current blanking time",
   "10 ms typ (5 ms to 20 ms) on FPF2000-2002, FPF2004-2006"
  ],
  [
   "Auto-restart time",
   "80 ms typ (40 ms to 160 ms) on FPF2000, 2001, 2004, 2005"
  ],
  [
   "Quiescent current",
   "60 µA typ at VIN = 1.8 V to 3.3 V; 100 µA max at 3.3 V to 5.5 V"
  ],
  [
   "Shutdown current",
   "1 µA max"
  ],
  [
   "Undervoltage lockout",
   "1.6 V typ, VIN rising, 50 mV hysteresis"
  ],
  [
   "Thermal shutdown",
   "140 °C typ, returns at 130 °C"
  ],
  [
   "Package",
   "SC-70-5 (SC-88A), 2.0 mm × 1.25 mm body"
  ]
 ],
