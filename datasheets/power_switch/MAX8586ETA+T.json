 "equations": [
  {
   "name": "Current limit",
   "expr": "ILIM(TYPICAL) = 36400 / RISET",
   "where": {
    "ILIM(TYPICAL)": "typical continuous current limit, A",
    "RISET": "ISET-to-GND resistance, Ω, 26 kΩ to 60 kΩ"
   },
   "note": "Below 26 kΩ the device's maximum current rating can be exceeded; above 60 kΩ the limit goes no lower than 500 mA. With VOUT under about 1 V the short-circuit threshold is 30 % above ILIM(TYPICAL).",
   "page": 9
  },
  {
   "name": "Dissipation, switch on",
   "expr": "P = IOUT² × RON",
   "where": {
    "IOUT": "output current",
    "RON": "switch on-resistance"
   },
   "note": "At IOUT = 0.5 A and RON = 95 mΩ: P = (0.5 A)² × 0.095 Ω = 24 mW. The worked example's 0.95 Ω should read 0.095 Ω.",
   "page": 9
  },
  {
   "name": "Dissipation, in current limit",
   "expr": "P = ILIM × (VIN - VOUT)",
   "where": {
    "ILIM": "current limit",
    "VIN": "input voltage",
    "VOUT": "output voltage, above 1 V"
   },
   "note": "Worst case is with the load just under the limit and VOUT above 1 V. At VIN = 5.5 V, VOUT = 1 V: P = 1.6 A × (5.5 V - 1 V) = 7.2 W, far above the 1951 mW package rating, so the die reaches the +160 °C shutdown and the output cycles.",
   "page": 9
  },
  {
