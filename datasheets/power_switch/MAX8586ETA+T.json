{
 "sheet": 1,
 "name": "MAX8586ETA+T",
 "kind": "power_switch",
 "manufacturer": "Analog Devices (Maxim Integrated)",
 "title": "Single 1.2 A current-limited USB power switch, 3 mm x 3 mm TDFN",
 "source": {
  "revision": "19-3449; Rev 3; 1/13",
  "pages": 13
 },
 "summary": "The MAX8586 is a single high-side load switch for USB ports, running from 2.75 V to 5.5 V and carrying up to 1.2 A. Its current limit is set by one resistor on ISET, and it adds reverse-current blocking, thermal shutdown, undervoltage lockout and an open-drain FAULT flag with 20 ms blanking. After a sustained fault it latches off and, with auto-restart on, probes the output with 25 mA and turns back on once the fault is gone. The enable polarity is chosen with the SEL pin.",
 "key_figures": [
  [
   "Input voltage",
   "2.75 V to 5.5 V"
  ],
  [
   "Output current",
   "up to 1.2 A"
  ],
  [
   "On-resistance",
   "55 mΩ typ at VIN = 5 V; 95 mΩ max at VIN = 4.4 V"
  ],
  [
   "Current limit",
   "set by RISET 26 kΩ to 60 kΩ; 1.4 A typ at 26 kΩ"
  ],
  [
   "Fault blanking",
   "20 ms typ"
  ],
  [
   "Quiescent current",
   "30 µA typ"
  ],
  [
   "Standby current",
   "3 µA typ"
  ],
  [
   "ESD",
   "15 kV with capacitors"
  ],
  [
   "Package",
   "8-pin TDFN 3 mm x 3 mm with exposed pad (T833-2)"
  ]
 ],
