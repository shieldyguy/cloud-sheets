 "pins": [
  {
   "package": "TDFN-8 3 mm x 3 mm (T833-2)",
   "page": 7,
   "pins": [
    {
     "pin": "1",
     "name": "SEL",
     "type": "input",
     "function": "Sets the polarity of ON. High: ON enables the switch when high. Low (GND): ON enables the switch when low."
    },
    {
     "pin": "2",
     "name": "ISET",
     "type": "analog",
     "function": "Current-limit setting. A resistor RISET from this pin to GND sets the limit; RISET is 26 kΩ to 60 kΩ."
    },
    {
     "pin": "3",
     "name": "ON",
     "type": "input",
     "function": "Enable. With SEL high the switch is on while ON is high; with SEL low it is on while ON is low."
    },
    {
     "pin": "4",
     "name": "IN",
     "type": "power in",
     "function": "Supply input, 2.75 V to 5.5 V. Needs a ceramic capacitor of at least 1 µF to GND."
    },
    {
     "pin": "5",
     "name": "OUT",
     "type": "power out",
     "function": "Switched output. Needs a capacitor of at least 1 µF to GND. High impedance while the switch is off."
    },
    {
     "pin": "6",
     "name": "FAULT",
     "type": "open-drain output",
     "function": "Active-low fault flag. Pulled low during undervoltage lockout, current limit, reverse-current detection and thermal shutdown."
    },
    {
     "pin": "7",
     "name": "GND",
     "type": "ground",
     "function": "Ground. Tie to the exposed pad and to the ground plane."
    },
    {
     "pin": "8",
     "name": "ENRESET",
     "type": "input",
     "function": "Auto-restart control. High turns auto-restart on; low turns it off."
    },
    {
     "pin": "EP",
     "name": "EP",
     "type": "thermal",
     "function": "Exposed pad. Solder to a wide ground plane to carry heat away."
    }
   ]
  }
 ],
