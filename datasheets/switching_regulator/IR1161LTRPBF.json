{
 "sheet": 1,
 "name": "IR1161LTRPBF",
 "kind": "switching_regulator",
 "manufacturer": "Infineon",
 "title": "IR1161: SmartRectifier secondary-side synchronous rectifier controller, 5-pin SOT-23",
 "source": {
  "revision": "2016-07-01",
  "pages": 26
 },
 "summary": "A controller that sits on the secondary of an isolated converter and drives one N-channel MOSFET used in place of the output rectifier diode. It watches the MOSFET's drain-to-source voltage directly on a pin rated to 200 V, switches the gate on when the body diode starts to conduct and off as the current falls to zero, and suits DCM or CrCM flyback and LLC resonant half-bridge converters up to 500 kHz. A resistor sets a minimum on time that blanks turn-on ringing and, checked each cycle, stops gate drive at very light load. It runs from 4.75 to 18 V, draws 0.65 mA quiescent, and drives the gate with 1 A source and 2.5 A sink.",
 "key_figures": [
