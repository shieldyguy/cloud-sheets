 "pins": [
  {
   "package": "5L-SOT-23",
   "page": 9,
   "pins": [
    {
     "pin": "1",
     "name": "VCC",
     "type": "power in",
     "function": "Supply. Watched by the undervoltage lockout; held under its off threshold, the chip sleeps at micropower. Clamped inside at 20 V. Wants a ceramic bypass capacitor to GND right at the pins, and may take a small series resistor for more filtering."
    },
    {
     "pin": "2",
     "name": "GND",
     "type": "ground",
     "function": "Reference of the chip; joins the source of the rectifier MOSFET."
    },
    {
     "pin": "3",
     "name": "MOT",
     "type": "analog in",
     "function": "Minimum on time set point: a resistor from this pin to GND fixes how long the gate is held on after turn-on, during which the drain comparator is ignored. Typical settings run from 500 ns to 2 µs."
    },
    {
     "pin": "4",
     "name": "VD",
     "type": "analog in",
     "function": "High-voltage sense input for the rectifier MOSFET's drain. Route it with care. A small RC filter (around 100 Ω and 100 pF) may be added for noise; larger values delay the control loop."
    },
    {
     "pin": "5",
     "name": "GATE",
     "type": "output",
     "function": "Gate driver output, 1 A source and 2.5 A sink. Can drive the MOSFET gate straight, but a small series resistor is advised, above all with MOSFETs in parallel. Keep the gate loop short and tight."
    }
   ]
  }
 ],
