 "pins": [
  {
   "package": "SOIC8N",
   "page": 10,
   "pins": [
    {
     "pin": "1",
     "name": "GATE1",
     "type": "output",
     "function": "Gate drive for synchronous rectifier 1. Internally clamped, +1 A / -4 A peak. A series gate resistor is recommended, above all with paralleled MOSFETs; keep the gate loop short and small."
    },
    {
     "pin": "2",
     "name": "VCC",
     "type": "power in",
     "function": "Supply, watched by the undervoltage lockout. Pulling it below the turn-off threshold shuts the chip down without harm. Has no internal clamp. Wants a ceramic bypass capacitor to ground right beside the chip."
    },
    {
     "pin": "3",
     "name": "VS1",
     "type": "input",
     "function": "Source sense for rectifier 1, the comparator's other input. Run it as a Kelvin connection to the MOSFET's source pin; never tie it straight to pin 7."
    },
    {
     "pin": "4",
     "name": "VD1",
     "type": "input",
     "function": "Drain sense for rectifier 1, rated to 200 V. Route it carefully from the MOSFET drain. An RC filter may be added for noise immunity; above 100 V on the drain, a 1 kΩ to 2 kΩ series resistor is recommended to cut the pin's switching loss."
    },
    {
     "pin": "5",
     "name": "VD2",
     "type": "input",
     "function": "Drain sense for rectifier 2; same rules as VD1."
    },
    {
     "pin": "6",
     "name": "VS2",
     "type": "input",
     "function": "Source sense for rectifier 2; Kelvin connection to its MOSFET's source, as VS1."
    },
    {
     "pin": "7",
     "name": "GND",
     "type": "ground",
     "function": "Ground for both the control circuits and the gate drivers; the reference for every voltage and output parameter."
    },
    {
     "pin": "8",
     "name": "GATE2",
     "type": "output",
     "function": "Gate drive for synchronous rectifier 2; same as GATE1."
    }
   ]
  }
 ],
