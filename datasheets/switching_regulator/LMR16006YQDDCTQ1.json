   "pins": [
    {
     "pin": "1",
     "name": "CB",
     "type": "input",
     "function": "Bootstrap supply for the high-side switch gate; a capacitor goes from CB to SW."
    },
    {
     "pin": "2",
     "name": "GND",
     "type": "ground",
     "function": "Ground."
    },
    {
     "pin": "3",
     "name": "FB",
     "type": "input",
     "function": "Feedback. On the adjustable version a divider sets VOUT = VFB × (1 + R1 / R2)."
    },
    {
     "pin": "4",
     "name": "SHDN",
     "type": "input",
     "function": "Active-low shutdown, high-voltage tolerant, with an internal pull-up current. Below 1.25 V the part is off; left open it runs. A resistor divider from VIN sets an input undervoltage lockout."
    },
    {
     "pin": "5",
     "name": "VIN",
     "type": "power in",
     "function": "Input supply: feeds the internal supply and the drain of the high-side MOSFET."
    },
    {
     "pin": "6",
     "name": "SW",
     "type": "output",
     "function": "Switch node, to the inductor, the catch diode and the bootstrap capacitor."
    }
   ]
  }
 ],
