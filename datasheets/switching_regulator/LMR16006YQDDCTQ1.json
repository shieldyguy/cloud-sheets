 "equations": [
  {
   "name": "Output voltage",
   "expr": "VOUT = VFB × (1 + R1 / R2), VFB = 0.765 V",
   "where": {
    "VFB": "feedback voltage, 0.765 V typical",
    "R1": "resistor from the output to FB",
    "R2": "resistor from FB to ground"
   },
   "note": "R2 of 1 kΩ to 100 kΩ is a typical starting value.",
   "page": 8
  },
  {
   "name": "Upper feedback resistor",
   "expr": "R1 = R2 × (VOUT / 0.765 V - 1)",
   "where": {
    "R2": "chosen lower resistor",
    "VOUT": "wanted output voltage"
   },
   "note": "",
   "page": 8
  },
  {
   "name": "Duty cycle",
   "expr": "D = VOUT / VIN; D' = 1 - D",
   "where": {
    "D": "fraction of the period the high-side switch is on",
    "D'": "fraction it is off"
   },
   "note": "Approximate, continuous conduction.",
   "page": 9
  },
  {
   "name": "Minimum output inductance (Equation 1)",
   "expr": "Lo_min = (Vin_max - Vout) / (Io × KIND) × Vout / (Vin_max × fsw)",
   "where": {
    "Vin_max": "highest input voltage",
    "Io": "maximum output current",
    "KIND": "inductor ripple current as a fraction of the maximum output current, 0.3 to 0.4 suggested",
    "fsw": "switching frequency"
   },
   "note": "Design example: 6.82 µH, rounded to 6.8 µH.",
   "page": 11
  },
  {
   "name": "Inductor ripple current (Equation 2)",
   "expr": "I_ripple = Vout × (Vin_max - Vout) / (Vin_max × Lo × fsw)",
   "where": {
    "Lo": "output inductance"
   },
   "note": "Design example: 0.074 A.",
   "page": 11
  },
  {
   "name": "Inductor RMS current (Equation 3)",
   "expr": "IL_RMS = sqrt(Io² + I_ripple² / 12)",
   "where": {},
   "note": "Design example: 0.60 A.",
   "page": 11
  },
  {
   "name": "Inductor peak current (Equation 4)",
   "expr": "IL_peak = Io + I_ripple / 2",
   "where": {},
   "note": "",
   "page": 11
  },
  {
   "name": "Output capacitance for a load step (Equation 5)",
   "expr": "Cout > 2 × ΔIout / (fsw × ΔVout)",
   "where": {
    "ΔIout": "size of the load step",
    "ΔVout": "allowed output droop"
   },
   "note": "Design example: ΔIout = 0.57 A, ΔVout = 0.15 V, giving 3.62 µF.",
   "page": 12
  },
  {
   "name": "Output capacitance for load release overshoot (Equation 6)",
   "expr": "Cout > Lo × (Ioh² - Iol²) / (Vf² - Vi²)",
   "where": {
    "Ioh": "output current at heavy load",
    "Iol": "output current at light load",
    "Vf": "final peak output voltage",
    "Vi": "initial capacitor voltage"
   },
   "note": "Design example: 0.6 A to 0.03 A, Vf = 5.15 V, Vi = 5 V, giving 1.6 µF.",
   "page": 12
  },
  {
   "name": "Output capacitance for ripple (Equation 7)",
   "expr": "Cout > 1 / (8 × fsw) × 1 / (Vo_ripple / IL_ripple)",
   "where": {
    "Vo_ripple": "largest allowed output ripple voltage",
    "IL_ripple": "inductor ripple current"
   },
   "note": "Design example: 95 nF.",
   "page": 12
  },
  {
   "name": "Maximum output capacitor ESR (Equation 8)",
   "expr": "RESR < Vo_ripple / IL_ripple",
   "where": {},
   "note": "Design example: below 623 mΩ.",
   "page": 12
  },
  {
   "name": "Input capacitor RMS ripple current (Equation 9)",
   "expr": "Icirms = Iout × sqrt(Vout / Vin_min × (Vin_min - Vout) / Vin_min)",
   "where": {
    "Vin_min": "lowest input voltage"
   },
   "note": "Design example: 0.3 A rms.",
   "page": 12
  },
  {
   "name": "Input ripple voltage (Equation 10)",
   "expr": "ΔVin = Iout_max × 0.25 / (Cin × fsw)",
   "where": {
    "Cin": "input capacitance",
    "Iout_max": "maximum output current"
   },
   "note": "Design example: 0.6 A, 2.2 µF, 2100 kHz, giving 33 mV.",
   "page": 12
  }
