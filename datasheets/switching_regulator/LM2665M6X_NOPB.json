 "circuits": [
  {
   "id": "doubler",
   "title": "Voltage doubler",
   "page": 9,
   "description": "The basic doubler. C1 is the flying capacitor between CAP+ and CAP-; C2 holds the output, which sits near twice the input with no load. D1 runs from the input to OUT so that the oscillator, which is powered between OUT and GND, gets enough voltage to start. SD is grounded, so the part always runs.",
   "parts": [
