 "equations": [
  {
   "name": "Doubler output resistance",
   "expr": "ROUT ≅ 2·RSW + 2 / (ƒOSC × C1) + 4·ESRC1 + ESRC2",
   "where": {
    "RSW": "sum of the on-resistances of the internal switches",
    "ƒOSC": "oscillator frequency",
    "C1": "flying capacitor",
    "ESRC1": "ESR of C1",
    "ESRC2": "ESR of the output capacitor C2"
   },
   "note": "The flying capacitor carries about twice the output current, so its ESR counts four times; the output capacitor carries about the output current, so its ESR counts once.",
   "page": 10
  },
  {
   "name": "Output ripple, peak to peak",
   "expr": "VRIPPLE = IL / (ƒOSC × C2) + 2 × IL × ESRC2",
   "where": {
    "IL": "load current",
    "ƒOSC": "oscillator frequency",
    "C2": "output capacitor",
    "ESRC2": "ESR of C2"
   },
   "note": "",
   "page": 10
  },
  {
   "name": "Power efficiency",
   "expr": "η = POUT / PIN = IL²·RL / (IL²·RL + IL²·ROUT + IQ·(V+))",
   "where": {
    "IL": "load current",
    "RL": "load resistance",
    "ROUT": "output resistance",
    "IQ·(V+)": "the chip's own quiescent loss",
    "IL²·ROUT": "loss in the switch resistance and in the two capacitors and their ESR"
   },
   "note": "The output voltage drop is IL × ROUT.",
   "page": 10
  },
  {
   "name": "Output resistance of paralleled devices",
   "expr": "ROUT = ROUT of each LM2665 / number of devices",
   "where": {},
   "note": "",
   "page": 10
