 "pins": [
  {
   "package": "SOIC8N",
   "page": 10,
   "pins": [
    {
     "pin": "1",
     "name": "VCC",
     "type": "power in",
     "function": "Supply. Watched by the undervoltage lockout; pulling it below the turn-off threshold stops the chip without harm. Clamped inside. Wants a ceramic bypass capacitor to GND placed right at the pin."
    },
    {
     "pin": "2",
     "name": "OVT",
     "type": "input",
     "function": "Offset voltage trim for the turn-off threshold VTH1. Tied to GND, left open or tied to VCC it picks one of three offset ranges, to suit MOSFETs of different RDS(on)."
    },
    {
     "pin": "3",
     "name": "MOT",
     "type": "analog",
     "function": "Minimum on time. A resistor from this pin to ground sets it, about 200 ns to 3 µs typ (RMOT 5 kΩ to 75 kΩ)."
    },
    {
     "pin": "4",
     "name": "EN",
     "type": "input",
     "function": "Enable, with a 1.5 MΩ internal pull-up. Below about 1.6 V the chip sleeps: gate held off, supply current at its lowest. Meant to be driven cleanly above or below the threshold band, not held inside it, and not toggled fast: high pulses longer than 20 µs, low pulses longer than 10 µs."
    },
    {
     "pin": "5",
     "name": "VD",
     "type": "analog",
     "function": "Drain sense, a 200 V input wired to the SR MOSFET's drain. Route it with care; extra filtering or series current limiting on it slows the chip's response and is advised against."
    },
    {
     "pin": "6",
     "name": "VS",
     "type": "analog",
     "function": "Source sense, the second input of the differential VDS measurement. Taken as a Kelvin connection at the MOSFET's source pin, not joined straight to GND (pin 7)."
    },
    {
     "pin": "7",
     "name": "GND",
     "type": "ground",
     "function": "Ground of the control circuit and the gate driver; electrical figures are referred to it."
    },
    {
     "pin": "8",
     "name": "VGATE",
     "type": "output",
     "function": "Gate drive output, voltage limited inside, 2 A peak source and 7 A peak sink. May drive the gate directly, though a small gate resistor is preferred, above all with paralleled MOSFETs. Keep the gate loop short and small."
    }
   ]
  }
 ],
