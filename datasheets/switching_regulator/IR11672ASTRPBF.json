{
 "sheet": 1,
 "name": "IR11672ASTRPBF",
 "kind": "switching_regulator",
 "manufacturer": "International Rectifier (Infineon)",
 "title": "IR11672AS SmartRectifier: secondary-side synchronous rectifier controller, 200 V sense, SOIC-8",
 "source": {
  "revision": "Nov 6, 2013",
  "pages": 26
 },
 "summary": "A controller that sits on the secondary of an isolated converter and drives one N-channel MOSFET, or several in parallel, so that it takes the place of a rectifier diode. It reads the MOSFET's drain-to-source voltage directly through a 200 V sense pin, turns the gate on when the body diode starts to conduct and off as the current nears zero. It is meant for flyback converters in DCM, CrCM or CCM and for resonant (LLC) half-bridges, up to 500 kHz. A programmable minimum on time masks ringing and, checked every cycle, shuts the gate off at light load; the gate output is clamped near 10.7 V and sinks 7 A peak.",
 "key_figures": [
  [
   "Drain sense voltage VD",
   "200 V max"
  ],
  [
   "Supply VCC",
   "11.4 V to 18 V recommended; 20 V absolute maximum"
  ],
  [
   "Gate drive peak current",
   "+2 A source, -7 A sink (typ)"
  ],
  [
   "Gate high voltage VGTH",
   "10.7 V typ, internally clamped"
  ],
  [
   "Turn-on / turn-off propagation delay",
   "60 ns / 50 ns typ"
  ],
  [
   "Switching frequency",
   "500 kHz max"
  ],
  [
   "Turn-off threshold VTH1",
   "-3.5, -9.5 or -18 mV typ, chosen by the OVT pin"
  ],
  [
   "Minimum on time",
   "240 ns (RMOT = 5 kΩ) to 3.1 µs (RMOT = 75 kΩ) typ"
  ],
