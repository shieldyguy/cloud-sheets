{
 "sheet": 1,
 "name": "ZED-F9P-04B",
 "kind": "wireless_module",
 "manufacturer": "u-blox",
 "title": "ZED-F9P-04B: multi-band high precision GNSS module with RTK, PPP-RTK and moving base, professional grade",
 "source": {
  "document": "UBX-21044850",
  "revision": "R05, 21-Mar-2024",
  "pages": 26
 },
 "summary": "A 17.0 × 22.0 × 2.4 mm land-grid-array GNSS receiver on the u-blox F9 platform that receives GPS, GLONASS, Galileo and BeiDou on two bands each (L1 and L2/E5b), plus QZSS and SBAS. With RTCM corrections it gives RTK fixes to 0.01 m + 1 ppm; with SPARTN or CLAS corrections it gives PPP-RTK fixes; a moving-base mode gives a relative vector and heading between two moving receivers. It runs from 2.7 to 3.6 V, needs an active antenna, and talks over two UARTs, I2C, SPI and USB.",
 "key_figures": [
  [
   "Supply",
   "2.7 to 3.6 V (3.0 V typ)"
  ],
  [
   "Current, acquisition",
   "90 mA (GPS+GLO+GAL+BDS); 130 mA peak"
  ],
  [
   "Signals",
   "GPS L1C/A L2C, GLONASS L1OF L2OF, Galileo E1-B/C E5b, BeiDou B1I B2I, QZSS, SBAS"
  ],
