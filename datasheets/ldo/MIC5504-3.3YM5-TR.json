   "1.2 V to 3.3 V fixed (MIC5504-3.3YM5: 3.3 V)"
  ],
  [
   "Output accuracy",
   "±2.0 % at 25 °C, ±3.0 % over -40 °C to +125 °C"
  ],
  [
   "Dropout voltage",
   "80 mV typ at 150 mA, 160 mV typ at 300 mA"
  ],
  [
   "Ground current",
