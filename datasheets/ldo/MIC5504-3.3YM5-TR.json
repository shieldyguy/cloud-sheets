{
 "sheet": 1,
 "name": "MIC5504-3.3YM5-TR",
 "kind": "ldo",
 "manufacturer": "Microchip (Micrel)",
 "title": "MIC5501/2/3/4: single 300 mA LDO, fixed output, in 1 mm × 1 mm thin DFN or SOT23-5",
 "source": {
  "revision": "Revision 2.3, April 20, 2015",
  "pages": 15
 },
 "summary": "A family of fixed-output CMOS linear regulators that deliver up to 300 mA from a 2.5 V to 5.5 V input, with ±2 % output tolerance at 25 °C, 160 mV typical dropout at full load and 38 µA typical ground current. The four members differ in two features: the MIC5502 and MIC5504 pull the output down through a 25 Ω switch when disabled, and the MIC5503 and MIC5504 hold EN low through an internal 4 MΩ resistor so a floating enable turns the output off. A 1 µF ceramic capacitor on each side keeps the loop stable, and current limiting and thermal shutdown protect the part. MIC5504-3.3YM5 is the 3.3 V MIC5504 in the 5-pin SOT23.",
 "key_figures": [
