{
 "sheet": 1,
 "name": "LK112M50TR",
 "kind": "ldo",
 "manufacturer": "STMicroelectronics",
 "title": "LK112: 150 mA low-noise, low-dropout regulator with shutdown, SOT23-5L",
 "source": {
  "document": "DocID7362",
  "revision": "Rev 17, April 2014",
  "pages": 18
 },
 "summary": "A fixed-output linear regulator with a PNP pass transistor, rated for 150 mA, in a five-lead SOT23-5L. A logic-level SHDN pin switches it off, and then it draws 0.1 µA at most; on and unloaded it draws 175 µA typical. A capacitor on the Bypass pin brings output noise down to 30 µVrms over 10 Hz to 80 kHz. Current limit and thermal shutdown are built in. Eight output voltages from 1.5 V to 8.0 V are offered; LK112M50TR is the 5.0 V part.",
 "key_figures": [
  [
   "Output current",
   "150 mA (current limit 150 mA min)"
  ],
  [
   "Input range",
   "VOUT + 0.5 V to 14 V for VOUT > 2 V; 2.5 V to 14 V for VOUT < 2 V"
  ],
  [
   "Dropout",
   "0.17 V typ, 0.24 V max at 60 mA; 0.29 V typ, 0.35 V max at 150 mA (VOUT > 2.1 V)"
  ],
  [
   "Quiescent current",
   "175 µA typ, 250 µA max on at IOUT = 0; 0 µA typ, 0.1 µA max off"
  ],
  [
   "Output accuracy",
   "±2 % at IO = 30 mA, TJ = 25 °C"
  ],
  [
   "Output noise",
   "30 µVrms, 10 Hz to 80 kHz, CBYP = 0.1 µF, IO = 60 mA"
  ],
  [
   "Supply rejection",
   "55 dB at 400 Hz"
  ],
  [
   "Shutdown thresholds",
   "on at 1.8 V min, off at 0.6 V max"
  ],
  [
   "Absolute maximum input",
   "16 V"
  ],
  [
   "Junction temperature",
   "-40 °C to 125 °C"
  ]
 ],
