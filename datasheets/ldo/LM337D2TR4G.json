 "title": "LM337: 1.5 A adjustable negative three-terminal voltage regulator",
 "source": {
  "document": "LM337/D",
  "revision": "Rev. 11, October 2021",
  "pages": 11
 },
 "summary": "LM337 is a three-terminal linear regulator for negative rails, set from -1.2 V to -37 V by two resistors and good for more than 1.5 A. A floating -1.25 V reference sits between Vout and Adjust. Current limit, thermal shutdown and safe-area protection are built in. It comes in D2PAK and TO-220AB, in commercial (0 to +125 °C junction) and B-grade (-40 to +125 °C) versions; LM337D2TR4G is the commercial D2PAK on tape and reel.",
 "key_figures": [
  [
   "Output voltage range",
   "-1.2 V to -37 V"
  ],
  [
   "Output current",
   "more than 1.5 A; Imax 1.5 A typ, 2.2 A max at |VI-VO| ≤ 15 V (T package)"
  ],
  [
   "Reference voltage",
   "-1.250 V typ (-1.213 to -1.287 V at 25 °C)"
  ],
  [
   "Input-output differential",
   "40 Vdc max"
  ],
  [
   "Adjustment pin current",
   "65 µA typ, 100 µA max"
  ],
  [
   "Line regulation",
   "0.01 %/V typ at 25 °C"
  ],
  [
   "Minimum load current",
   "1.5 mA typ, 6.0 mA max (|VI-VO| ≤ 10 V); 2.5 mA typ, 10 mA max (≤ 40 V)"
  ],
  [
   "Ripple rejection",
   "60 dB typ; 77 dB typ with CAdj = 10 µF"
  ],
  [
   "Thermal resistance, D2PAK",
   "θJA 70 °C/W, θJC 5.0 °C/W"
  ],
  [
   "LM337D2TR4G junction range",
   "0 °C to +125 °C"
  ]
 ],
