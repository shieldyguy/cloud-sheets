{
 "sheet": 1,
 "name": "MC79L05ACDR",
 "kind": "ldo",
 "manufacturer": "Texas Instruments",
 "title": "MC79L00 series 100 mA fixed negative-voltage regulators, −5, −12 and −15 V",
 "source": {
  "revision": "SLVS011D, October 1982, revised August 2003",
  "pages": 14
 },
 "summary": "Three-terminal linear regulators with a fixed negative output of −5, −12 or −15 V and up to 100 mA of load current. Short-circuit current limiting and thermal shutdown are on the die, and the part runs with no parts around it. Output tolerance is 5% (AC grade) or 10% (C grade), for a 0 to 125 °C junction, in an 8-pin SOIC (D) or a three-lead TO-92 (LP). The MC79L05ACDR is the −5 V, 5% part in SOIC on a 2500-piece reel.",
