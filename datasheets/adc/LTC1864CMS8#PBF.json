 "circuits": [
  {
   "id": "typical",
   "title": "Single 5V supply, 250ksps, 16-bit sampling ADC",
   "page": 1,
   "description": "The LTC1864 on one 5V rail with its reference pin tied to the supply, so the span is 0V to 5V. A single 1µF capacitor bypasses the joined VCC and VREF node to ground. The differential input and the three-wire serial port (SCK, SDO, CONV) go to the outside world.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "LTC1864"
    },
    {
     "ref": "C1",
     "type": "capacitor",
