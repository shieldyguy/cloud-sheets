{
 "sheet": 1,
 "name": "AD7171BCPZ-500RL7",
 "kind": "adc",
 "manufacturer": "Analog Devices",
 "title": "16-bit low-power sigma-delta ADC, 125 Hz output rate",
 "source": {
  "revision": "Rev. C",
  "pages": 17
 },
 "summary": "The AD7171 is a single-channel 16-bit sigma-delta converter with one differential input at unity gain, a sinc3 digital filter and its own 64 kHz clock. It delivers conversions at a fixed 125 Hz and reads out over a two-wire, read-only serial port (SCLK in, DOUT/RDY out), each 16-bit result followed by eight status bits. It runs from 2.7 V to 5.25 V, drawing 135 µA typical at 5 V (110 µA at 3 V) and 5 µA with PDRST held low. The reference is external, from 0.5 V up to VDD, and the package is a 3 mm × 3 mm 10-lead LFCSP.",
 "key_figures": [
