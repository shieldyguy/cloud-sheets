 "pins": [
  {
   "package": "10-lead LFCSP (CP-10-9)",
   "page": 8,
   "pins": [
    {
     "pin": "1",
     "name": "SCLK",
     "type": "digital in",
     "function": "Clock for reading data out of the converter; Schmitt-trigger input. It may run continuously, shifting the whole word in one burst, or in separate bursts that take the word a piece at a time."
    },
    {
     "pin": "2",
     "name": "DOUT/RDY",
     "type": "digital out",
     "function": "Two jobs on one pin: it falls when a new conversion is ready, which can serve as a processor interrupt, and it then shifts out the data register, 16 result bits plus 8 status bits. If a result is left unread, the pin returns high ahead of the next register update."
    },
    {
     "pin": "3",
     "name": "AIN(+)",
     "type": "analog in",
     "function": "Positive side of the differential analog input."
    },
    {
     "pin": "4",
     "name": "AIN(−)",
     "type": "analog in",
     "function": "Negative side of the differential analog input."
    },
    {
     "pin": "5",
     "name": "REFIN(+)",
     "type": "analog in",
     "function": "Positive reference input. The external reference sits between REFIN(+) and REFIN(−); nominally 5 V, usable from 0.5 V to VDD."
    },
    {
     "pin": "6",
     "name": "REFIN(−)",
     "type": "analog in",
     "function": "Negative reference input."
    },
    {
     "pin": "7",
     "name": "GND",
     "type": "ground",
     "function": "Ground."
    },
    {
     "pin": "8",
     "name": "VDD",
     "type": "power in",
     "function": "Supply, 2.7 V to 5.25 V."
    },
    {
     "pin": "9",
     "name": "PDRST",
     "type": "digital in",
     "function": "Power-down and reset, active low. Low: the whole chip powers down, all logic resets and DOUT/RDY goes high-impedance. High: the clock starts (about 1 ms) and conversions run continuously."
    },
    {
     "pin": "10",
     "name": "GND",
     "type": "ground",
     "function": "Ground."
    },
    {
     "pin": "EPAD",
     "name": "EPAD",
     "type": "ground",
     "function": "Exposed pad; connect to ground."
    }
   ]
  }
 ],
