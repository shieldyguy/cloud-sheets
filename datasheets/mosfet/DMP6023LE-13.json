 "title": "60 V P-channel enhancement-mode MOSFET in SOT223",
 "source": {
  "revision": "DS37199 Rev. 3-2, January 2015",
  "pages": 7
 },
 "summary": "A single P-channel enhancement-mode MOSFET rated -60 V drain to source, in the SOT223 package with the drain on the middle lead and the tab. On-resistance is 28 mΩ max with the gate at -10 V and 35 mΩ max at -4.5 V; continuous drain current is -7 A at 25 °C ambient on a 1-inch-square 2 oz copper pad and -18.2 A with the case held at 25 °C. It is qualified to AEC-Q101 and is aimed at backlighting, power management and DC-DC converters.",
 "key_figures": [
  [
   "Drain-source voltage",
   "-60 V"
  ],
  [
   "RDS(ON)",
   "28 mΩ max at VGS = -10 V, ID = -5 A; 35 mΩ max at VGS = -4.5 V, ID = -4 A"
  ],
  [
   "Continuous drain current",
   "-7 A at TA = +25 °C; -18.2 A at TC = +25 °C (VGS = -10 V)"
  ],
  [
   "Pulsed drain current",
   "-50 A (10 µs, 1 % duty)"
  ],
  [
   "Gate threshold",
   "-1 to -3 V at ID = -250 µA"
  ],
  [
   "Gate-source voltage",
   "±20 V"
  ],
  [
   "Total gate charge",
   "53.1 nC typ at VGS = -10 V; 26.5 nC at -4.5 V"
  ],
  [
   "Input capacitance",
   "2569 pF typ at VDS = -30 V"
  ],
  [
   "Avalanche",
   "-35.5 A, 62.9 mJ at L = 0.1 mH"
  ],
  [
   "Thermal resistance",
   "60 °C/W junction to ambient; 7.2 °C/W junction to case"
  ],
  [
   "Junction temperature",
   "-55 to +150 °C"
  ]
 ],
