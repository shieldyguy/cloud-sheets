   "Gate-source voltage",
   "±20 V"
  ],
  [
   "Continuous drain current",
   "-50 A at TC = 25 °C (package limited); -39 A at TC = 125 °C"
  ],
  [
   "Pulsed drain current",
   "-80 A"
  ],
  [
   "RDS(on)",
   "12 mΩ typ, 15 mΩ max at VGS = -10 V, ID = -17 A; 20 mΩ max at VGS = -4.5 V, ID = -14 A"
  ],
  [
   "Gate threshold voltage",
   "-1 to -3 V at ID = -250 µA"
  ],
  [
   "Total gate charge",
   "110 nC typ, 165 nC max at VGS = -10 V"
  ],
  [
   "Input capacitance",
   "4950 pF typ at VDS = -25 V"
  ],
  [
   "Power dissipation",
   "136 W at TC = 25 °C; 3 W at TA = 25 °C on a 1 in² FR4 board"
  ],
  [
   "Thermal resistance, junction to case",
   "0.82 °C/W typ, 1.1 °C/W max"
  ],
  [
   "Repetitive avalanche energy",
   "125 mJ at L = 0.1 mH"
  ],
  [
   "Junction temperature",
   "-55 to +175 °C"
  ]
 ],
