 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Body diode",
   "page": 1,
   "text": "The body diode has its anode at the source and its cathode at the drain. Its forward voltage is 1.4 V max at IS = 0.44 A."
  },
  {
   "topic": "Gate drive",
   "page": 2,
   "text": "Gate threshold is 0.7 V min and 1.5 V max at ID = 250 µA. On-resistance at ID = 0.22 A is 3.5 Ω max at VGS = 10 V and 6.0 Ω max at VGS = 4.5 V. Typical on-resistance at 25 °C and 0.1 A is about 0.89 Ω at 10 V and 1.04 Ω at 4.5 V, and it rises steeply below VGS = 3 V. Gate-source voltage is rated ±20 V."
  },
  {
   "topic": "Heat",
   "page": 1,
   "text": "Junction-to-ambient thermal resistance is 417 °C/W in steady state. Power dissipation is 0.3 W at TA = 25 °C. Junction and storage temperature range is -55 to +150 °C."
  },
  {
   "topic": "Construction",
   "page": 1,
   "text": "Built on a trench power MV MOSFET process for fast switching. The mold compound is halogen-free, meets RoHS and carries a UL 94V-0 flammability rating. Leads are solder plated; solderability is to MIL-STD-750, Method 2026."
  }
 ],
