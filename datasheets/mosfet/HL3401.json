 "title": "-30 V, -4.4 A P-channel trench MOSFET in SOT-23",
 "source": {
  "revision": "Rev 2.0",
  "pages": 5
 },
 "summary": "A single P-channel enhancement MOSFET on a low-voltage trench process, in the three-lead SOT-23 marked A19T. It is rated -30 V drain to source and -4.4 A continuous drain current (-17 A pulsed), with the gate rated ±12 V. On-resistance is at most 55 mΩ with -10 V on the gate, 68 mΩ at -4.5 V and 96 mΩ at -2.5 V, and the threshold sits between -0.6 V and -1.4 V. Named uses are battery protection, load switching and power management.",
 "key_figures": [
  [
   "Drain-source voltage VDS",
   "-30 V"
  ],
  [
   "Continuous drain current ID",
   "-4.4 A; -17 A pulsed"
  ],
  [
   "RDS(ON)",
   "55 mΩ max (45.5 typ) at VGS = -10 V, ID = -4.4 A; 68 mΩ max (52 typ) at -4.5 V, -4.0 A; 96 mΩ max (64 typ) at -2.5 V, -2.0 A"
  ],
  [
   "Gate threshold VGS(th)",
   "-0.6 to -1.4 V (-0.9 typ) at VDS = VGS, ID = -250 μA"
  ],
