{
 "sheet": 1,
 "name": "HL6042",
 "kind": "mosfet",
 "manufacturer": "Zhuhai Hongjiacheng Technology Co., Ltd",
 "title": "-20 V, -5.0 A P-channel trench MOSFET in SOT-23",
 "source": {
  "revision": "Rev 2.0",
  "pages": 5
 },
 "summary": "A P-channel enhancement MOSFET in the three-lead SOT-23, built on a trench process. It blocks -20 V drain to source and carries -5.0 A continuously with the ambient at 25 °C (-30 A pulsed). On-resistance is at most 43 mΩ with -4.5 V on the gate and stays specified down to -1.5 V of gate drive (100 mΩ max); the threshold lies between -0.3 V and -0.9 V. Uses named for it are battery-powered equipment, solid-state relays and direct drive from TTL or CMOS logic.",
 "key_figures": [
  [
   "Drain-source voltage",
   "-20 V"
  ],
  [
   "Continuous drain current",
   "-5.0 A at TA = 25 °C, -4.0 A at TA = 70 °C (-30 A pulsed)"
  ],
  [
   "RDS(on)",
   "43 mΩ max at VGS = -4.5 V; 55 mΩ max at -2.5 V; 75 mΩ max at -1.8 V; 100 mΩ max at -1.5 V"
  ],
  [
   "Gate threshold",
   "-0.3 to -0.9 V at VDS = VGS, ID = -250 μA"
  ],
  [
   "Gate-source voltage",
   "±10 V"
  ],
  [
   "Total gate charge",
   "7.4 to 11 nC at VGS = -4.5 V, VDS = -10 V, ID = -4.0 A"
  ],
  [
   "Power dissipation",
   "1.5 W at TA = 25 °C"
  ],
  [
   "Thermal resistance, junction to ambient",
   "357 °C/W"
  ],
  [
   "Package",
   "SOT-23, marking 6042"
  ]
 ],
