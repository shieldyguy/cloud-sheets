 "operation": [
  {
   "topic": "Gate drive",
   "page": 3,
   "text": "The channel starts to conduct between 1 V and 2.5 V on the gate. On-resistance is guaranteed at two drive levels, 10 V (35 mΩ max) and 4.5 V (40 mΩ max). At 25 °C it rises steeply once VGS drops below about 3.6 V (Figure 5). The gate tolerates ±20 V."
  },
  {
   "topic": "Gate charge",
   "page": 3,
   "text": "Taking the gate to 10 V needs 25 nC typical with 30 V and 15 A at the drain; of that, Qgs is 4.5 nC and the Miller charge Qgd is 6.5 nC."
  },
  {
   "topic": "Heat and current",
   "page": 1,
   "text": "The 20 A continuous and 55 W ratings are for a case held at 25 °C; at a 100 °C case the continuous current falls to 14 A. Junction-to-case resistance is 2.7 °C/W max; the transient-impedance curves use 125 °C/W junction to ambient. On-resistance rises with temperature, to about 1.6 times its 25 °C value at 100 °C and 2.2 times at 150 °C (Figure 4)."
  },
  {
   "topic": "Avalanche",
   "page": 1,
   "text": "The avalanche energy rating is 72 mJ, with a 0.5 mH inductor from 30 V, starting at TJ = 25 °C."
  },
  {
   "topic": "Body diode",
   "page": 4,
   "text": "The source-to-drain diode drops at most 1.2 V at 15 A with the gate off. Recovering from 15 A at 100 A/µs takes 29 ns typical."
  }
 ],
