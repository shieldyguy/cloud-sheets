{
 "sheet": 1,
 "name": "HL2310A",
 "kind": "mosfet",
 "manufacturer": "Zhuhai Hongjiacheng Technology Co., Ltd",
 "title": "60 V, 3.0 A N-channel trench MOSFET in SOT-23",
 "source": {
  "revision": "Rev 2.1",
  "pages": 5
 },
 "summary": "An N-channel enhancement MOSFET in the three-lead SOT-23, built on a trench low-voltage process. It blocks 60 V drain to source and carries 3.0 A continuously with the ambient at 25 °C (10 A pulsed). On-resistance is at most 105 mΩ with 10 V on the gate and 125 mΩ with 4.5 V; the threshold lies between 0.9 V and 2.0 V. Listed uses are battery protection, load switching and power management.",
 "key_figures": [
  [
   "Drain-source voltage",
   "60 V"
  ],
  [
   "Continuous drain current",
   "3.0 A at Ta = 25 °C, 2.4 A at Ta = 100 °C (10 A pulsed)"
  ],
  [
   "RDS(on)",
   "105 mΩ max at VGS = 10 V, ID = 3 A; 125 mΩ max at VGS = 4.5 V, ID = 2 A"
  ],
  [
   "Gate threshold",
   "0.9 to 2.0 V at VDS = VGS, ID = 250 μA"
  ],
  [
   "Gate-source voltage",
   "±20 V"
  ],
  [
