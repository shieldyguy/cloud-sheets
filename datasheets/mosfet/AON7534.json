 "circuits": [
  {
   "id": "gate-charge-test",
   "title": "Gate charge test circuit",
   "page": 6,
   "description": "Measures Qg, Qgs and Qgd. A pulsed constant gate current Ig charges the DUT gate, and VGS is recorded against the charge delivered. Drain current comes from the Vds supply through a second N-channel MOSFET stacked on the DUT drain. That upper transistor takes its gate voltage from a potentiometer wiper; the potentiometer sits across a floating DC source referenced to the node between the two transistors, with one capacitor across that source and another from the wiper to the same node. On the VGS-against-charge trace, which climbs to 10 V, Qgs is the charge to the start of the plateau, Qgd the charge along the plateau, and Qg the total. The charge rows use VGS = 10 V, VDS = 15 V, ID = 20 A.",
   "parts": [
