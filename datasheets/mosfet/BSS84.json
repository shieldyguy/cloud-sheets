 "title": "-50 V, -0.13 A P-channel enhancement-mode small-signal MOSFET in SOT-23",
 "source": {
  "revision": "BSS84/D Rev. 5, October 2021; case outline 98ASB42226B (case 318, issue AU, 14 Aug 2024)",
  "pages": 8
 },
 "summary": "A P-channel enhancement-mode DMOS field-effect transistor in the three-lead SOT-23. It blocks -50 V drain to source, takes ±20 V on the gate, and carries -0.13 A continuously and -0.52 A in pulses. On-resistance is 1.2 Ω typical and 10 Ω maximum at VGS = -5 V and ID = -0.10 A; the gate threshold lies between -0.8 V and -2 V. It is aimed at low-current high-side switching on low-voltage rails.",
 "key_figures": [
  [
   "Drain-source voltage",
   "-50 V"
  ],
  [
   "Gate-source voltage",
   "±20 V"
  ],
  [
   "Drain current",
   "-0.13 A continuous, -0.52 A pulsed"
  ],
  [
   "RDS(on) at VGS = -5 V, ID = -0.10 A",
   "1.2 Ω typ, 10 Ω max (17 Ω max at TJ = 125 °C)"
  ],
  [
   "Gate threshold voltage",
   "-0.8 to -2 V (-1.7 V typ) at ID = -1 mA"
  ],
  [
   "Total gate charge",
   "0.9 nC typ, 1.3 nC max at VGS = -5 V"
  ],
  [
   "Input capacitance",
   "73 pF typ at VDS = -25 V"
  ],
  [
   "Power dissipation",
   "0.36 W at TA = 25 °C, minimum pad"
  ],
  [
   "Thermal resistance, junction to ambient",
   "350 °C/W"
  ],
  [
   "Junction temperature",
   "-55 to +150 °C"
  ]
 ],
