{
 "sheet": 1,
 "name": "DMG2302UK-7",
 "kind": "mosfet",
 "manufacturer": "Diodes Incorporated",
 "title": "20 V N-channel enhancement MOSFET with ESD-protected gate, SOT23",
 "source": {
  "revision": "DS38439 Rev. 2 - 2, January 2016",
  "pages": 7
 },
 "summary": "A single N-channel enhancement-mode MOSFET in the three-lead SOT23, rated 20 V drain to source and ±12 V on the gate. On-resistance is at most 90 mΩ with 4.5 V of gate drive and 120 mΩ at 2.5 V, and the threshold sits between 0.3 V and 1.0 V. The gate carries a protection diode against ESD. Qualified to AEC-Q101, lead-free, halogen- and antimony-free; aimed at backlighting, power management, DC-DC conversion and motor control.",
 "key_figures": [
  [
   "Drain-source voltage",
   "20 V"
  ],
  [
   "Gate-source voltage",
   "±12 V"
  ],
  [
   "Continuous drain current",
   "2.8 A at TA = +25 °C, 2.2 A at TA = +70 °C (VGS = 4.5 V, 1 in² 2 oz copper)"
  ],
  [
   "Pulsed drain current",
   "12 A (10 µs, 1 % duty)"
  ],
  [
   "RDS(ON) max",
   "90 mΩ at VGS = 4.5 V; 120 mΩ at VGS = 2.5 V"
  ],
  [
   "Gate threshold",
   "0.3 to 1.0 V (0.6 V typ) at ID = 250 µA"
  ],
  [
   "Total gate charge",
   "1.4 nC typ at VGS = 4.5 V; 2.8 nC typ at VGS = 10 V"
  ],
  [
   "Input capacitance",
   "130 pF typ at VDS = 10 V"
  ],
  [
   "Power dissipation",
   "0.66 W (minimum pad); 1.1 W (1 in² 2 oz copper)"
  ],
  [
   "Package",
   "SOT23"
  ]
 ],
