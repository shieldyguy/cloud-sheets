 "circuits": [
  {
   "id": "gate-charge-test",
   "title": "Gate charge test circuit",
   "page": 5,
   "description": "Measures Qg, Qgs and Qgd. A constant current Ig is pushed into the gate of the device under test while VGS is recorded against the charge delivered. The drain current comes from a second N-channel MOSFET in series with the DUT drain, fed from the Vds supply; its gate is set by a potentiometer across a floating DC source referred to its own source, with a capacitor from the wiper to that source. The charge rows use VGS = 4.5 V, VDS = 15 V, ID = 5.7 A. On the VGS-against-charge trace, Qgs runs from zero to the start of the flat plateau, Qgd spans the plateau, and Qg is the total up to the final gate voltage.",
   "parts": [
    {
     "ref": "Q1",
     "type": "nmos",
     "value": "AO3400A",
     "note": "device under test"
