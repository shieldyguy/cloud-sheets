{
 "sheet": 1,
 "name": "LBSS84LT1G",
 "kind": "mosfet",
 "manufacturer": "Leshan Radio Company (LRC)",
 "title": "50 V, 130 mA P-channel MOSFET in SOT-23",
 "source": {
  "revision": "Rev. A",
  "pages": 4
 },
 "summary": "A small P-channel enhancement MOSFET in the three-lead SOT-23, rated 50 V drain to source, ±20 V gate to source and 130 mA continuous drain current (520 mA in 10 µs pulses). On-resistance is 5.0 Ω typical and 10 Ω at most with 5 V of gate drive at 100 mA; the gate threshold falls between 0.8 V and 2.0 V. It is aimed at switching loads and DC-DC conversion in battery-run and portable gear. Parts with the S- prefix are AEC-Q101 qualified and PPAP capable.",
 "key_figures": [
  [
