 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Gate drive",
   "page": 3,
   "text": "The threshold is 1 V to 2 V at 250 µA. On-resistance is specified at 3 A with 10 V on the gate (105 mΩ max) and with 4.5 V (125 mΩ max). 5 V, 4 V and 3 V of gate drive give one output curve, reaching about 14 A at 5 V across the part; 2.5 V gives about 8 A and 2.0 V about 2.4 A."
  },
  {
   "topic": "Temperature",
   "page": 3,
   "text": "The threshold at 250 µA falls about linearly from roughly 1.03 V at 25 °C to roughly 0.69 V at 125 °C. In the transfer curve the 25 °C and 100 °C lines cross near VGS = 2.1 V and 3 A: below that point the hot part conducts more, above it less."
  },
  {
   "topic": "Body diode",
   "page": 2,
   "text": "The source-to-drain diode drops at most 1.2 V at 3 A; at 25 °C it carries about 1 mA at 0.55 V and 10 A at 1.02 V."
  }
 ],
