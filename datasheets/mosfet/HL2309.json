 "manufacturer": "Zhuhai Hongjiacheng Technology",
 "title": "-60 V P-channel trench MOSFET in SOT-23",
 "source": {
  "revision": "Rev 2.2",
  "pages": 5
 },
 "summary": "A single P-channel enhancement MOSFET on a trench process in the three-lead SOT-23, rated -60 V from drain to source and -1.25 A continuous at 25 °C ambient on an FR4 board. On-resistance is at most 340 mΩ with the gate at -10 V and 550 mΩ at -4.5 V; the threshold lies between -1.0 V and -3.0 V. Total gate charge is 5.4 nC typical, and the package dissipates 1.25 W at 25 °C ambient.",
 "key_figures": [
  [
   "Drain-source voltage",
   "-60 V"
  ],
  [
   "Continuous drain current",
   "-1.25 A at TA = 25 °C; -0.85 A at 70 °C"
  ],
  [
   "Pulsed drain current",
   "-8.0 A"
  ],
  [
   "RDS(ON)",
   "275 mΩ typ, 340 mΩ max at VGS = -10 V; 406 mΩ typ, 550 mΩ max at VGS = -4.5 V"
  ],
  [
   "Gate threshold",
   "-1.0 to -3.0 V at -250 µA"
  ],
  [
   "Gate-source voltage",
   "±20 V"
  ],
  [
   "Total gate charge",
   "5.4 nC typ, 12 nC max at VGS = -10 V"
  ],
  [
   "Input capacitance",
   "380 pF typ at VDS = -30 V"
  ],
  [
   "Power dissipation",
   "1.25 W at TA = 25 °C"
  ],
  [
   "Thermal resistance, junction to ambient",
   "357 °C/W steady state"
  ]
 ],
