   "–35 A package limit; –76 A at TC = 25 °C; –15 A on 1 in² copper"
  ],
  [
   "Pulsed drain current",
   "–148 A"
  ],
  [
   "RDS(on)",
   "7.7 mΩ typ, 8.9 mΩ max at VGS = –4.5 V; 13.3 / 15.9 mΩ at –2.5 V (ID = –10 A); 74 / 300 mΩ at –1.8 V (ID = –1 A)"
  ],
  [
   "Gate threshold",
   "–0.65 to –1.15 V, –0.90 V typ at ID = –250 µA"
  ],
  [
   "Total gate charge",
   "7.5 nC typ, 9.7 nC max at –4.5 V"
  ],
  [
   "Gate-drain charge",
   "1.1 nC typ"
  ],
  [
   "Input capacitance",
   "1380 pF typ at VDS = –10 V"
  ],
  [
   "Thermal resistance",
   "RθJC 2.3 °C/W max; RθJA 55 °C/W max on 1 in² copper"
  ],
  [
   "Junction temperature",
   "–55 °C to 150 °C"
  ],
  [
   "Package",
   "SON 3.3 mm × 3.3 mm (Q3A, VSONP DNH), 8 pins plus exposed pad"
  ]
 ],
