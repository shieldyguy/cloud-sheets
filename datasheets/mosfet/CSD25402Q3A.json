 "name": "CSD25402Q3A",
 "kind": "mosfet",
 "manufacturer": "Texas Instruments",
 "title": "–20 V P-channel NexFET power MOSFET, 3.3 mm × 3.3 mm SON",
 "source": {
  "revision": "SLPS454B, revised January 2016",
  "pages": 17
 },
 "summary": "A single P-channel power MOSFET rated to –20 V, built in a 3.3 mm square eight-lead SON whose exposed underside pad is the source. Its gate is specified down to –1.8 V: on-resistance is 8.9 mΩ max at –4.5 V, 15.9 mΩ max at –2.5 V and 300 mΩ max at –1.8 V, with 7.5 nC typical total gate charge. Continuous drain current is –76 A at TC = 25 °C, with a –35 A package limit. Uses listed are DC-DC conversion, battery management and protection, and load switching. Lead-free, halogen-free and RoHS compliant.",
 "key_figures": [
  [
   "Drain-source voltage",
   "–20 V"
  ],
  [
   "Gate-source voltage",
   "±12 V"
  ],
