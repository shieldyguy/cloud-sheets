 "source": {
  "revision": "S10-2430-Rev. C, 25-Oct-10",
  "pages": 8
 },
 "summary": "A single P-channel enhancement MOSFET on Vishay's TrenchFET process, rated -20 V drain to source and ±8 V gate to source, in the three-lead TO-236 (SOT-23) package. On-resistance is at most 0.112 Ω with -4.5 V on the gate and 0.142 Ω with -2.5 V. Continuous drain current is -3.1 A with the case at 25 °C and -2.3 A on a 1 in × 1 in FR4 board. Its listed use is load switching; it is halogen-free (IEC 61249-2-21) and RoHS compliant.",
 "key_figures": [
  [
   "Drain-source voltage",
   "- 20 V"
  ],
  [
   "Gate-source voltage",
   "± 8 V"
  ],
  [
   "RDS(on)",
   "0.112 Ω max at VGS = - 4.5 V; 0.142 Ω max at VGS = - 2.5 V"
  ],
  [
   "Continuous drain current",
   "- 3.1 A at TC = 25 °C; - 2.3 A at TA = 25 °C (1 in × 1 in FR4, t = 5 s)"
  ],
  [
   "Pulsed drain current",
   "- 10 A"
  ],
  [
   "Gate threshold",
   "- 0.4 to - 1 V at ID = - 250 µA"
  ],
  [
   "Total gate charge",
   "3.3 nC typ at VGS = - 2.5 V; 5.5 nC typ at - 4.5 V"
  ],
  [
   "Input capacitance",
   "405 pF typ at VDS = - 10 V"
  ],
  [
   "Power dissipation",
   "1.6 W at TC = 25 °C; 0.86 W at TA = 25 °C (FR4 board, t = 5 s)"
  ],
  [
   "Junction-to-foot thermal resistance",
   "78 °C/W max"
  ],
  [
   "Junction temperature",
   "- 55 to 150 °C"
  ]
 ],
