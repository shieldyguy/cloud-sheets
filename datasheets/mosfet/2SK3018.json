 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Gate drive",
   "page": 2,
   "text": "The threshold is 0.8 to 1.5 V at 0.1 mA drain current with 3 V on the drain. On-resistance is guaranteed at two gate voltages: 8.0 Ω max at 4.0 V and 10 mA, and 13 Ω max at 2.5 V and 1.0 mA. It rises with temperature: with 4 V on the gate it is about 4.2 Ω at -25 °C and about 7 Ω at 125 °C."
  },
  {
   "topic": "Gate protection",
   "page": 1,
   "text": "A protection diode is built in between gate and source, alongside the drain-source body diode. Gate leakage is at most ±10 μA at ±20 V."
  },
  {
   "topic": "Heat",
   "page": 1,
   "text": "Dissipation is rated 200 mW with the ambient at 25 °C, and the junction-to-ambient thermal resistance is 357 °C/W typical. Junction and storage temperature both span -55 °C to +150 °C."
  },
  {
   "topic": "Construction",
   "page": 1,
   "text": "Trench low-voltage process with a dense cell layout. The SOT-23 mold compound is rated UL 94V-0 for flammability and is RoHS-compliant and halogen-free. Leads are solder plated and meet the solderability test of MIL-STD-750 method 2026."
  },
  {
   "topic": "Uses",
   "page": 1,
   "text": "Listed applications are interfacing and load switching; the part is described as high-speed switching."
  }
 ],
