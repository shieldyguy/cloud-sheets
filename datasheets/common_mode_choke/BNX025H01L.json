 "operation": [
  {
   "topic": "Equivalent circuit",
   "page": 4,
   "text": "From terminal 1 (B) the supply path runs through inductor L1, then inductor L3, to terminal 2 (CB). From terminal 3 (PSG) the ground path runs through inductor L2 to terminal 4 (CG). Capacitor C1 joins the L1-L3 node to the output of L2, and capacitor C2 joins CB to CG."
  },
  {
   "topic": "Current derating",
   "page": 4,
   "text": "Across the BNX024H, 025H, 026H and 027H series the full 20 A holds up to 85 °C. Above that the allowed current falls in a straight line to 1 A at 125 °C."
  },
  {
   "topic": "Family",
   "page": 2,
   "text": "BNX024H, 025H, 026H and 027H are SMD block-type EMIFIL filters for automotive use, built for high current across a wide frequency range. With a -55 °C to 125 °C operating range they are aimed at noise on DC switching lines in automotive, factory-automation and office equipment. The family features name 15 A, and for BNX027 an insertion loss of 35 dB min from 40 kHz to 1 GHz."
  },
  {
   "topic": "Applications",
   "page": 2,
   "text": "Named uses: automotive equipment, PDP and LCD televisions, digital AV equipment, amusement machines, PC peripherals, industrial and measuring equipment, and power supplies."
  }
 ],
