 "circuits": [],
 "equations": [
  {
   "name": "Maximum zener current",
   "expr": "IZ = Ptot / VZ",
   "where": {
    "Ptot": "power dissipation rating, 500 mW",
    "VZ": "zener voltage"
   },
   "note": "",
   "page": 1
  },
  {
   "name": "Peak zener current for a pulse",
   "expr": "iZM = (−VZ + (VZ² + 4 × rzj × T / Zthp)^(1/2)) / (2 × rzj)",
   "where": {
    "iZM": "permitted peak zener current in the pulse",
    "VZ": "zener voltage",
    "rzj": "zener resistance of the junction",
    "T": "temperature rise allowed, Tj max − Tamb",
    "Zthp": "thermal resistance for the pulse length and duty cycle, from Fig. 11"
   },
   "note": "Fig. 11 is drawn for RthJA = 300 K/W.",
   "page": 5
  },
  {
   "name": "Relative working voltage",
   "expr": "VZtn = VZt / VZ(25 °C)",
   "where": {
    "VZt": "zener voltage at junction temperature Tj",
    "VZ(25 °C)": "zener voltage at 25 °C"
   },
   "note": "Fig. 4 plots VZtn for temperature coefficients from −4 to 10 × 10⁻⁴/K.",
   "page": 4
  }
 ],
 "operation": [
  {
   "topic": "Tolerance groups and test currents",
   "page": 2,
   "text": "Each voltage comes in a C version and a B version with the same nominal voltage and the same leakage, resistance and temperature-coefficient limits; the B parts hold a narrower zener voltage window (for 5.6 V: 5.48 V to 5.72 V against 5.2 V to 6 V). Voltages 2V4 to 36 are tested at IZT1 = 5 mA and IZT2 = 1 mA; 39 to 75 at 2.5 mA and 0.5 mA (BZM55B39 keeps IZT2 = 1 mA)."
  },
  {
   "topic": "Construction and equivalents",
   "page": 1,
   "text": "A glass body, hermetically sealed, between two metal end caps (MicroMELF). Electrically the series matches the BZT55 and TZM series. The part fits a SOD-323 land. A band marks the cathode end. The small gap between end plug and glass may sit at either end of the body."
  },
  {
   "topic": "Characteristics",
   "page": 1,
   "text": "Very sharp reverse knee, low reverse current, very high stability and low noise. Lead (Pb) free, RoHS compliant, halogen free."
  },
  {
   "topic": "Power derating",
   "page": 4,
   "text": "Ptot is 500 mW up to about 25 °C ambient and falls linearly to zero near 175 °C (Fig. 1). The 500 mW rating holds for RthJA ≤ 300 K/W; the zener current limit is Ptot/VZ."
  },
  {
   "topic": "Thermal test board",
   "page": 5,
   "text": "The board for the RthJA definition (Fig. 8) measures 24 mm × 25 mm. Four terminal pads, each 2.5 mm wide and 10 mm long, lie along one edge; traces 0.152 mm and 0.355 mm wide run from them to the diode land, 9.9 mm above the terminal pads. The diode land carries further dimensions of 0.71 mm, 1.3 mm and 1.27 mm."
  },
  {
   "topic": "Pulsed operation",
   "page": 5,
   "text": "For pulses, Fig. 11 gives the thermal resistance Zthp against pulse length for duty cycles tp/T from 0.5 down to 0.01 and for a single pulse; with it the iZM equation gives the peak current a pulse may carry for a given allowed temperature rise."
  },
  {
   "topic": "Soldering",
   "page": 1,
   "text": "Moisture sensitivity level 1 to J-STD-020; peak soldering temperature 260 °C. Pads for reflow and wave soldering are in the foot pad table."
  }
 ],
