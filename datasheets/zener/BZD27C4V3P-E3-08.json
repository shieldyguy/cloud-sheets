 "title": "BZD27C series: silicon planar Zener diodes, 3.6 V to 200 V, with surge rating, in SMF (DO-219AB)",
 "source": {
  "document": "Document Number: 85153",
  "revision": "Rev. 2.1, 15-Dec-2022",
  "pages": 7
 },
 "summary": "A family of 43 single, unidirectional Zener diodes in the low-profile SMF (DO-219AB) surface-mount package, nominal Zener voltages 3.6 V to 200 V. Each voltage is specified twice: as a voltage regulator (Zener voltage, leakage, dynamic resistance at the test current) and, from 7.5 V up, as a protection diode (clamping voltage at a rated 10/1000 µs surge current). Dissipation is 800 mW on a small-pad board and 2300 mW with the lead held at 105 °C. BZD27C4V3P-E3-08 is the 4.3 V part, commercial grade, on a 7-inch reel.",
 "key_figures": [
  [
   "Zener voltage range, nominal",
   "3.6 V to 200 V (BZD27C4V3P: 4 V min, 4.3 V nom, 4.6 V max at 100 mA)"
  ],
  [
   "Test current IZT",
   "5 mA to 100 mA"
  ],
  [
   "Power dissipation Ptot",
   "2300 mW at TL = 105 °C; 800 mW at TA = 30 °C on 3 mm x 3 mm pads"
  ],
  [
   "Non-repetitive surge power",
   "300 W (100 µs square pulse); 150 W (10/1000 µs waveform)"
  ],
  [
   "Thermal resistance",
   "RthJL 30 K/W; RthJA 180 K/W"
  ],
  [
   "Forward voltage VF",
   "1.2 V max at IF = 0.2 A"
  ],
  [
   "Junction temperature",
   "175 °C max; operating and storage -65 °C to +175 °C"
  ],
  [
   "ESD (AEC-Q101)",
   "human body model > 8 kV; machine model > 800 V"
  ],
  [
   "Package",
   "SMF (DO-219AB), 15 mg"
  ]
 ],
