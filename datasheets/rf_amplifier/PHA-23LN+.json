 "circuits": [
  {
   "id": "typical",
   "title": "Characterization test and recommended application circuit",
   "page": 4,
   "description": "The amplifier between two 50 Ω ports. At the input, C1 is a small shunt capacitor to ground and L2 a series inductor, ahead of the DC-blocking capacitor C2 that feeds pin 1. C3 in series with R1 runs from pin 1 to pin 3, a resistive feedback path whose capacitor keeps DC off it. The supply VDD reaches pin 3 through the choke L1, decoupled to ground at the supply end by C5 and C6; C4 blocks DC from the output port. Pins 2 and 4 go to ground.",
   "parts": [
