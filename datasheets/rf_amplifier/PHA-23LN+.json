 "equations": [],
 "operation": [
  {
   "topic": "Biasing",
   "page": 3,
   "text": "DC bias enters at pin 3, the RF output, through the choke L1; C4 couples the RF output to the load. Pin 3 is rated to +10 V DC. Supply current at +5 V is 141.7 mA typical and varies by 0.0354 mA per mV of supply."
  },
  {
   "topic": "Linearity",
   "page": 1,
   "text": "Output IP3 is approximately 13 to 18 dB above P1dB across the band. Named uses: drivers for up-converter paths with complex waveforms, drivers in linearized transmitters, and second-stage receiver amplifiers where very wide dynamic range is needed."
  },
  {
   "topic": "Supply range",
   "page": 1,
   "text": "Supply voltage is +3 V to +5 V. Typical supply current is 72.4 mA at +3 V and 141.7 mA at +5 V."
  },
  {
   "topic": "Test conditions",
   "page": 4,
   "text": "Gain, return loss, P1dB, output IP3 and noise figure are measured with an Agilent N5242A PNA-X microwave network analyzer, with the part soldered on test board TB-951-23LN+."
  },
  {
   "topic": "Thermal",
   "page": 2,
   "text": "Junction-to-ground-lead thermal resistance is 23.3 °C/W, at a +85°C stage temperature. Operating temperature is stated at the ground lead, -40°C to +105°C."
  }
 ]
