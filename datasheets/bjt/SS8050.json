 "operation": [
  {
   "topic": "Complement",
   "page": 1,
   "text": "The PNP counterpart is the SS8550."
  },
  {
   "topic": "Current gain ranks",
   "page": 2,
   "text": "Gain is sorted into three ranks: L spans 120 to 200, H 200 to 350 and J 300 to 400."
  },
  {
   "topic": "Gain against current and temperature",
   "page": 2,
   "text": "At VCE = 1 V the gain is nearly flat from 0.1 mA to roughly 100 mA and then drops off towards 1 A. It rises with temperature: near 170 at -25 °C, near 240 at 25 °C and near 340 at 125 °C at the low-current end (Fig.2)."
  },
  {
   "topic": "Saturation",
   "page": 2,
   "text": "With base current one tenth of collector current, VCE(sat) sits between about 6 and 10 mV at low current and climbs to about 0.2 to 0.3 V at 1 A, higher when hotter (Fig.3). VBE(sat) falls as temperature rises and approaches 1 V at the top of the current range (Fig.4)."
  },
  {
   "topic": "Base-emitter voltage",
   "page": 3,
   "text": "At VCE = 1 V and 25 °C, IC reaches 1 mA at about 0.58 V and 100 mA at about 0.71 V on VBE; the curve moves to lower voltage as temperature rises (Fig.5)."
  },
  {
   "topic": "Moisture and soldering",
   "page": 1,
   "text": "Moisture sensitivity level 1 to J-STD-020, with a lead-free reflow peak of 260 °C."
  },
  {
   "topic": "Materials and finish",
   "page": 1,
   "text": "Moulding compound: UL 94V-0 flammability, RoHS-compliant, halogen-free. Lead finish: solder plate, solderable to MIL-STD-750 Method 2026."
  }
