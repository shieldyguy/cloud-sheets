 "operation": [
  {
   "topic": "Switching time definitions",
   "page": 6,
   "text": "Times are taken between the 10 % and 90 % points of the base current and collector current waveforms. Delay time td runs from the base current reaching 10 % to the collector current reaching 10 %; rise time tr from 10 % to 90 % of collector current. ton is td plus tr. Storage time ts runs from the falling base current passing 90 % of IBon to the falling collector current passing 90 %; fall time tf from 90 % to 10 % of collector current. toff is ts plus tf. The base is driven to IBon and then reversed to IBoff."
  },
  {
   "topic": "Qualification",
   "page": 6,
   "text": "Qualified to AEC-Q101, the automotive stress test standard for discrete semiconductors."
  },
  {
   "topic": "Marking",
   "page": 2,
   "text": "The body carries the code %1P, where % is replaced by a manufacturing site code."
  }
 ],
