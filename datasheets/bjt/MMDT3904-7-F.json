 "operation": [
  {
   "topic": "Two transistors",
   "page": 1,
   "text": "Q1 has its collector, base and emitter on pins 3, 5 and 4; Q2 has them on pins 6, 2 and 1. The two transistors are electrically separate. The 200 mW dissipation rating and its derating curve are for the whole package."
  },
  {
   "topic": "Derating",
   "page": 2,
   "text": "Total dissipation is 200 mW up to 25 °C ambient and falls in a straight line to zero at 150 °C."
  },
  {
   "topic": "Uses",
   "page": 1,
   "text": "Intended for switching and for amplifier stages at moderate power."
  }
 ],
