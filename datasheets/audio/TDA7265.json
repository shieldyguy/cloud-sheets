 "sheet": 1,
 "name": "TDA7265",
 "kind": "audio",
 "manufacturer": "STMicroelectronics",
 "title": "25 W + 25 W stereo class AB power amplifier with mute and standby",
 "source": {
  "revision": "July 1998",
  "pages": 11
 },
 "summary": "Dual class AB audio power amplifier in the 11-lead Multiwatt package, run from a split supply of up to ±25 V absolute maximum. It gives 25 W per channel into 8 Ω at 10 % THD from ±20 V. One pin selects standby, mute or play by its voltage below +VS, without pops at power-up and power-down. Outputs are short-circuit protected and the die has a thermal shutdown.",
