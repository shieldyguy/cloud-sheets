{
 "sheet": 1,
 "name": "LM386G-S08-R",
 "kind": "audio",
 "manufacturer": "Unisonic Technologies (UTC)",
 "title": "LM386: low-voltage audio power amplifier, gain 20 to 200, DIP-8, SOP-8 and TSSOP-8",
 "source": {
  "document": "QW-R107-007.J",
  "revision": "2015",
  "pages": 7
 },
 "summary": "A single-channel audio power amplifier for battery-powered equipment running from 4 V to 12 V. With pins 1 and 8 open the voltage gain is fixed at 20 by internal resistors; a capacitor, or a resistor and capacitor in series, across those pins raises it up to 200. Both inputs are referred to ground through 50 kΩ and the output settles at half the supply with no external bias parts. Quiescent drain is 4 mA typical (24 mW at 6 V). LM386G-S08-R is the halogen-free SOP-8 part on tape and reel.",
 "key_figures": [
  [
   "Supply voltage",
   "4 V to 12 V"
  ],
  [
   "Quiescent current",
   "4 mA typ, 8 mA max at VS = 6 V"
  ],
  [
   "Output power",
   "325 mW typ at VS = 6 V, 700 mW typ at VS = 9 V (RL = 8 Ω, THD = 10 %)"
  ],
  [
   "Voltage gain",
   "26 dB (pins 1, 8 open) to 46 dB (10 µF from pin 1 to pin 8)"
  ],
  [
   "Bandwidth",
   "300 kHz typ"
  ],
  [
   "THD",
   "0.2 % typ at 125 mW, 6 V, 8 Ω, 1 kHz"
  ],
  [
   "Input resistance",
   "50 kΩ typ"
  ],
  [
   "Operating temperature",
   "-25 °C to +85 °C"
  ]
 ],
