{
 "sheet": 1,
 "name": "RE46C318S8F",
 "kind": "audio",
 "manufacturer": "Microchip",
 "title": "RE46C317/18: CMOS piezoelectric horn driver with 10 V boost converter",
 "source": {
  "document": "DS20002301B",
  "revision": "Revision B, May 2013",
  "pages": 22
 },
 "summary": "A CMOS driver for a piezoelectric horn that runs from a 3 V battery (2 V to 5 V) and raises its own 10 V drive rail with an on-chip boost converter and an external inductor and Schottky diode. Two push-pull outputs drive the brass and silver electrodes of a three-terminal horn, and a feedback input takes the horn's third electrode. The RE46C317's enable input has three states (standby, boost only, horn on); the RE46C318's has two (standby, horn on). Uses named for it are smoke and CO detectors, personal security products and electronic toys; it is pin compatible with the RE46C117 with lower standby current.",
 "key_figures": [
