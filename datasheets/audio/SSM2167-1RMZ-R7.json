{
 "sheet": 1,
 "name": "SSM2167-1RMZ-R7",
 "kind": "audio",
 "manufacturer": "Analog Devices",
 "title": "Microphone preamplifier for low supply voltages, with adjustable compression and noise gate",
 "source": {
  "revision": "Rev. G (9/11)",
  "pages": 12
 },
 "summary": "The SSM2167 conditions a microphone signal on one chip: an input buffer, a voltage-controlled amplifier steered by a true-rms level detector, and control logic that together give an adjustable compression ratio (1:1 to 10:1, one resistor), an adjustable downward-expansion noise gate (one resistor), and a fixed limiting point at 63 mV rms input. It runs from a single 2.5 V to 5.5 V supply, draws about 2.3 mA, and has an active-low shutdown that drops the supply current to a few microamps. It comes in a 10-lead MSOP rated from -40 °C to +85 °C.",
 "key_figures": [
