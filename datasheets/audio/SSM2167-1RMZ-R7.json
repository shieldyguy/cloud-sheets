     "type": "analog in",
     "function": "Input of the voltage-controlled amplifier, about 1 kΩ. Fed from BUFOUT through a series capacitor (C2, 4.7 µF to 10 µF)."
    },
    {
     "pin": "3",
     "name": "SHUTDOWN",
     "type": "digital in",
     "function": "Active-low CMOS shutdown input. At 0 V the part draws a few microamps and its input and output go high impedance."
    },
    {
     "pin": "4",
     "name": "BUFOUT",
     "type": "analog out",
     "function": "Output of the unity-gain input buffer; also drives the internal rms detector."
    },
    {
     "pin": "5",
     "name": "INPUT",
     "type": "analog in",
     "function": "Audio input to the buffer, about 100 kΩ, sitting near 400 mV dc; a ground-referenced source connects through a capacitor."
    },
    {
     "pin": "6",
     "name": "AVG CAP",
     "type": "analog",
     "function": "Averaging capacitor CAVG for the rms level detector, to ground. Its value sets the detector time constant and the release rate."
    },
    {
     "pin": "7",
     "name": "GATE THRS",
     "type": "analog",
     "function": "Noise gate (downward expansion) threshold: resistor RGATE from this pin to VDD, 0 Ω to 5 kΩ."
    },
    {
     "pin": "8",
     "name": "COMPRESSION RATIO",
     "type": "analog",
     "function": "Compression ratio: resistor RCOMP from this pin to VDD. Shorted to VDD gives 1:1; 175 kΩ gives 10:1."
    },
    {
     "pin": "9",
     "name": "OUTPUT",
     "type": "analog out",
     "function": "Audio output, about 145 Ω, near 1.4 V dc; a grounded load connects through a capacitor. Load at least 5 kΩ."
    },
    {
     "pin": "10",
     "name": "VDD",
     "type": "power in",
     "function": "Positive supply, 2.5 V to 5.5 V."
    }
   ]
  }
