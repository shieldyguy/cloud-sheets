{
 "sheet": 1,
 "name": "TDA7297",
 "kind": "audio",
 "manufacturer": "STMicroelectronics",
 "title": "15 W + 15 W dual bridge audio amplifier in Multiwatt15",
 "source": {
  "revision": "September 2003",
  "pages": 9
 },
 "summary": "A two-channel audio power amplifier with each channel wired as a bridge (BTL), giving 15 W per channel into 8 Ω at 16.5 V and 10 % THD. It runs from 6.5 V to 18 V, has its gain set inside at 32 dB, and needs no supply-ripple capacitor, bootstrap capacitors or output RC networks. Separate stand-by and mute pins allow click-free power sequencing; the outputs are short-circuit protected and the chip shuts down on overtemperature. Intended for television sets and portable radios.",
