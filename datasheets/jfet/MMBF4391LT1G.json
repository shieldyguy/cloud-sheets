 "circuits": [
  {
   "id": "switching-test",
   "title": "Switching time test circuit",
   "page": 4,
   "description": "The circuit the switching-time curves were measured in. A 50 Ω pulse generator drives a 50 Ω-terminated input; RK couples the pulse to the gate, which RGG and the supply VGG hold negative so the channel starts off. The drain is loaded by RD from VDD, set so the off-state drain-source voltage is 10 V, and the output is taken through RT across a 50 Ω load. The curves use two drive cases: RK = RD', standing in for a stage driven by the load resistance of the one before it, and RK = 0, driven straight from the generator.",
   "parts": [
    {
     "ref": "Q1",
     "type": "other",
     "value": "MMBF4391L / MMBF4392L / MMBF4393L",
     "note": "N-channel JFET"
    },
    {
     "ref": "VGEN",
     "type": "source",
     "value": "pulse",
     "note": "tr ≤ 0.25 ns, tf ≤ 0.5 ns, pulse width 2.0 µs, duty cycle ≤ 2.0%"
    },
