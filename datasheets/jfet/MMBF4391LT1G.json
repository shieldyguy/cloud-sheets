 "equations": [
  {
   "name": "Effective load resistance",
   "expr": "RD' = RD × (RT + 50) / (RD + RT + 50)",
   "where": {
    "RD'": "effective drain load resistance, Ω",
    "RD": "drain load resistor, Ω",
    "RT": "series resistor to the 50 Ω output load, Ω"
   },
   "note": "RD in parallel with RT plus the 50 Ω load.",
   "page": 4
  }
 ],
 "operation": [
  {
   "topic": "Switching",
   "page": 4,
   "text": "Ahead of the pulse the gate sits at −VGG, and Cgd holds VGG + VDS. Switching on, Cgs empties through RGEN and RK in series; Cgd falls to VDS(on) through RG and RK, followed by RD' in parallel with the channel resistance rDS. Switching off runs these charge paths the other way. The turn-on time is non-linear and hard to predict, since rDS drops as VGS approaches zero while Cgs discharges, and Cgd discharges through that changing rDS; at turn-off rDS climbs while Cgd charges."
  },
  {
   "topic": "IDSS sets the other characteristics",
   "page": 5,
   "text": "IDSS is the parameter that most of the other JFET characteristics depend on. Most devices fall within ±10% of the rDS(on) and VGS(off) curves plotted against IDSS, which gives the spread to expect within one part number. Across the MMBF4392 range of 25 to 75 mA, the curves give rDS(on) of 52 Ω and 30 Ω and VGS of 2.2 V and 4.8 V."
  }
 ],
