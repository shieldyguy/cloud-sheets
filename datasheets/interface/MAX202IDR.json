{
 "sheet": 1,
 "name": "MAX202IDR",
 "kind": "interface",
 "manufacturer": "Texas Instruments",
 "title": "MAX202: 5 V dual RS-232 driver and receiver with ±15 kV ESD protection",
 "source": {
  "document": "SLLS576G",
  "revision": "July 2003, revised February 2024",
  "pages": 27
 },
 "summary": "A two-driver, two-receiver RS-232 transceiver that runs from one 5 V supply. An on-chip charge pump with four external 0.1 µF capacitors doubles and inverts the supply to make the line levels. The part sits between an asynchronous communication controller and a serial-port connector. The line pins (7, 8, 13 and 14) carry ±15 kV human-body-model ESD protection, and the drivers are rated to 120 kbit/s with slew limited to 30 V/µs. It meets TIA/EIA-232-F and ITU v.28. MAX202IDR is the -40 °C to 85 °C part in the 16-pin SOIC (D) on a 2500-piece reel.",
 "key_figures": [
