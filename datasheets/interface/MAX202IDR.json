   "Supply voltage",
   "4.5 V to 5.5 V (5 V nominal)"
  ],
  [
   "Channels",
   "2 drivers, 2 receivers"
  ],
  [
   "Data rate",
   "120 kbit/s min, CL = 50 pF to 1000 pF, RL = 3 kΩ to 7 kΩ"
  ],
  [
   "Supply current",
   "8 mA typ, 15 mA max, no load, VCC = 5 V"
  ],
  [
   "Driver output swing",
   "±5 V min, ±9 V typ into 3 kΩ"
  ],
  [
   "Driver slew rate",
