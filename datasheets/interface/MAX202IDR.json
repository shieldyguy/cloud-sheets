 "equations": [
  {
   "name": "Driver slew rate",
   "expr": "SR(tf) = 6 V / tPHL(D) or tPLH(D)",
   "where": {
    "6 V": "the swing between the -3 V and 3 V crossings of the driver output",
    "tPHL(D), tPLH(D)": "time the output takes to pass from one of those crossings to the other, falling or rising"
   },
   "note": "Timing taken in the driver test circuit.",
   "page": 7
  },
  {
   "name": "Pulse skew",
   "expr": "tsk(p) = |tPLH – tPHL|",
   "where": {
    "tPLH": "low-to-high propagation delay of a channel",
    "tPHL": "high-to-low propagation delay of the same channel"
   },
   "note": "",
   "page": 5
  },
  {
   "name": "Receiver hysteresis",
   "expr": "Vhys = VIT+ – VIT–",
   "where": {
    "VIT+": "rising-input threshold",
    "VIT–": "falling-input threshold"
   },
   "note": "",
   "page": 5
  }
