     "type": "ic",
     "value": "differential receiver",
     "external": true
    },
    {
     "ref": "T1",
     "type": "other",
     "value": "Zo = 50 Ω",
     "note": "50 Ω transmission line"
    },
    {
     "ref": "T2",
     "type": "other",
     "value": "Zo = 50 Ω",
     "note": "50 Ω transmission line"
    },
    {
     "ref": "R1",
     "type": "resistor",
     "value": "50 Ω"
