{
 "sheet": 1,
 "name": "MC100EPT22DR2G",
 "kind": "interface",
 "manufacturer": "onsemi",
 "title": "Dual-channel 3.3 V translator from LVTTL/LVCMOS inputs to LVPECL differential outputs",
 "source": {
  "revision": "Rev. 15, June 2024",
  "pages": 11
 },
 "summary": "The MC100EPT22 takes two single-ended LVTTL or LVCMOS logic inputs and gives each one a differential LVPECL output pair. It runs from a single 3.0 V to 3.6 V supply and ground, with no negative rail. Propagation delay is 420 ps typical and the toggle rate reaches about 1.1 GHz typical (0.8 GHz minimum). The inputs are PNP stages that load the driving logic lightly, and a Q output sits HIGH when its input is left open. It is a 100-series ECL part, so its output levels are temperature compensated.",
 "key_figures": [
  [
   "Channels",
   "2 (LVTTL/LVCMOS in, LVPECL differential out)"
  ],
