{
 "sheet": 1,
 "name": "TCA9546APWR",
 "kind": "interface",
 "manufacturer": "Texas Instruments",
 "title": "4-channel I2C/SMBus switch, 1.65 V to 5.5 V, with reset input",
 "source": {
  "revision": "SCPS205B, revised November 2019",
  "pages": 31
 },
 "summary": "The TCA9546A connects one upstream I2C or SMBus pair to any combination of four downstream pairs through bidirectional pass switches, chosen by writing one control register over the bus. It runs from 1.65 V to 5.5 V; with VCC clamping the pass-gate voltage and separate pull-ups on each segment, buses at 1.8 V, 2.5 V, 3.3 V and 5 V can talk to each other. An active-low RESET input and an internal power-on reset turn all channels off, and three address pins allow eight devices on one bus.",
 "key_figures": [
  [
   "Supply",
   "1.65 V to 5.5 V"
  ],
  [
   "Channels",
   "4, any combination"
  ],
  [
   "Clock",
   "0 to 400 kHz"
  ],
  [
   "On-resistance",
   "10 Ω typ at VCC 4.5 V to 5.5 V"
  ],
  [
   "Standby current",
   "1.6 µA typ at 5.5 V"
  ],
  [
   "Addresses",
   "0x70 to 0x77"
  ],
  [
   "I/O tolerance",
   "5.5 V"
  ],
  [
   "ESD",
   "±4000 V HBM, ±1500 V CDM"
  ],
  [
   "Latch-up",
   "exceeds 100 mA per JESD 78"
  ],
  [
   "Operating temperature",
   "–40 °C to 85 °C"
  ]
 ],
