{
 "sheet": 1,
 "name": "ST485ECDR",
 "kind": "interface",
 "manufacturer": "STMicroelectronics",
 "title": "Low-power RS-485/RS-422 transceiver with ±15 kV ESD protection",
 "source": {
  "revision": "Rev 14, February 2009",
  "pages": 18
 },
 "summary": "The ST485E is a 5 V half-duplex transceiver for RS-485 and RS-422 links, with one line driver and one line receiver sharing the A/B bus pair. The bus pins withstand ±15 kV human-body-model and ±8 kV IEC-1000-4-2 contact discharge without latching up. With the driver disabled it draws 300 µA typical, whether the bus is idle or loaded. Receiver input resistance is 96 kΩ minimum, and up to 256 transceivers can share one bus. Order codes ST485EC, ST485EB and ST485EX cover 0 to 70 °C, -40 to 85 °C and -55 to 125 °C, all in SO-8.",
 "key_figures": [
  [
