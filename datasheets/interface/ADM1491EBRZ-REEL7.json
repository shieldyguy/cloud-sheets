 "operation": [
  {
   "topic": "Function",
   "page": 10,
   "text": "Each device holds one differential line driver and one differential line receiver for full-duplex RS-485 or RS-422 links (TIA/EIA-485-A and TIA/EIA-422-B). It runs from one 5 V ± 5 % supply."
  },
  {
   "topic": "Bus loading",
   "page": 10,
   "text": "The receiver input is 12 kΩ, one unit load, so up to 32 transceivers can sit on one bus."
  },
  {
   "topic": "Fail-safe receiver",
   "page": 10,
   "text": "With the A and B inputs left floating, RO goes high."
  },
  {
   "topic": "Short-circuit and thermal protection",
   "page": 1,
   "text": "Driver output current is limited to ±250 mA in a fault. If the die passes 150°C the thermal shutdown puts the driver outputs in high impedance, protecting against bus contention and shorted outputs."
  },
  {
   "topic": "Enables",
   "page": 6,
   "text": "The ADM1491E has DE (high turns the driver on) and RE (low turns the receiver output on). The ADM1490E has neither pin; its driver and receiver are always enabled."
  },
  {
   "topic": "Skew",
   "page": 10,
   "text": "Driver propagation delays are short and closely matched between the two outputs; skew between the complementary outputs degrades noise immunity and raises EMI."
  },
  {
   "topic": "ESD protection",
   "page": 10,
   "text": "Clamps on the bus pins A, B, Y and Z take ±8 kV human body model discharges; the other pins take ±4 kV. ESD tests on the I/O pins are run with the device powered, since a discharge can trigger latch-up."
  },
  {
   "topic": "RS-422 and RS-485",
   "page": 12,
   "text": "RS-422 allows up to 10 MBaud, 4000 ft of line and one driver with up to 10 receivers. RS-485 allows up to 32 drivers and 32 receivers on one bus with a common-mode range of −7 V to +12 V; its drivers can be disabled so several share a line, with one enabled at a time."
  },
  {
   "topic": "Cable and termination",
   "page": 12,
   "text": "RS-485 runs on twisted pair. Reflections are held down by terminating each end of the line in a resistor equal to its characteristic impedance (at the receiving end) and by short stubs off the main line. A line terminated this way looks purely resistive to the driver."
  }
 ],
