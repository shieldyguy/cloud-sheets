{
 "sheet": 1,
 "name": "TPS2514AQDBVRQ1",
 "kind": "interface",
 "manufacturer": "Texas Instruments",
 "title": "Automotive USB dedicated charging port controller, single (TPS2514A-Q1) and dual (TPS2513A-Q1)",
 "source": {
  "revision": "SLVSCC8A, May 2014, revised December 2014",
  "pages": 23
 },
 "summary": "The TPS2514A-Q1 (one port) and TPS2513A-Q1 (two ports) sit on the D+ and D- lines of a USB charging port and present whichever dedicated-charger signature the attached phone or tablet recognises: 2.7 V on both lines (Divider 3), the two lines shorted per BC1.2 and YD/T 1591-2009, or 1.2 V on both lines. The choice is made automatically by watching the data-line voltages. They do not supply VBUS power; a USB power switch can be added where the port needs overcurrent protection. AEC-Q100 qualified, 4.5 V to 5.5 V supply, SOT-23 six-pin package.",
 "key_figures": [
  [
   "Supply range",
   "4.5 V to 5.5 V"
  ],
  [
   "Supply current",
   "155 µA typ, 220 µA max"
  ],
  [
   "Divider 3 output",
   "2.7 V typ (2.57 to 2.84 V) on D+ and D-"
  ],
  [
   "1.2 V mode output",
   "1.2 V typ (1.12 to 1.28 V)"
  ],
  [
   "Short mode D+ to D- resistance",
   "157 Ω typ, 200 Ω max"
  ],
  [
   "UVLO rising",
   "4.1 V typ"
  ],
  [
   "Junction temperature",
   "–40 °C to 125 °C"
  ],
  [
   "ESD",
   "±2000 V HBM, ±750 V CDM"
  ],
  [
   "Package",
   "SOT-23 (DBV), 6 pins, 2.90 mm × 1.60 mm"
  ]
 ],
