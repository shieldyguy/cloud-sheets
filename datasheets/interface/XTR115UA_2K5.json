{
 "sheet": 1,
 "name": "XTR115UA_2K5",
 "kind": "interface",
 "manufacturer": "Texas Instruments",
 "title": "4-20 mA two-wire current-loop transmitters with 5 V regulator and voltage reference",
 "source": {
  "revision": "SBOS124C, revised January 2026",
  "pages": 25
 },
 "summary": "XTR115 and XTR116 turn a small input current into a loop current 100 times larger, for two-wire 4-20 mA transmitters. The chip runs from the loop itself (7.5 V to 36 V), draws about 200 µA, and offers a 5 V regulator and a precision reference (2.5 V on the XTR115, 4.096 V on the XTR116) to power and excite the sensor; all sensor-side current comes back through IRET so it is counted in the loop. An external NPN transistor carries most of the output current. SOIC-8, specified from -40 °C to +85 °C.",
 "key_figures": [
  [
   "Current gain",
   "100 A/A (IO = 100 × IIN)"
  ],
  [
   "Loop supply",
   "7.5 V to 36 V (40 V absolute maximum)"
  ],
  [
   "Quiescent current",
   "200 µA typ (CSO: SHE), 165 µA typ (CSO: TID)"
  ],
  [
   "Reference",
   "2.5 V (XTR115), 4.096 V (XTR116)"
  ],
