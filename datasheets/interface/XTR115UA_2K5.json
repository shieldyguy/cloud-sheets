 "circuits": [
  {
   "id": "typical",
   "title": "Typical application",
   "page": 1,
   "description": "A voltage VIN across RIN sets the input current into IIN, and the loop current is 100 × VIN / RIN. The source's low side returns to IRET. The external NPN takes most of the loop current between V+ and E; the loop supply VLOOP and the receiver's load RL sit in series between V+ and IO over a two-wire run. VREG (5 V) and VREF (2.5 V on XTR115, 4.096 V on XTR116) are left free for outside use.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "XTR115/XTR116"
    },
    {
     "ref": "RIN",
     "type": "resistor",
     "value": "RIN"
    },
    {
     "ref": "J_VINP",
     "type": "terminal",
