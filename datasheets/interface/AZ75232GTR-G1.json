{
 "sheet": 1,
 "name": "AZ75232GTR-G1",
 "kind": "interface",
 "manufacturer": "BCD Semiconductor Manufacturing Limited",
 "title": "AZ75232: three RS-232 drivers and five RS-232 receivers, 120 kbit/s, SOIC-20, SSOP-20, TSSOP-20",
 "source": {
  "revision": "Rev. 1.7, Oct. 2009",
  "pages": 13
 },
 "summary": "A line interface for EIA/TIA-232-F and ITU V.28 serial ports with three line drivers and five line receivers in one 20-pin package. The drivers take TTL/CMOS logic levels and produce bipolar RS-232 levels from separate positive (VDD, 7.5 V to 15 V) and negative (VSS, -7.5 V to -15 V) supplies; the receivers turn RS-232 levels into 5 V TTL/CMOS outputs powered from VCC (4.5 V to 5.5 V). Data rates up to 120 kbit/s are supported. The pinout is flow-through: logic-side pins on one side of the package, line-side pins on the other, for a board layout without crossovers.",
 "key_figures": [
  [
   "Channels",
   "3 drivers, 5 receivers"
  ],
  [
   "Data rate",
   "up to 120 kbit/s"
  ],
  [
   "Driver supplies",
   "VDD 7.5 V to 15 V, VSS -15 V to -7.5 V"
  ],
  [
   "Receiver supply",
   "VCC 4.5 V to 5.5 V"
  ],
  [
   "Driver output swing",
   "±7.5 V typ, ±6 V min into 3 kΩ (VDD = 9 V, VSS = -9 V)"
  ],
  [
   "Driver short-circuit current",
   "±12 mA typ, ±19.5 mA max"
  ],
  [
   "Receiver input range",
   "-30 V to 30 V (absolute maximum)"
  ],
  [
   "Receiver thresholds",
   "VIT+ 1.9 V typ, VIT- 0.97 V typ, hysteresis 0.5 V min"
  ],
  [
   "Supply current",
   "IDD 15 mA max, ICC 30 mA max (VDD = 9 V, VSS = -9 V)"
  ],
  [
   "Operating temperature",
   "-40 °C to 85 °C"
  ]
 ],
