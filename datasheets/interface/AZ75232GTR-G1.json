 "circuits": [
  {
   "id": "typical",
   "title": "Typical application: UART to DB9 serial port",
   "page": 9,
   "description": "The AZ75232 sits between a UART or microcontroller on the logic side and a DB9S socket on the line side, carrying all eight data and handshake lines of a 9-pin port. The three drivers send DTR, TX and RTS out to the socket; the five receivers bring RI, CTS, RX, DSR and DCD back in. VCC takes 5 V for the receivers, VDD 12 V and VSS -12 V for the drivers. A capacitor runs from each driver output to ground, and the socket's signal ground (pin 5) joins the chip's ground.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "AZ75232"
    },
    {
     "ref": "C1",
     "type": "capacitor",
     "value": "unspecified",
     "note": "from the RTS driver output (DY1) to ground"
    },
    {
     "ref": "C2",
     "type": "capacitor",
     "value": "unspecified",
     "note": "from the TX driver output (DY2) to ground"
    },
    {
     "ref": "C3",
     "type": "capacitor",
     "value": "unspecified",
     "note": "from the DTR driver output (DY3) to ground"
    },
    {
     "ref": "J1",
     "type": "connector",
     "value": "DB9S",
     "note": "EIA/TIA-232-F socket; signal ground on pin 5, DCD on pin 1, DSR on pin 6, RI on pin 9"
    },
    {
     "ref": "TP5V",
     "type": "terminal",
     "value": "5V"
    },
