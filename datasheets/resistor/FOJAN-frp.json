 "operation": [
  {
   "topic": "Construction",
   "page": 3,
   "text": "A ruthenium oxide resistive film sits on an alumina substrate between silver top electrodes, under an inner glass coat and an outer epoxy coat that also carries the marking. Each end has a NiCr side electrode, a silver back electrode and nickel plating."
  },
  {
   "topic": "Derating",
   "page": 5,
   "text": "The parts run from -55 °C to +155 °C. Full rated power applies up to 70 °C ambient; above that the allowed load falls in a straight line to zero at 155 °C."
  },
  {
   "topic": "Compliance",
   "page": 2,
   "text": "RoHS compliant and halogen free."
  },
  {
   "topic": "Tape peel force",
   "page": 11,
   "text": "The cover tape is peeled at 200 mm/min at 165 to 180 degrees to the unreeling direction. Peel force is 0.1 N to 0.7 N (10 g to 70 g) on paper tape and 0.3 N to 1 N (30 g to 100 g) on embossed plastic tape."
  },
  {
   "topic": "Environments that degrade the part",
   "page": 12,
   "text": "Performance can suffer at high temperature; near sea air or corrosive gases such as Cl2, H2S, NH3, SO2 and NO2; in contact with water, oil, chemicals or organic solvents not verified for use; under an unverified resin or paint coating; and with an unclean flux, or washing in water or a water-soluble cleaner, after soldering."
  },
  {
   "topic": "Handling",
   "page": 12,
   "text": "Boxes are kept the right way up in storage and transport and must not be dropped; a fall can damage the electrodes or the body."
  }
 ],
