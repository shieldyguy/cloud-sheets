   "1 Ω to 10 MΩ"
  ],
  [
   "TCR",
   "±400 ppm/°C (1 Ω to <10 Ω), ±100 ppm/°C (10 Ω to <10 MΩ)"
  ],
  [
   "Jumper",
   "<30 mΩ (±1%) or <50 mΩ (±5%); rated 1 A or 2 A, maximum 3 A to 12 A"
  ],
  [
   "Operating temperature",
   "-55 °C to +155 °C, full power to 70 °C"
  ]
 ],
