 "operation": [
  {
   "topic": "Construction",
   "page": 4,
   "text": "A ceramic substrate carries an inner metal electrode at each end with a resistive paste between them. The paste mix sets the value roughly and laser trimming of the resistive layer brings it into tolerance. A protective coat covers the resistive layer and carries the marking, and the end terminations are nickel under matte tin. The resistive element is thick film; the terminations are lead free."
  },
  {
   "topic": "Operating temperature",
   "page": 6,
   "text": "Normal-power parts operate from –55 °C to +155 °C; double-power parts (RL0805 1/4 W, RL1206 1/2 W) from –55 °C to +125 °C."
  },
  {
   "topic": "Power rating and derating",
   "page": 6,
   "text": "Ratings at 70 °C ambient: RL0402 1/16 W, RL0603 1/10 W, RL0805 1/8 W or 1/4 W, RL1206 1/4 W or 1/2 W, RL1210 1/2 W, RL1218 1 W, RL2010 3/4 W, RL2512 1 W. Full rated power holds up to 70 °C and falls linearly to zero at 155 °C for normal power and at 125 °C for double power."
  },
  {
   "topic": "Materials and moisture",
   "page": 2,
   "text": "Halogen-free epoxy; RoHS compliant; free of forbidden materials. Moisture sensitivity level MSL 1."
  }
 ],
