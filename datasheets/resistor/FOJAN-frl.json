{
 "sheet": 1,
 "name": "FOJAN-frl",
 "kind": "resistor",
 "manufacturer": "FOJAN",
 "title": "FRL series low-ohmic thick film chip resistors, 0402 to 2512",
 "source": {
  "document": "FJ-JS-3001",
  "revision": "V2.0, 2025.01.01",
  "pages": 13
 },
 "summary": "Low-resistance thick film chip resistors, built as a ruthenium oxide film on an alumina substrate with nickel-plated ends. Nine sizes run from 0402 to 2512 with values from 50 mΩ to 0.91 Ω (100 mΩ minimum in 0402) at ±1% or ±5%. Rated power at 70 °C goes from 1/16 W to 1 W, and the TCR is ±400 to ±1200 ppm/°C depending on value. Listed uses include switching supplies, overcurrent protection in audio gear, voltage regulator modules, DC-DC converters, chargers, LED lamps and portable equipment; the parts are RoHS compliant and halogen free.",
 "key_figures": [
  [
   "Resistance range",
   "0.05Ω to <0.91Ω (0402: 0.1Ω to <0.91Ω)"
  ],
  [
   "Tolerance",
   "±1% (F), ±5% (J)"
  ],
  [
   "Rated power at 70 °C",
   "1/16W (0402) to 1W (2512)"
  ],
  [
   "Max working current",
   "0.79A (0402) to 7.07A (2512)"
  ],
  [
   "TCR",
   "±1200 ppm/°C below 0.1Ω, ±800 to 0.5Ω, ±400 to 0.91Ω"
  ],
  [
