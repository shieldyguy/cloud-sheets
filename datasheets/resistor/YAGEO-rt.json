 "operation": [
  {
   "topic": "Construction",
   "page": 4,
   "text": "A thin resistive film on a high-grade ceramic substrate joins internal metal electrodes at the two ends. The film is first laid down near the wanted value, then laser cut to bring it into tolerance. A protective coat covers it and carries the marking layer, and the outer end terminations are nickel finished in matte tin."
  },
  {
   "topic": "Power rating and derating",
   "page": 6,
   "text": "Each type holds its rated power up to 70 °C ambient. Above that it falls in a straight line to zero at 155 °C for RT0402 to RT1206, and at 125 °C for RT0100, RT0201 and RT1210 to RT2512. Ratings at 70 °C: RT0100 1/32W, RT0201 1/20W, RT0402 1/16W, RT0603 1/10W, RT0805 1/8W, RT1206 1/4W, RT1210 1/4W, RT2010 1/2W, RT2512 3/4W, or 1W in the high-power grade (reel code 7W)."
  },
  {
   "topic": "Operating temperature",
   "page": 5,
   "text": "RT0402, RT0603, RT0805 and RT1206 run from –55 °C to +155 °C; RT0100, RT0201, RT1210, RT2010 and RT2512 from –55 °C to +125 °C."
  },
  {
   "topic": "Materials and moisture",
   "page": 2,
   "text": "Lead-free terminations, RoHS compliant and halogen free, with a halogen-free epoxy and no forbidden materials in product or production. Moisture sensitivity level 1."
  },
  {
   "topic": "Reel label",
   "page": 2,
   "text": "The internal 2D reel label carries \"LFP\", for lead-free process; a customised label may carry \"LFP\" or another symbol."
  }
 ],
