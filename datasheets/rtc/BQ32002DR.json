 "equations": [
  {
   "name": "Calibration step",
   "expr": "adjustment = +N / 491520 per minute (S = 0); -N / 245760 per minute (S = 1)",
   "where": {
    "N": "decimal value of the CAL field, 0 to 31",
    "S": "calibration sign bit in CAL_CFG1"
   },
   "note": "N = 31 gives +63 ppm with S = 0 and -126 ppm with S = 1.",
   "page": 16
  },
  {
   "name": "Switchover to backup",
   "expr": "on VBACK when VCC < min(VBACK, VREF)",
   "where": {
    "VREF": "internal bandgap-derived reference, about 1.8 V",
    "VCC": "main supply",
    "VBACK": "backup supply"
   },
   "note": "The device returns to VCC when VCC rises above VBACK or VREF.",
   "page": 9
  }
 ],
 "operation": [
  {
   "topic": "Backup switchover",
   "page": 9,
   "text": "An internal comparator moves the device from VCC to VBACK when VCC falls below the lower of VBACK and VREF (about 1.8 V, derived from the internal bandgap), and back to VCC when VCC climbs above VBACK or VREF. VCC falls at -5 V/ms at most during the switchover. Some register bits are reset when the device goes onto backup; the register tables list their values in the Cycle row, UC meaning unchanged."
  },
  {
   "topic": "Running on backup",
   "page": 10,
   "text": "On backup the timekeeping registers (0 to 9) cannot be reached over I2C; access returns only once VCC is above VREF. The timekeeping registers keep full operation and accuracy on backup. IRQ is unused on backup, and its pull-up goes to VCC so that IRQ does not operate then."
  },
  {
   "topic": "Reading after backup",
   "page": 12,
   "text": "After the return to VCC the time registers can need up to 1 s to catch up, and a read started before then returns the time at which backup began. To read the right time, wait more than 1 s after VCC is above 2.8 V and above VBACK. Once out of backup the device needs 60 µs or more before the host may send a START."
  },
  {
   "topic": "First power-up and backup current",
   "page": 20,
   "text": "The low backup current holds only if VCC is brought up after every total loss of power: apply 3 V to 3.6 V to VCC for at least 1 ms straight after the backup source is connected. If the backup source is connected without VCC, VBACK leaks far more current than specified."
  },
  {
   "topic": "I2C interface",
   "page": 10,
   "text": "The device is an I2C slave only, with external pull-ups on SDA and SCL. Its address byte is 11010000b for a write and 11010001b for a read (7-bit address 1101000); it ignores the general call. A write sends the address, a register sub-address, then data bytes, each acknowledged; successive bytes go to successive registers. A read first writes the sub-address, then a repeated START with the read address returns data from that register onward, the host ending with a NACK and STOP. Data is taken only from complete, acknowledged bytes."
  },
  {
   "topic": "Register update",
   "page": 1,
   "text": "The time registers update once a second, all together, so a read never sees a half-updated time. Leap years are handled automatically."
  },
  {
   "topic": "Leap years",
   "page": 20,
   "text": "Every year divisible by 4 is taken as a leap year, which is right until 2100; the host must correct any other year."
  },
  {
   "topic": "IRQ output",
   "page": 7,
   "text": "IRQ works as a plain logic output (FT = 0, level from OUT) or as a test-frequency output (FT = 1, 512 Hz or, with FTF = 1, 1 Hz). On the very first power-up OUT is 1 and FT and FTF are 0; on later power-ups with the backup present OUT keeps its value and FT and FTF are cleared. The calibration works by stretching or shortening the 1-Hz clock now and then, so on the 1-Hz output its effect only shows once per 8 or 16 minutes, the interval set by the sign. The 512-Hz signal leaves the calibration out."
  },
  {
   "topic": "Oscillator stop and fail",
   "page": 13,
   "text": "The STOP bit halts the oscillator. The OF flag is set at first power-up and whenever four or more oscillator pulses in a row are missed; the host clears it over I2C."
  },
  {
   "topic": "Accuracy",
   "page": 5,
   "text": "Before calibration the clock is typically within ±35 ppm at 3.3 V and 25 °C, measured with TI's reference board and a KDS DMX-26S crystal."
  },
  {
   "topic": "Supply decoupling",
   "page": 21,
   "text": "VCC takes a low-ESR ceramic capacitor of at least 1 µF, whose voltage rating covers the highest supply voltage, placed as close to VCC and GND as possible, with a wide trace or a ground plane to GND."
  },
  {
   "topic": "Crystal placement",
   "page": 21,
   "text": "Placing the 32.768-kHz crystal right next to OSCI and OSCO keeps stray capacitance low."
  },
  {
   "topic": "Backup source",
   "page": 7,
   "text": "VBACK takes either a supercapacitor or a non-rechargeable battery, not both. The application circuits use a 0.22 F supercapacitor or a BR1225 cell."
  },
  {
   "topic": "Pull-ups",
   "page": 1,
   "text": "All pull-up resistors go to VCC so that none is powered during backup operation."
  }
 ],
