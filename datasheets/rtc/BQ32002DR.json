{
 "sheet": 1,
 "name": "BQ32002DR",
 "kind": "rtc",
 "manufacturer": "Texas Instruments",
 "title": "BQ32002 I2C real-time clock with automatic backup-supply switchover",
 "source": {
  "document": "SLUSA96B",
  "revision": "SLUSA96B, August 2010, revised April 2016",
  "pages": 30
 },
 "summary": "A real-time clock in an 8-pin SOIC that keeps seconds, minutes, hours (24-hour), day of week, date, month, year and a century bit in BCD registers, read and set over an I2C bus at up to 400 kHz. It runs from a 3 V to 3.6 V supply and moves itself onto a backup source on VBACK (a supercapacitor or a non-rechargeable cell) when VCC falls, drawing about 0.9 µA there. An external 32.768-kHz crystal sets the time base; a calibration register trims it from -126 ppm to +63 ppm, an oscillator-fail flag records lost oscillation, and the open-drain IRQ pin gives a logic level or a 1 Hz or 512 Hz test signal.",
 "key_figures": [
  [
   "Supply",
   "3 V to 3.6 V"
  ],
  [
   "Supply current",
   "65 µA typ, 200 µA max"
  ],
  [
   "Backup current",
   "0.9 µA typ, 1.5 µA max at VBAT = 3 V, 25 °C"
  ],
  [
   "Backup voltage",
   "1.4 V to VCC"
  ],
  [
   "Switchover",
   "1.8 V (to backup), 2.4 V (to VCC) typ"
  ],
  [
   "Interface",
   "I2C, 100 kHz and 400 kHz; address 1101000"
  ],
  [
   "Crystal",
   "32.768 kHz, 12 pF load, 70 kΩ max series resistance"
  ],
  [
   "Calibration",
   "+63 ppm to -126 ppm in 32 steps each way"
  ],
  [
   "Temperature",
   "-40 °C to +85 °C ambient"
  ],
  [
   "Package",
   "SOIC-8 (D), 4.90 mm × 3.91 mm body"
  ]
 ],
