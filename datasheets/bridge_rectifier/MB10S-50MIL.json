 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Internal connection",
   "page": 1,
   "text": "Four diodes make a full-wave bridge. Each AC pin (3, 4) has one diode up to + (pin 1) and one diode down from - (pin 2), so pin 1 sits positive of pin 2 whichever way the AC input swings."
  },
  {
   "topic": "Ratings basis",
   "page": 1,
   "text": "The ratings apply at 25 °C ambient for single-phase half-wave 60 Hz operation into a resistive or inductive load; a capacitive load takes 20 % off the current rating. Forward voltage, capacitance and thermal resistance are given per leg."
  },
  {
   "topic": "Current derating",
   "page": 2,
   "text": "The full 1.0 A average output holds up to about 115 °C case temperature; beyond it the allowed current falls in a straight line to zero at 150 °C."
  },
  {
   "topic": "Surge",
   "page": 2,
   "text": "The 35 A figure is for a single 8.3 ms half sine. When the surge repeats over many cycles the allowed peak drops, to about 19 A at 10 cycles and about 10 A at 100."
  },
  {
   "topic": "Reverse leakage",
   "page": 2,
   "text": "Below rated reverse voltage the leakage rises only slowly: about 0.4 to 0.7 µA at 25 °C and about 14 to 45 µA at 125 °C. A little above 100 % of rated voltage it climbs steeply."
  },
  {
   "topic": "Construction",
   "page": 1,
   "text": "Glass-passivated junctions in a small molded package for printed circuit boards, marked RoHS compliant, with a high surge capability."
  }
 ],
