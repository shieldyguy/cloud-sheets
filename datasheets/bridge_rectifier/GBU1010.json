 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Internal arrangement",
   "page": 1,
   "text": "Four diodes form a full bridge. Each AC lead (pins 2 and 3) meets the anode of one diode and the cathode of another; the two cathodes that do not meet an AC lead join at + (pin 4), and the two anodes that do not meet an AC lead join at - (pin 1). The leads run - ~ ~ + across the case, in that order, and the legend on the face marks each one."
  },
  {
   "topic": "Current derating",
   "page": 2,
   "text": "The full 10 A average holds up to a lead temperature of 100 °C, then falls in a straight line to zero near 150 °C."
  },
  {
   "topic": "Surge",
   "page": 2,
   "text": "The 175 A surge rating is for one 8.3 ms half sine. Over repeated half-sine cycles the allowed peak shrinks, to about 85 A at 10 cycles and about 35 A at 100."
  },
  {
   "topic": "Soldering",
   "page": 1,
   "text": "Lead soldering is guaranteed at 260 °C for 10 seconds with 5 lb (2.3 kg) of tension on the leads. Terminals are solder plated and solderable to MIL-STD-750, Method 2026."
  },
  {
   "topic": "Construction",
   "page": 1,
   "text": "Moulded plastic case with a mounting hole through the body, meant for printed circuit boards, with high case dielectric strength and a high surge capability. A cathode line on the body marks polarity."
  }
 ],
