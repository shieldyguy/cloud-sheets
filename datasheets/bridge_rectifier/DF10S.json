 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "Four glass-passivated diodes form a full-wave bridge. The AC supply goes across the two ~ leads (3 and 4); rectified current leaves at + (pin 1) and returns at - (pin 2). Forward voltage, reverse current and capacitance figures are for one diode."
  },
  {
   "topic": "Current derating",
   "page": 3,
   "text": "Average output current is 1.5 A up to 40 °C ambient and falls in a straight line to zero at 150 °C, a curve set by the junction-to-ambient thermal resistance per leg."
  },
  {
   "topic": "Surge",
   "page": 3,
   "text": "A single 8.3 ms half-sine surge of 50 A is allowed. The permitted peak falls as the surge repeats at 60 Hz: about 20 A over 10 cycles and about 4.4 A over 100 cycles."
  },
  {
   "topic": "Assembly and compliance",
   "page": 1,
   "text": "The part is qualified for IR reflow and wave soldering. It uses a green mold compound to IEC 61249, is lead free to EU RoHS 2002/95, and is UL certified under file E258596."
  }
 ],
