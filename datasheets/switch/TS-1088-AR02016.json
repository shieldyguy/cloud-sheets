 "operation": [
  {
   "topic": "Switching",
   "page": 1,
   "text": "A single normally open contact: terminals 1 and 2 are isolated at rest and joined while the plunger is pressed through its 0.2 mm travel."
  },
  {
   "topic": "Construction",
   "page": 1,
   "text": "Six parts from base to top: a phosphor bronze clip (A), a black LCP body (B), two silver-plated stainless steel domes (C), an orange-yellow polyimide dust seal (D), a stainless steel cover plate (E) and a black LCP button (F)."
  },
  {
   "topic": "Mounting",
   "page": 1,
   "text": "Surface mount. Recommended land pattern: two pads 2.00 mm tall, 3.40 mm apart at their inner edges and 5.50 mm apart at their outer edges."
  }
