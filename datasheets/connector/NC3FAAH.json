 "operation": [
  {
   "topic": "Contacts",
   "page": 1,
   "text": "Each socket is a tulip-type contact held under high contact pressure, specified for long durability. The mating zone and the PCB terminations are selectively gold plated, for conductivity and solderability."
  },
  {
   "topic": "Latch",
   "page": 1,
   "text": "A push latch is fitted at the factory."
  },
  {
   "topic": "Panel and board compatibility",
   "page": 1,
   "text": "Front panel cutout and PCB layout are fully compatible with Neutrik's A series. The part belongs to Neutrik's most cost-effective series."
  },
  {
   "topic": "Housing and approvals",
   "page": 1,
   "text": "The round body is polyamide PA 6.6 with 30 % glass reinforcement, flammability rated UL 94 HB. The part is a UL recognized component."
  }
