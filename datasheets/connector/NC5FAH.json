 "operation": [
  {
   "topic": "Grounding",
   "page": 1,
   "text": "Apart from the five signal poles, a dedicated contact ties the mating plug's shell to the front panel."
  },
  {
   "topic": "Contacts",
   "page": 1,
   "text": "Tulip-form female contacts, polished and hard gold plated at the mating area; the PCB terminations are tin plated."
  },
  {
   "topic": "Housing and latch",
   "page": 1,
   "text": "Round plastic housing rated UL 94 V-0, with a steel latch that locks the inserted plug."
  },
  {
   "topic": "Panel mounting",
   "page": 2,
   "text": "Mounts from the rear of the panel into a shape A chassis cut-out, fixed with A-type screws, and solders to a horizontal PCB. Receptacles may be placed on 23 mm centres."
  }
