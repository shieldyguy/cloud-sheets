 ],
 "operation": [
  {
   "topic": "Pin numbering",
   "page": 1,
   "text": "The two rows are marked 1P and 2P."
  },
  {
   "topic": "Construction",
   "page": 1,
   "text": "Pins are 0.4 mm square on a 1.27 ± 0.1 mm pitch, with 1.27 ± 0.1 mm between the rows. The housing is 1.0 ± 0.15 mm thick and 3.4 ± 0.15 mm across, with notches between neighbouring pins along both long edges. Under the housing each pin turns outward through a right angle into a flat foot; the two rows of feet span W = 5.50 ± 0.25 mm."
  },
  {
   "topic": "Locating posts",
   "page": 1,
   "text": "The P version carries two round posts, Ø0.60 mm, below the housing on its centre line, 1.27 × N - 2.54 mm apart; each reaches 1.2 ± 0.15 mm below the underside of the housing. The version without P has no posts."
  },
  {
   "topic": "Land pattern",
   "page": 1,
   "text": "Pads are 0.74 mm wide on a 1.27 mm pitch, two rows facing each other with a 1.2 mm gap between their inner ends and W + 1 mm over their outer ends. For the post version, two Ø0.8 mm holes sit on the centre line between the rows, 1.27 × N - 2.54 mm apart. Board tolerance for the pattern is ±0.05 mm."
  },
  {
   "topic": "Soldering",
   "page": 1,
   "text": "Processing temperature is at most 230 °C for 30 to 60 s, or 260 °C for 10 s."
  }
 ],
