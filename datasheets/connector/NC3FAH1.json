 "operation": [
  {
   "topic": "Grounding",
   "page": 1,
   "text": "When a plug is mated, its shell connects to pin 1, and pin 1 connects to the front panel. No contact is set aside for ground alone."
  },
  {
   "topic": "Contacts",
   "page": 1,
   "text": "The sockets are tulip-type; their mating surfaces are polished and carry hard gold."
  },
  {
   "topic": "Housing and latch",
   "page": 1,
   "text": "The round housing is plastic, flammability class UL 94 V-0, and the plug is held by a steel latch. The receptacle is a UL recognized component."
  },
  {
   "topic": "Packing density",
   "page": 1,
   "text": "Among XLR receptacles it is the smallest size; neighbouring receptacles fit at 23 mm between centres."
  }
 ],
