 "operation": [
  {
   "topic": "Wire connection",
   "page": 1,
   "text": "Each pole has a round wire entry on its top face beside a rectangular slot. Stripping length 11.0 mm; conductor 26 to 20 AWG, or 0.5 mm², solid or flexible."
  },
  {
   "topic": "Footprint",
   "page": 1,
   "text": "Two rows of Ø1.20 +0.10/0.00 mm holes, 5.08 ±0.03 mm apart, with 2.54 ±0.03 mm between holes in a row; P holes per row. The first hole sits 0.95 mm in from the end of the body, and the row nearer the body edge is 2.87 mm from it."
  },
  {
   "topic": "Approvals",
   "page": 1,
   "text": "The UL/CUL data are given under the cURus mark, for use group B only; the IEC data under the VDE mark, for three overvoltage-category and contamination-class pairs. The housing side is moulded with the cRUus and CE marks."
  }
 ],
