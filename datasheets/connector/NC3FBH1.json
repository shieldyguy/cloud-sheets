 "operation": [
  {
   "topic": "Grounding",
   "page": 1,
   "text": "Pin 1 connects directly to the mating plug's shell and to the front panel. The metal flange makes continuous ground contact with the chassis around its whole circumference, for EMC and RF protection."
  },
  {
   "topic": "Relation to the A series",
   "page": 1,
   "text": "The part matches Neutrik's A series except for the metal mounting flange. It belongs to Neutrik's smallest XLR receptacle family, built for dense panel packing."
  },
  {
   "topic": "Contacts and housing",
   "page": 1,
   "text": "The sockets are tulip-type female contacts. The housing is rated UL 94 V-0, and the part is a UL recognized component."
  }
 ],
