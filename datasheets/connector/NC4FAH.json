 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "The body is round and made of plastic (PA66, rated UL 94 V-0). Inside, each of the four female contacts is a fork, hard gold plated with polished mating surfaces. A steel latch locks the inserted plug."
  },
  {
   "topic": "Grounding",
   "page": 1,
   "text": "Besides the four poles, a separate ground contact connects the shell of the mating plug and the front panel."
  },
  {
   "topic": "Mounting",
   "page": 2,
   "text": "The receptacle mounts from the rear of the panel; its chassis cutout is shape A and it is held with A-Screw mounting. It is a horizontal PCB mount."
  },
  {
   "topic": "Spacing",
   "page": 1,
   "text": "Adjacent receptacles fit on 23 mm centres. It is among the smallest XLR receptacles, with the highest packing density."
  },
  {
   "topic": "Options",
   "page": 1,
   "text": "Colour coding is available for this receptacle."
  }
 ],
