{
 "sheet": 1,
 "name": "HEF4051BTT,118",
 "kind": "analog_switch",
 "manufacturer": "Nexperia",
 "title": "8-channel analog multiplexer/demultiplexer",
 "source": {
  "revision": "Rev. 13, 29 July 2021",
  "pages": 18
 },
 "summary": "The HEF4051B is a CMOS single-pole, eight-throw analog switch: one common terminal Z connects to one of eight terminals Y0 to Y7, picked by the three select inputs S1 to S3. Signals pass in either direction, so it serves as an 8:1 multiplexer or a 1:8 demultiplexer for analog or digital signals. A HIGH on the active-LOW enable E opens every switch. It runs from 3 V to 15 V, with a separate VEE supply for the analog path, and is specified over -40 °C to +125 °C.",
 "key_figures": [
  [
   "Configuration",
   "SP8T, 8:1 multiplexer/demultiplexer"
  ],
  [
   "Supply VDD",
   "3 V to 15 V"
  ],
  [
   "ON resistance (peak)",
   "350 Ω typ at VDD - VEE = 5 V; 60 Ω typ at 15 V"
  ],
  [
   "-3 dB bandwidth",
   "13 MHz typ at 5 V; 70 MHz typ at 15 V"
  ],
