 "equations": [
  {
   "name": "Propagation delay",
   "expr": "tpd = ron(typ) × CL",
   "where": {
    "ron(typ)": "switch ron, typical value",
    "CL": "load capacitance, 50 pF"
   },
   "note": "The source driving the switch is taken as ideal, with zero output impedance.",
   "page": 5
  },
  {
   "name": "ON-state resistance",
   "expr": "ron = (VA - VB) / II/O",
   "where": {
    "VA - VB": "voltage drop from the A to the B terminal",
    "II/O": "test current through the switch"
   },
   "note": "Taken at whichever terminal is lower in voltage.",
   "page": 5
  }
 ],
 "operation": [
  {
   "topic": "Organisation",
   "page": 1,
   "text": "Two independent 4-to-1 switches. S0 and S1 are shared and pick the same channel number (B1 to B4) in both; 1OE and 2OE enable each multiplexer separately. Functionally identical to the industry-standard '3253."
  },
  {
   "topic": "Enable",
   "page": 1,
   "text": "OE low: the A port connects to the selected B port and data can flow either way. OE high: that multiplexer is off and A is high-impedance to all B ports."
  },
  {
   "topic": "Undershoot protection",
   "page": 1,
   "text": "Both switch ports carry active sensing that notices a port driven below ground, down to -2 V, and holds an off switch off so off-isolation is kept. Data and control inputs both carry undershoot clamp diodes."
  },
  {
   "topic": "Signal levels",
   "page": 1,
   "text": "Data I/Os pass 0 to 5 V signals (0.8, 1.2, 1.5, 1.8, 2.5, 3.3 and 5 V levels). Control inputs are TTL-compatible and accept TTL or 5 V and 3.3 V CMOS drive."
  },
  {
   "topic": "Partial power-down",
   "page": 2,
   "text": "Ioff is specified: with VCC at 0 the device stays isolated and no harmful current flows back through it."
  },
  {
   "topic": "Power-up and power-down",
   "page": 2,
   "text": "To hold the switch high-impedance while VCC ramps, pull OE up to VCC through a resistor. Its smallest value is set by how much current the circuit driving OE can sink."
  },
  {
   "topic": "Unused control inputs",
   "page": 4,
   "text": "Tie any control input not in use to VCC or to GND; none may float."
  },
  {
   "topic": "Uses",
   "page": 1,
   "text": "Named applications: I2C bus expansion, USB interface, bus isolation and low-distortion signal gating, digital or analog."
  },
  {
   "topic": "Exposed pad (RGY)",
   "page": 13,
   "text": "Solder the RGY's exposed pad to a board land. Thermal vias under it are optional; if used, place them where the example land pattern shows and fill, plug or tent any via under paste. The example stencil puts paste on 80 % of the pad area through four openings, 0.125 mm stencil."
  }
 ],
