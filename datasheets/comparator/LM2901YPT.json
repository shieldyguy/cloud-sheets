{
 "sheet": 1,
 "name": "LM2901YPT",
 "kind": "comparator",
 "manufacturer": "STMicroelectronics",
 "title": "LM2901 low-power quad voltage comparator",
 "source": {
  "document": "Doc ID 2468",
  "revision": "Rev 7, February 2012",
  "pages": 17
 },
 "summary": "Four independent voltage comparators in one package, each with a PNP input stage and an open-collector output. They run from one supply of 2 V to 32 V, or split supplies of ±1 V to ±16 V, and the input common-mode range reaches down to the negative rail. The whole part draws about 1.1 mA regardless of supply voltage. LM2901YPT is the automotive-grade part in TSSOP14 on tape and reel.",
 "key_figures": [
  [
   "Supply voltage, operating",
   "2 V to 32 V, or ±1 V to ±16 V"
  ],
  [
   "Supply voltage range, single or dual supplies",
   "+2 V to +36 V, or ±1 V to ±18 V"
  ],
  [
   "Supply current, all four comparators",
   "1.1 mA typ, 2 mA max at VCC = 5 V; 1.4 mW per comparator at +5 V"
  ],
  [
   "Input offset voltage",
   "1 mV typ, 7 mV max at 25 °C"
  ],
  [
   "Input bias current",
   "25 nA typ"
  ],
  [
   "Input offset current",
   "±5 nA typ"
  ],
  [
   "Low-level output voltage",
   "250 mV typ at Isink = 4 mA"
  ],
  [
   "Small-signal response time",
   "1.3 µs typ, RL = 5.1 kΩ"
  ],
  [
   "Differential input voltage range",
   "equal to the supply voltage"
  ],
  [
   "Output compatibility",
   "TTL, DTL, ECL, MOS, CMOS"
  ],
  [
   "Operating temperature",
   "-40 °C to +125 °C"
  ]
 ],
