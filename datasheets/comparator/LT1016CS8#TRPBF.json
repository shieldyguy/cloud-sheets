{
 "sheet": 1,
 "name": "LT1016CS8#TRPBF",
 "kind": "comparator",
 "manufacturer": "Analog Devices",
 "title": "UltraFast precision 10ns comparator",
 "source": {
  "revision": "Rev D, 04/18",
  "pages": 22
 },
 "summary": "The LT1016 is a single high-speed voltage comparator with a typical propagation delay of 10ns, complementary Q and Q̄ outputs that drive TTL/CMOS directly, and a LATCH ENABLE input that holds the output. It runs from a single 5V supply or from ±5V. Offset is 1.0mV typical and gain 3000V/V typical, and the output stage drives actively in both directions without supply current spikes.",
 "key_figures": [
  [
   "Propagation delay",
   "10ns typ, 14ns max (100mV step, 5mV overdrive)"
  ],
  [
   "Supplies",
   "single 5V or ±5V"
  ],
