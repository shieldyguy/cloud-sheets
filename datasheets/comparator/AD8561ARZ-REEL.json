{
 "sheet": 1,
 "name": "AD8561ARZ-REEL",
 "kind": "comparator",
 "manufacturer": "Analog Devices",
 "title": "AD8561: 7 ns single comparator with latch, 3 V to 10 V supply",
 "source": {
  "revision": "Rev. D",
  "pages": 12
 },
 "summary": "A single high-speed voltage comparator with about 7 ns propagation delay at 5 V and a complementary pair of outputs. The input and output sections have their own supply pins, so the inputs can sit on a single +5 V or on ±5 V, and the common-mode range includes the negative rail. A latch pin freezes the outputs. It shares the LT1016 pinout with less supply current, and comes in 8-lead PDIP, SOIC and TSSOP for -40 °C to +85 °C; AD8561ARZ-REEL is the SOIC_N part on a reel.",
 "key_figures": [
  [
   "Propagation delay",
   "6.75 ns typ, 9.8 ns max (200 mV step, 100 mV overdrive, V+ = 5 V)"
  ],
  [
   "Supply range",
   "3 V to 10 V single supply; 14 V max total V– to V+"
  ],
  [
   "Offset voltage",
   "2.3 mV typ, 7 mV max (V+ = 5 V)"
  ],
  [
   "Input common-mode range",
   "0 V to +3.0 V at V+ = 5 V; -5.0 V to +3.0 V on ±5 V"
  ],
  [
   "Positive supply current",
   "4.5 mA typ, 6.0 mA max (V+ = 5 V)"
  ],
  [
   "Input bias current",
   "-3 µA typ (VCM = 0 V)"
  ],
  [
   "Rise / fall time",
   "3.8 ns / 1.5 ns typ"
  ],
  [
   "Latch setup / hold",
   "1 ns / 1.2 ns typ"
  ],
  [
   "Operating temperature",
   "-40 °C to +85 °C"
  ]
 ],
