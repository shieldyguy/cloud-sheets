{
 "sheet": 1,
 "name": "LM397MFX_NOPB",
 "kind": "comparator",
 "manufacturer": "Texas Instruments",
 "title": "LM397 single general-purpose voltage comparator, open-collector output, SOT-23-5",
 "source": {
  "document": "SNOS977F",
  "revision": "SNOS977F, May 2001, revised May 2016",
  "pages": 19
 },
 "summary": "A single bipolar-input voltage comparator whose common-mode range reaches down to ground, from 0 V to VS - 1.5 V. It runs from one 5 V to 30 V supply or from split supplies, drawing about 0.25 mA at 5 V and 0.3 mA at 30 V. The output is an NPN open collector that needs a pull-up resistor, so its high level can be set to suit TTL, CMOS or another logic supply. It comes in the 5-pin SOT-23 (DBV) and shares its pinout with the TL331.",
 "key_figures": [
  [
   "Supply voltage",
   "5 V to 30 V (single), or split supplies"
  ],
  [
   "Supply current",
   "0.25 mA typ, 0.7 mA max at VS = 5 V; 0.3 mA typ, 2 mA max at VS = 30 V"
  ],
  [
   "Input offset voltage",
   "2 mV typ, 7 mV max at 25 °C; 10 mV max over temperature"
  ],
  [
   "Input bias current",
   "10 nA typ, 250 nA max at 25 °C"
  ],
  [
   "Input offset current",
   "1.6 nA typ, 50 nA max at 25 °C"
  ],
  [
   "Common-mode input range",
   "0 V to VS - 1.5 V at 25 °C; 0 V to VS - 2 V over temperature"
  ],
  [
   "Output",
   "open collector; sink 6 mA min, 13 mA typ at VO = 1.5 V"
  ],
  [
   "Propagation delay",
   "tPHL 250 ns, tPLH 440 ns typ at 50 mV overdrive"
  ],
  [
   "Voltage gain",
   "120 V/mV typ"
  ],
