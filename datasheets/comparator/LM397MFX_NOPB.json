  {
   "id": "basic",
   "title": "Basic comparator",
   "page": 7,
   "description": "The simplest connection. The signal goes to the non-inverting input and a reference to the inverting input; a pull-up from the output to VS gives the output its high level. The output is low while VIN sits below VREF and high once VIN rises above it.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "LM397"
    },
