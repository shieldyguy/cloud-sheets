   "notes": []
  },
  {
   "id": "hysteresis",
   "title": "Inverting comparator with hysteresis",
   "page": 9,
   "description": "The signal drives the inverting input, so the output falls as VIN rises. R1 from VS and R2 to ground set a threshold at the non-inverting input, VT, and R3 from the output back to that node moves the threshold with the output state, giving two switching points and so hysteresis. RPULLUP sets the output high level at VS.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "LM397"
    },
    {
     "ref": "R1",
     "type": "resistor",
