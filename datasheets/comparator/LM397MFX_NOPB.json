     "note": "value set by the threshold equations"
    },
    {
     "ref": "R2",
     "type": "resistor",
     "value": "R2",
     "note": "value set by the threshold equations"
    },
    {
     "ref": "R3",
     "type": "resistor",
     "value": "R3",
     "note": "feedback resistor; value set by the threshold equations"
    },
    {
