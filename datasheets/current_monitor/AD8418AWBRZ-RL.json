{
 "sheet": 1,
 "name": "AD8418AWBRZ-RL",
 "kind": "current_monitor",
 "manufacturer": "Analog Devices",
 "title": "AD8418A: bidirectional zero-drift current sense amplifier, gain 20, −2 V to +70 V common mode",
 "source": {
  "revision": "Rev. E, June 2020",
  "pages": 18
 },
 "summary": "A fixed-gain (20 V/V) difference amplifier for reading the voltage across a current shunt whose common mode sits anywhere from −2 V to +70 V and may be switched by PWM; the inputs survive −3 V to +80 V. A zero-drift core holds offset to ±200 µV and drift to 0.1 µV/°C typical, and gain error stays within ±0.15 % over temperature. Two reference pins set the output's zero-current level for one-way or two-way current measurement, and input EMI filters are built in. It runs from 2.7 V to 5.5 V, is AEC-Q100 qualified, and comes in SOIC_N-8, MSOP-8 and an FMEA-oriented MSOP-10.",
 "key_figures": [
  [
   "Gain",
   "20 V/V; ±0.15 % error over temperature"
  ],
  [
   "Offset (RTI)",
   "±100 µV typ at 25 °C; ±200 µV max over temperature"
  ],
  [
   "Offset drift",
   "+0.1 µV/°C typ, ±0.4 µV/°C max"
  ],
  [
   "Common-mode range",
   "−2 V to +70 V operating; −3 V to +80 V survival"
  ],
  [
   "CMRR",
   "90 dB min dc; 86 dB typ dc to 10 kHz"
  ],
  [
   "Bandwidth",
   "250 kHz typ (−3 dB)"
  ],
  [
   "Supply",
   "2.7 V to 5.5 V; 4.1 mA max (AWB/AB), 4.2 mA max (AWH)"
  ],
  [
   "Temperature",
   "−40 °C to +125 °C (AWB, AB); −40 °C to +150 °C (AWH)"
  ]
 ],
