   ],
   "rows": [
    [
     "1, 2",
     "−IN and NC",
     "No effect; the amplifier works normally."
    ],
    [
     "2, 3",
     "NC and GND",
     "No effect; the amplifier works normally."
    ],
    [
     "3, 4",
     "GND and VREF2",
     "VREF2 may sit anywhere from GND to VS, so this short alone is no fault: with the split-supply setup (VREF2 already at GND) nothing changes. If VREF2 is driven from VS or from an external reference, the short connects that source to GND on the board and the system misbehaves."
    ],
    [
     "4, 5",
     "VREF2 and NC",
     "No effect; the amplifier works normally."
    ],
    [
     "6, 7",
     "OUT and VS",
     "OUT goes toward the VS voltage."
    ],
    [
     "7, 8",
     "VS and VREF1",
     "VREF1 may sit anywhere from GND to VS, so this short alone is no fault: with the split-supply setup (VREF1 already at VS) nothing changes. If VREF1 is driven from GND or from an external reference, the short connects VS to that node on the board and the system misbehaves."
    ],
    [
     "8, 9",
     "VREF1 and NC",
     "No effect; the amplifier works normally."
    ],
    [
