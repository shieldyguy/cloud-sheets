{
 "sheet": 1,
 "name": "AD8211YRJZ-RL7",
 "kind": "current_monitor",
 "manufacturer": "Analog Devices",
 "title": "High-voltage current shunt monitor, gain 20",
 "source": {
  "revision": "Rev. C, 12/2016",
  "pages": 13
 },
 "summary": "A unidirectional current-sense amplifier with a fixed gain of 20 V/V for a shunt whose common-mode voltage may sit anywhere from −2 V to +65 V while the part runs from 5 V. The output is buffered and ground-referenced, ready for an ADC, and stays linear down to differential inputs of a few millivolts whatever the common-mode voltage. It comes in a 5-lead SOT-23, rated −40 °C to +125 °C, in a standard (Y) grade and an automotive-qualified (W) grade.",
 "key_figures": [
