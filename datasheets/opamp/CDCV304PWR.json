{
 "sheet": 1,
 "name": "CDCV304PWR",
 "kind": "opamp",
 "manufacturer": "Texas Instruments",
 "title": "CDCV304: 1:4 clock fan-out buffer for general use and PCI-X, 0 MHz to 200 MHz, TSSOP-8",
 "source": {
  "document": "SCAS643I",
  "revision": "Revised October 2017",
  "pages": 18
 },
 "summary": "A single-input, four-output clock fan-out buffer. One clock on CLKIN is repeated on 1Y0 to 1Y3 with under 100 ps between outputs (3.3 V, typ 50 ps). It runs from one supply of 2.3 V to 3.6 V, covering 2.5 V and 3.3 V systems, and meets the 3.3 V PCI-X clock requirements. An OE input forces all four outputs low. Rated -40 °C to 85 °C in an 8-pin TSSOP.",
 "key_figures": [
  [
   "Fan-out",
   "1 input to 4 outputs (one bank)"
  ],
  [
   "Clock frequency",
   "0 MHz to 200 MHz"
  ],
  [
   "Output skew",
   "50 ps typ; 100 ps max at 3.3 V, 150 ps max at 2.5 V"
  ],
  [
   "Propagation delay",
   "2.4 ns typ, 1.8 ns to 3 ns at 3.3 V"
  ],
  [
   "Additive phase jitter",
   "56 fs rms typ (12 kHz to 20 MHz, 125 MHz)"
  ],
  [
   "Supply",
   "2.3 V to 3.6 V"
  ],
  [
   "Output drive",
   "±24 mA at 3.3 V, ±12 mA at 2.5 V"
  ],
  [
   "Dynamic supply current",
   "37 mA max at 67 MHz, VDD = 3.6 V"
  ],
  [
   "Temperature",
   "-40 °C to 85 °C"
  ],
  [
   "Package",
   "TSSOP-8 (PW), 3.00 mm × 4.40 mm body"
  ]
 ],
