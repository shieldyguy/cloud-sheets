 "operation": [
  {
   "topic": "Function",
   "page": 8,
   "text": "Every output follows CLKIN while OE is high. With OE low all four outputs sit low whatever CLKIN does."
  },
  {
   "topic": "Supply",
   "page": 1,
   "text": "One supply pin serves the whole part; it is specified at 2.5 V ± 10% and 3.3 V ± 10%, within a recommended range of 2.3 V to 3.6 V. Input thresholds scale with VDD (VIH 0.7 VDD, VIL 0.3 VDD)."
  },
  {
   "topic": "PCI-X",
   "page": 1,
   "text": "The part meets the 3.3 V PCI-X clock specifications; its clock high and low times and slew rates are given against the PCI-X 1.0 waveform levels."
  },
  {
   "topic": "Timing measurement",
   "page": 7,
   "text": "Propagation delay runs from CLKIN crossing 50% VDD to an output crossing 50% VDD, with each output loaded by the test load. Output rise and fall are taken between 0.2 VDD and 0.6 VDD. Output skew is the spread between the 50% VDD crossings of any two outputs, and is guaranteed only with equal loads on all outputs."
  },
  {
   "topic": "Other versions",
   "page": 11,
   "text": "An Enhanced Product grade, CDCV304-EP, is qualified for defense, aerospace and medical use."
  }
 ],
