{
 "sheet": 1,
 "name": "OP07CDR",
 "kind": "opamp",
 "manufacturer": "Texas Instruments",
 "title": "OP07C and OP07D precision bipolar operational amplifiers",
 "source": {
  "document": "SLOS099F",
  "revision": "Revised January 2014",
  "pages": 15
 },
 "summary": "A single precision op amp with a bipolar input and no chopper, giving 60 µV typical offset, 0.5 µV/°C drift and 9.8 nV/√Hz noise at 1 kHz with internal compensation. It runs from ±3 V to ±18 V, accepts common-mode inputs to ±14 V typical on ±15 V and needs no external parts in most uses; two pins allow optional offset trim. Two grades, OP07C and OP07D, come in SOIC, PDIP and (OP07D) SO packages for 0 °C to 70 °C. OP07CDR is the OP07C in SOIC on a 2500-piece reel.",
 "key_figures": [
