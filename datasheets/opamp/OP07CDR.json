 "equations": [
  {
   "name": "Allowed power dissipation",
   "expr": "PD = (TJ(max) - TA) / θJA",
   "where": {
    "PD": "maximum dissipation at the ambient temperature",
    "TJ(max)": "maximum junction temperature, 150 °C",
    "TA": "ambient (free-air) temperature",
    "θJA": "junction-to-air thermal impedance: 97 °C/W D package, 85 °C/W P package"
   },
   "note": "",
   "page": 3
  }
 ],
 "operation": [
  {
   "topic": "Grades",
   "page": 1,
   "text": "OP07C and OP07D share a pinout and one characteristics table, and both are characterized from 0 °C to 70 °C."
  },
  {
   "topic": "Input stage",
   "page": 1,
   "text": "A bipolar-transistor input with no chopper gives low offset, low noise and good long-term stability. Bias current stays low and input impedance high across the whole temperature range. The part is offered as a lower-cost stand-in for chopper-stabilised amplifiers."
  },
  {
   "topic": "Offset trim and compensation",
   "page": 1,
   "text": "Most uses need no external parts: frequency compensation is internal and offset trim is optional. When trim is wanted, a 20 kΩ potentiometer across OFFSET N1 and OFFSET N2 with its wiper on VCC+ gives about ±4 mV of adjustment (Figure 1)."
  },
  {
   "topic": "Input range",
   "page": 1,
   "text": "The inputs are truly differential. The common-mode range reaches ±14 V typical on ±15 V supplies, and common-mode rejection is high, which suits noisy surroundings and non-inverting gain stages. Either input must stay within the smaller of the supply voltage and 15 V in magnitude; the inputs may differ by up to ±30 V."
  },
  {
   "topic": "Supplies",
   "page": 3,
   "text": "The amplifier runs from ±3 V to ±18 V. At ±15 V with no load it dissipates 80 mW typical, 150 mW maximum; at ±3 V, 4 mW typical, 8 mW maximum."
  },
  {
   "topic": "Output protection",
   "page": 3,
   "text": "The output survives an unlimited-duration short to ground, VCC+ or VCC-."
  },
  {
   "topic": "Internal circuit",
   "page": 2,
   "text": "The chip holds 28 resistors, 39 transistors and 4 capacitors."
  }
 ],
