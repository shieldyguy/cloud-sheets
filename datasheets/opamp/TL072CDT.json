{
 "sheet": 1,
 "name": "TL072CDT",
 "kind": "opamp",
 "manufacturer": "STMicroelectronics",
 "title": "Low-noise JFET-input dual operational amplifiers (TL072, TL072A, TL072B)",
 "source": {
  "revision": "Doc ID 2298 Rev 7, July 2012",
  "pages": 16
 },
 "summary": "Two fast, internally compensated op amps with JFET inputs in one DIP8 or SO-8 package, running from 6 V to 36 V total supply. Picoamp input currents, 15 nV/√Hz noise, 16 V/µs slew and 4 MHz gain-bandwidth are typical. TL072, TL072A and TL072B are offset grades (10, 6, 3 mV max); each comes in a -40 to +105 °C and a 0 to +70 °C version, plus automotive SO-8 codes. TL072CDT is the standard-offset 0 to +70 °C part in SO-8.",
 "key_figures": [
