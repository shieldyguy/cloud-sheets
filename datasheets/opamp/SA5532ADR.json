 "equations": [
  {
   "name": "Buffered output (Equation 1)",
   "expr": "VOUT+ = VIN",
   "where": {
    "VOUT+": "amplifier 1 output",
    "VIN": "single-ended input"
   },
   "note": "",
   "page": 8
  },
  {
   "name": "Inverting output (Equation 2)",
   "expr": "VOUT– = VREF × (R4 / (R3 + R4)) × (1 + R2 / R1) – VIN × R2 / R1",
   "where": {
    "VOUT–": "amplifier 2 output",
    "VREF": "reference, 12 V",
    "R1": "inverting-stage input resistor",
    "R2": "inverting-stage feedback resistor",
    "R3": "reference divider, top",
    "R4": "reference divider, bottom"
   },
   "note": "",
   "page": 8
  },
  {
   "name": "Differential output (Equation 3)",
   "expr": "VDIFF = VOUT+ – VOUT– = VIN × (1 + R2 / R1) – VREF × (R4 / (R3 + R4)) × (1 + R2 / R1)",
   "where": {
    "VDIFF": "voltage between the two outputs"
   },
   "note": "",
   "page": 8
  },
  {
   "name": "Outputs with R1 = R2 and R3 = R4 (Equations 4 and 5)",
   "expr": "VOUT+ = VIN; VOUT– = VREF – VIN",
   "where": {},
   "note": "",
   "page": 8
  },
  {
   "name": "Differential output with R1 = R2 and R3 = R4 (Equation 6)",
   "expr": "VDIFF = 2 × VIN – VREF",
   "where": {},
   "note": "Input and each output reach at most VREF, so the differential span is 2 × VREF.",
   "page": 8
  },
  {
   "name": "Common-mode output (Equation 7)",
   "expr": "Vcm = (VOUT+ + VOUT–) / 2 = VREF / 2",
   "where": {
    "Vcm": "mean of the two outputs"
   },
   "note": "",
   "page": 8
  },
  {
   "name": "Allowed power dissipation",
   "expr": "PD = (TJ(max) – TA) / θJA",
   "where": {
    "PD": "power dissipation",
    "TJ(max)": "maximum junction temperature, 150 °C",
    "TA": "ambient temperature",
    "θJA": "junction-to-ambient thermal resistance"
   },
   "note": "",
   "page": 3
  }
