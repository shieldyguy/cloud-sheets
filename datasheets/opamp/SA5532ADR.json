 "circuits": [
  {
   "id": "single-to-differential",
   "title": "Single-ended input to differential output conversion",
   "page": 7,
   "description": "Both halves of one NE5532 turn a 2 V to 10 V single-ended signal into a ±8 V differential pair from a single 15 V rail with a 12 V reference. Amplifier 1 is a follower, so VOUT+ tracks VIN. Amplifier 2 takes VOUT+ through R1 into its inverting input with R2 as feedback, while R3 and R4 halve VREF onto its noninverting input; with all four resistors equal, VOUT– = VREF – VIN. Each output spans 2 V to 10 V, VDIFF = 2 × VIN – VREF, and the outputs centre on VREF / 2.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "NE5532",
     "note": "amplifier 1 buffers the input, amplifier 2 inverts and offsets it"
    },
    {
     "ref": "R1",
     "type": "resistor",
     "value": "36 kΩ",
     "note": "R1 to R4 with tolerance measured within 2 %"
    },
    {
