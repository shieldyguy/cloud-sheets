 "circuits": [
  {
   "id": "single-to-differential",
   "title": "Single-ended input to differential output conversion",
   "page": 9,
   "description": "Both amplifiers of one RC4580 on a single 15 V rail turn a 2 V to 10 V input into a ±8 V differential signal. Amplifier 1 is a voltage follower, so VOUT+ equals VIN. Amplifier 2 inverts: VOUT+ reaches its inverting input through R1 with R2 as feedback, while R3 and R4 divide the 12 V reference onto its noninverting input. With R1 = R2 and R3 = R4, VOUT– = VREF – VIN, both outputs span 2 V to 10 V, VDIFF = 2 × VIN – VREF and the two outputs sit about VREF / 2.",
   "parts": [
