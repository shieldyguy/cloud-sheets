 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "Metal-silicon junction with majority-carrier conduction. The molding compound is rated UL 94V-0; the part is RoHS compliant and halogen free."
  },
  {
   "topic": "Terminals and soldering",
   "page": 1,
   "text": "Terminals are solder plated and pass MIL-STD-750 method 2026 solderability. Moisture sensitivity is level 1 to J-STD-020, with a lead-free reflow peak of 260 °C."
  },
  {
   "topic": "Marking",
   "page": 1,
   "text": "The body carries its part number as the marking code and a band at the cathode end."
  },
  {
   "topic": "Uses",
   "page": 1,
   "text": "Low-voltage high-frequency inverters, freewheeling paths, DC/DC converters and polarity protection."
  },
  {
   "topic": "Current derating",
   "page": 2,
   "text": "The full 8 A average current holds up to a lead temperature of 100 °C and falls linearly to zero at 150 °C."
  }
 ],
