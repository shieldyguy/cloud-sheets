 "operation": [
  {
   "topic": "Choosing a part",
   "page": 1,
   "text": "All seven types share current, surge, forward-voltage, leakage, capacitance and thermal ratings; only the reverse voltage ratings change. VRRM and VDC run 50, 100, 200, 400, 600, 800 and 1000 V from M1 to M7, with RMS ratings of 35 V to 700 V."
  },
  {
   "topic": "Construction",
   "page": 1,
   "text": "Glass-passivated junction in a molded plastic JEDEC DO-214AC (SMA) body whose material meets UL 94V-0. Terminals are solder plated and solderable to MIL-STD-750 method 2026. A polarity symbol is marked on the body; any mounting position is allowed. Weight 0.0019 oz (0.055 g)."
  },
  {
   "topic": "Soldering",
   "page": 1,
   "text": "The terminals withstand 250 °C for 10 seconds."
  },
  {
   "topic": "Current derating",
   "page": 2,
   "text": "Average forward current stays at the full 1.0 A up to a case temperature of 125 °C and falls in a straight line to zero at 150 °C."
  },
  {
   "topic": "Surge capability",
   "page": 2,
   "text": "The non-repetitive surge limit is 30 A for one 8.3 ms half sine cycle and falls with the number of cycles, to about 16 A at 10 cycles and about 9 A at 100 cycles."
  },
  {
   "topic": "Leakage and temperature",
   "page": 2,
   "text": "Typical reverse current rises steeply with junction temperature, from tens of nanoamperes at 25 °C to tens of microamperes at 150 °C, and grows slowly with reverse voltage at each temperature."
  }
 ],
