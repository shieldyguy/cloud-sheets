 "operation": [
  {
   "topic": "Uses",
   "page": 1,
   "text": "Meant for low-voltage, high-frequency inverters and signal circuits, freewheeling and polarity protection."
  },
  {
   "topic": "Construction and marking",
   "page": 1,
   "text": "SOD-323 molded body; the compound is rated UL 94V-0, RoHS compliant and halogen free. Terminals are solder plated and solderable to MIL-STD-750 method 2026. A band on the body marks the cathode end, and a two-character code on top names the part: S4 (SD103AWS), S5 (SD103BWS), S6 (SD103CWS)."
  },
  {
   "topic": "Derating",
   "page": 2,
   "text": "The 200 mW dissipation holds up to 25 °C ambient and falls linearly to zero at 125 °C."
  }
 ],
