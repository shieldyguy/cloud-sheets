 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Grouping by voltage",
   "page": 2,
   "text": "All nine types share the package, the current rating and the surge rating. Maximum forward voltage comes in four groups (SS22-SS24, SS25-SS26, SS28-SS210, SS215-SS220), reverse leakage in two (SS22-SS26 and SS28-SS220) and junction capacitance in two (SS22-SS24 and SS25-SS220). Higher-voltage types leak less and drop more in the forward direction."
  },
  {
   "topic": "Current derating",
   "page": 2,
   "text": "The full 2.0 A average current holds up to a lead temperature of about 100 °C. Beyond that it falls in a straight line to zero, reached at 150 °C for SS22-SS24 and at about 125 °C for SS25-SS220."
  },
  {
   "topic": "Surge",
   "page": 2,
   "text": "The 50 A surge rating is for one 8.3 ms half sine. Over repeated cycles the allowed peak drops, to about 13 A at 10 cycles and below 8 A at 100 cycles."
  },
  {
   "topic": "Marking and polarity",
   "page": 1,
   "text": "The body is marked with its code (the part number, e.g. SS24) and carries a band at the cathode end."
  }
 ],
