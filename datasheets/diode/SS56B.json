 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Grouping by voltage",
   "page": 2,
   "text": "The nine parts fall into groups that share figures. Forward voltage at 5 A is 0.55 V for SS52B to SS54B, 0.70 V for SS55B and SS56B, 0.85 V for SS58B and SS510B, and 0.95 V for SS515B and SS520B. Leakage limits and the reverse-current curves split the family in two: SS52B to SS56B, and SS58B to SS520B, the higher-voltage group leaking less. The junction temperature limit splits the same way: 125 °C for the lower group, 150 °C for the higher."
  },
  {
   "topic": "Current derating",
   "page": 2,
   "text": "The full 5.0 A average current holds up to a lead temperature of about 70 °C and falls in a straight line to zero at 150 °C."
  },
  {
   "topic": "Surge",
   "page": 2,
   "text": "The 120 A surge figure is for a single 8.3 ms half-sine pulse. With repeated cycles the allowed peak drops, to roughly 45 A at 10 cycles and 10 A at 100 cycles."
  },
  {
   "topic": "Applications",
   "page": 1,
   "text": "Intended for low-voltage high-frequency inverters, freewheeling and polarity protection, in surface-mount assembly. Built-in strain relief suits automated placement."
  }
 ],
