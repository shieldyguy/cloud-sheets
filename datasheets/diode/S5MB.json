 "equations": [],
 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "Glass-passivated junction in a moulded SMB body for surface mounting. The moulding compound is rated UL 94V-0; the part is RoHS-compliant and halogen-free. Moisture sensitivity is MSL 1 to J-STD-020, with a 260 °C peak for lead-free reflow."
  },
  {
   "topic": "Terminals and polarity",
   "page": 1,
   "text": "Solder-plated terminals, solderable to MIL-STD-750 Method 2026. A line on the body marks the cathode end; the body carries the marking code."
  },
  {
   "topic": "Uses",
   "page": 1,
   "text": "Applications: rectifier and freewheeling diode for power supplies, inverters and converters in consumer and telecom equipment. Features: low reverse leakage, high forward surge capability."
  },
  {
   "topic": "Current derating",
   "page": 2,
   "text": "The full 5.0 A average forward current holds up to a lead temperature of 100 °C and falls linearly to zero at about 150 °C (Fig.1)."
  }
 ],
