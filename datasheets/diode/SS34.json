 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "The junction is metal on silicon and conducts by majority carriers. The leads carry built-in strain relief for automated placement."
  },
  {
   "topic": "Current rating",
   "page": 2,
   "text": "The full 3.0 A average current holds up to a lead temperature of 100 °C and falls linearly to zero at 125 °C."
  },
  {
