 "operation": [
  {
   "topic": "Choosing a configuration",
   "page": 1,
   "text": "Each type carries its own marking code: KL1 on the BAT54, KL2 on the BAT54A, KL3 on the BAT54C and KL4 on the BAT54S. On the BAT54, lead 2 has no connection."
  },
  {
   "topic": "Power derating",
   "page": 2,
   "text": "200 mW is allowed up to 25 °C ambient, falling in a straight line to zero at 125 °C."
  },
  {
   "topic": "Forward drop and temperature",
   "page": 2,
   "text": "At a given forward current the diode drops less voltage at 100 °C than at 25 °C; the two typical curves draw together near 200 mA."
  },
  {
   "topic": "Leakage and temperature",
   "page": 2,
   "text": "Typical reverse current is around 0.1 to 0.65 µA at 25 °C across 0 to 30 V, and about 20 to 100 µA at 100 °C, rising with reverse voltage."
  },
  {
   "topic": "Capacitance",
   "page": 2,
   "text": "Typical capacitance between terminals is about 18 pF near zero bias, falls steeply over the first few volts and is near 3 pF at 30 V."
  },
  {
   "topic": "Materials and finish",
   "page": 1,
   "text": "Molding compound is rated UL 94V-0, RoHS-compliant and halogen-free. Leads are solder plated and solderable to MIL-STD-750, Method 2026. A line marks the cathode end."
  }
 ],
