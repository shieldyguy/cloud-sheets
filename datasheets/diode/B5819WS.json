 "operation": [
  {
   "topic": "Uses",
   "page": 1,
   "text": "Intended for low-voltage, high-frequency inverters and signal circuits, for freewheeling and for reverse-polarity protection; switching is fast."
  },
  {
   "topic": "Construction and marking",
   "page": 1,
   "text": "SOD-323 molded body; the compound carries a UL 94V-0 flammability rating and is RoHS compliant and halogen free. Terminals are solder plated and solderable to MIL-STD-750 method 2026. A line on the body marks the cathode end, and a two-letter code on the top identifies the part (SJ, SK or SL)."
  },
  {
   "topic": "Derating",
   "page": 2,
   "text": "The 250 mW dissipation holds up to 25 °C ambient and falls linearly to zero at 150 °C."
  }
 ],
