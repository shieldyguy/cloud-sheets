 "operation": [
  {
   "topic": "Choosing a type",
   "page": 1,
   "text": "The three types differ only in reverse voltage grade and forward drop: the 20 V 1N5817WS has the lowest drop, the 40 V 1N5819WS the highest. Current, surge, leakage and capacitance ratings are common to all three."
  },
  {
   "topic": "Temperature",
   "page": 2,
   "text": "Allowed dissipation is 250 mW up to 25 °C ambient and falls linearly to zero at 125 °C. Leakage rises about twentyfold from 25 °C to 100 °C, while forward drop at a given current falls."
  }
 ],
