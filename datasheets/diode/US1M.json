 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "Molded plastic body in the JEDEC DO-214AC (SMA) outline with built-in strain relief, suited to surface mounting and automated placement. The plastic is rated UL 94V-0 for flammability. RoHS compliant. Weight 0.07 g (0.002 oz)."
  },
  {
   "topic": "Terminals and soldering",
   "page": 1,
   "text": "Terminals are solder plated and solderable to MIL-STD-750, method 2026; they withstand 250 °C for 10 s during soldering. Any mounting orientation is allowed."
  },
  {
   "topic": "Polarity",
   "page": 1,
   "text": "A polarity symbol is marked on the body; the band on the outline is at the cathode end."
  },
  {
   "topic": "Derating",
   "page": 2,
   "text": "The full 1.0 A average current holds up to a case temperature of 125 °C and falls linearly to zero at 150 °C (half-wave 60 Hz, resistive or inductive load). A capacitive load takes 20 % off the rated current."
  }
 ],
