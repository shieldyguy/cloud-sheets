 "circuits": [
  {
   "id": "rectification-efficiency",
   "title": "Rectification efficiency measurement circuit",
   "page": 2,
   "fixture": true,
   "description": "A half-wave detector used to measure how well the diode rectifies: an RF generator of 2 V (VRF) with 60 Ω in series feeds the diode's anode, and the cathode charges a 2 nF capacitor that is loaded by 5 kΩ. The DC across that RC pair is the output Vo.",
