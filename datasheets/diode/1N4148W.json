 "equations": [],
 "operation": [
  {
   "topic": "Marking and polarity",
   "page": 1,
   "text": "The top of the case carries the code W1. Pin 1, the cathode, sits at the banded end."
  },
  {
   "topic": "Other packages",
   "page": 1,
   "text": "The same diode type is offered as 1N4148 in the leaded DO-35 glass case, LL4148 in MiniMELF and MCL4148 in MicroMELF."
  },
  {
   "topic": "Power derating",
   "page": 2,
   "text": "The 400 mW rating holds from 0 °C to 25 °C ambient and then falls linearly, reaching zero at 150 °C."
  },
  {
   "topic": "Capacitance against bias",
   "page": 2,
   "text": "At 25 °C and 1 MHz, capacitance drops quickly over the first volt of reverse bias to about 94 % of its zero-bias value, then falls slowly to about 86 % at 10 V."
  }
 ],
