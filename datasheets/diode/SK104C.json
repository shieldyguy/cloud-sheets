 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Construction and marking",
   "page": 1,
   "text": "A guard ring is built into the junction to protect against overvoltage. The molded body uses a UL 94V-0 rated, RoHS-compliant, halogen-free compound. The terminals are solder plated and pass MIL-STD-750 method 2026 solderability. A band on the body marks the cathode, and the top carries the part number as its marking code."
  },
  {
   "topic": "Moisture and reflow",
   "page": 1,
   "text": "Moisture sensitivity is MSL 1 under J-STD-020, with a 260 °C peak for lead-free reflow."
  },
  {
   "topic": "Current derating",
   "page": 2,
   "text": "The 10 A average rating holds up to a lead temperature of 100 °C and falls in a straight line to zero at 150 °C."
  },
  {
   "topic": "Surge",
   "page": 2,
   "text": "The surge curve starts near 170 A for a single 8.3 ms half sine and falls with repeated cycles, to about 65 A at 10 cycles and about 12 A at 100 cycles."
  },
  {
   "topic": "Leakage against temperature",
   "page": 2,
   "text": "At full rated reverse voltage, an SK102C to SK106C part leaks typically about 0.07 mA at 25 °C and about 28 mA at 100 °C; an SK108C to SK1020C part about 0.009 mA at 25 °C and about 3.4 mA at 100 °C."
  }
 ],
