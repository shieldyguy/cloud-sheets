 "operation": [
  {
   "topic": "Types",
   "page": 1,
   "text": "The three types share every current, power, thermal and electrical figure; only the voltage ratings (VRRM, VRMS, V(BR)R) step up from BAV19WS to BAV21WS."
  },
  {
   "topic": "Marking and polarity",
   "page": 1,
   "text": "A stripe on the body marks the cathode end. Each type carries a two-character code: A8 for BAV19WS, T2 for BAV20WS, T3 for BAV21WS."
  },
  {
   "topic": "Power derating",
   "page": 2,
   "text": "The 250 mW dissipation rating holds up to 25 °C ambient and falls linearly to zero at 150 °C."
  },
  {
   "topic": "Materials and soldering",
   "page": 1,
   "text": "The molding compound is rated UL 94V-0 for flammability and is RoHS-compliant and halogen-free. The leads are solder plated and meet MIL-STD-750 Method 2026 for solderability. Moisture sensitivity is MSL 1 to J-STD-020, with a lead-free reflow peak of 260 °C."
  },
  {
   "topic": "Applications",
   "page": 1,
   "text": "Intended for signal paths in high-frequency circuits at low voltage."
  }
 ],
