 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "Glass-passivated standard rectifier for surface mounting, with low reverse leakage and a high forward surge rating."
  },
  {
   "topic": "Uses",
   "page": 1,
   "text": "Intended for consumer and telecom equipment: rectifiers in power supplies, inverters and converters, and freewheeling diodes."
  },
  {
   "topic": "Polarity and marking",
   "page": 1,
   "text": "A band on the body marks the cathode end. Each part is marked with its own part number, S3AB through S3MB."
  },
  {
   "topic": "Package and soldering",
   "page": 1,
   "text": "DO-214AA (SMB). Moisture sensitivity level 1 to J-STD-020, with a lead-free reflow peak of 260 °C. The mould compound is UL 94V-0 rated, RoHS compliant and halogen-free. Terminals are solder plated and solderable to MIL-STD-750 Method 2026."
  },
  {
   "topic": "Derating and surge",
   "page": 2,
   "text": "The full 3.0 A average current holds up to a lead temperature of 100 °C and falls linearly to zero at about 150 °C. Surge capability drops from 100 A for one 8.3 ms half-sine cycle to about 23 A over 100 cycles."
  }
 ],
