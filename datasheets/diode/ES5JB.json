 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "Glass-passivated junction in a low-profile moulded SMB body suited to automated placement. The moulding compound is rated UL 94V-0, and the part is RoHS-compliant and halogen-free."
  },
  {
   "topic": "Terminals and polarity",
   "page": 1,
   "text": "Solder-plated terminals, solderable to MIL-STD-750 Method 2026. A line on the body marks the cathode end."
  },
  {
   "topic": "Uses",
   "page": 1,
   "text": "High-frequency rectification and freewheeling in switch-mode converters and inverters, in consumer, computer, automotive and telecom equipment. Listed features: super fast reverse recovery, low switching losses, high efficiency, high forward surge capability."
  },
  {
   "topic": "Current derating",
   "page": 2,
   "text": "The full 5.0 A average forward current holds up to a lead temperature of 100 °C and falls linearly to zero at about 150 °C (Fig.1)."
  }
 ],
