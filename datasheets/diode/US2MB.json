 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "One glass-passivated chip junction per part. Reverse recovery is super fast, switching losses are low, efficiency is high and forward surge capability is high. The package is low profile and suited to automated placement."
  },
  {
   "topic": "Uses",
   "page": 1,
   "text": "Switching power converters and inverters: high-frequency rectifying and freewheeling. Markets: consumer, computer, automotive, telecom."
  },
  {
   "topic": "Polarity and marking",
   "page": 1,
   "text": "The stripe on the body is at the cathode. The marking code is the part number itself, US2AB to US2MB."
  },
  {
   "topic": "Package and soldering",
   "page": 1,
   "text": "Case DO-214AA (SMB). Moulding compound rated UL 94V-0, RoHS compliant, halogen-free. Terminals are solder plated and meet MIL-STD-750 Method 2026 for solderability."
  },
  {
   "topic": "Derating and surge",
   "page": 2,
   "text": "Average forward current stays at 2.0 A up to 100 °C lead temperature and drops linearly to zero near 151 °C. Peak surge current falls from 50 A for one 8.3 ms half-sine cycle to roughly 11 A when repeated over 100 cycles."
  }
 ],
