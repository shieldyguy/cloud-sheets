 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "Glass passivated junction in a DO-214AC (SMA) surface mount body. The mold compound is rated UL 94V-0, and the part is RoHS compliant and halogen free. Moisture sensitivity level 1 to J-STD-020, with a lead-free reflow peak of 260 °C."
  },
  {
   "topic": "Terminals",
   "page": 1,
   "text": "Solder plated, solderable to MIL-STD-750 method 2026."
  },
  {
   "topic": "Polarity and marking",
   "page": 1,
   "text": "A band on the body marks the cathode end. The marking code is the type number, S2A through S2M."
  },
  {
   "topic": "Uses",
   "page": 1,
   "text": "Rectifying and freewheeling diode for power supplies, inverters and converters in consumer and telecom products."
  },
  {
   "topic": "Derating",
   "page": 2,
   "text": "The full 2.0 A average current holds up to a lead temperature of 100 °C and falls linearly to zero at 150 °C."
  }
 ],
