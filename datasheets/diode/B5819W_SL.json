 "operation": [
  {
   "topic": "The three types",
   "page": 1,
   "text": "The B5817W, B5818W and B5819W have the same current, surge, power, thermal and capacitance ratings. They differ in reverse voltage, 20 V, 30 V and 40 V, and in maximum forward voltage, 0.45 V, 0.55 V and 0.6 V at 1 A."
  },
  {
   "topic": "Power derating",
   "page": 2,
   "text": "The B5819W may dissipate 500 mW up to 25 °C ambient; the limit falls linearly to zero at 125 °C."
  },
  {
   "topic": "Leakage and temperature",
   "page": 2,
   "text": "For the B5819W, reverse current rises about tenfold from 25 °C to 75 °C and again from 75 °C to 100 °C, and grows with reverse voltage at each temperature."
  },
  {
   "topic": "Forward drop and temperature",
   "page": 2,
   "text": "Below about 5 A the B5819W's forward drop at 100 °C is lower than at 25 °C; from about 6 A to 9 A the two curves lie together."
  }
 ],
