 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "A metal-semiconductor barrier gives the low forward drop; the barrier metal is chosen to balance forward drop against reverse leakage. A guard ring around the junction protects it against stress. The SOD-123 case is an alternative to the leadless MELF case."
  },
  {
   "topic": "Current rating and temperature",
   "page": 3,
   "text": "In DC the allowed average current is about 0.78 A up to a lead temperature of about 85 °C, crosses 0.5 A near 105 °C and reaches zero at 125 °C. Square-wave current (IPK/IAV = π) starts falling from about 0.56 A; at peak-to-average ratios of 5, 10 and 20 the flat limits are about 0.40, 0.28 and 0.20 A."
  },
  {
   "topic": "Dissipation",
   "page": 3,
   "text": "At TJ = 125 °C, average dissipation at 0.5 A is about 0.13 W in DC and about 0.19 W with a square wave. Higher peak-to-average ratios raise the dissipation at a given average current."
  },
  {
   "topic": "Leakage and capacitance",
   "page": 3,
   "text": "Reverse current rises steeply with temperature: at 20 V it is typically about 20 µA at 25 °C, 0.7 mA at 75 °C and 3.5 mA at 100 °C. Junction capacitance falls from about 180 pF near 0 V to about 32 pF at 20 V."
  },
  {
   "topic": "Thermal resistance",
   "page": 2,
   "text": "The 206 °C/W junction-to-ambient figure is for FR4 with 1 × 0.5 inch of copper under each lead. Junction to lead is 150 °C/W."
  }
 ],
