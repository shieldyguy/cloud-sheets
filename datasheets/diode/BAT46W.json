 "operation": [
  {
   "topic": "Uses",
   "page": 1,
   "text": "Meant for signal paths in low-voltage, high-frequency circuits."
  },
  {
   "topic": "Construction and marking",
   "page": 1,
   "text": "Molded SOD-123 body; the compound is rated UL 94V-0 for flammability and is RoHS compliant and halogen free. Terminals are solder plated and solderable to MIL-STD-750 method 2026. A line across one end of the body marks the cathode, and the top carries the code S9. Moisture sensitivity is MSL 1 under J-STD-020, with a 260 °C lead-free reflow peak."
  },
  {
   "topic": "Derating",
   "page": 2,
   "text": "The 500 mW dissipation rating holds up to 25 °C ambient and falls in a straight line to zero at 125 °C."
  }
 ],
