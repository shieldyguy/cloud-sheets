 "circuits": [
  {
   "id": "trr-test",
   "title": "Reverse recovery time test circuit",
   "page": 5,
   "fixture": true,
   "description": "The diode under test is held in forward conduction by a DC current IF fed into its anode, while a pulse generator with 50 Ω source resistance drives the same node through a coupling capacitor. A negative pulse reverses the diode, and a 50 Ω sampling oscilloscope at the cathode records the current until it has fallen back to IR(meas) = 1 mA; that interval is trr. The pulse rises in 0.6 ns, lasts 100 ns and repeats at a duty cycle of 0.05; the oscilloscope rise time is 0.35 ns.",
   "parts": [
    {
     "ref": "V1",
     "type": "source",
     "value": "pulse generator, V = VR + IF × RS",
     "note": "reverse pulse: tr = 0.6 ns, tp = 100 ns, δ = 0.05"
    },
    {
     "ref": "RS",
     "type": "resistor",
     "value": "50 Ω",
     "note": "generator source resistance"
    },
    {
     "ref": "C1",
     "type": "capacitor",
