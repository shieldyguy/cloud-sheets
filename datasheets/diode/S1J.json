 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "A glass passivated silicon chip junction in the low-profile SMA surface mount package, suited to pick-and-place assembly. Lead free, to EU RoHS 2011/65/EU. Weight about 0.055 g (0.002 oz)."
  },
  {
   "topic": "Terminals",
   "page": 1,
   "text": "Solderable to MIL-STD-750, method 2026."
  },
  {
   "topic": "Marking",
   "page": 3,
   "text": "Each part carries its type number as its marking code, S1A through S1M."
  },
  {
   "topic": "Derating",
   "page": 2,
   "text": "The full 1 A average current holds up to a case temperature of 125 °C and falls linearly to zero at 150 °C (half-wave 60 Hz, resistive or inductive load). A capacitive load takes 20 % off the rated current."
  }
 ],
