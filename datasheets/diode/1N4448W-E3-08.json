 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Ratings and lead temperature",
   "page": 1,
   "text": "The 150 mA average current, the 500 mW dissipation and the 350 K/W junction-to-ambient figure all assume both electrodes sit at ambient temperature. Allowed dissipation stays at 500 mW up to about 28 °C ambient and falls linearly to zero near 172 °C."
  },
  {
   "topic": "Leakage against temperature",
   "page": 3,
   "text": "At VR = 20 V the reverse current plotted against junction temperature is a straight line on a log scale, from about 1.6 nA at 0 °C to about 10 µA at 150 °C. The maximum at Tj = 150 °C is 50 µA."
  },
  {
   "topic": "Pulsed forward current",
   "page": 3,
   "text": "The repetitive peak forward current limit depends on pulse width tp and duty cycle V = tp/T. At tp = 10 µs it is about 14 A for V = 0, 5 A for V = 0.1, 1.8 A for V = 0.2 and 0.67 A for V = 0.5. Toward 1 s the curves converge near 0.48 A; at 10 s the V = 0 limit is about 0.43 A."
  },
  {
   "topic": "Cathode marking and mounting",
   "page": 4,
   "text": "A bar across one end of the top face marks the cathode. The suggested land pattern is two 0.85 mm by 0.85 mm pads with 2.5 mm between their inner edges."
  }
 ],
