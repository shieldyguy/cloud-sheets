 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "A molded plastic body in the JEDEC DO-214AB (SMC) outline with built-in strain relief, for surface mounting and automated placement. The plastic carries the UL 94V-0 flammability classification. RoHS compliant. Weight 0.22 g (0.0077 oz)."
  },
  {
   "topic": "Terminals and soldering",
   "page": 1,
   "text": "Terminals are solderable to MIL-STD-750, method 2026, and withstand 250 °C for 10 s during soldering. Any mounting orientation is allowed."
  },
  {
   "topic": "Polarity",
   "page": 1,
   "text": "A polarity symbol is marked on the body; the band on the outline drawing is at the cathode end."
  },
  {
   "topic": "Derating",
   "page": 2,
   "text": "The full 3.0 A average current holds up to a case temperature of 100 °C and falls linearly to zero at 150 °C (half-wave 60 Hz, resistive or inductive load). A capacitive load takes 20 % off the rated current."
  }
 ],
