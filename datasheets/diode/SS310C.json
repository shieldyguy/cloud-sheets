 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Voltage groups",
   "page": 2,
   "text": "The nine types differ in reverse rating and fall into groups for the other figures. Forward voltage at 3 A has four groups (SS32C-SS34C, SS35C-SS36C, SS38C-SS310C, SS315C-SS320C); reverse current and junction capacitance have two (SS32C-SS36C and SS38C-SS320C). Junction temperature tops out at 125 °C for SS32C-SS34C and 150 °C for SS35C-SS320C."
  },
  {
   "topic": "Current derating",
   "page": 2,
   "text": "The full 3 A average current holds up to a lead temperature of about 96 °C, then falls in a straight line to zero at 150 °C."
  },
  {
   "topic": "Surge",
   "page": 2,
   "text": "80 A is the limit for one 8.3 ms half sine. Over repeated cycles the allowed peak drops, to roughly 35 A at 10 cycles and roughly 11 A at 100 cycles."
  },
  {
   "topic": "Construction",
   "page": 1,
   "text": "The junction has a guard ring for overvoltage protection. The body is marked with the type code and a band at the cathode end."
  }
 ],
