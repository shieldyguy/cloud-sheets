 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Choosing a part",
   "page": 1,
   "text": "The three types share current, surge, capacitance, leakage and thermal ratings and differ in reverse voltage: VRRM and V(BR)R are 20 V, 30 V and 40 V, RMS reverse voltage 14 V, 21 V and 28 V. The lower-voltage types have the lower forward drop."
  },
  {
   "topic": "Power derating",
   "page": 2,
   "text": "Allowed dissipation for the B5819W is 500 mW up to 25 °C ambient and falls in a straight line to zero at 125 °C."
  },
  {
   "topic": "Leakage and temperature",
   "page": 2,
   "text": "Reverse current of the B5819W climbs by roughly a decade from 25 °C to 75 °C and again to 100 °C, and rises with reverse voltage at each temperature. The 1.0 mA and 10.0 mA limits are specified at 20 V reverse bias."
  },
  {
   "topic": "Forward drop and temperature",
   "page": 2,
   "text": "Below a few amperes the B5819W drops less voltage at 100 °C than at 25 °C; near 6 A the two curves meet."
  }
 ],
