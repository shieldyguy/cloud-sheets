 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "Schottky barrier junction with a guard ring for overvoltage protection. The case is moulded in a compound rated UL 94V-0, RoHS-compliant and halogen-free."
  },
  {
   "topic": "Terminals and soldering",
   "page": 1,
   "text": "Solder-plated terminals, solderable to MIL-STD-750 Method 2026. Moisture sensitivity level 1 per J-STD-020, with a lead-free reflow peak of 260 °C."
  },
  {
   "topic": "Polarity",
   "page": 1,
   "text": "A band on the body marks the cathode end."
  },
  {
   "topic": "Derating",
   "page": 2,
   "text": "The full 5.0 A average current holds up to a lead temperature of about 70 °C and falls linearly to zero at 150 °C."
  }
 ],
