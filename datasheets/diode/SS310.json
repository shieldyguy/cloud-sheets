 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Grouping by voltage",
   "page": 2,
   "text": "The nine types share package, current and surge ratings. Forward voltage falls into four groups (SS32-SS34, SS35-SS36, SS38-SS310, SS315-SS320), reverse leakage into two (SS32-SS36 and SS38-SS320), and junction capacitance into two (SS32-SS34 and SS35-SS320). The higher-voltage types have lower leakage and a higher forward drop."
  },
  {
   "topic": "Current derating",
   "page": 2,
   "text": "The full 3.0 A average current holds up to a lead temperature of about 96 °C; above that it falls linearly, reaching zero at 150 °C."
  },
  {
   "topic": "Surge",
   "page": 2,
   "text": "The 80 A surge figure applies to a single 8.3 ms half sine. With repeated cycles the permitted peak falls, to about 34 A at 10 cycles and about 11 A at 100 cycles."
  },
  {
   "topic": "Marking and polarity",
   "page": 1,
   "text": "The top of the body carries the marking code (the part number, e.g. SS310) and a band at the cathode end."
  }
 ],
