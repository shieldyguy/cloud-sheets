 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "A planar Schottky barrier with an integrated guard ring that protects the junction against stress, moulded in a small flat-lead plastic SMD body."
  },
  {
   "topic": "Polarity",
   "page": 2,
   "text": "Pin 1 is the cathode and pin 2 the anode in both packages; a bar on the body marks the cathode end."
  },
  {
   "topic": "Thermal runaway",
   "page": 3,
   "text": "Where reverse power loss PR is a significant fraction of total loss, a Schottky diode is open to thermal runaway."
  },
  {
   "topic": "Cooling",
   "page": 3,
   "text": "Rth(j-sp) is taken to the cathode tab. Enlarging the cathode pad to 1 cm² lowers Rth(j-a) from 330 K/W (CEH) or 350 K/W (CEJ) to 150 K/W, and raises the 25 °C dissipation rating to 830 mW for both."
  },
  {
   "topic": "Soldering",
   "page": 7,
   "text": "Reflow is the only soldering method recommended for either package."
  }
 ],
