 "operation": [
  {
   "topic": "Current derating",
   "page": 2,
   "text": "The full 2.0 A average current is allowed up to a lead temperature of about 113 °C; above that the allowed current falls in a straight line to zero at 150 °C."
  },
  {
   "topic": "Surge",
   "page": 2,
   "text": "The 50 A surge rating applies to a single 8.3 ms half-sine pulse. With repeated pulses the allowed peak falls: about 13 A at 10 cycles and under 8 A at 100 cycles."
  },
  {
   "topic": "Reverse leakage",
   "page": 2,
   "text": "Leakage rises steeply with temperature: at 25 °C it stays near 0.01 mA across the voltage range, while at 100 °C it is a few milliamps and grows with reverse voltage to about 9 mA at the full rating."
  },
  {
   "topic": "Construction",
   "page": 1,
   "text": "A metal-silicon junction with majority-carrier conduction; the part has an ultra-low forward drop, low power loss and high surge capability."
  }
 ],
