 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Grouping by voltage",
   "page": 2,
   "text": "The nine types share package, current and surge ratings. Forward voltage falls into four groups (SS12-SS14, SS15-SS16, SS18-SS110, SS115-SS120), reverse leakage into two (SS12-SS16 and SS18-SS120), and junction capacitance into two (SS12-SS14 and SS15-SS120). The higher-voltage types have lower leakage and a higher forward drop."
  },
  {
   "topic": "Current derating",
   "page": 2,
   "text": "The full 1.0 A average current is available up to a lead temperature of about 103 °C. Above that it falls linearly to zero: at 150 °C for SS12-SS14 and at about 123 °C for SS15-SS120."
  },
  {
   "topic": "Surge",
   "page": 2,
   "text": "The 30 A surge figure applies to a single 8.3 ms half sine. With repeated cycles the permitted peak falls, to about 14 A at 10 cycles and about 7 A at 100 cycles."
  },
  {
   "topic": "Marking and polarity",
   "page": 1,
   "text": "The top of the body carries the marking code (the part number, e.g. SS115) and a band at the cathode end."
  }
 ],
