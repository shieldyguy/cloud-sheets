 "operation": [
  {
   "topic": "Construction and materials",
   "page": 1,
   "text": "The die is a glass-passivated junction. The moulded body is rated UL 94V-0 for flammability and is RoHS-compliant and halogen-free. Leads are solder plated and meet the solderability test of MIL-STD-750, method 2026."
  },
  {
   "topic": "Polarity and marking",
   "page": 1,
   "text": "A band on the body marks the cathode end. Each grade carries its own part number (ES2A to ES2J) as its marking code."
  },
  {
   "topic": "Current derating",
   "page": 2,
   "text": "The full 2.0 A average current holds up to a lead temperature of 135 °C, then falls linearly to zero at 150 °C."
  },
  {
   "topic": "Repeated surges",
   "page": 2,
   "text": "The 50 A surge rating applies to one 8.3 ms half sine. Over a train of such cycles the allowed peak falls, to roughly 27 A at 8 cycles and about 16 A at 100 cycles."
  }
 ],
