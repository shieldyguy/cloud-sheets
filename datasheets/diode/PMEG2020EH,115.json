 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "A planar Schottky barrier die whose built-in guard ring protects it against stress, housed in a small plastic surface-mount body with flat leads."
  },
  {
   "topic": "Uses",
   "page": 1,
   "text": "Named uses: rectifying at low voltages, efficient DC-to-DC converters, switch-mode supplies, protection against reversed polarity, and circuits built for low consumption."
  },
  {
   "topic": "Thermal runaway",
   "page": 3,
   "text": "Reverse leakage rises steeply with temperature (about 45 µA at 25 °C and over 10 mA at 125 °C at 20 V, typical), so reverse power PR can be a large part of the dissipation and thermal runaway has to be checked in the application."
  },
  {
   "topic": "Soldering",
   "page": 7,
   "text": "Reflow is the only soldering method recommended for either package."
  }
 ],
