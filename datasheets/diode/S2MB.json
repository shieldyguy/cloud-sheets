 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "Glass passivated junction in a DO-214AA (SMB) molded body. The molding compound is rated UL 94 V-0 for flammability; the part is RoHS-compliant and halogen-free. A line on the body marks the cathode end; the marking code is the type name (S2AB to S2MB)."
  },
  {
   "topic": "Terminals and soldering",
   "page": 1,
   "text": "Terminals are solder plated and pass the MIL-STD-750 Method 2026 solderability test. Moisture sensitivity is MSL 1 per J-STD-020, with a lead-free reflow peak of 260 °C."
  },
  {
   "topic": "Uses",
   "page": 1,
   "text": "Applications: general purpose rectification and freewheeling in power supplies, inverters and converters; consumer and telecommunication equipment."
  },
  {
   "topic": "Current derating",
   "page": 2,
   "text": "The 2.0 A average current holds up to a lead temperature of 100 °C and falls linearly to zero at about 150 °C (Fig. 1)."
  }
 ],
