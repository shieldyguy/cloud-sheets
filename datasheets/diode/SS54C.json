 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "Schottky barrier junction with a guard ring for overvoltage protection, in an SMC (DO-214AB) molded body. The compound is rated UL 94V-0, RoHS compliant and halogen free. Terminals are solder plated and solderable to MIL-STD-750 method 2026. A band on the body marks the cathode end; the body carries the part number as its marking code."
  },
  {
   "topic": "Moisture sensitivity and reflow",
   "page": 1,
   "text": "MSL 1 to J-STD-020, with a lead-free reflow peak of 260 °C."
  },
  {
   "topic": "Uses",
   "page": 1,
   "text": "Low-voltage, high-frequency inverters, freewheeling, DC/DC converters and polarity protection."
  },
  {
   "topic": "Current derating",
   "page": 2,
   "text": "The 5 A average rating holds up to about 70 °C lead temperature and falls linearly to zero at about 150 °C (Fig.1). Surge capability falls from 120 A for one 8.3 ms half-sine cycle to about 11 A at 100 cycles (Fig.2)."
  }
 ],
