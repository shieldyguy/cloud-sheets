 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Construction",
   "page": 1,
   "text": "Each diode is a glass-passivated chip junction in a low-profile SOD-123FL body suited to automated placement. The mold compound is rated UL 94V-0, and the part is RoHS-compliant and halogen-free."
  },
  {
   "topic": "Terminals and polarity",
   "page": 1,
   "text": "The terminals are solder plated and solderable to MIL-STD-750, Method 2026. A line on the body marks the cathode end. The top of the body carries the marking code F1 to F7 for FR101W to FR107W."
  },
  {
   "topic": "Current derating",
   "page": 2,
   "text": "The full 1.0 A average rating holds up to a lead temperature of 100 °C and falls linearly from there, reaching 0.2 A at about 150 °C."
  },
  {
   "topic": "Recovery time grades",
   "page": 2,
   "text": "The four lower-voltage types (FR101W to FR104W) recover in 150 ns max, FR105W in 250 ns max, and FR106W and FR107W in 500 ns max, all measured at IF = 0.5 A, IR = 1.0 A, recovering to 0.25 A."
  }
 ],
