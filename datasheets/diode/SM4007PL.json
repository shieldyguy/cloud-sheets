 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Choosing a part",
   "page": 1,
   "text": "The seven types differ only in voltage rating: VRRM and VDC step through 50, 100, 200, 400, 600, 800 and 1000 V, with RMS ratings of 35 V to 700 V. Current, surge, forward voltage, leakage, capacitance and thermal figures are shared. Each type carries its own marking code, A1 to A7."
  },
  {
   "topic": "Construction",
   "page": 1,
   "text": "Glass-passivated, metallurgically bonded junction in a molded plastic JEDEC SOD-123FL body. Terminals are solderable to MIL-STD-750 method 2026. A polarity symbol is marked on the body; mounting position is any. Weight 0.015 g (0.00053 oz)."
  },
  {
   "topic": "Soldering",
   "page": 1,
   "text": "Rated for 260 °C for 10 seconds at 0.375 in (9.5 mm) lead length with 5 lb (2.3 kg) tension."
  },
  {
   "topic": "Current derating",
   "page": 2,
   "text": "The full 1.0 A average current holds up to 125 °C case temperature, then falls linearly to zero at 150 °C."
  },
  {
   "topic": "Surge capability",
   "page": 2,
   "text": "The non-repetitive surge curve starts at 30 A for a single 8.3 ms half sine cycle and drops with repeated cycles, to roughly 18 A at 10 cycles and 11 A at 100 cycles."
  },
  {
   "topic": "Leakage and temperature",
   "page": 2,
   "text": "Typical reverse current climbs by roughly three decades from 25 °C to 150 °C junction temperature, and rises gently with reverse voltage at any one temperature."
  }
 ],
