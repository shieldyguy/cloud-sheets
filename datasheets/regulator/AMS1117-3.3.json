 "equations": [
  {
   "name": "Output voltage, adjustable version",
   "expr": "VOUT = VREF × (1 + R2 / R1) + IADJ × R2",
   "where": {
    "VREF": "reference between VOUT and ADJ, 1.25 V",
    "R1": "resistor from VOUT to ADJ",
    "R2": "resistor from ADJ to ground",
    "IADJ": "adjust pin current, 55 µA typical"
   },
   "note": "The IADJ × R2 term is a small, steady error and can usually be left out.",
   "page": 4
  },
  {
   "name": "Effective series resistance with R1 at the load",
   "expr": "R = RP × (R2 + R1) / R1",
   "where": {
    "RP": "parasitic resistance of the line from regulator to load",
    "R1": "upper divider resistor",
    "R2": "lower divider resistor"
   },
   "note": "Applies when the top of R1 goes to the load; with R1 at the case, RP is not multiplied.",
   "page": 4
  },
  {
   "name": "Power dissipation",
   "expr": "PD = (VIN - VOUT) × IOUT",
   "where": {
    "VIN": "input voltage",
    "VOUT": "output voltage",
    "IOUT": "output current"
   },
   "note": "",
   "page": 5
  },
  {
   "name": "Maximum junction temperature",
   "expr": "TJ = TA(MAX) + PD × θJA",
   "where": {
    "TA(MAX)": "highest ambient temperature",
    "PD": "power dissipation",
    "θJA": "junction-to-ambient thermal resistance"
   },
   "note": "TJ must stay at or below 125 °C.",
   "page": 5
  },
  {
   "name": "Output ripple without an adjust-pin capacitor",
   "expr": "ripple gain = VOUT / VREF",
   "where": {
    "VOUT": "output voltage",
    "VREF": "reference voltage, 1.25 V"
   },
   "note": "Without CADJ, output ripple grows in proportion to this ratio.",
   "page": 5
  }
 ],
 "operation": [
  {
   "topic": "Protection",
   "page": 4,
   "text": "Short circuits and thermal overload are handled inside the part. The thermal shutdown trips when the sensed junction reaches 165 °C. Current limit is 900 mA minimum, 1.5 A maximum."
  },
  {
   "topic": "Output capacitor and stability",
   "page": 4,
   "text": "The output capacitor is part of the loop compensation and is required. A 22 µF solid tantalum keeps the part stable under every condition, including any adjust-pin bypass. Bypassing ADJ raises the capacitance the output needs; without that bypass smaller output capacitors work as well. Larger output capacitance further helps stability and transient response."
  },
  {
   "topic": "Protection diodes",
   "page": 4,
   "text": "Neither an ADJ-to-output diode nor an output-to-input one is required: internal resistors limit current at the adjust pin even with a capacitor on it, and an internal diode from output to input survives surges of 50 A to 100 A lasting microseconds. With 1000 µF to 5000 µF on the output and the input shorted to ground instantly, the part can be damaged; an output-to-input diode is recommended when the input has a crowbar circuit."
  },
  {
   "topic": "Setting the output (adjustable version)",
   "page": 4,
   "text": "The part holds 1.25 V between VOUT and ADJ. A resistor R1 across those pins sets a fixed current, which flows down through R2 to ground and so sets the output. That current is usually chosen as the 10 mA minimum load."
  },
  {
   "topic": "Minimum load",
   "page": 3,
   "text": "With 1.5 V to 12 V across the part it stays in regulation when the output draws more than 10 mA (5 mA typical)."
  },
  {
   "topic": "Dropout",
   "page": 3,
   "text": "Dropout is 1.1 V typical and 1.3 V maximum at 0.8 A, falling at lighter loads and rising above 0.8 A."
  },
  {
   "topic": "Load regulation and sensing",
   "page": 4,
   "text": "With only three terminals there is no remote sense, so the resistance of the wire to the load adds to the load regulation error. The load regulation figure is taken at the package. Best results come with R1 tied to the case and R2 returned to the load's negative side, which acts as a Kelvin connection. In the fixed versions the divider top is joined to the output inside the part, so its ground pin doubles as the negative-side sense."
  },
  {
   "topic": "Thermal design",
   "page": 5,
   "text": "Junction to tab is 15 °C/W. Tab to ambient can reach 30 °C/W, and junction to ambient 45 °C/W, on a fair-sized board with at least one copper layer spreading the heat. The spreading copper need not be electrically joined to the tab: heat crosses the board material to an inner or back-side plane well. Heat from nearby parts adds to an SOT-223's temperature. The junction must stay at or below 125 °C in continuous operation."
  },
  {
   "topic": "Ripple rejection and the adjust capacitor",
   "page": 5,
   "text": "Ripple rejection figures are taken with ADJ bypassed. For full rejection, the capacitor's impedance at the ripple frequency should be below R1, typically 100 Ω to 200 Ω. With R1 = 100 Ω that means more than 13 µF at 120 Hz, and 0.16 µF at 10 kHz."
  },
  {
   "topic": "Compatibility",
   "page": 4,
   "text": "The AMS1117 fits the pinout of earlier three-pin adjustable and SCSI regulators, with lower dropout, a tighter reference tolerance and better reference stability over temperature."
  }
 ],
