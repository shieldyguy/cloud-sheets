{
 "sheet": 1,
 "name": "WS2812B-2020-V6",
 "kind": "led",
 "manufacturer": "Worldsemi",
 "title": "WS2812B-2020-V6: addressable RGB LED with built-in driver in a 2.2 × 2.0 mm package",
 "source": {
  "revision": "V1.4, July 28, 2026",
  "pages": 10
 },
 "summary": "A 2020-size surface-mount RGB LED with its control chip moulded into the same body, so each part is one individually addressable full-colour light point. A single serial data wire carries 24 bits per device (8 bits each of green, red and blue, 256 levels per colour); each device keeps its own 24 bits and sends the rest on, reshaped, from DO to the next one in the chain. The driver and the LEDs share one supply, each colour channel runs at a constant 12 mA, the outputs are scanned at 2 kHz, the part survives a reversed supply, and it draws under 1 µA when idle. It runs from 5 V and also from 3.3 V.",
 "key_figures": [
  [
   "Supply voltage VDD (maximum rated range)",
   "+3.3 to +5.3 V"
  ],
  [
   "Channel current",
   "12 mA per colour"
  ],
  [
   "Data rate",
   "up to 800 Kbps; FMAX 600 Kbps min at 50% duty cycle"
  ],
  [
   "Grey levels",
   "256 per colour, 16,777,216 colours"
  ],
  [
   "Output scan frequency",
   "2 kHz"
  ],
  [
   "Reset (frame latch) time",
   "280 µs or more, low"
  ],
  [
   "Chain length",
   "at least 1,024 devices at 30 frames per second"
  ],
  [
   "Quiescent current",
   "1 µA max, no data, all channels off"
  ],
  [
   "Luminous intensity at 12 mA",
   "R 340, G 850, B 260 mcd typ"
  ],
  [
   "Dominant wavelength at 12 mA",
   "R 615-625, G 515-525, B 465-475 nm"
  ],
