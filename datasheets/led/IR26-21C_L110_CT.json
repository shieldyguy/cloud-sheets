 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Current limiting",
   "page": 6,
   "text": "The forward current climbs steeply for a small rise in forward voltage, so the LED needs a series resistor; without one a small shift in supply can destroy it."
  },
  {
   "topic": "Derating",
   "page": 4,
   "text": "Continuous forward current is 65 mA up to about 25 °C ambient and falls linearly to about 10 mA near 85 °C."
  },
  {
   "topic": "Polarity and mounting",
   "page": 2,
   "text": "Terminal 1 is the anode and terminal 2 the cathode, which carries the cathode mark. The lens faces sideways; the proposed reflow mounting puts the part on the underside of the board with the lens through a 2.5 mm hole, the two pads either side of it."
  },
  {
   "topic": "Soldering",
   "page": 6,
   "text": "Reflow no more than twice. Keep mechanical stress off the part while it is hot, and do not bend the board after soldering. By hand, solder one terminal at a time with a pause between them; damage to the part often begins during hand soldering."
  },
  {
   "topic": "Repair",
   "page": 7,
   "text": "Rework after soldering is to be avoided. Where it cannot be, use a twin-tip iron that heats both terminals together, and check first that the part's characteristics survive it."
  },
  {
   "topic": "Labelling",
   "page": 9,
   "text": "The reel label carries the customer and maker part numbers, lot number, quantity, HUE (peak wavelength), CAT (rank), REF (reference), MSL level and country of manufacture."
  }
 ],
