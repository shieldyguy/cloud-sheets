 "circuits": [
  {
   "id": "chain",
   "title": "Application circuit: three LEDs in a chain",
   "page": 9,
   "description": "Three LEDs share a 5 V rail and ground. The controller's data enters through R1 into the first DIN; each DOUT feeds the next DIN, and the last DOUT leaves through R2. The two series resistors guard the data pins against the surge of plugging or unplugging a powered string. Each LED has its own decoupling capacitor from VDD to ground, needed for the chips to work reliably together.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "SK6812MINI-E"
    },
    {
     "ref": "U2",
