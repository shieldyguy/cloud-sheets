{
 "sheet": 1,
 "name": "HDC1080DMBR",
 "kind": "sensor",
 "manufacturer": "Texas Instruments",
 "title": "HDC1080: digital relative-humidity and temperature sensor, I2C, 3 mm x 3 mm 6-pin WSON",
 "source": {
  "document": "SNAS672A",
  "revision": "November 2015, revised January 2016",
  "pages": 29
 },
 "summary": "A factory-calibrated relative-humidity sensor with an on-chip temperature sensor, read over I2C at the fixed 7-bit address 1000000. Humidity converts at 8, 11 or 14 bits and temperature at 11 or 14 bits; between conversions the part sleeps at about 100 nA, so one humidity-plus-temperature reading a second averages 1.3 µA. It runs from 2.7 V to 5.5 V, carries a resistive heater for driving off condensation, a low-supply flag and a 40-bit serial number. The sensing area is a window in the top of the package.",
 "key_figures": [
  [
   "RH accuracy",
   "±2 %RH typ"
  ],
  [
   "Temperature accuracy",
   "±0.2 °C typ, ±0.4 °C max (5 °C < TA < 60 °C)"
  ],
  [
   "Resolution",
   "RH 8, 11 or 14 bit; temperature 11 or 14 bit"
  ],
  [
   "Supply voltage",
   "2.7 V to 5.5 V"
  ],
  [
   "Sleep current",
   "100 nA typ, 200 nA max"
  ],
  [
   "Average current",
   "710 nA (RH, 11 bit, 1 sample/s); 1.3 µA (RH + temperature, 11 bit, 1 sample/s)"
  ],
  [
   "Active current",
   "190 µA typ during an RH conversion"
  ],
  [
   "RH response time",
   "15 s (t63%)"
  ],
  [
   "Interface",
   "I2C, 10 kHz to 400 kHz, address 1000000"
  ],
  [
   "Package",
   "6-pin WSON (DMB), 3.00 mm x 3.00 mm, 0.8 mm max height"
  ]
