{
 "sheet": 1,
 "name": "LIS2DHTR",
 "kind": "sensor",
 "manufacturer": "STMicroelectronics",
 "title": "LIS2DH: 3-axis MEMS accelerometer, ±2/±4/±8/±16 g, I2C/SPI, 32-level FIFO, LGA-14 2 x 2 x 1 mm",
 "source": {
  "document": "Doc ID 022516",
  "revision": "Rev 1, November 2011",
  "pages": 49
 },
 "summary": "A three-axis linear accelerometer with a digital I2C or SPI port, built as a capacitive MEMS element read by a charge amplifier and an A/D converter. Full scale is set by register to ±2, ±4, ±8 or ±16 g, and the output data rate runs from 1 Hz to 5.376 kHz. Three resolutions trade current for noise: 8-bit low-power, 10-bit normal and 12-bit high-resolution, with 2 µA at 1 Hz. Two programmable interrupt generators handle free-fall, wake-up, 6D/4D orientation and single or double click; a 32-level FIFO, a self-test and an 8-bit temperature output are on chip. The core runs from 1.71 V to 3.6 V with a separate I/O supply, over -40 °C to +85 °C.",
 "key_figures": [
  [
   "Full scale",
   "±2, ±4, ±8, ±16 g"
  ],
  [
   "Sensitivity",
   "1 mg/digit (±2 g, high resolution) to 192 mg/digit (±16 g, low power)"
  ],
  [
   "Zero-g offset",
   "±40 mg typ (±2 g)"
  ],
  [
   "Output data rate",
   "1 Hz to 1.344 kHz (HR/normal); up to 5.376 kHz (low power)"
  ],
  [
   "Supply",
   "Vdd 1.71 V to 3.6 V; Vdd_IO 1.71 V to Vdd+0.1"
  ],
  [
   "Current",
   "11 µA typ normal mode 50 Hz; 2 µA at 1 Hz; 6 µA low power 50 Hz; 0.5 µA power-down"
  ],
  [
   "Interfaces",
   "I2C to 400 kHz; SPI to 10 MHz, 3- or 4-wire"
  ],
  [
   "FIFO",
   "32 levels per axis"
  ],
  [
   "Shock survival",
   "10000 g for 0.1 ms"
  ],
  [
   "Operating temperature",
   "-40 °C to +85 °C"
  ]
 ],
