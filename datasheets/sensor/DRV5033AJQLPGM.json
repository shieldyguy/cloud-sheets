{
 "sheet": 1,
 "name": "DRV5033AJQLPGM",
 "kind": "sensor",
 "manufacturer": "Texas Instruments",
 "title": "DRV5033: omnipolar digital Hall-effect switch with open-drain output",
 "source": {
  "document": "SLIS152G",
  "revision": "Revised September 2016",
  "pages": 33
 },
 "summary": "The DRV5033 is a chopper-stabilized Hall-effect switch that reacts to either magnetic pole: its open-drain NMOS output pulls low once the field magnitude exceeds BOP and lets go when it falls below BRP. It runs from 2.5 to 38 V with no external regulator, withstands 40 V load dump and -22 V reverse supply, sinks up to 30 mA with a current limit, and is valid 35 µs after power-up. Two sensitivity grades exist (AJ: ±6.9 / ±3.5 mT typ, FA: ±3.5 / ±2 mT typ) in SOT-23 (DBZ) and TO-92 (LPG). The DRV5033AJQLPGM is the AJ grade in the through-hole TO-92 for -40 to 125 °C, 3000 pieces in an ammo box.",
 "key_figures": [
  [
   "Supply voltage",
   "2.5 to 38 V; 40 V abs max; -22 V reverse"
  ],
  [
   "Supply current",
   "2.7 mA typ at 25 °C; 3.6 mA max at 125 °C"
  ],
  [
   "AJ BOP / BRP",
   "±6.9 / ±3.5 mT typ (BOP ±3 to ±12 mT, BRP ±1 to ±5 mT)"
  ],
  [
   "FA BOP / BRP",
   "±3.5 / ±2 mT typ (BOP ±1.8 to ±6.8 mT, BRP ±0.5 to ±4.2 mT)"
  ],
  [
   "Output",
   "open drain, 30 mA sink, 22 Ω typ on-resistance at 25 °C"
  ],
  [
   "Overcurrent limit",
   "15 / 30 / 45 mA min / typ / max"
  ],
  [
   "Power-on time",
   "35 µs typ; 50 µs max (AJ), 70 µs max (FA)"
  ],
  [
