 "circuits": [
  {
   "id": "standard",
   "title": "Standard circuit",
   "page": 16,
   "description": "The basic hookup. VCC feeds pin VCC with C1 across to ground right at the part. R1 pulls the open-drain OUT up to the supply, so OUT reads high with no field and low while a field of either polarity is stronger than BOP. C2 from OUT to ground is fitted only when the output needs low-pass filtering; with R1 = 10 kΩ and C2 = 680 pF the corner sits at 23.4 kHz, enough for a 10 kHz system bandwidth.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "DRV5033"
    },
    {
     "ref": "R1",
     "type": "resistor",
     "value": "10 kΩ",
     "note": "output pull-up"
    },
    {
     "ref": "C1",
     "type": "capacitor",
     "value": "0.01 µF",
     "note": "minimum; ceramic, rated for VCC"
    },
    {
     "ref": "C2",
     "type": "capacitor",
     "value": "680 pF",
     "note": "optional output filter"
    },
    {
     "ref": "VCC",
     "type": "terminal",
     "value": "VCC",
     "note": "supply"
    },
    {
     "ref": "OUT",
     "type": "terminal",
     "value": "OUT",
     "note": "switch output"
    }
   ],
   "notes": []
  },
  {
   "id": "two-wire",
   "title": "Two-wire application",
   "page": 18,
   "description": "Only two wires run to the sensor. R1 ties OUT to VCC, so when the output switches on it draws VCC / (R1 + rDS(on)) on top of the supply current. The sensor's GND return passes through a current sense stage at the controller end, which reads about 3 mA with the field below BRP and about 15 mA with it above BOP at 12 V and 1 kΩ. C1 decouples the supply at the sensor.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "DRV5033"
    },
    {
     "ref": "R1",
     "type": "resistor",
     "value": "1 kΩ",
     "note": "OUT to VCC load"
    },
    {
     "ref": "C1",
     "type": "capacitor",
     "value": "0.1 µF",
     "note": "bypass; larger with long or inductive supply wiring"
    },
    {
     "ref": "V1",
     "type": "source",
     "value": "12 V",
     "note": "supply, negative side to ground"
    },
    {
     "ref": "SENSE",
     "type": "terminal",
     "value": "Current sense",
     "note": "to the current sense stage (shunt or other circuit) that returns to ground and reports to the controller"
    }
   ],
   "notes": []
  }
 ],
 "equations": [
  {
   "name": "Pull-up resistor range",
   "expr": "Vref max / 30 mA ≤ R1 ≤ Vref min / 100 µA",
   "where": {
    "R1": "pull-up resistor from OUT to Vref",
    "Vref": "voltage R1 is tied to; VCC or another rail within the OUT pin rating"
   },
   "note": "R1 must also be above 500 Ω for OUT to reach close to GND. A smaller R1 gives faster edges and more bandwidth; a larger one draws less current while OUT is low.",
   "page": 13
  },
  {
   "name": "Output filter capacitor",
   "expr": "2 × ƒBW (Hz) < 1 / (2π × R1 × C2)",
   "where": {
    "ƒBW": "system bandwidth",
    "R1": "pull-up resistor",
    "C2": "capacitor from OUT to GND"
   },
   "note": "Most designs leave C2 out.",
   "page": 14
  },
  {
   "name": "Pull-up range, 3.3 V example",
   "expr": "3.4 V / 30 mA ≤ R1 ≤ 3.2 V / 100 µA, so 113 Ω ≤ R1 ≤ 32 kΩ",
   "where": {
    "R1": "pull-up resistor; chosen between 500 Ω and 32 kΩ"
   },
   "note": "For 10 kHz bandwidth, R1 = 10 kΩ allows any C2 below 820 pF; 680 pF puts the corner at 23.4 kHz.",
   "page": 17
  },
  {
   "name": "Hysteresis",
   "expr": "Bhys = BOP – BRP",
   "where": {
    "BOP": "operate point",
    "BRP": "release point"
   },
   "note": "",
   "page": 6
  },
  {
   "name": "Magnetic offset",
   "expr": "BO = (BOP + BRP) / 2",
   "where": {
    "BOP": "operate point",
    "BRP": "release point"
   },
   "note": "",
   "page": 6
  },
  {
   "name": "Two-wire supply current with the output on",
   "expr": "I = ICC + VCC / (R1 + rDS(on))",
   "where": {
    "ICC": "sensor supply current, about 3 mA",
    "R1": "resistor from OUT to VCC",
    "rDS(on)": "output FET on-resistance"
   },
   "note": "At 12 V and 1 kΩ the added path carries about 12 mA, about 15 mA in total.",
   "page": 18
  }
 ],
 "operation": [
  {
   "topic": "Switching",
   "page": 9,
   "text": "The output responds to field magnitude, not sign: a south or a north field stronger than BOP turns the NMOS on and pulls OUT low, and the output turns off again once the field falls below BRP. The gap between the two points is the hysteresis that keeps field noise from toggling the output."
  },
  {
   "topic": "Field polarity",
   "page": 10,
   "text": "A south pole facing the marked side of the package counts as a positive field; a north pole facing the marked side counts as negative."
  },
  {
   "topic": "Supply range",
   "page": 9,
   "text": "The part works from 2.5 to 38 V and stands up to -22 V reverse supply indefinitely. Between about -22 V and 2.4 V it does not operate. Transients up to 40 V are tolerated."
  },
  {
   "topic": "Power-on",
   "page": 11,
   "text": "After VCC is applied OUT stays high-impedance for ton, then gives one pulse marking the end of power-up; a host can use that pulse to know the output is valid. With the field above BOP the output then sits low; below BRP it stays released. If the field is between BRP and BOP at power-up the output state is undefined (Hi-Z or low) until the field crosses one of the thresholds, after which it follows within td."
  },
  {
   "topic": "Output stage",
   "page": 13,
   "text": "OUT is an open-drain NMOS rated for 30 mA sink. The pull-up may go to VCC or to a separate rail within the OUT pin's absolute maximum rating. Choosing R1 trades rise time against the current drawn while OUT is low."
  },
  {
   "topic": "Overcurrent protection",
   "page": 15,
   "text": "An analog limit clamps the output FET current at IOCP; while it is clamping, the FET's on-resistance rises above its normal value. It recovers once the load current drops below IOCP."
  },
  {
   "topic": "Load dump",
   "page": 15,
   "text": "Normal operation extends to 38 V DC, and the part rides through VCC up to 40 V without a series current-limiting resistor."
  },
  {
   "topic": "Reverse supply",
   "page": 15,
   "text": "With VCC and GND swapped, up to -22 V, the part is disabled and survives; current flowing backwards out of OUT must stay inside its absolute maximum rating. It operates again once VCC reaches 2.5 V."
  },
  {
   "topic": "Functional modes",
   "page": 15,
   "text": "The part runs only while VCC lies between 2.5 and 38 V; under reverse supply it is off."
  },
  {
   "topic": "Supply decoupling",
   "page": 18,
   "text": "A ceramic capacitor of at least 0.01 µF, rated for VCC, goes as close to the part as possible."
  },
  {
   "topic": "Layout",
   "page": 19,
   "text": "Keep the bypass capacitor next to the sensor to keep supply inductance low. Put the pull-up resistor near the microcontroller input, or use the GPIO's internal pull-up instead. Copper planes under the sensor do not affect the field, copper not being ferromagnetic; nearby parts containing iron or nickel can bend the flux unpredictably."
  },
  {
   "topic": "Hall element position",
   "page": 20,
   "text": "The sensing element is at the centre of the package within ±100 µm. Its height above the package bottom is 0.7 mm ±50 µm in DBZ and 0.987 mm ±50 µm in LPG."
  }
 ],
