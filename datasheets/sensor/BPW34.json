 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Spectral response",
   "page": 3,
   "text": "Response climbs from about 400 nm to a broad peak near 900 to 950 nm and then drops steeply, falling to roughly a seventh of the peak by 1100 nm. The λ0.1 range, where response is at least a tenth of the peak, is 430 to 1100 nm."
  },
  {
   "topic": "Light to current",
   "page": 3,
   "text": "With 5 V reverse bias the reverse light current is close to proportional to light level, from 0.01 to about 2 mW/cm² of irradiance and from 10 lx to about 8 klx of illuminance. At a fixed irradiance the current changes little with reverse voltage: from 0.1 V to about 50 V it rises by roughly 5 to 15 %."
  },
  {
   "topic": "Bias, capacitance and speed",
   "page": 3,
   "text": "Junction capacitance is 70 pF typ with no bias and falls with reverse voltage: about 25 pF at 3 V and under 10 pF at 30 V. Rise and fall times of 100 ns are given at 10 V reverse bias into a 1 kΩ load with 820 nm light."
  },
  {
   "topic": "Temperature",
   "page": 2,
   "text": "Dark current grows roughly tenfold for every 25 °C: from 2 nA at 25 °C to several hundred nA near 95 °C at 10 V. Light current is nearly flat with temperature, about 3 % low at 0 °C and 7 % high at 100 °C against 25 °C. Open-circuit voltage falls by 2.6 mV/K and short-circuit current rises by 0.1 %/K."
  },
  {
   "topic": "Angular response",
   "page": 3,
   "text": "Sensitivity is flat within a few percent out to about ±20° from the axis normal to the top face and halves at ±65°."
  },
  {
   "topic": "Soldering and mounting",
   "page": 1,
   "text": "The leads may be soldered at 260 °C for up to 3 s. The 350 K/W junction-to-ambient figure applies with the leads connected by copper wire of 0.14 mm² cross-section."
  }
 ],
