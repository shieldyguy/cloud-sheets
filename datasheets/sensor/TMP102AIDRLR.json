 "equations": [
  {
   "name": "Temperature from a register code",
   "expr": "T = N × 0.0625 °C",
   "where": {
    "T": "temperature, °C",
    "N": "the left-justified 12-bit code (13-bit in extended mode) read as a signed two's-complement integer: for a negative reading, invert the bits, add one and negate"
   },
   "note": "Example: 0011 0010 0000 (320h) = 800 counts = 50 °C; 1110 0111 0000 (E70h) = -400 counts = -25 °C.",
   "page": 9
  },
  {
   "name": "Register code from a temperature",
   "expr": "N = T / 0.0625 °C",
   "where": {
    "N": "counts; a positive result is written in binary with a leading 0, a negative one as the two's complement of |N| with a leading 1",
