{
 "sheet": 1,
 "name": "TMP102AIDRLR",
 "kind": "sensor",
 "manufacturer": "Texas Instruments",
 "title": "TMP102 digital temperature sensor, 12-bit, I2C/SMBus, 1.4 V to 3.6 V, SOT563",
 "source": {
  "document": "SBOS397I",
  "revision": "August 2007, revised June 2024",
  "pages": 33
 },
 "summary": "A local temperature sensor in a 1.6 mm × 1.6 mm six-lead SOT563 that reports its own die temperature over a two-wire bus compatible with I2C and SMBus. A 12-bit converter gives 0.0625 °C per count; error is ±2 °C at most from -25 °C to 85 °C and ±3 °C at most from -40 °C to 125 °C, with no calibration. It runs from 1.4 V to 3.6 V on 7.5 µA at most averaged at its default four conversions per second, and 0.35 µA at most in shutdown. One address pin chooses among four addresses, and an open-drain ALERT output trips on programmable high and low limits, as a comparator or an SMBus interrupt.",
 "key_figures": [
  [
   "Accuracy",
   "±0.5 °C typ, ±2 °C max (-25 °C to 85 °C); ±1 °C typ, ±3 °C max (-40 °C to 125 °C)"
  ],
  [
   "Resolution",
   "12 bit, 0.0625 °C; 13-bit extended mode to 150 °C"
  ],
  [
   "Supply",
   "1.4 V to 3.6 V, 3.3 V nominal"
  ],
  [
   "Average quiescent current",
   "4.8 µA typ, 7.5 µA max at 4 conversions/s, bus idle"
  ],
  [
   "Shutdown current",
   "0.15 µA typ, 0.35 µA max, bus idle"
  ],
  [
   "Conversion time",
   "10 ms typ, 15 ms max"
  ],
  [
   "Conversion rate",
   "0.25, 1, 4 (default) or 8 per second"
  ],
  [
   "Bus",
   "fast mode to 400 kHz, high-speed mode to 2.85 MHz; four addresses"
  ],
  [
   "Specified range",
   "-40 °C to 125 °C (operates -55 °C to 150 °C)"
  ],
  [
   "Package",
   "SOT563 (DRL), 6 pins, 1.6 mm × 1.6 mm, 0.6 mm max height"
  ]
 ],
