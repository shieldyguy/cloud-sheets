{
 "sheet": 1,
 "name": "GP2S700HCP",
 "kind": "sensor",
 "manufacturer": "Sharp",
 "title": "Compact surface-mount reflective photointerrupter, phototransistor output, 3 mm sensing distance",
 "source": {
  "document": "Sheet No. D3-A02201EN-A",
  "pages": 13
 },
 "summary": "An infrared LED and a silicon phototransistor side by side in one black epoxy body of 4 × 3 × 2 mm, both looking up, so an object above the part reflects the LED's light back into the transistor. Output is greatest with the reflector about 3 mm away. The resin blocks visible light. The body is leadless with gold-plated terminals, for reflow, and ships 1 000 to a reel; uses named for it are sensing whether an object is present or moving, as in printers and optical drives.",
 "key_figures": [
  [
   "Sensing distance at peak output",
   "3 mm"
  ],
  [
   "Collector current IC",
   "60 to 410 µA at IF = 4 mA, VCE = 2 V, d = 4 mm"
  ],
  [
   "Leak current with no reflector",
   "700 nA max at IF = 4 mA, VCE = 2 V"
  ],
  [
   "Forward voltage VF",
   "1.2 V typ, 1.4 V max at IF = 20 mA"
  ],
  [
   "Response time tr, tf",
   "20 µs typ, 100 µs max at RL = 1 kΩ"
  ],
  [
   "Forward current IF",
   "50 mA max"
  ],
  [
   "Collector-emitter voltage VCEO",
   "35 V max"
  ],
  [
   "Peak wavelengths",
   "LED 950 nm; detector sensitivity peak 930 nm"
  ],
  [
   "Package",
   "4 × 3 × 2 mm leadless SMT, 0.01 g"
  ],
  [
   "Operating temperature",
   "-25 to +85 °C"
  ]
