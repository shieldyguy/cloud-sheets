 "title": "MCP9501/2/3/4: factory-set temperature switches with pin-selected hysteresis, SOT-23-5",
 "source": {
  "document": "DS20002268B",
  "revision": "Revision B, July 2016",
  "pages": 22
 },
 "summary": "A family of fixed-threshold temperature switches in a 5-lead SOT-23. Each holds a sensing diode, a trimmed resistor network and a comparator; the network sets one threshold between -35°C and +125°C in 10°C steps; the output changes state when the die crosses it, with 2°C or 10°C typical hysteresis picked by one pin. MCP9501/2 trip on rising temperature and MCP9503/4 on falling; MCP9501/3 have an active-low open-drain output and MCP9502/4 an active-high push-pull one. MCP9501PT-105E/OT is the open-drain, active-low, +105°C rising-temperature part on tape and reel.",
 "key_figures": [
  [
   "Thresholds",
   "-35°C to +125°C in 10°C steps, set at the factory"
  ],
  [
   "Threshold accuracy",
   "±1°C typ; ±4°C max (-15°C to +75°C), ±6°C max (-40°C to +125°C)"
  ],
  [
   "Hysteresis",
   "+2°C (HYST = GND) or +10°C (HYST = VDD), typical"
  ],
  [
   "Supply voltage",
   "2.7 V to 5.5 V"
  ],
  [
   "Supply current",
