 "equations": [
  {
   "name": "Lux from the count",
   "expr": "Ecal = α × DATA",
   "where": {
    "Ecal": "computed illuminance, lux",
    "α": "lux per count, set by range and ADC full scale (EQ. 2)",
    "DATA": "ADC output code from registers 0x02 and 0x03"
   },
   "note": "α does not depend on the light source (fluorescent, incandescent or sunlight), since the IR part of the light is removed in the light signal processing. It is also the smallest lux step the part resolves.",
   "page": 13
  },
  {
   "name": "Lux per count",
   "expr": "α = Range / Countmax",
   "where": {
    "Range": "full-scale lux range from the range bits: 1,000, 4,000, 16,000 or 64,000",
    "Countmax": "largest count the ADC can output"
   },
   "note": "",
   "page": 13
  },
  {
   "name": "Lux for an n-bit ADC",
   "expr": "Ecal = (Range / 2^n) × DATA",
   "where": {
    "n": "ADC resolution set in COMMAND-II: 4, 8, 12 or 16",
    "2^n": "largest number of counts at that resolution",
    "Range": "full-scale lux range",
    "DATA": "ADC output code"
   },
   "note": "",
   "page": 14
  },
  {
   "name": "IR count",
   "expr": "DATAIR = β × EIR",
   "where": {
    "DATAIR": "ADC output code in IR sensing",
    "EIR": "received IR intensity",
    "β": "proportionality constant"
   },
   "note": "",
   "page": 14
  },
  {
   "name": "EV accuracy",
   "expr": "EVAccuracy = K × DATAEV + β × DATAIR",
   "where": {
    "DATAEV": "ADC code for the received ambient light",
    "K": "visible-light resolution, lux/count; typical 0.82",
    "DATAIR": "ADC code for the received IR",
    "β": "constant that varies with the background IR spectrum (A, F2, D65) and with ADC range and resolution; typical -11292.86 for Range1 and Range2 and 2137.14 for Range3 and Range4, without IR-tinted glass"
   },
   "note": "Combining the IR channel with the visible reading reduces the spread of readings between light sources of different IR content.",
   "page": 14
  }
