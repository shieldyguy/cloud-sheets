{
 "sheet": 1,
 "name": "ISL29035IROZ-T7",
 "kind": "sensor",
 "manufacturer": "Renesas",
 "title": "ISL29035 digital ambient light sensor with interrupt, I2C, 6-lead ODFN",
 "source": {
  "document": "FN8371",
  "revision": "Rev 3.00, December 12, 2016",
  "pages": 17
 },
 "summary": "A light-to-digital converter that reads visible light with a response close to the eye's, and can also read infrared, over an I2C (SMBus compatible) bus at a fixed 7-bit address. A charge-balancing integrating ADC of 4 to 16 bits gives the count; four full-scale ranges from 1,000 to 64,000 lux set the counts per lux, and the 105 ms 16-bit conversion cancels 50 Hz and 60 Hz lamp flicker. An open-drain active-low INT pin flags readings outside a programmable window after 1, 4, 8 or 16 out-of-window conversions.",
 "key_figures": [
