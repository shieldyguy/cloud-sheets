   "Supply current",
   "57 µA typ, 85 µA max"
  ],
  [
   "Powered-down current",
   "0.24 µA typ, 0.51 µA max"
  ],
  [
   "ADC resolution",
   "16-bit (4, 8, 12 or 16 selectable)"
  ],
  [
   "Full-scale ranges",
   "1,000 / 4,000 / 16,000 / 64,000 lux"
  ],
  [
   "Dynamic range",
   "1:4,200,000"
  ],
  [
   "Conversion time",
   "105 ms at 16 bits, down to 0.0256 ms at 4 bits"
  ],
