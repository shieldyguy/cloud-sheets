   "20 µs / 20 µs typ (VCE = 2 V, IC = 100 µA, RL = 1 kΩ)"
  ],
  [
   "Operating temperature",
   "-25 °C to +85 °C"
  ],
  [
   "Body",
   "2.7 × 3.4 mm, 1.5 mm high; 4.6 mm across the leads"
  ]
 ],
