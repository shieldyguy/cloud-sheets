{
 "sheet": 1,
 "name": "ITR8307_S18_TR8(B)",
 "kind": "sensor",
 "manufacturer": "Everlight",
 "title": "ITR8307/S18/TR8 reflective opto interrupter: 940 nm GaAs infrared LED beside a silicon NPN phototransistor, 4-lead SMD",
 "source": {
  "document": "DRX-0000321",
  "revision": "Rev.4, Nov 14, 2017",
  "pages": 8
 },
 "summary": "A reflective optical switch for short sensing distances. A GaAs infrared LED peaking at 940 nm and a high-sensitivity silicon NPN phototransistor face the same way from one small plastic surface-mount body, so light from the LED that bounces off a nearby surface turns the transistor on. With 20 mA in the LED and 5 V across the transistor, the collector carries 0.3 mA to 0.8 mA, sorted into bins B (300 to 600 µA) and C (500 to 800 µA). Rise and fall times are 20 µs typical. Named uses are cameras, VCRs, floppy disk drives, cassette recorders and microcomputer-controlled equipment.",
 "key_figures": [
  [
   "Light current IC(ON)",
   "0.3 mA min, 0.8 mA max (VCE = 5 V, IF = 20 mA)"
  ],
  [
   "Bins",
   "B: 300 to 600 µA; C: 500 to 800 µA"
  ],
  [
   "Peak wavelength",
   "940 nm typ"
  ],
  [
   "LED forward voltage",
   "1.2 V typ, 1.6 V max at 20 mA"
  ],
  [
   "LED forward current",
   "50 mA max; 1 A peak (100 µs, 10 ms period)"
  ],
  [
   "Collector-emitter voltage",
   "30 V max"
  ],
  [
