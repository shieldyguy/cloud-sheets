{
 "sheet": 1,
 "name": "QRE1113GR",
 "kind": "sensor",
 "manufacturer": "onsemi",
 "title": "QRE1113, QRE1113GR, QRE1114GR: miniature reflective object sensors, infrared LED and phototransistor",
 "source": {
  "document": "QRE1113/D",
  "revision": "Rev. 9, December 2024",
  "pages": 9
 },
 "summary": "A small reflective optical sensor: a 940 nm infrared emitting diode and a phototransistor face the same direction side by side in one housing, so the transistor conducts when a surface close in front sends the LED's light back. It senses an object without touching it. QRE1113 has straight through-hole leads and ships in tubes; QRE1113GR and QRE1114GR have gull-wing leads for surface mount and ship on tape and reel. QRE1114GR is the grade with a bounded on-state current, 0.30 to 0.60 mA.",
 "key_figures": [
