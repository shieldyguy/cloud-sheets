 "circuits": [
  {
   "id": "stereo",
   "title": "Stereo pair on one I²S bus",
   "page": 13,
   "description": "Two microphones share the bit clock, word select and data line of one I²S master (a DSP, microcontroller or codec). The left microphone has LR grounded and drives the first half of each frame; the right one has LR tied to VDD and drives the second half, so the two take turns on SD. Each has its own 0.1 µF decoupling capacitor from VDD to ground, the supply coming from a 1.8 V to 3.3 V regulator. A 100 kΩ resistor pulls SD to ground to drain the line while neither microphone is driving it.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "ICS-43434",
     "note": "left channel"
    },
    {
     "ref": "U2",
     "type": "ic",
     "value": "ICS-43434",
     "note": "right channel"
    },
    {
     "ref": "U3",
     "type": "ic",
     "value": "System master (DSP, microcontroller, codec)",
     "external": true
    },
    {
     "ref": "C1",
     "type": "capacitor",
     "value": "0.1 µF"
    },
    {
     "ref": "C2",
     "type": "capacitor",
     "value": "0.1 µF"
    },
    {
     "ref": "R1",
     "type": "resistor",
     "value": "100 kΩ"
    },
    {
     "ref": "J1",
     "type": "terminal",
     "value": "VDD, 1.8 V to 3.3 V from a regulator"
    }
   ],
   "notes": [
    "Where SD must discharge faster than 100 kΩ allows, a lower value, 10 kΩ for example, is acceptable."
   ]
  }
 ],
 "equations": [
  {
   "name": "Bit clock",
   "expr": "fSCK = 64 × fS",
   "where": {
    "fSCK": "SCK frequency",
    "fS": "sample rate, the WS frequency"
   },
   "note": "Each WS stereo frame holds 64 SCK cycles.",
   "page": 12
  },
  {
   "name": "Filter pass band",
   "expr": "fPASS = 0.417 × fS",
   "where": {
    "fPASS": "upper edge of the ±0.3 dB pass band",
    "fS": "sample rate"
   },
   "note": "At fS = 48 kHz the pass band reaches 20 kHz and the half-amplitude corner sits at 24 kHz; the filter's figures scale with fS.",
   "page": 14
  },
  {
   "name": "Group delay",
   "expr": "tGD = 2 / fS",
   "where": {
    "tGD": "delay from sound to digital output, filter and I²S port included",
    "fS": "sample rate"
   },
   "note": "",
   "page": 5
  },
  {
   "name": "Wake from sleep",
   "expr": "tOUT = 32768 / fSCK",
   "where": {
    "tOUT": "time from the clock starting to the first output data",
    "fSCK": "SCK frequency"
   },
   "note": "3.072 MHz (fS = 48 kHz) gives 10.7 ms; 2.4 MHz (fS = 37.5 kHz) gives 13.7 ms. Output within 1 dB of settled sensitivity takes up to the 20 ms wake-up time.",
   "page": 15
  }
 ],
 "operation": [
  {
   "topic": "Modes set by the clock",
   "page": 12,
   "text": "The clock rate sets the state. With SCK and WS running at a sample rate of 23 to 51.6 kHz it is in high-performance mode; at 6.25 to 18.75 kHz it is in low-power mode, drawing 230 µA for always-on uses such as wake-word detection and listening for ambient sounds. Below a 3.125 kHz sample rate it sleeps within 1 ms, SD goes high impedance and it draws 12 µA typ. Moving between the two running modes takes up to 10 ms."
  },
  {
   "topic": "Start-up",
   "page": 12,
   "text": "Start-up takes under 20 ms, and data is usable as soon as it appears on SD. Leaving standby follows the same timing as a power-up."
  },
  {
   "topic": "Standby",
   "page": 12,
   "text": "Standby begins once SCK falls below roughly 200 kHz. The preferred way in is to stop both SCK and WS and hold them low, so no current flows into the internal pull-down on WS. Clocks should not be applied while VDD is off: they forward-bias the ESD diodes, which over time can harm reliability."
  },
  {
   "topic": "I²S format",
   "page": 12,
   "text": "The port is an I²S slave sending 24-bit two's-complement words, MSB first, each MSB one SCK cycle late relative to its half-frame's start. A frame needs 64 SCK cycles. With LR low the word follows the falling edge of WS (left); with LR high it follows the rising edge (right). SD goes high impedance straight after the LSB so another microphone can drive the shared line."
  },
  {
   "topic": "Synchronised microphones",
   "page": 12,
   "text": "Microphones on a common clock sample together, at the WS falling edge that opens the frame, so a stereo pair or an array stays in step. The ±1 dB sensitivity tolerance lets arrays be built without calibration."
  },
  {
   "topic": "Sharing a data line",
   "page": 15,
   "text": "One microphone can run in low-power mode while another on the same SD line is unpowered or held asleep by a separate slower clock; the idle one does not load the active one's data output."
  },
  {
   "topic": "SD drive",
   "page": 15,
   "text": "SD can drive 85 pF: the trace plus the inputs of the other microphones on it, each of which presents about 6 pF while high impedance."
  },
  {
   "topic": "Sensitivity in dB FS",
   "page": 13,
   "text": "dB FS is referred to a sine whose peaks just reach full-scale code, so a signal with another crest factor can sit above 0 dB FS rms; a full-scale square wave is +3 dB FS."
  },
  {
   "topic": "Reading −26 dB FS",
   "page": 14,
   "text": "A 1 kHz tone at 94 dB SPL comes out at −26 dB FS: the output words peak 26 dB under digital full scale, and the rms is not −29 dB FS. Counted as instantaneous sample level in units of D, with 1.0 D at digital full scale, a −26 dB FS sine peaks at 0.05 D."
  },
  {
   "topic": "Digital filters",
   "page": 14,
   "text": "The ADC, a one-bit sigma-delta modulator of high order running heavily oversampled, pushes its noise above the audio band; a low-pass decimation filter removes it. The pass band runs to 0.417 × fS with ±0.3 dB ripple and the stop band is 58 dB down; both scale with fS. A high-pass filter with a −3 dB corner at 24 Hz removes DC and does not scale with fS."
  },
  {
   "topic": "Supply decoupling",
   "page": 15,
   "text": "Fit a 0.1 µF X7R or better ceramic from VDD (pin 5) to ground, as near pin 3 as possible, with short traces on one layer and no vias. Put it midway between the VDD and GND pins, or a little nearer VDD, and make the via connections to the ground plane on the far side of the capacitor."
  },
  {
   "topic": "Board and sound hole",
   "page": 17,
   "text": "Lands are the package pads at 1:1. The board's sound hole is wider than the part's port, 0.5 mm diameter at least, and gets no solder paste. Board thickness does not change performance; the part goes on rigid or flex boards, and a flex board can be glued straight to the product housing, sealing the port with the shortest acoustic path."
  },
  {
   "topic": "Handling and assembly",
   "page": 18,
   "text": "Standard pick-and-place tools may grip anywhere on the lid, since the port is underneath. Never apply vacuum to the bottom face, never blow or suck air through the port, and place without excessive force. Reflow by the profile the solder paste calls for, kept inside the limits of Table 7. When washing, keep water out of the port; no blow-off or ultrasonic cleaning."
  },
  {
   "topic": "Construction",
   "page": 1,
   "text": "Inside are the MEMS sensor, an ADC with filtering, power management, hardware control and the I²S serial port. The part is omnidirectional with non-inverted polarity, works with tin-lead and lead-free solder, and is RoHS/WEEE compliant. Uses listed for it include wearables, smart TVs, remote controls, IoT devices, teleconferencing, game consoles and security systems."
  },
  {
   "topic": "Marking",
   "page": 19,
   "text": "The lid carries 434 on its first line and YYXXX (date code, then lot code) below it, with a dot marking the pin 1 corner."
  }
 ],
