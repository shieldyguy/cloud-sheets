{
 "sheet": 1,
 "name": "ICS-43434",
 "kind": "sensor",
 "manufacturer": "InvenSense (TDK)",
 "title": "Multi-mode bottom-port MEMS microphone with 24-bit I²S output",
 "source": {
  "document": "DS-000069",
  "revision": "Revision 1.2, 08/29/2016",
  "pages": 21
 },
 "summary": "A bottom-ported MEMS microphone that puts the transducer, signal conditioning, a sigma-delta ADC, decimation and anti-alias filtering, power management and a 24-bit I²S slave port in one 3.50 × 2.65 × 0.98 mm package, so it connects straight to a DSP or microcontroller with no codec. The I²S clock rate picks its mode: high-performance (65 dBA SNR, 490 µA), low-power for always-on listening (64 dBA, 230 µA) or sleep (12 µA). Sensitivity is −26 dB FS ±1 dB and the acoustic overload point is 120 dB SPL in both running modes. It is function-compatible with the ICS-43432, in a smaller package and at lower current.",
 "key_figures": [
  [
   "Sensitivity",
   "−26 dB FS typ, −27 to −25 dB FS, at 1 kHz, 94 dB SPL"
  ],
  [
   "SNR",
   "65 dBA (high-performance), 64 dBA (low-power)"
  ],
  [
   "Acoustic overload point",
   "120 dB SPL at 10% THD"
  ],
  [
   "Supply voltage",
   "1.65 V to 3.63 V"
  ],
  [
   "Supply current",
   "490 µA typ high-performance, 230 µA typ low-power, 12 µA typ sleep"
  ],
  [
   "Sample rate",
   "23 to 51.6 kHz (high-performance), 6.25 to 18.75 kHz (low-power)"
  ],
  [
   "Frequency response",
   "60 Hz to 20 kHz"
  ],
  [
   "Output",
   "I²S, 24-bit two's complement, MSB first, 64 SCK cycles per frame"
  ],
  [
   "Power supply rejection",
   "−100 dB FS; −99 dB FS typ at 217 Hz, 100 mV p-p square wave"
  ],
  [
   "Package",
   "6-terminal LGA cavity, 3.50 × 2.65 × 0.98 mm"
  ],
  [
   "Temperature",
   "−40 °C to +85 °C"
  ]
 ],
