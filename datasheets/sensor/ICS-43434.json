    },
    {
     "pin": "5",
     "name": "VDD",
     "type": "power",
     "function": "Supply, 1.65 V to 3.63 V; decouple to GND with 0.1 µF."
    },
    {
     "pin": "6",
     "name": "SD",
     "type": "output",
     "function": "I²S serial data out. High impedance whenever the part is not driving its own channel; the line takes a 100 kΩ pull-down so it discharges while every microphone on it is off the bus."
    }
   ]
  }
