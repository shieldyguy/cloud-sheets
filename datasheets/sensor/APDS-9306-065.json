{
 "sheet": 1,
 "name": "APDS-9306-065",
 "kind": "sensor",
 "manufacturer": "Broadcom",
 "title": "APDS-9306 / APDS-9306-065: digital ambient light sensor with I2C, 2.0 x 2.0 mm",
 "source": {
  "document": "AV02-4755EN",
  "revision": "October 21, 2016",
  "pages": 21
 },
 "summary": "A digital ambient light sensor in a 2.0 mm square surface-mount package. A photodiode with a coating that shapes its spectrum toward the human eye's response feeds an ADC of 13 to 20 bits; results are read over an I2C bus at up to 400 kHz, and an open-drain INT pin signals threshold or variance events. It runs from 1.7 V to 3.6 V, draws 85 µA typical while measuring and 2 µA at most in standby, and integration times are chosen to reject 50 Hz and 60 Hz flicker. APDS-9306 is 0.34 mm tall with eight pads; APDS-9306-065 is 0.65 mm tall with six.",
 "key_figures": [
  [
   "Supply",
   "1.7 V to 3.6 V"
  ],
  [
   "Active current",
   "85 µA typ (gain 18x, 50 ms, VDD = 2.8 V)"
  ],
  [
   "Standby current",
   "2 µA max"
  ],
  [
   "Resolution",
   "13 to 20 bit, programmable"
  ],
  [
   "Integration time",
   "3.125 ms to 400 ms"
  ],
  [
   "Dynamic range",
   "18,000,000 : 1"
  ],
  [
   "Lowest illuminance",
   "0.01 lux"
  ],
  [
   "Peak wavelength",
   "560 nm typ"
  ],
  [
   "Gain",
   "1x, 3x, 6x, 9x, 18x"
  ],
  [
   "Interface",
   "I2C, 7-bit address 0x52, up to 400 kHz"
  ],
  [
   "Operating temperature",
   "-40 °C to 85 °C"
  ],
  [
   "Package",
   "2.0 x 2.0 x 0.34 mm (APDS-9306), 2.0 x 2.0 x 0.65 mm (APDS-9306-065)"
  ]
 ],
