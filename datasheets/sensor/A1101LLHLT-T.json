 "equations": [
  {
   "name": "Power dissipation",
   "expr": "PD = VIN × IIN",
   "where": {
    "PD": "power dissipated in the device",
    "VIN": "supply voltage (VCC)",
    "IIN": "supply current (ICC)"
   },
   "note": "Equation (1).",
   "page": 9
  },
  {
   "name": "Junction temperature rise",
   "expr": "ΔT = PD × RθJA",
   "where": {
    "ΔT": "rise of junction temperature over ambient",
    "RθJA": "junction-to-ambient thermal resistance of package and board"
   },
   "note": "Equation (2).",
   "page": 9
  },
  {
   "name": "Junction temperature",
   "expr": "TJ = TA + ΔT",
   "where": {
    "TJ": "junction temperature",
    "TA": "ambient temperature"
   },
   "note": "Equation (3).",
   "page": 9
  },
  {
   "name": "Maximum allowable power",
   "expr": "PD(max) = (TJ(max) – TA) ÷ RθJA",
   "where": {
