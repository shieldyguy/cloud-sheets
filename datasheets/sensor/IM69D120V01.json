 "pins": [
  {
   "package": "LGA-5",
   "page": 12,
   "pins": [
    {
     "pin": "1",
     "name": "DATA",
     "type": "output",
     "function": "PDM bit stream out. Driven only during its own half of the clock period and high impedance during the other half, so two microphones can share one data line."
    },
    {
     "pin": "2",
     "name": "VDD",
     "type": "power in",
     "function": "Supply, 1.62 V to 3.6 V. Decouple with 100 nF placed next to the pin."
    },
    {
     "pin": "3",
     "name": "CLOCK",
     "type": "input",
     "function": "PDM clock in. Its frequency selects the power mode; at 250 kHz or below the part is in standby, and held low it is in clock-off mode."
    },
    {
     "pin": "4",
     "name": "SELECT",
     "type": "input",
     "function": "Left/right channel select (LR): grounded, data is driven after the falling clock edge; tied to VDD, after the rising edge."
    },
    {
     "pin": "5",
     "name": "GND",
     "type": "ground",
     "function": "Ground; the ring pad around the sound port."
    }
   ]
  }
 ],
