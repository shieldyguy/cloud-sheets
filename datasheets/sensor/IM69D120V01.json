{
 "sheet": 1,
 "name": "IM69D120V01",
 "kind": "sensor",
 "manufacturer": "Infineon",
 "title": "IM69D120 digital MEMS microphone with PDM output, 69 dB(A) SNR, 120 dBSPL AOP",
 "source": {
  "revision": "Datasheet 1.0, 2017-12-20",
  "pages": 16
 },
 "summary": "A bottom-port omnidirectional MEMS microphone whose capacitive element has two backplates around one membrane, followed by a preamplifier and sigma-delta converter that deliver a one-bit PDM stream. Its dynamic range is 95 dB: noise floor -95 dBFS(A), SNR 69 dB(A), distortion 1 % at 118 dBSPL and 10 % at the 120 dBSPL overload point. Each part is calibrated to -26 dBFS ±1 dB, with phase matched to ±2° at 1 kHz for arrays. The PDM clock rate chooses one of four power modes, from 980 µA at 3.072 MHz to 300 µA at 768 kHz, plus a standby and a clock-off state.",
 "key_figures": [
  [
   "Sensitivity",
   "-26 dBFS ±1 dB at 1 kHz, 94 dBSPL"
  ],
  [
   "Signal-to-noise ratio",
   "69 dB(A) at fclock = 3.072 MHz"
  ],
  [
   "Equivalent noise floor",
   "25 dBSPL"
  ],
  [
   "Acoustic overload point",
   "120 dBSPL (THD = 10 %)"
  ],
  [
   "THD",
   "1.0 % at 118 dBSPL; 0.5 % at 94 dBSPL"
  ],
  [
   "Low-frequency cutoff",
   "28 Hz (-3 dB)"
  ],
  [
   "Supply voltage",
   "1.62 V to 3.6 V"
  ],
  [
   "Current",
   "980 µA typ at 3.072 MHz; 25 µA standby; 1 µA max clock off"
  ],
  [
   "Group delay",
   "6 µs at 1 kHz"
  ],
  [
   "Ambient temperature",
   "-40 °C to 100 °C (to 70 °C with VDD > 3.0 V)"
  ],
  [
   "Package",
   "5-pin LGA, 4.000 × 3.000 × 1.200 mm, bottom sound port"
  ]
 ],
