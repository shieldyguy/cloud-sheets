 "circuits": [
  {
   "id": "stereo",
   "title": "Stereo pair on one PDM bus",
   "page": 10,
   "description": "Two microphones share a clock line and a data line to a codec. MIC 1 has SELECT tied to VDD and MIC 2 has SELECT grounded, so each drives DATA on a different clock edge and leaves it high impedance otherwise; the codec takes both channels from the one wire. Each microphone has its own 100 nF capacitor from VDD to ground, and a series resistor of about 100 Ω sits between each DATA pin and the shared data line to damp ringing and overshoot.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "IM69D120",
     "note": "MIC 1, SELECT high"
    },
    {
     "ref": "U2",
     "type": "ic",
     "value": "IM69D120",
     "note": "MIC 2, SELECT low"
    },
    {
     "ref": "C1",
     "type": "capacitor",
     "value": "100 nF",
     "note": "CVDD, close to U1 VDD"
    },
    {
     "ref": "C2",
     "type": "capacitor",
     "value": "100 nF",
     "note": "CVDD, close to U2 VDD"
    },
    {
     "ref": "R1",
     "type": "resistor",
     "value": "100 Ω",
     "note": "RTERM, optional"
    },
    {
     "ref": "R2",
     "type": "resistor",
     "value": "100 Ω",
     "note": "RTERM, optional"
    },
    {
     "ref": "U3",
     "type": "ic",
     "value": "codec",
     "external": true,
     "note": "PDM host"
    },
    {
     "ref": "J1",
     "type": "terminal",
     "value": "VDD"
    }
   ],
   "notes": [
    "RTERM may be left out."
   ]
  }
 ],
 "operation": [
  {
   "topic": "Signal chain",
   "page": 2,
   "text": "A charge pump biases the MEMS element, a membrane between two backplates. Its signal goes through an amplifier and a sigma-delta ADC into digital signal processing, with a digital core holding calibration coefficients, and leaves through a 1-bit PDM interface. Voltage regulators run the chip from VDD, and a power mode detector sets the mode from the PDM clock frequency."
  },
  {
   "topic": "Power modes",
   "page": 7,
   "text": "The clock frequency is the mode control. Four operating bands centre on 3.072 MHz, 2.4 MHz, 1.536 MHz and 768 kHz; lower bands trade SNR (69, 68, 66, 64 dB(A)) for current (980, 800, 620, 300 µA typ). A clock at 250 kHz or below puts the part in standby at 25 µA typ with DATA high impedance; a clock held low gives clock-off mode at 1 µA max. Moving between operating modes with VDD on takes up to 20 ms to come within ±0.5 dB of sensitivity, 50 ms for ±0.2 dB. The 768 kHz figures are over a 20 Hz to 8 kHz bandwidth."
  },
  {
   "topic": "Start-up",
   "page": 8,
   "text": "VDD should rise to its minimum within 50 ms. Once VDD and the clock are present, sensitivity settles to ±0.5 dB within 20 ms and to ±0.2 dB within 50 ms in any operating mode."
  },
  {
   "topic": "PDM timing and channel select",
   "page": 9,
   "text": "With SELECT grounded the microphone drives DATA starting tDD (40 to 80 ns) after a falling clock edge and releases it tHZ (5 to 30 ns) after the following rising edge. With SELECT at VDD it drives after the rising edge and releases after the falling edge. Data is valid at most 100 ns after the edge that starts it. Clock rise and fall are 13 ns max; duty cycle is 48 to 52 % at 2.9 MHz and above and 40 to 60 % below 2.65 MHz. The DATA load may be up to 200 pF."
  },
  {
   "topic": "Output coding",
   "page": 5,
   "text": "Rising pressure raises the proportion of 1s in the bit stream and falling pressure lowers it. A 94 dBSPL, 1 kHz tone reads -26 dBFS."
  },
  {
   "topic": "Matching",
   "page": 1,
   "text": "Each part is calibrated, giving a sensitivity tolerance of ±1 dB and phase matched to ±2° at 1 kHz between microphones, for beamforming arrays."
  },
  {
   "topic": "Decoupling and DATA termination",
   "page": 10,
   "text": "Put 100 nF from VDD to ground as near the VDD pin as possible for best SNR. A resistor of about 100 Ω in series with DATA reduces ringing and overshoot."
  },
  {
   "topic": "Board layout",
   "page": 13,
   "text": "Sound reaches the part through a hole in the board under its port; a 0.8 mm diameter hole is recommended, larger than the 0.6 mm port in the package. The land pattern assumes solder-mask-defined pads and may be adapted to the PCB fabricator's design rules."
  },
  {
   "topic": "Qualification",
   "page": 2,
   "text": "The technology is qualified for industrial use, with validation to the relevant IEC 60747 and 60749 tests or to JEDEC47/20/22."
  }
 ],
