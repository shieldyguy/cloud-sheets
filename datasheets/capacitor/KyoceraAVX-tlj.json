 "operation": [
  {
   "topic": "Voltage and temperature",
   "page": 2,
   "text": "Full rated voltage applies from -55 to +40 °C. Above 40 °C the allowed voltage falls: about half of VR at 85 °C and about a fifth at 125 °C (the category voltages). For use, 80% of VR is recommended up to 40 °C, meeting the rated limit from 60 °C upward (67% at 60 °C, 50% at 85 °C, 33% at 105 °C, 20% at 125 °C)."
  },
  {
   "topic": "Measurement conditions",
   "page": 4,
   "text": "Ratings are at +25 °C. Capacitance is measured at 120 Hz and 0.5 V rms with no more than 2.2 V DC bias. Leakage (DCL) is read at rated voltage after 5 minutes. ESR is the 100 kHz figure."
  },
  {
   "topic": "After mounting",
   "page": 4,
   "text": "Once soldered to a board, ESR may rise to 1.25 times its listed limit and DCL to 2 times its listed limit."
  },
  {
   "topic": "Product category",
   "page": 3,
   "text": "Each part number is product category 1 or 2, which sets its qualification limits. Category 2 limits are wider: endurance capacitance change +5/-30% against ±10%, capacitance at the later +20 °C steps ±10% against ±5%, -55 °C capacitance +5/-20% against +0/-20%, and DCL after the last step 2 x IL against IL."
  },
  {
   "topic": "Moisture sensitivity and soldering",
   "page": 4,
   "text": "All parts are MSL 3 under J-STD-020 and withstand three reflow passes at 260 °C. The parts are lead-free compatible and RoHS compliant."
  },
  {
   "topic": "Surge screening",
   "page": 1,
   "text": "Every capacitor is surge-current tested in production."
  },
  {
   "topic": "Marking",
   "page": 1,
   "text": "Every case except N, P and R carries the three-digit capacitance code in pF, the voltage code letter (J = 6.3 V), the logo and an ID code, with a band at the anode end. The small N, P and R cases carry the capacitance code on one line and the voltage code letter with the logo below it, again with an anode band."
  },
  {
   "topic": "Terminations and packing",
   "page": 1,
   "text": "Terminations are J-leads folded under the body, finished in pure tin. Parts come on 7-inch (R) or 13-inch (S) reels; the # in a part number stands for the packaging letter."
  },
  {
   "topic": "Supply substitution",
   "page": 4,
   "text": "Kyocera AVX may ship a part with a higher voltage rating or a tighter tolerance in the same case size, at the same reliability."
  },
  {
   "topic": "Applications",
   "page": 1,
   "text": "Intended for consumer equipment such as mobile phones, PDAs and MP3/MP4 players."
  }
 ],
