{
 "sheet": 1,
 "name": "KyoceraAVX-tlj",
 "kind": "capacitor",
 "manufacturer": "Kyocera AVX",
 "title": "TLJ series high-CV solid tantalum chip capacitors, J-lead",
 "source": {
  "document": "TDS-PTNO-0035",
  "revision": "Rev 2",
  "pages": 6
 },
 "summary": "The TLJ series are solid tantalum electrolytic (MnO2) chip capacitors with J-lead terminations, a high-CV series with high volumetric efficiency listed for consumer applications such as mobile phones, PDAs and MP3/MP4 players. The range covers 10 to 1500 µF at ±20% and rated voltages of 2.5 to 20 V across fourteen case codes from 0805 to 2924, including low-profile codes down to 1.0 mm high. Every part is surge-current tested, rated for three reflow passes at 260 °C, and runs from -55 to +125 °C with the voltage derated above 40 °C.",
 "key_figures": [
  [
   "Capacitance",
   "10 µF to 1500 µF, ±20%"
  ],
  [
   "Rated voltage",
   "2.5, 4, 6.3, 10, 16, 20 V at -55 to +40 °C"
  ],
  [
   "Category voltage",
   "0.5 x VR at 85 °C; 0.2 x VR at 125 °C"
  ],
  [
   "Temperature range",
   "-55 °C to +125 °C with category voltage"
  ],
