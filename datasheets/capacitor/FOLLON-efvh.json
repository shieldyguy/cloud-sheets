 "operation": [
  {
   "topic": "Ripple current and life",
   "page": 3,
   "text": "Ripple current warms the capacitor from inside, and every 10 °C of that warming cuts its life in half. Where a long life is needed, run it at a lower rms ripple current than the rating."
  },
  {
   "topic": "Ripple current at other frequencies",
   "page": 3,
   "text": "The listed ripple currents hold at 120 Hz. Multiply by the frequency coefficient for the case size and capacitance band to get the limit at 50 Hz to 10 kHz and above."
  },
  {
   "topic": "Marking",
   "page": 2,
   "text": "The can top carries the capacitance in µF (for example 470), the rated voltage (25V), the series name FVH, the FOLLON logo, and a dark band over the negative terminal."
  },
  {
   "topic": "Pressure vent",
   "page": 1,
   "text": "Cans of 8 mm diameter × 10 mm length and larger have a pressure-relief vent in the top."
  },
  {
   "topic": "Shelf life",
   "page": 1,
   "text": "After 1000 hours at 105 °C with no voltage applied, the capacitor still meets the load life limits."
  },
  {
   "topic": "Base plate",
   "page": 1,
   "text": "The can stands on a square plastic base plate, A × B, with the two flat terminals running out from under it on opposite sides. Two corners on the positive side are cut off."
  }
