 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Capacitance under DC bias",
   "page": 2,
   "text": "Typical capacitance falls with DC bias: about 45% down at 10 V, about 73% down at 20 V and about 86% down at 35 V, against its zero-bias value."
  },
  {
   "topic": "Capacitance over temperature",
   "page": 2,
   "text": "Typical capacitance peaks near +1% around 40 to 45 °C and drops to about -12% at -55 °C and about -7% at +85 °C."
  },
  {
   "topic": "Impedance and ESR",
   "page": 2,
   "text": "Typical impedance reaches its minimum, a few milliohms, near 1.3 to 1.5 MHz, and climbs to about 9 Ω at 3 GHz. ESR stays in the low milliohm range from roughly 50 kHz to a few MHz and rises steeply above 1 GHz."
  },
  {
   "topic": "Self-heating",
   "page": 2,
   "text": "Typical temperature rise reaches about 20 °C at 2.6 Arms of 10 kHz ripple and at about 4.4 Arms of 100 kHz or 1 MHz ripple."
  },
  {
   "topic": "Thickness",
   "page": 2,
   "text": "Maximum thickness is 2.7 mm (0.106 inch)."
  }
 ],
