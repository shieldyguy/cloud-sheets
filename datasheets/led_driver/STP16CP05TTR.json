{
 "sheet": 1,
 "name": "STP16CP05TTR",
 "kind": "led_driver",
 "manufacturer": "STMicroelectronics",
 "title": "16-channel constant-current LED sink driver with serial shift register, 3 V to 5.5 V",
 "source": {
  "revision": "DocID12568 Rev 13, March 2017",
  "pages": 30
 },
 "summary": "STP16CP05 sinks a regulated current of 5 mA to 100 mA on each of 16 outputs, for LED panels and displays. Data arrives on a serial input clocked at up to 30 MHz, is latched in parallel and gated by an active-low output enable; a serial output lets devices be chained. One external resistor sets the current of every channel, the outputs stand off 20 V, and the logic runs from 3.0 V to 5.5 V. STP16CP05TTR is the TSSOP24 part on a 2500-piece reel.",
 "key_figures": [
  [
   "Channels",
   "16 constant-current sinks"
  ],
  [
   "Output current",
   "5 mA to 100 mA per channel, set by R-EXT"
  ],
  [
   "Output voltage",
   "20 V max"
  ],
  [
   "Supply voltage VDD",
   "3.0 V to 5.5 V"
  ],
  [
   "Clock frequency",
   "30 MHz (cascade, VDD = 5 V)"
  ],
  [
   "Current error between bits",
   "± 1.5 % typ, ± 3 % max at 20 mA"
  ],
  [
   "Output current setup time",
   "40 ns typ"
  ],
  [
   "Supply current",
   "4 mA typ, outputs off, Rext = 1 kΩ"
  ],
  [
   "Operating temperature",
   "-40 °C to +125 °C"
  ],
