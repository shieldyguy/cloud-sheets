 "equations": [
  {
   "name": "Inductor value",
   "expr": "L1 = VO × TOFF / ΔIO",
   "where": {
    "VO": "total forward drop across the LED string",
    "TOFF": "off-time of the IC",
    "ΔIO": "peak-to-peak ripple current in L1"
   },
   "note": "",
   "page": 6
  },
  {
   "name": "Output current",
   "expr": "IO = ITH − (1/2 × ΔIO)",
   "where": {
    "IO": "average LED string current",
    "ITH": "current sense comparator threshold",
    "ΔIO": "peak-to-peak ripple current in L1"
   },
   "note": "",
   "page": 6
  },
  {
   "name": "Coil self-resonant frequency",
   "expr": "SRF = 1 / (2π × √(L × CL))",
   "where": {
    "L": "inductance",
    "CL": "coil capacitance"
   },
   "note": "",
   "page": 7
  },
  {
   "name": "Total DRAIN parasitic capacitance",
   "expr": "CP = CDRAIN + CPCB + CL + CJ",
   "where": {
    "CDRAIN": "IC output capacitance",
    "CPCB": "board trace capacitance",
    "CL": "coil capacitance of L1",
    "CJ": "junction capacitance of D1"
   },
   "note": "",
   "page": 7
  },
  {
   "name": "Leading edge spike duration",
   "expr": "TSPIKE = VIN × CP / ISAT + trr",
   "where": {
    "VIN": "input voltage",
    "CP": "total DRAIN parasitic capacitance",
    "ISAT": "MOSFET saturation current",
    "trr": "reverse recovery time of D1"
   },
   "note": "",
   "page": 7
  },
  {
   "name": "Parasitic capacitance limit",
   "expr": "CP < ISAT × (TBLANK(MIN) − trr) / VIN(MAX)",
   "where": {
    "TBLANK(MIN)": "minimum blanking time, 200 ns",
    "VIN(MAX)": "highest instantaneous input voltage",
    "ISAT": "MOSFET saturation current",
    "trr": "reverse recovery time of D1"
   },
   "note": "Keeps the spike inside the blanking time so the comparator does not trip falsely.",
   "page": 7
  },
  {
   "name": "Switching power loss, DC input",
   "expr": "PSWITCH = (VIN² × CP / 2 + VIN × ISAT × trr) × FS",
   "where": {
    "FS": "switching frequency",
    "ISAT": "saturated DRAIN current",
    "CP": "total DRAIN parasitic capacitance"
   },
   "note": "Largest at the highest input voltage.",
   "page": 7
  },
  {
   "name": "Switching frequency",
   "expr": "FS = (VIN − VO) / (VIN × TOFF)",
   "where": {
    "VIN": "input voltage",
    "VO": "LED string voltage",
    "TOFF": "off-time"
   },
   "note": "",
   "page": 7
  },
  {
   "name": "Switching power loss, full-wave rectified AC input",
   "expr": "PSWITCH ≈ 1 / (2 × TOFF) × (VAC × CP + 2 × ISAT × trr) × (VAC − VO)",
   "where": {
    "VAC": "input AC line voltage"
   },
   "note": "",
   "page": 7
  },
  {
   "name": "Conduction power loss, DC input",
   "expr": "PCOND = D × IO² × RON + IDD × VIN × (1 − D)",
   "where": {
    "D": "duty ratio, VO / VIN",
    "RON": "on-resistance",
    "IDD": "internal linear regulator current"
   },
   "note": "",
   "page": 7
  },
  {
   "name": "Conduction power loss, full-wave rectified AC input",
   "expr": "PCOND = KC × IO² × RON + Kd × IDD × VAC",
   "where": {
    "VAC": "input AC line voltage",
    "KC, Kd": "coefficients that depend on the lowest duty ratio Dm; see the conduction loss coefficient graph"
   },
   "note": "An estimate.",
   "page": 7
  }
 ],
 "operation": [
  {
   "topic": "Control scheme",
   "page": 6,
   "text": "The chip is a PWM peak-current controller for a buck stage run in continuous conduction. Its output current is preset internally: 20 mA (HV9921), 50 mA (HV9922), 30 mA (HV9923)."
  },
  {
   "topic": "Start-up and under-voltage lockout",
   "page": 6,
   "text": "With 20 to 400 V on DRAIN, a built-in high-voltage linear regulator drives VDD toward 7.5 V. The switch stays off until VDD passes the under-voltage threshold, then turns on and current flows into DRAIN. The lockout has hysteresis, 200 mV typ, against chatter."
  },
  {
   "topic": "Switching cycle",
   "page": 6,
   "text": "Once the DRAIN current reaches the internal threshold, the current comparator resets a flip-flop and the switch turns off. A one-shot then holds it off for the fixed off-time (10.5 µs typ), after which the flip-flop sets and the next cycle starts."
  },
  {
   "topic": "Leading edge blanking",
   "page": 6,
   "text": "The comparator ignores the first 300 ns (typ) of each on-time, so the turn-on spike from parasitic capacitance cannot end the cycle early."
  },
  {
   "topic": "Ripple and line regulation",
   "page": 6,
   "text": "With a constant off-time the ripple in L1 does not depend on the line voltage, AC or DC, so the output current holds as the input varies. Ripple puts a gap between the peak setting and the average current. A capacitor placed across the string cuts the ripple further and allows a smaller L1, but at large ripple the off-time spread then costs initial current accuracy."
  },
  {
   "topic": "Supply range and loads",
   "page": 6,
   "text": "Runs from 85-264 VAC or 20-400 VDC and drives a single series string of high-brightness LEDs, up to a few tens of them. Compatible with triac dimmers. Available in TO-92 and SOT-89."
  },
  {
   "topic": "Parasitic capacitance at DRAIN",
   "page": 6,
   "text": "The coil capacitance of L1, the reverse recovery and junction capacitance of D1, board trace capacitance CPCB and the IC's own CDRAIN all lower efficiency and can trip the current comparator falsely, so they should be kept small. At each turn-on the switch discharges CP; that discharge is limited to about 150 mA typ and falls as the junction heats."
  },
  {
   "topic": "Output capacitor CO",
   "page": 7,
   "text": "Charging and discharging the coil capacitance each cycle drives high current spikes through the LED string; a small capacitor CO, about 10 nF, across the string bypasses them. Inductor makers list coil capacitance directly or give the self-resonant frequency."
  },
  {
   "topic": "Freewheel diode D1",
   "page": 7,
   "text": "An ultra-fast rectifier gives high efficiency and less risk of false comparator trips; shorter trr and lower CJ are better. Its reverse rating VR has to exceed the lamp's highest input voltage. Recovery data at IF = 20 to 50 mA are seldom published, so trying several diodes may be needed."
  },
  {
   "topic": "Power loss",
   "page": 7,
   "text": "Most of the switching loss is the discharge of CP into DRAIN at turn-on. Turn-off loss is negligible: the large capacitance on the switching node lets DRAIN rise at essentially zero voltage."
  },
  {
   "topic": "EMI filter",
   "page": 8,
   "text": "An off-line converter needs an input filter for good EMI. A capacitor on the switching side, small though it is, gives the high-frequency switching current a low-impedance path; size it at roughly 0.1-0.2 µF per watt of LED output power."
  },
  {
   "topic": "Layout: grounding and bypass",
   "page": 11,
   "text": "Run one single-point ground from the input filter capacitor to the copper on the GND pin. Put CDD right beside the VDD and GND pins, as near them as it will go."
  },
  {
   "topic": "Layout: switching loops",
   "page": 11,
   "text": "Keep two loops as small as possible: CIN, D1 and the IC; and CO, L1 and D1."
  },
  {
   "topic": "Layout: heat and radiated EMI",
   "page": 11,
   "text": "The GND copper is both the single-point ground and the heat sink; make it large, above all with the SOT-89. The cathode copper of D1 may be large too. Both nodes are quiet and do not radiate. The switching node (DRAIN, D1 anode, L1) should have as little copper as possible, since a large area there radiates high-frequency EMI."
  },
  {
   "topic": "Layout: input filter",
   "page": 11,
   "text": "Keep the EMI filter parts away from L1 so its leakage field does not couple in, which matters most with an unshielded L1. An axial LIN goes at right angles to L1. Make the CIN2, LIN, CIN loop small and twist the input leads together."
  }
 ],
