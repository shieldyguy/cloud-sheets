{
 "sheet": 1,
 "name": "HV9923N8-G",
 "kind": "led_driver",
 "manufacturer": "Microchip",
 "title": "HV9921/HV9922/HV9923: 3-pin off-line buck LED drivers with fixed 20, 50 or 30 mA output",
 "source": {
  "document": "DS20005311A",
  "revision": "Revision A, October 2014",
  "pages": 19
 },
 "summary": "Three-terminal buck controllers with a 475 V switching MOSFET built in, for running a series LED string straight off rectified mains (85-264 VAC) or a 20-400 V DC rail. The current is fixed inside the chip by a peak-current comparator and a fixed off-time near 10 µs: 20 mA for the HV9921, 50 mA for the HV9922 and 30 mA for the HV9923. The chip powers itself from the DRAIN pin through an internal regulator. HV9923N8-G is the 30 mA part in SOT-89 on a 2000-piece reel.",
 "key_figures": [
  [
   "Output current",
   "20 mA (HV9921), 50 mA (HV9922), 30 mA (HV9923)"
  ],
