{
 "sheet": 1,
 "name": "IS31FL3218-QFLS2-TR",
 "kind": "led_driver",
 "manufacturer": "Lumissil Microsystems (ISSI)",
 "title": "IS31FL3218: 18-channel constant-current LED driver with I2C and 8-bit PWM per channel",
 "source": {
  "revision": "Rev. G, 09/05/2024",
  "pages": 16
 },
 "summary": "Eighteen constant-current LED sinks controlled over I2C. One resistor on R_EXT sets the full-scale current for all channels, up to 38 mA, and each channel has its own on/off bit and 8-bit PWM duty, so its average current can be set in 256 steps. It runs from 2.7 V to 5.5 V over -40 °C to +85 °C, sits at the fixed write address 1010 1000, and can be shut down by the SDB pin or by a register bit. Packages are QFN-24 (4 mm × 4 mm) and SOP-24.",
 "key_figures": [
  [
   "Channels",
   "18 constant-current sinks"
  ],
  [
   "Supply voltage",
   "2.7 V to 5.5 V"
  ],
  [
   "Full-scale current per channel",
   "38 mA typ at REXT = 2 kΩ, VCC = 4.2 V, VOUT = 0.8 V"
  ],
  [
   "Brightness control",
   "8-bit PWM (256 steps) per channel"
  ],
  [
   "Quiescent current",
   "5.25 mA typ at REXT = 3.3 kΩ"
  ],
  [
   "Shutdown current",
   "3.1 µA typ"
  ],
  [
   "Interface",
   "I2C, write-only, 400 kHz, address 1010 1000"
  ],
  [
   "Operating temperature",
   "-40 °C to +85 °C"
  ],
  [
   "θJA",
   "29 °C/W (QFN), 40.8 °C/W (SOP)"
  ]
 ],
