 "pins": [
  {
   "package": "SOT89-5",
   "page": 2,
   "pins": [
    {
     "pin": "1",
     "name": "LX",
     "type": "power out",
     "function": "Drain of the internal power switch; the switching node that drives the inductor."
    },
    {
     "pin": "2",
     "name": "GND",
     "type": "ground",
     "function": "Ground, 0 V."
    },
    {
     "pin": "3",
     "name": "ADJ",
     "type": "input",
     "function": "On/off and brightness control. Left open it sits at VREF = 1.2 V and the output runs at IOUT_NOM = 0.1/RS. Below 0.2 V the output turns off. A DC level from 0.3 V to 1.2 V sets the current between 25 % and 100 % of IOUT_NOM; a PWM signal also adjusts it. Above 1.2 V the current is held at 100 %."
    },
    {
     "pin": "4",
     "name": "ISENSE",
     "type": "input",
     "function": "Current sense input; RS goes from this pin to VIN and sets IOUT_NOM = 0.1/RS."
    },
    {
     "pin": "5",
     "name": "VIN",
     "type": "power in",
     "function": "Supply input, 6 V to 40 V. Bypass to ground with a 0.1 µF X7R ceramic capacitor placed next to the part."
    },
    {
     "pin": "EP",
     "name": "Thermal Pad",
     "type": "ground",
     "function": "Exposed tab; tie it to GND."
    }
   ]
  }
 ],
