{
 "sheet": 1,
 "name": "IS31LT3360-SDLS4-TR",
 "kind": "led_driver",
 "manufacturer": "Lumissil Microsystems (ISSI)",
 "title": "IS31LT3360: 40 V, 1.2 A buck LED driver with internal switch, SOT89-5",
 "source": {
  "revision": "Rev. D, 06/07/2024",
  "pages": 17
 },
 "summary": "A continuous-mode inductive step-down LED driver with its power switch on chip. It runs from 6 V to 40 V and drives one LED or a series string at up to 1.2 A, the average current set by a resistor RS between VIN and ISENSE that sees a 100 mV threshold. The single ADJ pin dims the output by a DC level or a PWM signal and shuts the part down below 0.2 V. IS31LT3360-SDLS4-TR is the -40 °C to +125 °C grade; IS31LT3360-SDLS3-TR is the -40 °C to +105 °C grade.",
 "key_figures": [
  [
   "Input voltage",
   "6 V to 40 V"
  ],
  [
   "Output current",
   "up to 1.2 A"
  ],
  [
   "Current sense threshold VSENSE",
   "100 mV typ; 95 mV to 105 mV over -40 °C to +125 °C"
  ],
  [
   "Output current accuracy",
   "3 % typ (SDLS3, -40 °C to +105 °C); 5 % typ (SDLS4, -40 °C to +125 °C)"
  ],
  [
   "LX switch on resistance",
   "0.27 Ω typ"
  ],
  [
   "Switching frequency",
   "up to 1 MHz"
  ],
  [
   "Efficiency",
   "up to 98 %"
  ],
  [
   "Dimming ratio",
   "up to 1200:1"
  ],
  [
   "Quiescent current, output off",
   "120 µA typ"
  ],
  [
   "Package",
   "SOT89-5 with thermal pad, θJA 132.6 °C/W"
  ]
 ],
 "features": [
  "Integrated 40 V power switch",
  "High-side current sensing with one external resistor",
  "On/off and brightness on one pin, by DC voltage or PWM",
  "Inherent protection against open-circuit and short-circuit LEDs",
  "Thermal shutdown",
  "RoHS, halogen-free and TSCA compliant"
 ],
 "applications": [
  "Automotive and avionic lighting",
  "LED MR16 and MR11 spot lights",
  "LED street lights",
  "PAR lights",
  "Industrial lighting",
  "Refrigeration lights",
  "Other LED lighting"
 ],
