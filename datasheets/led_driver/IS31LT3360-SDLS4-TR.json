     "value": "0.15 Ω"
    },
    {
     "ref": "D1",
     "type": "schottky",
     "value": ""
    },
    {
     "ref": "L1",
     "type": "inductor",
     "value": "47 µH"
    },
    {
     "ref": "C1",
     "type": "capacitor",
     "value": "100 µF",
     "note": "bulk input capacitor, polarised"
    },
    {
     "ref": "C2",
     "type": "capacitor",
     "value": "0.1 µF",
     "note": "required; placed at the VIN and GND pins"
    },
    {
     "ref": "C3",
     "type": "capacitor",
     "value": "1 µF",
     "note": "across the LED string"
    },
