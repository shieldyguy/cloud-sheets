  {
   "id": "pwm-dimming",
   "title": "PWM dimming control via ADJ pin",
   "page": 10,
   "description": "A PWM signal of 0 V to 5 V drives ADJ directly; its duty cycle scales the current below the RS setting. High must be above 1.2 V and low below 0.2 V, and the source must be able to pull against the internal 500 kΩ resistor to VREF. The other pins connect as in the typical application.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "IS31LT3360"
    },
