 "circuits": [
  {
   "id": "typical",
   "title": "Typical application circuit",
   "page": 1,
   "description": "Buck LED driver from a 6 V to 40 V DC supply. RS (0.15 Ω, about 667 mA) sits between the supply and ISENSE and carries the LED current; the LED string runs from the ISENSE side of RS down to the inductor, which returns to the LX switch. D1 is the freewheel Schottky from LX back to VIN. C1 is bulk input capacitance, C2 the local VIN bypass that must stay next to VIN and GND, and C3 across the string lowers ripple current. ADJ is left open for full current.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "IS31LT3360"
    },
