 "title": "CMI2012 series multilayer chip ferrite inductors, 2.0 × 1.2 mm (0805)",
 "source": {
  "document": "CMI2012 Series approval sheet",
  "revision": "22.01, 2022-1-7",
  "pages": 14
 },
 "summary": "The CMI2012 family is a set of two-terminal multilayer chip inductors in a 2.0 × 1.2 mm body, built from silver coil electrodes stacked inside a Ni-Cu-Zn ferrite body with Ni/Sn plated ends. Values run from 0.047 µH to 68 µH across four ferrite material grades (V, U, X, J); the 0.9 mm thick 201209 body covers up to 33 µH and the 1.2 mm thick 201212 body carries 39 µH to 68 µH. Rated current falls from 300 mA at the smallest values to 5 mA at the largest, and the parts operate from -40 °C to +85 °C.",
 "key_figures": [
  [
   "Inductance range",
   "0.047 µH to 68 µH"
  ],
  [
   "Tolerance",
   "±10 % (K) up to 27 µH; ±20 % (M) from 33 µH"
  ],
  [
   "Rated current",
   "300 mA max (0.047 µH) to 5 mA max (15 µH and above)"
  ],
  [
   "DC resistance",
   "0.15 Ω to 2.60 Ω max"
  ],
  [
   "Self-resonant frequency",
   "320 MHz min (0.047 µH) to 10 MHz min (56 µH, 68 µH)"
  ],
  [
   "Body",
   "2.0 × 1.2 × 0.9 mm (201209) or 2.0 × 1.2 × 1.2 mm (201212)"
  ],
