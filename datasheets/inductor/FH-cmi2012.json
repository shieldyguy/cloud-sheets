    [
     "2",
     "Solderability",
     "Solder covers 95 % or more of each terminal electrode surface.",
     "Flux dip about 3 to 5 s; preheat 120 ℃ to 150 ℃ for 60 s; dip 10 mm deep in Sn 96.5 % / Ag 3.0 % / Cu 0.5 % solder at 245±5 ℃ for 5±1 s."
    ],
    [
     "3",
     "Resistance to soldering heat",
     "Solder covers 95 % or more of each terminal; no visible mechanical damage. Inductance shift: V and U grades within ±20 %, X grade within ±25 %, J grade within ±30 %. Q shift (ferrite) within ±30 %.",
     "Flux dip about 3 to 5 s; preheat 120 ℃ to 150 ℃ for 60 s; dip 10 mm deep in Sn 96.5 % / Ag 3.0 % / Cu 0.5 % solder at 260±5 ℃ for 10±1 s."
    ],
    [
     "4",
     "Adhesion of electrode",
     "Neither the terminations nor the body are damaged.",
     "Chip soldered to mounting pads on a glass-epoxy board; a sideways force of 10 N (2012 series) is held for 10±1 s."
    ],
    [
     "5",
     "Low temperature resistance",
     "No visible mechanical damage; inductance shift within ±10 %; Q shift (ferrite) within ±30 %.",
     "-40±2 ℃ for 1000 +24/-0 h."
    ],
    [
     "6",
     "Bending strength",
     "No visible mechanical damage.",
     "Mounted on a glass-epoxy board (1.6±0.20 mm or 0.8±0.10 mm thick) on supports 45±2 mm either side of the part; an R5 tool presses at 0.5 mm/s to 2 mm deflection, held 20±1 s."
    ],
    [
     "7",
     "Vibration",
