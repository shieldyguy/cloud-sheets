 "name": "H3V3HD3U",
 "kind": "tvs",
 "manufacturer": "Zhuhai Hongjiacheng Technology",
 "title": "Unidirectional 3.3 V high-capacitance ESD protection diode, SOD-323",
 "source": {
  "revision": "Rev 2.1",
  "pages": 3
 },
 "summary": "A single unidirectional transient-voltage suppressor in a two-lead SOD-323 package, guarding one line that works at up to 3.3 V. It takes ±30 kV IEC 61000-4-2 discharges by air and by contact and 20 A of 8/20 µs surge, holding the line to 14 V at most at that current. Its capacitance is up to 200 pF at 0 V and its leakage at most 0.5 µA at 3.3 V. Laptops, mobile phones, digital cameras and PDAs are the uses listed for it.",
 "key_figures": [
