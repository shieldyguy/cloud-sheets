 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Uses",
   "page": 1,
   "text": "Applications listed are laptop computers, cellular phones, digital cameras and personal digital assistants."
  },
  {
   "topic": "Protection ratings",
   "page": 1,
   "text": "Withstands ±30 kV IEC 61000-4-2 discharge, both air and contact, and an IEC 61000-4-5 8/20 µs lightning surge of 20 A peak (300 W)."
  },
  {
   "topic": "Polarity and conduction",
   "page": 1,
   "text": "Unidirectional. With the cathode positive only leakage flows up to VRWM; above VBR it breaks down, and at IPP the voltage across it is VC. With the anode positive it conducts forward, VF at IF."
  },
  {
   "topic": "Pulse power",
   "page": 2,
   "text": "Allowed peak pulse power drops with pulse length along a straight line in log-log scale, from about 0.87 kW at 1 µs to about 0.078 kW at 1 ms."
  },
  {
   "topic": "Clamping",
   "page": 2,
   "text": "Clamping voltage climbs from about 6 V near 1 A to just under 10 V at 20 A, flattening as current grows."
  },
  {
   "topic": "Marking",
   "page": 1,
   "text": "The body carries the code D03, with a band at the cathode end."
  }
 ],
