 "kind": "tvs",
 "manufacturer": "Brightking",
 "title": "SMBJ series: 600 W surface-mount transient voltage suppressors, SMB (DO-214AA)",
 "source": {
  "revision": "Revision 21-Jul-14",
  "pages": 6
 },
 "summary": "A family of glass-passivated silicon TVS diodes in the low-profile SMB (DO-214AA) moulded package, each rated for at least 600 W peak with a 10/1000 µs pulse. Stand-off voltages run from 5.0 V to 440 V with breakdown held to a 5 % window (A suffix); each voltage comes unidirectional (A) or bidirectional (CA). Intended uses are I/O interfaces, AC/DC supplies and low-frequency signal lines such as RS232 and RS485.",
 "key_figures": [
  [
   "Peak pulse power PPPM",
   "600 W minimum, 10/1000 µs waveform"
  ],
  [
   "Stand-off voltage VRWM",
   "5.0 V to 440 V"
  ],
  [
   "SMBJ20A / SMBJ20CA",
   "VRWM 20.0 V; VBR 22.20 V to 24.50 V at 1 mA; VC 32.4 V max at IPP 18.6 A; IR 1 µA max"
  ],
  [
   "Steady state power PM(AV)",
   "5.0 W at TA = 50 ℃"
  ],
  [
   "Forward surge current IFSM",
