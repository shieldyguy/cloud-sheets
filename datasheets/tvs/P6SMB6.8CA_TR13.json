 "operation": [
  {
   "topic": "Polarity and direction",
   "page": 2,
   "text": "A-suffix parts are unidirectional and carry a colour band at the cathode. CA-suffix parts are bidirectional, carry no band and share the same row of figures. The forward surge rating (IFSM, Fig. 6) applies to unidirectional parts only."
  },
  {
   "topic": "Pulse rating",
   "page": 5,
   "text": "The 600 W figure is a minimum for a 10/1000 µs pulse: the current reaches its peak in 10 µs and falls to half of it at 1000 µs (Fig. 3), at a repetition rate of 0.01 %. Allowed peak power rises for shorter pulses, to about 11.6 kW at 1 µs, and falls for longer ones (Fig. 1). Pulse power and current fall linearly from 100 % at 25 °C to zero at 150 °C (Fig. 2)."
  },
  {
   "topic": "Steady-state dissipation",
   "page": 5,
   "text": "The part may dissipate 5.0 W continuously up to 50 °C ambient, falling linearly to zero at 150 °C (Fig. 5)."
  },
  {
   "topic": "Capacitance",
   "page": 5,
   "text": "Junction capacitance falls as breakdown voltage rises. At zero bias a unidirectional part is near 4500 pF at 6 V breakdown and a bidirectional one near 2800 pF; at reverse bias VR the figures are near 2500 pF and 2300 pF at 6 V, falling to about 8 pF and 10 pF near 500 V (Fig. 4)."
  },
  {
   "topic": "Mounting pad",
   "page": 3,
   "text": "The suggested land pattern is two pads 1.75 mm wide and 2.18 mm long, with 2.16 mm between them."
  }
 ],
