 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Bidirectional clamping",
   "page": 1,
   "text": "Two diodes connect back to back between terminals 1 and 2. The I-V characteristic is symmetric about the origin: IR flows at VRWM, IT at VBR, and IPP at VC, in either polarity."
  },
  {
   "topic": "Test waveforms",
   "page": 2,
   "text": "Surge ratings use the 8/20 µs current pulse: an 8 µs rise to peak and a decay to half the peak at 20 µs. The ESD waveform of IEC 61000-4-2 rises in 0.7 to 1.0 ns, and its current is down to 50 % of the peak at 30 ns and 25 % at 60 ns."
  },
  {
   "topic": "Pulse power against duration",
   "page": 2,
   "text": "The peak pulse power the part takes falls with pulse length, from about 1.3 kW at 1 µs to about 0.07 kW at 1 ms (Fig.3)."
  },
  {
   "topic": "Clamping against current",
   "page": 2,
   "text": "The typical clamping voltage rises from about 7 V near 0.6 A to about 15 V at 10 A, then levels off near 16 V up to 20 A (Fig.4)."
  },
  {
   "topic": "Land pattern",
   "page": 3,
   "text": "The recommended footprint is two pads each at least 0.80 mm long and 0.80 mm wide, separated by a gap of at most 1.40 mm."
  }
 ],
