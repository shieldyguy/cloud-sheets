{
 "sheet": 1,
 "name": "SMF5.0CA",
 "kind": "tvs",
 "manufacturer": "Zhuhai Hongjiacheng Technology",
 "title": "SMF series: 200 W surface-mount transient voltage suppressors, SOD-123FL",
 "source": {
  "revision": "Rev:2.2",
  "pages": 5
 },
 "summary": "A family of glass-passivated transient voltage suppressor diodes in the flat-lead SOD-123FL package, each able to absorb 200 W peak in a 10/1000 µs pulse. Stand-off voltages run from 3.3 V to 250 V with breakdown held to a 5 % window (A suffix); each voltage is offered unidirectional (A) or bidirectional (CA). They guard I/O lines, supply buses and other exposed nodes in telecom, computing, industrial and consumer equipment. SMF12A is the unidirectional 12 V stand-off part, marked BE.",
 "key_figures": [
  [
   "Peak pulse power PPPM",
   "200 W, 10/1000 µs waveform"
  ],
  [
   "Stand-off voltage VRWM",
   "3.3 V to 250 V"
  ],
  [
   "Breakdown voltage VBR",
   "5.2 V min (SMF3.3A) to 309 V max (SMF250A)"
  ],
  [
   "SMF12A",
   "VRWM 12 V; VBR 13.3 V to 14.7 V at 1 mA; VC 19.9 V at IPP 10.1 A; IR 2.5 µA"
  ],
  [
   "Steady power dissipation PM(AV)",
   "0.4 W on infinite heat sink at TL = 75 °C"
  ],
  [
   "Forward surge current IFSM",
   "30 A, 8.3 ms half sine"
  ],
  [
   "ESD, IEC 61000-4-2",
   "30 kV air, 30 kV contact"
  ],
  [
   "Junction and storage temperature",
   "-55 °C to +150 °C"
  ]
 ],
