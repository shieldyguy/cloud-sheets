   "id": "esd-test-setup",
   "title": "ESD test setup",
   "page": 4,
   "fixture": true,
   "description": "Measurement of the clamping waveform. An ESD simulator gun discharges into the cathode of the diode under test, its return strap on the anode; the voltage across the diode runs down a 50 Ω coaxial cable to an oscilloscope input terminated in 50 Ω.",
   "parts": [
    {
     "ref": "G1",
