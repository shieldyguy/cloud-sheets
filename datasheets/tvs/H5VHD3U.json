 "name": "H5VHD3U",
 "kind": "tvs",
 "manufacturer": "Zhuhai Hongjiacheng Technology",
 "title": "Unidirectional 5 V high-capacitance ESD protection diode, SOD-323",
 "source": {
  "revision": "Rev 2.1",
  "pages": 3
 },
 "summary": "A single unidirectional transient-voltage suppressor in a two-lead SOD-323 package, for one line working up to 5 V. It withstands ±30 kV IEC 61000-4-2 discharges, air and contact, and 25 A of 8/20 µs surge, and clamps that surge to 14 V at most. Capacitance is high, 185 pF at most at 0 V, and leakage is 0.2 µA at most at 5 V. Uses named for it are laptops, mobile phones, digital cameras and PDAs.",
 "key_figures": [
