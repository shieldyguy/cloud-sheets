 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Uses",
   "page": 1,
   "text": "Named applications are laptop computers, cellular phones, digital cameras and personal digital assistants."
  },
  {
   "topic": "Protection ratings",
   "page": 1,
   "text": "Rated for ±30 kV IEC 61000-4-2 discharge by air and by contact, and for 25 A of IEC 61000-4-5 8/20 µs lightning surge; peak pulse power is 350 W at 8/20 µs."
  },
  {
   "topic": "Polarity and conduction",
   "page": 1,
   "text": "Unidirectional: reverse biased (cathode positive) it passes only leakage up to VRWM, breaks down above VBR and holds the line at VC while carrying IPP; forward biased it conducts like a diode at VF."
  },
  {
   "topic": "Pulse energy",
   "page": 2,
   "text": "Allowed peak pulse power falls with pulse length, from about 1.2 kW at 1 µs to about 0.07 kW at 1 ms."
  },
  {
   "topic": "Marking",
   "page": 1,
   "text": "The body carries the code D05 and a band at the cathode end."
  }
 ],
