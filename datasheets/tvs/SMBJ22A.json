 "source": {
  "revision": "Rev:2.0",
  "pages": 5
 },
 "summary": "A family of glass-passivated TVS diodes in the SMB (DO-214AA) surface-mount package, rated 600 W peak pulse power for a 10/1000 µs pulse. Stand-off voltages run from 3.3 V to 440 V with a 5 % breakdown tolerance, each as a unidirectional (A suffix) or bidirectional (CA suffix) part. SMBJ22A is the unidirectional 22 V stand-off part: breakdown 24.40 V to 26.90 V at 1 mA, clamping at 35.5 V max with 16.90 A peak pulse current.",
 "key_figures": [
  [
   "Peak pulse power PPPM",
   "600 W, 10/1000 µs"
  ],
  [
   "Stand-off voltage VRWM",
   "3.3 V to 440 V across the series; 22.0 V for SMBJ22A"
  ],
  [
   "Breakdown voltage VBR (SMBJ22A)",
   "24.40 V min, 26.90 V max at IT = 1 mA"
  ],
  [
   "Clamping voltage VC (SMBJ22A)",
   "35.5 V max at IPP = 16.90 A"
  ],
  [
   "Reverse leakage IR (SMBJ22A)",
   "5 µA max at VRWM"
  ],
  [
   "Forward surge IFSM",
