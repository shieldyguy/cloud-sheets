{
 "sheet": 1,
 "name": "PESD24VL1BA,115",
 "kind": "tvs",
 "manufacturer": "Nexperia",
 "title": "Low capacitance bidirectional ESD protection diode, 24 V, SOD323",
 "source": {
  "revision": "Product data sheet v.3, 11 April 2023",
  "pages": 11
 },
 "summary": "PESD24VL1BA guards a single signal line against electrostatic discharge and surge. It is bidirectional, standing off 24 V of either polarity, so it suits lines that swing above and below ground; it is not meant for a line tied to a DC supply. It takes a 3 A, 200 W 8/20 µs surge, clamping to 70 V at most, and 23 kV contact discharge, with 11 pF typical capacitance and 1 nA typical leakage. The package is the two-lead SOD323 (SC-76).",
 "key_figures": [
  [
   "Reverse standoff voltage VRWM",
   "24 V max"
  ],
  [
   "Breakdown voltage VBR",
   "25.4 V min, 27.8 V typ, 30.3 V max at IR = 5 mA"
  ],
  [
   "Clamping voltage VCL",
   "40 V max at IPP = 1 A; 70 V max at IPP = 3 A (8/20 µs)"
  ],
  [
   "Peak pulse current IPPM",
   "3 A (8/20 µs, IEC 61000-4-5)"
  ],
  [
   "Peak pulse power PPPM",
