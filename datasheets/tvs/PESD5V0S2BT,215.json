{
 "sheet": 1,
 "name": "PESD5V0S2BT,215",
 "kind": "tvs",
 "manufacturer": "Nexperia",
 "title": "Low capacitance bidirectional double ESD protection diode, SOT23",
 "source": {
  "revision": "Product data sheet, 23 August 2018 (v.4)",
  "pages": 12
 },
 "summary": "PESD5V0S2BT guards two signal lines against ESD and surge with two bidirectional clamp pairs in a three-lead SOT23 (TO-236AB) package; each line pin clamps to the shared pin 3. Stand-off is 5 V, capacitance 35 pF typical at 0 V, and leakage 5 nA typical. Each diode is rated for 12 A or 130 W of 8/20 µs surge, and the part for 30 kV of IEC 61000-4-2 contact discharge. It is AEC-Q101 qualified.",
 "key_figures": [
  [
   "Reverse standoff voltage VRWM",
   "5 V max"
  ],
  [
   "Breakdown voltage VBR",
   "5.5 V min, 9.5 V max at IR = 1 mA"
  ],
  [
   "Clamping voltage VCL",
   "10 V max at IPP = 1 A; 14 V max at IPPM = 12 A (8/20 µs)"
  ],
  [
   "Peak pulse power PPPM",
   "130 W per diode, 8/20 µs"
  ],
  [
   "Peak pulse current IPPM",
