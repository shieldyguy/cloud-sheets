 "circuits": [],
 "operation": [
  {
   "topic": "Clamping",
   "page": 1,
   "text": "Leakage is at most 1.0 µA at VRWM = 24 V. Breakdown lies between 26.5 V and 31 V at 1.0 mA in either polarity. The clamping voltage rises with peak current: 35 V max at 1 A and 50 V max at 6 A, 8/20 µs."
  },
  {
   "topic": "Surge waveforms",
   "page": 2,
   "text": "Surge ratings use the 8/20 µs current pulse: 8 µs to peak, 20 µs to half of peak. The IEC 61000-4-2 ESD current rises in 0.7 to 1.0 ns to an initial spike, then a slower second hump, passing 50 % of peak at 30 ns and 25 % at 60 ns."
  },
  {
   "topic": "Pulse power against duration",
   "page": 2,
   "text": "Peak pulse power falls with pulse length, from about 0.75 kW at 1 µs to under 0.1 kW at 1 ms, a straight line on log-log axes."
  }
 ],
