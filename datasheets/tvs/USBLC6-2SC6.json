 "equations": [
  {
   "name": "Positive clamping voltage",
   "expr": "VCL+ = VTRANSIL + VF",
   "where": {
    "VTRANSIL": "voltage across the VBUS-to-GND breakdown diode",
    "VF": "drop across the conducting steering diode"
   },
   "note": "Holds for a positive surge, ignoring track inductance.",
   "page": 4
  },
  {
   "name": "Negative clamping voltage",
   "expr": "VCL- = -VF",
   "where": {
    "VF": "drop across the conducting low steering diode"
   },
   "note": "Holds for a negative surge, ignoring track inductance.",
   "page": 4
  },
  {
   "name": "Steering diode drop",
   "expr": "VF = VT + Rd × Ip",
   "where": {
    "VT": "forward threshold voltage of the steering diode",
    "Rd": "dynamic resistance of the steering diode",
    "Ip": "surge peak current"
   },
   "note": "Example values: Rd = 0.5 Ω, VT = 1.1 V.",
   "page": 4
  },
  {
   "name": "Breakdown diode voltage",
   "expr": "VTRANSIL = VBR + Rd_TRANSIL × IP",
   "where": {
    "VBR": "breakdown voltage of the VBUS-to-GND diode",
    "Rd_TRANSIL": "dynamic resistance of that diode",
    "IP": "surge peak current"
   },
   "note": "Example values: Rd_TRANSIL = 0.5 Ω, VBR = 6.1 V.",
   "page": 4
  },
  {
   "name": "Surge peak current, first approximation",
   "expr": "Ip = Vg / Rg",
   "where": {
    "Vg": "ESD generator voltage",
    "Rg": "ESD generator series resistance"
   },
   "note": "IEC 61000-4-2 level 4 contact, Vg = 8 kV and Rg = 330 Ω, with VBUS = +5 V: Ip = 24 A, giving VCL+ = +31.2 V and VCL- = -13 V.",
   "page": 4
  },
  {
   "name": "Current slope",
   "expr": "dI/dt = Ip / tr",
   "where": {
    "tr": "surge rise time, 1 ns for IEC 61000-4-2"
   },
   "note": "With Ip = 24 A: 24 A/ns.",
   "page": 4
  },
  {
   "name": "Clamping voltage with track inductance",
   "expr": "VCL+ = VTRANSIL + VF + LI/O × dI/dt + LGND × dI/dt;  VCL- = -VF - LI/O × dI/dt - LGND × dI/dt",
   "where": {
    "LI/O": "inductance of the track from the data line to the I/O pin",
    "LGND": "inductance of the track from the GND pin to the ground plane"
   },
   "note": "Tracks 10 mm long and 0.5 mm wide are about 6 nH each; at 24 A/ns each adds 144 V, so VCL+ = +31.2 + 144 + 144 = 319.2 V and VCL- = -13.1 - 144 - 144 = -301.1 V.",
   "page": 4
  }
 ],
 "operation": [
  {
   "topic": "Structure",
   "page": 1,
   "text": "Each data line is a node between two small steering diodes: one with its anode on GND, one with its cathode on VBUS. A 6 V breakdown (Transil) diode joins VBUS to GND. Pins 1 and 6 are the two ends of line 1 and pins 3 and 4 the two ends of line 2, so a line can be routed straight through the package. VBUS gets protection of its own from the breakdown diode."
  },
  {
   "topic": "Clamping",
   "page": 4,
   "text": "A positive strike on a line turns on its high steering diode and is held at the breakdown diode's voltage plus one diode drop; a negative strike turns on the low steering diode and is held one diode drop below ground. Parasitic inductance is left out of these figures."
  },
  {
   "topic": "Layout",
   "page": 5,
   "text": "An ESD strike rises in 1 ns, so a few nanohenries in the I/O and GND tracks add hundreds of volts to the clamping voltage. The tracks from the data line to the I/O pins, from VCC to the VBUS pin and from the GND pin to the ground plane are kept as short as possible, with the data line routed through the pins rather than on a stub to them. The part goes as close as possible to the source of the disturbance, generally the connector. A 100 nF capacitor, CBUS, goes on VBUS at the part."
  },
  {
   "topic": "Crosstalk",
   "page": 7,
   "text": "Coupling between the two lines inside the die adds a fraction of one line's signal to the other; it matters most for fast or high-frequency signals and for a victim line carrying small signals or ending in a high impedance. Measured line-to-line, the coupling stays below -55 dB up to 240 MHz."
  },
  {
   "topic": "Signal bandwidth",
   "page": 7,
   "text": "Insertion loss (S21) stays near 0 dB up to a few hundred megahertz and falls off in the gigahertz range, so the part carries 480 Mb/s USB data and filters unwanted signals such as GSM at 900 MHz."
  },
  {
   "topic": "Simulation model",
   "page": 9,
   "text": "In the PSpice model, each cell has a series LI/O and RI/O at each end of each data line, with the line's middle node between a Dlow diode to an internal GND node and a Dhigh diode to an internal VBUS node; a Dzener joins the internal GND node to the internal VBUS node. The GND pin reaches its node through LGND and RGND, and the VBUS pin through RI/O and LI/O."
  },
  {
   "topic": "Packages",
   "page": 11,
   "text": "Epoxy is rated UL94 V0 and both packages are lead-free (ECOPACK). The SOT23-6L is marked UL26 and the SOT-666 is marked F, each with a dot beside the marking."
  }
 ],
