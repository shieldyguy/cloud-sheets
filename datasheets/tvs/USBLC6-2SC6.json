 "circuits": [
  {
   "id": "usb-device-port",
   "title": "USB 2.0 device upstream port",
   "page": 8,
   "description": "A USB 2.0 device transceiver behind its USB connector, with the USBLC6-2 at the connector. D+ runs through pins 1 and 6 and D- through pins 3 and 4, VBUS goes to pin 5 and ground to pin 2, so both data lines and the bus supply are clamped. The transceiver's receive and high-speed transmit pins sit straight on the lines; its low/full-speed transmit outputs drive them through the series resistors RS. RPU from +3.3 V is switched onto D- (SW2) for low speed or onto D+ (SW1) for full speed; for high speed SW1 is closed and then opened. C1 decouples VBUS to ground. The USBLC6-2P6 in SOT-666 takes the same place in the same circuit.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "USBLC6-2SC6",
     "note": "or USBLC6-2P6"
    },
    {
     "ref": "U2",
     "type": "ic",
     "value": "USB device upstream transceiver",
     "external": true
    },
    {
     "ref": "J1",
     "type": "connector",
     "value": "USB connector"
    },
    {
     "ref": "RPU",
     "type": "resistor",
     "value": "RPU",
     "note": "pull-up; no value given"
    },
    {
     "ref": "RS1",
     "type": "resistor",
     "value": "RS",
     "note": "series resistor; no value given"
    },
    {
     "ref": "RS2",
     "type": "resistor",
     "value": "RS",
     "note": "series resistor; no value given"
    },
    {
     "ref": "SW1",
     "type": "switch",
     "value": "SW1",
     "note": "pull-up onto D+"
    },
    {
     "ref": "SW2",
     "type": "switch",
     "value": "SW2",
     "note": "pull-up onto D-"
    },
    {
     "ref": "C1",
     "type": "capacitor",
     "value": "",
     "note": "VBUS decoupling; no value given"
    },
    {
     "ref": "P3V3",
     "type": "terminal",
     "value": "+3.3 V"
    }
   ],
   "notes": []
  },
  {
   "id": "ethernet-tx-rx",
   "title": "T1/E1/Ethernet line protection",
   "page": 8,
   "description": "Transmit and receive pairs of a T1, E1 or Ethernet port, each through its own line transformer. On the line side an SMP75-8 protector sits across each pair. On the transceiver side each pair passes through one USBLC6-2SC6: one wire through pins 4 and 3, the other through pins 6 and 1. Pin 5 of both parts goes to +VCC, decoupled to ground by 100 nF at each part, and pin 2 to ground.",
