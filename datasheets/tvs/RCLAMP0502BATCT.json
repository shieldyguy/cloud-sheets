{
 "sheet": 1,
 "name": "RCLAMP0502BATCT",
 "kind": "tvs",
 "manufacturer": "Semtech",
 "title": "Low-capacitance two-line TVS array for ESD and cable-discharge protection, 5 V, SC-75",
 "source": {
  "document": "RClamp0502BA",
  "revision": "Rev 4.0, 6/6/2017",
  "pages": 8
 },
 "summary": "RClamp0502BA is a pair of silicon-avalanche TVS diodes in a three-lead SC-75 (SOT-523) package, cathodes on pins 1 and 2 and the common anode on pin 3, for guarding high-speed data and RF lines against ESD, cable discharge events and fast transients. With the line on pin 1 or pin 2 and ground on the other it guards one bidirectional line with 0.5 pF typical capacitance; wired with lines on pins 1 and 2 and ground on pin 3 it guards two lines. Stand-off is 5 V, the IEC 61000-4-2 rating ±12 kV contact and ±18 kV air, and the 8/20 µs surge rating 5 A.",
 "key_figures": [
  [
   "Reverse stand-off voltage VRWM",
   "5 V max"
  ],
