   "Reverse breakdown voltage VBR",
   "6 V min at IBR = 1 mA, pin 1 or 2 to pin 3"
  ],
  [
   "Reverse leakage IR",
   "1 µA max at VRWM = 5 V"
  ],
  [
   "Clamping voltage VC",
   "15 V max at IPP = 1 A, 22 V max at 5 A (pin 1 or 2 to pin 3); 25 V max at 5 A between pins 1 and 2 (8/20 µs)"
  ],
  [
   "Peak pulse current IPP",
