 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Configuration",
   "page": 1,
   "text": "Inside, each I/O pin meets two steering diodes: one conducts from the I/O up to a common node, the other from pin 3 to the I/O. A single zener runs from that common node, its cathode, down to pin 3, its anode."
  },
  {
   "topic": "V-I characteristic",
   "page": 1,
   "text": "In reverse, the diode carries no more than IR up to VRWM, reaches IT at VBR, and holds VC while the peak pulse current IPP flows. In forward it conducts IF at VF."
  },
  {
   "topic": "Surge and ESD ratings",
   "page": 2,
   "text": "Surge figures use the 8/20 µs current pulse, which peaks at tr = 8 µs and decays to half its peak at td = 20 µs. The ESD figures follow IEC 61000-4-2, a current wave that rises in 0.7 to 1.0 ns and passes 50 % at 30 ns and 25 % at 60 ns. Peak pulse power falls with pulse length, from about 280 W at 1 µs to about 16 W at 1 ms. Clamping voltage climbs from about 6.8 V at 1 A to about 13.4 V at 5 A, flattening above 3 A."
  },
  {
   "topic": "Footprint",
   "page": 3,
   "text": "The pad layout is a reference; the assembler's own PCB design rules govern the final footprint."
  }
 ],
