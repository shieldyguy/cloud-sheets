{
 "sheet": 1,
 "name": "SMAJ200CA",
 "kind": "tvs",
 "manufacturer": "Littelfuse",
 "title": "SMAJ series: 400 W surface-mount TVS diodes, 5 V to 440 V stand-off, uni- and bi-directional, DO-214AC (SMA)",
 "source": {
  "revision": "Revised: BA.10/21/20",
  "pages": 6
 },
 "summary": "A family of transient voltage suppressor diodes in the DO-214AC (SMA) package, absorbing 400 W peak with a 10/1000 µs pulse (600 W for the stacked-die parts: SMAJ220CA, SMAJ250CA and the 300 V to 440 V parts). Stand-off voltages run from 5.0 V to 440 V, each offered as an A (uni-directional) or CA (bi-directional) part with a 5 % breakdown tolerance. SMAJ200CA is the bi-directional, single-die part with 200 V stand-off, 224 V minimum breakdown at 1 mA, and 324 V maximum clamping at 1.2 A.",
 "key_figures": [
  [
   "Peak pulse power PPPM, 10/1000 µs",
   "400 W single die; 600 W stacked die"
  ],
  [
   "Stand-off voltage VR",
   "5.0 V to 440 V (SMAJ200CA: 200 V)"
  ],
  [
   "Breakdown voltage VBR at IT",
   "SMAJ200CA: 224 V min, 247 V max at 1 mA"
  ],
  [
   "Clamping voltage VC at Ipp",
   "SMAJ200CA: 324 V max at 1.2 A"
  ],
  [
   "Reverse leakage IR at VR",
   "SMAJ200CA: 1 µA max"
  ],
  [
   "ESD, IEC 61000-4-2",
   "30 kV air, 30 kV contact"
  ],
  [
   "Steady-state power PD",
   "3.3 W on infinite heat sink, TL = 50 °C"
  ],
  [
   "Junction temperature",
   "-65 °C to 150 °C"
  ]
 ],
