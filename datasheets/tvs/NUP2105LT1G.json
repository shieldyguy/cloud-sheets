 "circuits": [
  {
   "id": "can-protection",
   "title": "High-speed and fault tolerant CAN TVS protection circuit",
   "page": 6,
   "description": "The two bus wires leave the CAN transceiver and run out to the bus. Pin 1 of the NUP2105L sits on CAN_H and pin 2 on CAN_L, with pin 3 to ground, so each wire has its own bidirectional clamp to ground. Inside, each clamp is two zener TVS junctions back to back, four alike in all.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "NUP2105LT1G"
    },
