 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Bidirectional clamping",
   "page": 1,
   "text": "The circuit symbol is a bidirectional TVS diode between the two terminals, so blocking and clamping apply in either polarity."
  },
  {
   "topic": "Test waveforms",
   "page": 2,
   "text": "Surge figures use the 8/20 µs current pulse, which peaks at 8 µs and has decayed to half its peak by 20 µs. The IEC 61000-4-2 ESD pulse rises in 0.7 to 1.0 ns; its current has fallen to 50 % of peak at 30 ns and 25 % at 60 ns."
  },
  {
   "topic": "Pulse power against duration",
   "page": 2,
   "text": "Allowed peak pulse power drops as the pulse lengthens, from about 325 W at 1 µs to about 22 W at 1 ms (Fig.3)."
  },
  {
   "topic": "Marking",
   "page": 1,
   "text": "The top of the body carries the code 3C and a cathode band at one end."
  },
  {
   "topic": "Land pattern",
   "page": 3,
   "text": "The suggested footprint is two pads 0.55 to 0.65 mm wide and 0.65 to 0.75 mm tall, their centres 1.37 to 1.47 mm apart."
  }
 ],
