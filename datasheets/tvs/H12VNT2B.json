 "operation": [
  {
   "topic": "Structure",
   "page": 1,
   "text": "Two bidirectional suppressor diodes share pin 3; pins 1 and 2 each connect to it through one of them, so each of the two lines is clamped in both polarities against pin 3."
  },
  {
   "topic": "Surge test waveform",
   "page": 2,
   "text": "Surge ratings use the 8/20 µs current pulse: it reaches its peak IPP at tr = 8 µs and decays to half of IPP at td = 20 µs."
  },
  {
   "topic": "ESD test waveform",
   "page": 2,
   "text": "The IEC 61000-4-2 discharge current has a rise time tr of 0.7 ns to 1.0 ns, and falls to 50 % of its peak by 30 ns and to 25 % by 60 ns."
  }
 ],
