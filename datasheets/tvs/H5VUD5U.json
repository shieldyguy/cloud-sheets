 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Internal arrangement",
   "page": 1,
   "text": "Between pins 2 and 1 sit two paths in parallel: a single diode with its anode at pin 2 and cathode at pin 1, and a breakdown diode in series with an opposing diode."
  },
  {
   "topic": "Current-voltage behaviour",
   "page": 1,
   "text": "The current-voltage characteristic marks forward voltage VF at forward current IF in the forward quadrant. In the reverse quadrant it marks leakage IR at the working voltage VRWM, breakdown voltage VBR at test current IT, and clamping voltage VC at peak pulse current IPP."
  },
  {
   "topic": "Surge and ESD ratings",
   "page": 2,
   "text": "The 8/20 µs surge pulse peaks at 8 µs and has fallen to half its peak at 20 µs. The IEC 61000-4-2 ESD current pulse rises in 0.7 to 1.0 ns and stands at about half its peak at 30 ns and a quarter at 60 ns. The part is rated for 5 A of IEC 61000-4-5 lightning surge, 8/20 µs."
  },
  {
   "topic": "Marking",
   "page": 1,
   "text": "The package top carries the code 5U and a cathode band."
  }
 ],
