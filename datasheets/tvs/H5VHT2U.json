 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Configuration",
   "page": 1,
   "text": "Pins 1 and 2 are each the cathode of a separate TVS diode; the two anodes join at pin 3."
  },
  {
   "topic": "V-I characteristic",
   "page": 1,
   "text": "In reverse, the diode carries no more than IR up to VRWM, reaches IT at VBR, and holds VC while the peak pulse current IPP flows. In forward it conducts IF at VF."
  },
  {
   "topic": "Surge and ESD ratings",
   "page": 2,
   "text": "Surge figures use the 8/20 µs current pulse, which peaks at tr = 8 µs and decays to half its peak at td = 20 µs. The ESD figures follow IEC 61000-4-2, a current wave that rises in 0.7 to 1.0 ns and passes 50 % at 30 ns and 25 % at 60 ns. Peak pulse power falls with pulse length, from about 680 W at 1 µs to about 140 W at 1 ms. Clamping voltage rises roughly in a straight line from about 7 V near zero current to 14 V at 25 A."
  },
  {
   "topic": "Footprint",
   "page": 3,
   "text": "The pad layout is a reference; the assembler's own PCB design rules govern the final footprint."
  }
 ],
