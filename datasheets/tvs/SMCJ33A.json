   "1500 W, 10/1000 µs waveform"
  ],
  [
   "Stand-off voltage VRWM",
   "5 V to 440 V"
  ],
  [
   "Breakdown voltage VBR",
   "6.4 V min (SMCJ5.0A) to 543 V max (SMCJ440A)"
  ],
  [
   "SMCJ33A",
   "VRWM 33 V; VBR 36.7 V to 40.6 V at 1 mA; VC 53.3 V at IPP 28.2 A; IR 1 µA"
