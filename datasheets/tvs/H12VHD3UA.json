 "sheet": 1,
 "name": "H12VHD3UA",
 "kind": "tvs",
 "manufacturer": "Zhuhai Hongjiacheng Technology",
 "title": "Unidirectional 12 V high-capacitance ESD protection diode, SOD-323",
 "source": {
  "revision": "Rev 2.1",
  "pages": 3
 },
 "summary": "A single unidirectional transient-voltage suppressor in a two-lead SOD-323 package, for one line working up to 12 V. It withstands ±30 kV IEC 61000-4-2 discharges, air and contact, and 100 A of 8/20 µs surge, and clamps that surge to 25 V at most. Capacitance is high, 350 pF at most at 0 V, and leakage is 0.5 µA at most at 12 V. Uses named for it are laptops, mobile phones, digital cameras and PDAs.",
 "key_figures": [
