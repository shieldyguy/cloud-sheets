 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Uses",
   "page": 1,
   "text": "Named applications are laptop computers, cellular phones, digital cameras and personal digital assistants."
  },
  {
   "topic": "Protection ratings",
   "page": 1,
   "text": "Rated for ±30 kV IEC 61000-4-2 discharge both by air and by contact, and for 100 A peak, 2500 W, of IEC 61000-4-5 8/20 µs lightning surge."
  },
  {
   "topic": "Polarity and conduction",
   "page": 1,
   "text": "Unidirectional: reverse biased (cathode positive) it passes only leakage up to VRWM, breaks down above VBR and holds the line at VC while carrying IPP; forward biased it conducts like a diode at VF."
  },
  {
   "topic": "Pulse energy",
   "page": 2,
   "text": "Allowed peak pulse power falls with pulse length, from about 15 kW at 1 µs to about 0.22 kW at 1 ms on a straight line in log-log scale."
  },
  {
   "topic": "Marking",
   "page": 1,
   "text": "The body carries the code 72D and a band at the cathode end."
  }
 ],
