   "Working voltage VRWM",
   "5.0 V max"
  ],
  [
   "Breakdown voltage VBR",
   "6.0 V min at IT = 1 mA"
  ],
  [
   "Reverse leakage IR",
   "5.0 µA max at VRWM = 5 V"
  ],
  [
   "Clamping voltage VC",
   "12.5 V max at 1 A; 17.5 V max at 5 A (8 × 20 µs)"
  ],
  [
   "Junction capacitance",
   "3.0 pF typ, 5.0 pF max I/O to GND; 1.5 pF typ, 3.0 pF max I/O to I/O"
  ],
