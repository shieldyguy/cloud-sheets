 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Configuration",
   "page": 1,
   "text": "Each of pins 1 and 2 is the cathode of its own TVS diode, and both anodes meet at pin 3. Junction capacitance is specified between pins 1 and 2."
  },
  {
   "topic": "V-I characteristic",
   "page": 1,
   "text": "In reverse, the diode carries no more than IR up to VRWM, reaches IT at VBR, and holds VC while the peak pulse current IPP flows. In forward it conducts IF at VF."
  },
  {
   "topic": "Surge and ESD ratings",
   "page": 1,
   "text": "Surge ratings use the 8/20 µs current pulse: peak at tr = 8 µs, back down to half the peak at td = 20 µs. The ESD ratings follow IEC 61000-4-2, whose current wave rises in 0.7 to 1.0 ns, passing 50 % at 30 ns and 25 % at 60 ns. Peak pulse power falls with longer pulses, from about 4 kW at 0.1 µs to about 30 W at 10 ms."
  },
  {
   "topic": "Footprint",
   "page": 3,
   "text": "The pad layout is a reference; the assembler's own PCB design rules govern the final footprint."
  }
 ],
