 "circuits": [],
 "equations": [],
 "operation": [
  {
   "topic": "Bidirectional clamping",
   "page": 1,
   "text": "The symbol is a bidirectional TVS between the two terminals, and the I-V characteristic is mirrored about the origin: IR at VRWM, IT at VBR and IPP at VC hold in both polarities."
  },
  {
   "topic": "Test waveforms",
   "page": 2,
   "text": "Surge ratings refer to the 8/20 µs current pulse, peaking at 8 µs and back to half its peak at 20 µs. The IEC 61000-4-2 ESD current rises in 0.7 to 1.0 ns and is down to 50 % of peak at 30 ns and 25 % at 60 ns."
  },
  {
   "topic": "Pulse power against duration",
   "page": 2,
   "text": "Peak pulse power falls with pulse length, from roughly 0.55 kW at 1 µs to roughly 0.02 kW near 1 ms (Fig.3)."
  },
  {
   "topic": "Clamping against current",
   "page": 2,
   "text": "Clamping voltage rises from about 11 V at 1 A to about 21 V at 5 A (Fig.4)."
  },
  {
   "topic": "Marking",
   "page": 1,
   "text": "The body is marked 5S, with a cathode band at one end."
  },
  {
   "topic": "Land pattern",
   "page": 3,
   "text": "Recommended pads are 0.55 to 0.65 mm wide (X) and 0.65 to 0.75 mm tall (Y), spaced 1.37 to 1.47 mm centre to centre (Z)."
  }
 ],
