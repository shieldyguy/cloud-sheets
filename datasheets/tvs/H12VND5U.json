 "equations": [],
 "operation": [
  {
   "topic": "Current-voltage behaviour",
   "page": 1,
   "text": "The current-voltage characteristic marks forward voltage VF at forward current IF in the forward quadrant. In the reverse quadrant it marks leakage IR at the working voltage VRWM, breakdown voltage VBR at test current IT, and clamping voltage VC at peak pulse current IPP."
  },
  {
   "topic": "Surge and ESD ratings",
   "page": 2,
   "text": "The 8/20 µs surge pulse peaks at 8 µs and has fallen to half its peak at 20 µs. The IEC 61000-4-2 ESD current pulse has a rise time of 0.7 to 1.0 ns and stands at about half its peak at 30 ns and a quarter at 60 ns."
  },
  {
   "topic": "Marking",
   "page": 1,
   "text": "The package top carries the code M12 and a cathode band."
  }
 ],
