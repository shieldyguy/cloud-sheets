{
 "sheet": 1,
 "name": "MC34673AEPR2",
 "kind": "battery_charger",
 "manufacturer": "Freescale Semiconductor (NXP)",
 "title": "28 V input, 1.2 A linear charger for one Li-Ion cell",
 "source": {
  "document": "MC34673",
  "revision": "Rev. 1.0, 01/2008 (Advance Information)",
  "pages": 22
 },
 "summary": "A linear charger for a single Li-Ion or Li-Polymer cell with the pass MOSFET, reverse blocking and current sensing on chip. It runs trickle, CC and CV phases to a fixed 4.2 V (±0.7% from -20 to 70 °C), with CC current up to 1.2 A set by one resistor, trickle at 20% and end of charge at 10% of that. The input survives 28 V and shuts off above 6.8 V; PPR, CHG and FAST open-drain flags report status, and ISET's voltage reads out the charge current.",
 "key_figures": [
  [
   "Input voltage",
   "2.6 V to 6.6 V operating, 28 V max"
  ],
  [
   "CC charge current",
   "0.05 A to 1.2 A"
  ],
  [
   "Regulated output",
   "4.20 V, 4.170 V to 4.230 V over -20 to 70 °C"
  ],
  [
   "OVP threshold",
   "6.8 V typ"
  ],
  [
   "RDS(ON)",
   "330 mΩ typ, 475 mΩ max"
  ],
  [
   "Battery drain off",
   "1.0 µA max"
  ],
  [
   "Package",
   "8-UDFN 2 × 3 mm"
  ]
 ],
 "part_numbers": {
  "page": 1,
  "columns": [
   "part number",
   "temperature range (TA)",
   "package"
  ],
  "rows": [
   [
    "MC34673AEP/R2",
    "-40°C to 85°C",
    "8-UDFN"
   ]
  ]
 },
 "pins": [
  {
   "package": "8-UDFN (EP suffix, 98ASA10774D)",
   "page": 3,
   "pins": [
    {
     "pin": "1",
     "name": "VIN",
     "type": "power in",
     "function": "Power input, rated to 28 V; decouple to ground with 1.0 µF."
    },
    {
     "pin": "2",
     "name": "PPR",
     "type": "open-drain output",
     "function": "Power-present flag, active low: pulls low whenever VIN is above VPOR, regardless of EN, OVP or the VIN-BAT comparator. Sinks at least 12 mA, enough for an LED."
    },
    {
     "pin": "3",
     "name": "CHG",
     "type": "open-drain output",
     "function": "Charge status, active low: low while a charge is under way, high-impedance after end of charge, when disabled, or when VIN is outside its power-good range. Sinks at least 12 mA."
    },
    {
     "pin": "4",
     "name": "EN",
     "type": "input",
     "function": "Enable, active low, with a weak internal pull-down: low or open enables the charger, high disables it."
    },
    {
     "pin": "5",
     "name": "GND",
     "type": "ground",
     "function": "Ground."
    },
    {
     "pin": "6",
     "name": "FAST",
     "type": "open-drain output",
     "function": "Fast-charge flag, active low: low while charging with the battery above the trickle threshold; high-impedance in trickle mode, shutdown or any fault. Sinks more than 0.3 mA; needs a pull-up."
    },
    {
     "pin": "7",
     "name": "ISET",
     "type": "analog",
     "function": "A resistor RISET from ISET to ground programs the CC-mode current. The pin sits at 1.0 V in CC mode and falls in step with the current in CV mode, so its voltage reads out the charge current."
    },
    {
     "pin": "8",
     "name": "BAT",
     "type": "power out",
     "function": "Charger output to the Li-Ion cell; decouple to ground with 2.2 µF or more."
    },
    {
     "pin": "EPAD",
     "name": "EPAD",
     "type": "thermal pad",
     "function": "Exposed pad for heat; solder it to a large ground copper area and tie it electrically to GND."
    }
   ]
  }
 ],
