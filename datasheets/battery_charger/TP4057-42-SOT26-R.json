{
 "sheet": 1,
 "name": "TP4057-42-SOT26-R",
 "kind": "battery_charger",
 "manufacturer": "TOPPOWER (Nanjing Top Power ASIC Corp.)",
 "title": "TP4057: 500 mA linear single-cell Li-ion charger with battery reverse protection, SOT-23-6",
 "source": {
  "revision": "no revision given",
  "pages": 12
 },
 "summary": "A constant-current, constant-voltage linear charger for one Li-ion cell, with an internal P-channel MOSFET, no sense resistor and no blocking diode. One resistor on PROG sets the charge current up to 500 mA; the float voltage is fixed at 4.2 V ±1 %, cells below 2.9 V are trickle-charged, and charging ends at one tenth of the set current, restarting below 4.1 V. Thermal regulation near 120 ℃ limits die temperature, a cell connected backwards stops charging and leaves both status pins high impedance, and two open-drain pins report charging and charge complete. It runs from 4 V to 9 V, including a USB port.",
 "key_figures": [
  [
   "Input voltage",
   "4.0 to 9.0 V"
  ],
  [
   "Charge current",
   "up to 500 mA, set by RPROG"
  ],
  [
   "Float voltage",
   "4.158 / 4.2 / 4.242 V (0℃ to 85℃, IBAT = 40 mA)"
  ],
  [
   "Trickle threshold",
   "2.9 V typ, trickle current 15 mA typ at RPROG = 10K"
  ],
