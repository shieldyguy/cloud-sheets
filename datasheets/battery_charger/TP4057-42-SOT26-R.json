 "pins": [
  {
   "package": "SOT-23-6",
   "page": 3,
   "pins": [
    {
     "pin": "1",
     "name": "CHRG",
     "type": "open-drain output",
     "function": "Charge status, active low. An internal switch holds it low while the cell is being charged; at all other times it is high impedance. With no battery fitted it pulses. It sinks up to 10 mA, enough for an indicator LED."
    },
    {
     "pin": "2",
     "name": "GND",
     "type": "ground",
     "function": "Ground."
    },
    {
     "pin": "3",
     "name": "BAT",
     "type": "power out",
     "function": "Charge output to the cell's positive terminal. An internal precision divider on this pin sets the 4.2 V float voltage; the divider is disconnected in shutdown."
    },
    {
     "pin": "4",
     "name": "VCC",
     "type": "power in",
     "function": "Supply input, 4 V to 9 V, bypassed with at least 1 μF. When VCC falls to within 30 mV of BAT the part shuts down and the current drawn from BAT drops below 2 μA."
    },
    {
     "pin": "5",
     "name": "STDBY",
     "type": "open-drain output",
     "function": "Charge-complete status, active low. Pulled low by an internal switch once charging has finished; high impedance otherwise."
    },
    {
     "pin": "6",
     "name": "PROG",
     "type": "analog",
     "function": "Charge current set, charge current monitor and shutdown. A 1 % resistor RPROG to ground sets the charge current, and the pin sits at 1 V during constant-current charge. Leaving it open lets an internal 2.5 μA current pull it up; at the 2.7 V shutdown threshold the charger stops and the supply current falls to 40 μA. Reconnecting RPROG to ground resumes normal operation."
    }
   ]
  }
 ],
