     "pin": "6",
     "name": "VDD3.3V",
     "type": "power",
     "function": "3.3 V supply."
    },
    {
     "pin": "7",
     "name": "1Y3",
     "type": "output",
     "function": "Clock output, a low-skew copy of CLKIN through an on-chip 25 Ω series resistor."
    },
    {
     "pin": "8",
     "name": "CLKOUT",
     "type": "output",
     "function": "Feedback output. The PLL feedback loop is closed inside the chip, so no external feedback connection is made to this pin. Capacitance placed on it shifts the input-to-output delay and can null the CLKIN-to-output delay. It is meant for delay tuning only and does not drive a trace."
    }
   ]
  }
