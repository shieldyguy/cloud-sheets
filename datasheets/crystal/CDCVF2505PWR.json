 "equations": [
  {
   "name": "Cycle-to-cycle jitter",
   "expr": "tc(jit_cc) = tc1 - tc2",
   "where": {
    "tc1": "one output clock period",
    "tc2": "the period that follows it"
   },
   "note": "",
   "page": 7
  },
  {
   "name": "Delta load",
   "expr": "Delta load = CLKOUT load - Yn load",
   "where": {
    "CLKOUT load": "capacitance on the CLKOUT pin",
    "Yn load": "capacitance on each Y output"
   },
   "note": "Equal loads (zero delta) give zero delay; the delay against delta load curve gives tpd for other deltas at 100 MHz.",
   "page": 11
  }
 ],
 "operation": [
  {
   "topic": "Architecture",
   "page": 8,
   "text": "CLKIN is a single high-impedance input feeding the phase comparator of an on-chip PLL whose loop filter is also on the die. The PLL's oscillator drives a tree of five buffers; one, CLKOUT, is fed back to close the loop, so the outputs line up with the input with a phase error small against the clock period: a zero-delay buffer. The loop bandwidth is wide enough to follow a spread-spectrum reference."
  },
  {
   "topic": "Outputs",
   "page": 1,
   "text": "Each Y output has a 25 Ω series damping resistor built in, suited to point-to-point loads. Output duty cycle is set to 50 % independent of the input duty cycle."
  },
  {
   "topic": "Lock",
   "page": 3,
   "text": "The PLL needs up to 100 µs to lock after power-up once a steady clock is present at CLKIN, and again after any change to the reference. Delay, skew and jitter figures apply only after lock."
  },
  {
   "topic": "Power-down",
   "page": 9,
   "text": "An edge detector on CLKIN switches the part between active and power-down by itself. The PLL turns on and starts to lock once the input rises past 20 MHz (typical); below 12 MHz (typical) it turns off and the outputs go high-impedance. The detector threshold is typically under 10 MHz. Power-down supply consumption is less than 100 mA typical."
  },
  {
   "topic": "Delay tuning",
   "page": 10,
   "text": "Capacitors placed at CLKOUT add delay to the feedback and so set where the outputs sit against CLKIN. Find the average load on Y0 to Y3, pick the phase wanted, and read a starting delta load from the delay against delta load curve: equal loads for zero delay, CLKOUT lighter than the Y outputs for CLKIN leading, heavier for CLKIN lagging."
  },
  {
   "topic": "Supply",
   "page": 12,
   "text": "Give the part at least 100 nF of local decoupling. Decoupling can be tuned to the board's plane capacitance and resonance at the clock frequency; TI application report SCAA045 covers it."
  },
  {
   "topic": "Layout",
   "page": 12,
   "text": "Run a solid ground or reference plane under the clock lines and the decoupling. Ground pour stitched with vias keeps the clock's spectral lines out of nearby circuits. Put the decoupling capacitors right at the package, on the top or bottom layer. Keep the CLKOUT connection to its tuning capacitors very short. Supply and ground pins want low-inductance, low-resistance connections."
  },
  {
   "topic": "Typical application",
   "page": 10,
   "text": "In an SDRAM system the part takes one clock and sends copies to the memory controller and to four SDRAMs; the controller exchanges data with the SDRAMs."
  },
  {
   "topic": "Handling",
   "page": 13,
   "text": "ESD protection is limited; store and handle with leads shorted or in conductive foam."
  }
 ],
