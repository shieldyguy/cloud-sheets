{
 "sheet": 1,
 "name": "CDCVF2505PWR",
 "kind": "crystal",
 "manufacturer": "Texas Instruments",
 "title": "CDCVF2505: 3.3 V PLL zero-delay clock driver, one input to four outputs plus feedback, 24 MHz to 200 MHz",
 "source": {
  "document": "SCAS640G",
  "revision": "July 2000, revised August 2016",
  "pages": 25
 },
 "summary": "A phase-locked-loop clock buffer that copies one clock input onto four outputs (1Y0 to 1Y3) and a fifth, CLKOUT, used to trim the input-to-output delay. The PLL aligns the outputs to CLKIN in frequency and phase, squares the output duty cycle to 50 % whatever the input duty cycle, and tracks a spread-spectrum input. The loop filter and a 25 Ω series resistor on each output are on the die; no external parts are needed beyond supply decoupling. With no input clock it powers down and its outputs go high-impedance. It runs from 3.3 V, from -40 °C to 85 °C, in 8-pin SOIC and TSSOP; CDCVF2505PWR is the TSSOP on a 2000-piece reel.",
 "key_figures": [
  [
   "Clock frequency",
   "24 MHz to 200 MHz at VDD = 3.3 V ±0.3 V; 42 MHz to 166 MHz at VDD = 2.7 V"
  ],
  [
   "Supply",
   "3 V to 3.6 V, 3.3 V nominal"
  ],
  [
   "Outputs",
   "four (1Y0 to 1Y3) plus CLKOUT, 25 Ω series resistor on each"
  ],
  [
   "Cycle-to-cycle jitter",
   "70 ps typ, 150 ps max at 66 MHz to 200 MHz"
  ],
  [
   "Output skew",
   "150 ps max"
  ],
