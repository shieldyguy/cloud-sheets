     "type": "output",
     "function": "Clock output, a low-skew copy of CLKIN through an on-chip 25 Ω series resistor."
    },
    {
     "pin": "3",
     "name": "1Y0",
     "type": "output",
     "function": "Clock output, a low-skew copy of CLKIN through an on-chip 25 Ω series resistor."
    },
    {
     "pin": "4",
     "name": "GND",
     "type": "power",
     "function": "Ground."
    },
    {
     "pin": "5",
     "name": "1Y2",
     "type": "output",
     "function": "Clock output, a low-skew copy of CLKIN through an on-chip 25 Ω series resistor."
    },
