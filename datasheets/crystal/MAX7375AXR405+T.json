 "circuits": [
  {
   "id": "typical",
   "title": "Typical application circuit",
   "page": 2,
   "description": "The oscillator clocks a microcontroller in place of its crystal. V+ takes the 2.7 V to 5.5 V supply with a bypass capacitor from V+ to ground, GND goes to ground, and CLOCK drives the microcontroller's OSC1 input directly. The microcontroller's OSC2 pin is left open.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "MAX7375"
    },
    {
     "ref": "U2",
     "type": "ic",
     "value": "microcontroller",
     "external": true
    },
    {
     "ref": "C1",
     "type": "capacitor",
     "value": "0.1 µF",
     "note": "surface-mount ceramic, mounted next to U1"
    },
    {
     "ref": "J_VIN",
     "type": "terminal",
     "value": "2.7 V to 5.5 V"
    }
   ],
   "notes": [
    "With a large capacitive load on CLOCK, C1 is at least 1000 times that load."
   ]
  }
 ],
 "equations": [
  {
   "name": "Bypass capacitor for a large capacitive load",
   "expr": "CBYPASS ≥ 1000 × CLOAD",
   "where": {
    "CBYPASS": "capacitor from V+ to GND",
    "CLOAD": "capacitance loading the CLOCK output"
   },
   "note": "",
   "page": 6
  },
  {
   "name": "Jitter against frequency",
   "expr": "jitter ∝ 1 / fCLOCK",
   "where": {
    "jitter": "peak-to-peak output jitter",
    "fCLOCK": "output frequency"
   },
   "note": "A 4 MHz version has about twice the jitter of an 8 MHz one.",
   "page": 5
  }
 ],
 "operation": [
  {
   "topic": "Frequency",
   "page": 2,
   "text": "Each version is trimmed to a single frequency at the factory and generates it directly, with no PLL. Nothing outside the part sets or tunes the frequency."
  },
  {
   "topic": "Output",
   "page": 5,
   "text": "CLOCK is a push-pull CMOS output with a nominal 50 % duty cycle. Loaded with 1 kΩ to ground or 500 Ω to V+, it swings to within 300 mV of the rail. It stays stable across the whole supply range and gives no short cycles while the supply comes up or goes down."
  },
  {
   "topic": "Supply",
   "page": 5,
   "text": "Specified for 2.7 V to 5.5 V, aimed at 3 V, 3.3 V and 5 V systems; outside that range operation carries no guarantee."
  },
  {
   "topic": "Start-up",
   "page": 6,
   "text": "Oscillation begins once V+ reaches about 1.65 V (typical, +25 °C) and settles within a few cycles. Devices clocked by the part are to be held off, by a reset or voltage detector, until 5 µs after V+ has passed 2.7 V."
  },
  {
   "topic": "Driving a microcontroller",
   "page": 6,
   "text": "CLOCK connects straight to a µP or µC clock input with no impedance matching. Run the oscillator and the clocked device from the same supply level, and check the clocked device's own limits for an external clock. No bias parts or load capacitors are used; when the part replaces a crystal, the crystal's biasing parts come off the oscillator input."
  },
  {
   "topic": "Decoupling",
   "page": 6,
   "text": "A 0.1 µF surface-mount ceramic from V+ to GND, as close to the part as possible, keeps its supply rejection. Placed next to the microcontroller's own decoupling capacitor, the part needs no extra one. With a large capacitive load, the bypass capacitor is at least 1000 times the load capacitance."
  },
  {
   "topic": "Jitter",
   "page": 5,
   "text": "The jitter figure is the peak-to-peak spread seen over 20 s on a 500 MHz oscilloscope. It scales roughly with the output period. Vibration, shock and EMI degrade any clock source; this part has no high-impedance nodes and is little affected by them."
  },
  {
   "topic": "Robustness",
   "page": 2,
   "text": "With strong output drive and no high-impedance nodes, the part tolerates vibration, EMI, dirt and humidity better than crystal and ceramic-resonator oscillator circuits."
  },
  {
   "topic": "Temperature range",
   "page": 6,
   "text": "Production test and qualification cover -40 °C to +125 °C. In characterization the part worked normally at +135 °C; operation beyond +125 °C is by arrangement with the factory."
  }
 ],
