 "manufacturer": "Maxim Integrated Products",
 "title": "MAX7375: 3-pin silicon oscillator, 600 kHz to 9.99 MHz, in SC70",
 "source": {
  "document": "19-3060",
  "revision": "Rev 3, 12/07",
  "pages": 8
 },
 "summary": "A clock source in a 3-pin SC70 that stands in for a crystal, ceramic resonator or oscillator module on a microcontroller or UART running from 2.7 V to 5.5 V. Each part is trimmed at the factory to one frequency between 600 kHz and 9.99 MHz and gives a push-pull, rail-to-rail square wave with no PLL and no parts round it to set the frequency. Seven standard frequencies are listed; MAX7375AXR405 runs at 4.00 MHz.",
 "key_figures": [
  [
   "Supply voltage",
   "2.7 V to 5.5 V"
  ],
  [
   "Frequency",
   "factory-set, 600 kHz to 9.99 MHz; MAX7375AXR405: 4.00 MHz"
  ],
  [
   "Initial accuracy",
   "±2 % at V+ = 3.0 V, +25 °C; ±4 % over V+ = 2.7 V to 5.5 V, +25 °C"
  ],
  [
   "Temperature sensitivity",
   "±50 ppm/°C typ, ±325 ppm/°C max"
  ],
  [
   "Supply current, MAX7375A_R405",
   "1.7 mA typ, 4.2 mA max"
  ],
  [
   "Duty cycle",
   "45 % min, 52 % typ, 57 % max"
  ],
  [
   "Output drive",
   "±10 mA; VOL 0.4 V max at 10 mA sink"
  ],
  [
   "Rise / fall time",
   "5.0 ns / 2.5 ns typ"
  ],
  [
   "Jitter",
   "160 psP-P typ (MAX7375A_R805)"
  ],
  [
   "Start-up",
   "within 5 µs of V+ passing 2.7 V"
  ],
  [
   "Temperature range",
   "-40 °C to +125 °C"
  ]
 ],
