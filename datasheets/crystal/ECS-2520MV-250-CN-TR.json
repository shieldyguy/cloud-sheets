 "operation": [
  {
   "topic": "Supply",
   "page": 1,
   "text": "One part works anywhere from 1.6 V to 3.6 V, covering 1.8 V, 2.5 V and 3.3 V rails. Maximum supply current climbs with both supply voltage and output frequency: from 2.5 mA at 1.8 V below 19 MHz to 8.5 mA at 3.3 V near 60 MHz, and 40 mA at any supply for frequencies up to 160 MHz."
  },
  {
   "topic": "Tri-state control",
   "page": 1,
   "text": "Pad 1 gates the output. Driven to at least 0.7 × Vdd, or left unconnected, the oscillator output is active. Driven to 0.3 × Vdd or lower, the output becomes high impedance."
  },
  {
   "topic": "Output",
   "page": 1,
   "text": "The output is CMOS, rated for up to 15 pF of load. Its low level is at most 10 % of Vdd and its high level at least 90 % of Vdd; edges take at most 7 ns between those points, and duty cycle at half Vdd stays within 45/55 %."
  },
  {
   "topic": "Frequency stability",
   "page": 1,
   "text": "Stability is given as one overall limit, from ±20 ppm (D) to ±100 ppm (A), and it already counts initial tolerance, temperature drift, supply and load changes, the shift after reflow and aging."
  },
  {
   "topic": "Start-up",
   "page": 1,
   "text": "Start-up time is 5 ms max, specified at 90 % Vdd."
  },
  {
   "topic": "Soldering and handling",
   "page": 2,
   "text": "Moisture sensitivity level 1, gold terminations. Reflow peaks at 260 ± 5 °C for 10 ± 5 s, with at most two reflow passes. Lead-free profiles hold above 217 °C, tin-lead above 183 °C, for 60 to 150 s."
  },
  {
   "topic": "Packing",
   "page": 2,
   "text": "Parts ship on 8.0 mm carrier tape with pockets at 4.0 mm pitch, 3000 to a 180 mm reel."
  }
 ],
