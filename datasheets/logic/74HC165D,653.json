{
 "sheet": 1,
 "name": "74HC165D,653",
 "kind": "logic",
 "manufacturer": "Nexperia",
 "title": "74HC165; 74HCT165: 8-bit parallel-in/serial-out shift register",
 "source": {
  "revision": "Rev. 8, 30 May 2024",
  "pages": 18
 },
 "summary": "An eight-stage shift register that loads eight bits at once from D0 to D7, or one at a time from DS, and sends the last stage out on Q7 together with its inverse on /Q7. Pulling /PL LOW loads the parallel inputs without waiting for a clock; with /PL HIGH and /CE LOW each rising edge of CP moves the data one stage along. The 74HC165 runs from 2.0 V to 6.0 V with CMOS input thresholds and the 74HCT165 from 4.5 V to 5.5 V with TTL thresholds.",
 "key_figures": [
  [
   "Supply voltage",
   "2.0 V to 6.0 V (74HC165); 4.5 V to 5.5 V (74HCT165)"
  ],
  [
   "Propagation delay CP or /CE to Q7",
   "19 ns typ at VCC = 4.5 V, CL = 50 pF (74HC165)"
  ],
  [
   "Maximum clock frequency",
   "51 MHz typ, 30 MHz min at VCC = 4.5 V, 25 °C (74HC165)"
  ],
  [
   "Output current",
   "±25 mA absolute maximum; -4.0 mA / 4.0 mA at VCC = 4.5 V in VOH / VOL"
  ],
  [
   "Supply current",
   "8.0 µA max at 25 °C, VCC = 6.0 V, static"
  ],
  [
   "Input overvoltage tolerance",
   "15 V"
  ],
  [
   "Ambient temperature",
   "-40 °C to +125 °C"
  ],
  [
   "Packages",
   "SO16, TSSOP16, DHVQFN16"
  ]
 ],
