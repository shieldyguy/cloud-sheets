{
 "sheet": 1,
 "name": "74LVC1G125GV-TP",
 "kind": "logic",
 "manufacturer": "TECH PUBLIC",
 "title": "Single bus buffer / line driver with 3-state output",
 "source": {
  "revision": "",
  "pages": 9
 },
 "summary": "One non-inverting buffer with an active-LOW output enable in a five-lead SOT23-5. With G low, Y follows A; with G high, Y goes high-impedance. It runs from 1.65 V to 5.5 V, its inputs tolerate 5.5 V, and its output withstands 5.5 V with VCC = 0 V or in the high-impedance state. The output sources and sinks 24 mA at 3.0 V, with a 2.6 ns typical delay at 5.0 V into 50 pF.",
 "key_figures": [
  [
   "Function",
   "Y = A when G = L; Y high-impedance when G = H"
  ],
  [
   "Supply voltage",
   "1.65 V to 5.5 V (1.5 V for data retention only)"
  ],
  [
   "Input voltage",
   "0 V to 5.5 V"
  ],
  [
   "Output current",
   "±24 mA min at VCC = 3.0 V"
  ],
  [
   "Propagation delay",
   "2.6 ns typ at VCC = 5.0 V, CL = 50 pF, RL = 500 Ω, 25 °C"
  ],
  [
   "Quiescent supply current",
   "2 µA max at 25 °C, VCC = 5.5 V"
  ],
  [
   "Operating temperature",
   "-40 °C to 85 °C; -40 °C to 125 °C for J(CT order codes"
  ],
  [
   "Package",
   "SOT23-5"
  ]
 ],
