{
 "sheet": 1,
 "name": "NC7SZ125P5X",
 "kind": "logic",
 "manufacturer": "onsemi",
 "title": "Single non-inverting 3-state buffer, TinyLogic UHS",
 "source": {
  "revision": "NC7SZ125/D Rev. 7, August 2024",
  "pages": 12
 },
 "summary": "A single non-inverting CMOS buffer whose output goes to high impedance when the active-LOW enable OE is HIGH. It runs from 1.65 V to 5.5 V, accepts up to 5.5 V on its inputs whatever the supply, and with VCC at 0 V the inputs and output are high impedance; a disabled output withstands voltages above VCC. The output drives 24 mA at 3 V, and the typical delay is 2.6 ns into 50 pF at 5 V. It comes in SC-74A, SC-88A and two six-pad MicroPak packages.",
 "key_figures": [
  [
   "Function",
   "Y = A when OE = L; Y high impedance when OE = H"
  ],
  [
   "Supply voltage",
   "1.65 V to 5.5 V operating; 1.50 V data retention"
  ],
  [
   "Input voltage",
   "0 V to 5.5 V, independent of VCC"
  ],
  [
   "Output drive",
   "IOH = -24 mA / IOL = 24 mA at VCC = 3.00 V"
  ],
  [
   "Propagation delay",
   "2.6 ns typ, 5.0 ns max at VCC = 5.0 V, CL = 50 pF, 25 °C"
  ],
  [
   "Quiescent supply current",
   "2 µA max at 25 °C; 20 µA max at -40 °C to +85 °C"
  ],
  [
   "Operating temperature",
   "-40 °C to +85 °C"
  ],
  [
   "Packages",
   "SC-74A, SC-88A, MicroPak, MicroPak2"
  ]
 ],
