 "operation": [
  {
   "topic": "Output enable",
   "page": 2,
   "text": "OE is active LOW. With OE LOW, Y drives the logic level on A; with OE HIGH, Y is high impedance regardless of A."
  },
  {
   "topic": "Supply range",
   "page": 1,
   "text": "Specified for operation with VCC from 1.65 V to 5.5 V. The data-retention supply range is 1.50 V to 5.50 V."
  },
  {
   "topic": "Overvoltage-tolerant inputs",
   "page": 1,
   "text": "Both inputs accept up to 5.5 V whatever VCC is, which allows 5 V to 3 V translation."
  },
  {
   "topic": "Power-down and three-state behaviour",
   "page": 1,
   "text": "With VCC at 0 V the inputs and output present a high impedance to ground (IOFF 1 µA max at 25 °C with 5.5 V applied). When disabled, the output may be pulled above VCC, up to 5.5 V."
  },
  {
   "topic": "Output drive",
   "page": 1,
   "text": "The output sources and sinks 24 mA at VCC = 3 V and 32 mA at 4.5 V, and at 3.3 V its performance equals that of the LCX family. It includes noise and EMI reduction circuitry."
  },
  {
   "topic": "Unused inputs",
   "page": 3,
   "text": "Every unused input is tied to a HIGH or LOW level; none may float."
  },
  {
   "topic": "Input edges",
   "page": 3,
   "text": "Input transitions should be no slower than 20 ns/V at 1.8 V and 2.5 V supplies, 10 ns/V at 3.3 V and 5 ns/V at 5.0 V."
  },
  {
   "topic": "Timing reference levels",
   "page": 6,
   "text": "Propagation delays and enable times are measured from the 50% point of the input edge to the 50% point of the output, with 3 ns input edges between 10% and 90%. Disable times end when the output has moved 0.3 V from VOL (tPLZ) or from VOH (tPHZ) toward the three-state level VTRI."
  }
 ],
