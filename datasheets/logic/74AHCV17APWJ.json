 "title": "Hex buffer with Schmitt-trigger inputs",
 "source": {
  "document": "74AHCV17A",
  "revision": "Rev. 3, 23 January 2024",
  "pages": 11
 },
 "summary": "Six non-inverting buffers, each with a Schmitt-trigger input, in a 14-lead TSSOP. Hysteresis on every input turns slowly changing signals into sharp, jitter-free output edges. The inputs accept up to 5.5 V at any supply from 1.8 V to 5.5 V, so the part can shift levels between supply domains, and IOFF protection lets a powered-down device sit on a live bus without current flowing back into it.",
 "key_figures": [
  [
   "Supply",
   "1.8 V to 5.5 V"
  ],
  [
   "Propagation delay",
   "3.2 ns typ at 5 V, CL = 15 pF; 4.5 ns typ at 5 V, CL = 50 pF"
  ],
  [
   "Hysteresis",
   "0.5 V to 1.6 V at VCC = 5.5 V"
  ],
  [
   "Output drive",
   "±8 mA at 3.0 V, ±16 mA at 4.5 V"
  ],
  [
   "Output noise at 3.3 V",
   "VOL(p) under 0.8 V typ, VOH(v) over 2.3 V typ (Tamb = 25 °C)"
  ],
  [
   "Supply current",
   "2 µA max at 25 °C, 20 µA max to 125 °C (VCC = 5.5 V, static)"
  ],
  [
   "Power-off leakage IOFF",
   "0.5 µA max at 25 °C, 5 µA max over temperature"
  ],
  [
   "Input voltage",
   "0 V to 5.5 V at any VCC"
  ],
  [
   "ESD",
   "HBM over 3000 V (JS-001 class 2); CDM over 2000 V (JS-002 class C3)"
  ],
  [
   "Latch-up",
   "over 250 mA, JESD 78 Class II"
  ],
  [
   "Temperature",
   "-40 °C to +125 °C"
  ]
 ],
