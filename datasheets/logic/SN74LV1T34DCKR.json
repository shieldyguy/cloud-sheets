{
 "sheet": 1,
 "name": "SN74LV1T34DCKR",
 "kind": "logic",
 "manufacturer": "Texas Instruments",
 "title": "Single non-inverting buffer with low-threshold, 5.5 V tolerant input, single-supply level shifter",
 "source": {
  "revision": "SCLS743B, December 2013, revised June 2017",
  "pages": 22
 },
 "summary": "One CMOS buffer gate, Y = A, in a five-lead SOT-23 or SC70 package, running from 1.6 V to 5.5 V. Its input switches at lowered thresholds (VIH 1.37 V min at VCC = 3 V to 3.3 V) and accepts up to 5.5 V whatever the supply, so one part shifts a logic signal up (1.8 V to 3.3 V at VCC = 3.3 V) or down (5 V to 3.3 V at VCC = 3.3 V). The output swings rail to rail of VCC and drives up to 8 mA at 5 V. Rated from -40 °C to +125 °C.",
 "key_figures": [
  [
   "Function",
   "Y = A, one non-inverting buffer"
  ],
  [
   "Supply voltage",
   "1.6 V to 5.5 V recommended operating range; 1.65 V to 5.5 V operating range in the features"
  ],
  [
   "Input voltage",
   "0 V to 5.5 V at any VCC"
  ],
  [
   "Input high threshold",
   "VIH 1.37 V min at VCC = 3 V to 3.3 V, 25 °C; 2.02 V min at VCC = 4.5 V to 5 V"
  ],
  [
   "Output drive",
   "-8 mA / 8 mA at VCC = 5 V; -7 / 7 mA at 3.3 V; -3 / 3 mA at 1.8 V"
  ],
  [
   "Propagation delay",
   "3 ns typ, 6.5 ns max at VCC = 5.0 V, CL = 30 pF, 25 °C; 4.9 ns typ at 3.3 V, 30 pF"
  ],
  [
   "Operating frequency",
   "DC to 50 MHz at 3.3 V and 5.0 V; 25 MHz at 2.5 V; 15 MHz at 1.8 V"
  ],
  [
   "Supply current",
   "1 µA max at 25 °C, 10 µA max over -40 °C to +125 °C, static"
  ],
  [
   "ESD",
   "2000 V HBM, 1000 V CDM, 200 V MM"
  ],
  [
   "Latch-up",
   "above 250 mA per JESD 17"
  ],
  [
   "Ambient temperature",
   "-40 °C to +125 °C"
  ],
  [
   "Packages",
   "SOT-23 (DBV, 5 pins, 2.90 mm × 1.60 mm); SC70 (DCK, 5 pins, 2.00 mm × 1.25 mm)"
  ]
 ],
