 "sheet": 1,
 "name": "SN74LVC2G14DBVT",
 "kind": "logic",
 "manufacturer": "Texas Instruments",
 "title": "Dual Schmitt-trigger inverter, 1.65 V to 5.5 V",
 "source": {
  "revision": "SCES200O, April 1999, revised August 2015",
  "pages": 28
 },
 "summary": "Two independent CMOS inverters with Schmitt-trigger inputs, Y = NOT A, running from 1.65 V to 5.5 V in a six-lead SOT-23 (DBV), SC70 (DCK) or a six-ball DSBGA (YZP). The inputs take up to 5.5 V at any supply, so a gate also brings 5 V or 3.3 V logic down to its own VCC. Outputs sink and source 24 mA at 3.3 V and switch off when the part is unpowered (Ioff). Rated from -40 °C to 125 °C.",
 "key_figures": [
  [
   "Function",
   "two inverters with Schmitt-trigger inputs, Y = NOT A"
  ],
  [
   "Supply voltage",
   "1.65 V to 5.5 V; data retention to 1.5 V"
  ],
  [
   "Input voltage",
   "0 V to 5.5 V at any VCC"
  ],
  [
   "Hysteresis",
   "0.4 V to 1.1 V at VCC = 3 V; 0.7 V to 1.4 V at 5.5 V"
  ],
  [
   "Output drive",
   "±24 mA at 3 V; ±32 mA at 4.5 V; ±4 mA at 1.65 V"
  ],
  [
   "Propagation delay",
   "5.4 ns max at 3.3 V ± 0.3 V; 4.3 ns max at 5 V ± 0.5 V (-40 °C to 85 °C)"
  ],
  [
   "Supply current",
   "10 μA max static"
  ],
  [
   "Ioff",
   "±10 μA max at VCC = 0"
  ],
  [
   "Temperature",
   "-40 °C to 125 °C"
  ],
  [
   "Packages",
   "SOT-23 (DBV), 2.90 mm × 1.60 mm; SC70 (DCK), 2.00 mm × 1.25 mm; DSBGA (YZP), 1.41 mm × 0.91 mm"
  ]
 ],
