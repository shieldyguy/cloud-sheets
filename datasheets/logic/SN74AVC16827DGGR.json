{
 "sheet": 1,
 "name": "SN74AVC16827DGGR",
 "kind": "logic",
 "manufacturer": "Texas Instruments",
 "title": "20-bit buffer/driver with 3-state outputs",
 "source": {
  "revision": "SCES176I, December 1998, revised June 2005",
  "pages": 21
 },
 "summary": "A 20-bit non-inverting buffer/driver of the AVC family, split into two 10-bit banks, each with its own pair of active-low output enables. It runs from 1.2 V to 3.6 V (designed for 1.65 V to 3.6 V), has overvoltage-tolerant I/O and Ioff for partial power-down, and its dynamic output control lowers output impedance during an edge and raises it afterwards to reduce noise. Offered in 56-pin TSSOP (DGG) and TVSOP (DGV).",
 "key_figures": [
  [
   "Channels",
   "20 (2 × 10), non-inverting, 3-state"
  ],
  [
   "Supply",
   "1.2 V to 3.6 V"
  ],
  [
   "Propagation delay",
   "1.7 ns max at 3.3 V ± 0.3 V; 1.9 ns max at 2.5 V ± 0.2 V"
  ],
  [
   "Static output current",
   "±12 mA at 3 V to 3.6 V"
  ],
  [
   "Supply current",
   "40 µA max at 3.6 V"
  ],
  [
   "Operating temperature",
   "–40°C to 85°C"
  ],
  [
   "Packages",
   "TSSOP-56 (DGG), TVSOP-56 (DGV)"
  ]
 ],
