{
 "sheet": 1,
 "name": "74AHC1G125GW,125-JSM",
 "kind": "logic",
 "manufacturer": "JSMSEMI",
 "title": "Single non-inverting buffer/line driver with 3-state output (74AHC1G125, 74AHCT1G125)",
 "source": {
  "revision": "V1.0",
  "pages": 15
 },
 "summary": "One non-inverting buffer whose output goes to high impedance when the active-low enable OE is high. The 74AHC1G125 takes CMOS input levels and runs from 2 V to 5.5 V; the 74AHCT1G125 takes TTL input levels and runs from 4.5 V to 5.5 V. Output impedance is symmetrical, propagation delays are balanced, and both come in SOT23-5 and SOT353 for -40 °C to +125 °C. 74AHC1G125GW,125-JSM is the CMOS-level part in SOT353.",
 "key_figures": [
  [
   "Supply voltage",
   "2.0 V to 5.5 V (74AHC1G125); 4.5 V to 5.5 V (74AHCT1G125)"
  ],
  [
   "Propagation delay A to Y",
   "4.8 ns typ, 7.5 ns max at VCC = 4.5 V to 5.5 V, CL = 50 pF, 25 °C"
  ],
  [
   "Output drive",
   "±8 mA at VCC = 4.5 V (VOH ≥ 3.94 V, VOL ≤ 0.36 V at 25 °C)"
  ],
  [
   "Quiescent supply current",
   "1.0 µA max at 25 °C, 40 µA max at -40 °C to +125 °C"
  ],
  [
   "Off-state output current",
   "1.0 µA max at 25 °C"
  ],
  [
   "Power dissipation capacitance",
   "9 pF (74AHC1G125), 11 pF (74AHCT1G125)"
  ],
  [
   "Ambient temperature",
   "-40 °C to +125 °C"
  ]
 ],
