 "manufacturer": "HGSEMI (Huaguan Semiconductor)",
 "title": "74HC02: four 2-input NOR gates in high-performance silicon-gate CMOS",
 "source": {
  "revision": "V1.4, April 2026",
  "pages": 9
 },
 "summary": "Four independent 2-input NOR gates in silicon-gate CMOS, running from 2.0 V to 6.0 V. Each output is high only when both of its inputs are low. Outputs drive up to 10 LSTTL loads and connect straight to CMOS, NMOS or TTL inputs; input current is at most 1 µA. It comes in DIP-14, SOP-14, TSSOP-14 and a 3 mm QFN-16; 74HC02N is the DIP-14 part, supplied in tubes.",
 "key_figures": [
  [
   "Supply voltage VCC",
   "2.0 V to 6.0 V"
  ],
  [
   "Function",
   "4 × 2-input NOR, Y = NOT(A + B)"
  ],
  [
   "Propagation delay tPLH, tPHL",
   "15 ns max at VCC = 4.5 V, -40 °C to 25 °C, CL = 50 pF"
  ],
  [
   "Output drive",
   "10 LSTTL loads; VOH/VOL specified at |Iout| up to 5.2 mA (VCC = 6.0 V)"
  ],
  [
   "Input leakage Iin",
   "0.1 µA max at 25 °C, 1.0 µA max to 125 °C, VCC = 6.0 V"
  ],
  [
