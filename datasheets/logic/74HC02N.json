 "equations": [
  {
   "name": "Gate function",
   "expr": "Y = NOT(A + B)",
   "where": {
    "A": "input A of the gate",
    "B": "input B of the gate",
    "Y": "output of the same gate"
   },
   "note": "",
   "page": 2
  }
 ],
 "operation": [
  {
   "topic": "Logic",
   "page": 2,
   "text": "The four NOR gates share only the supply and ground pins. A gate's output goes high when A and B are both low, and low when either input is high."
  },
  {
   "topic": "Gate structure",
   "page": 5,
   "text": "Inside one gate, A and B each pass through an inverter, the two inverted signals meet a NAND stage, and an output inverter follows it. The device holds 40 FETs, equal to 10 gates."
  },
  {
   "topic": "Levels and interfacing",
   "page": 1,
   "text": "An output can drive 10 LSTTL loads and connects directly to CMOS, NMOS and TTL inputs. Input current is at most 1 µA, and noise immunity is that of CMOS logic."
  },
  {
   "topic": "Input and output limits",
   "page": 3,
   "text": "For correct operation keep every input and output voltage between GND and VCC. An unused input must not float: connect it to GND or VCC. An unused output stays unconnected."
  },
  {
   "topic": "Input edges",
   "page": 3,
   "text": "Input rise and fall times should stay under 1000 ns at VCC = 2.0 V, 500 ns at 4.5 V and 400 ns at 6.0 V."
  },
  {
   "topic": "Standards and materials",
   "page": 1,
   "text": "The part meets JEDEC Standard No. 7A and is lead-free."
  }
 ],
