{
 "sheet": 1,
 "name": "HEF4094BT,653",
 "kind": "logic",
 "manufacturer": "Nexperia",
 "title": "8-stage shift-and-store register with 3-state outputs",
 "source": {
  "revision": "Rev. 14, 8 July 2021",
  "pages": 15
 },
 "summary": "The HEF4094B is a CMOS 8-bit shift register with serial input D, followed by an 8-bit storage register whose contents drive eight 3-state parallel outputs QP0 to QP7. Data shifts on the rising edge of CP; STR HIGH copies the shift register into the storage register, and OE LOW floats the parallel outputs without touching either register. Two serial outputs allow chaining: QS1 changes on the rising clock edge, QS2 on the falling edge that follows. It runs from 3 V to 15 V, with figures at 5 V, 10 V and 15 V.",
 "key_figures": [
  [
   "Supply",
   "3 V to 15 V (18 V absolute maximum)"
  ],
  [
   "Shift clock",
   "fmax 10 MHz typ, 5 MHz min at VDD = 5 V; 28 MHz typ at 15 V"
  ],
  [
   "CP to QS1 delay",
   "135 ns typ tPHL, 105 ns typ tPLH at VDD = 5 V, 25 °C"
  ],
  [
   "Output drive",
   "IOL 0.64 mA min at 5 V, 4.2 mA min at 15 V (-40 °C)"
  ],
  [
   "Quiescent current",
   "5 μA max at 5 V, 25 °C; 600 μA max at 15 V, 125 °C"
  ],
  [
   "ESD",
   "HBM above 2000 V; MM above 200 V"
  ],
  [
   "Temperature",
   "-40 °C to +125 °C"
  ]
 ],
