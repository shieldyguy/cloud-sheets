 "operation": [
  {
   "topic": "Shifting",
   "page": 1,
   "text": "Each rising CP edge moves the level on D into stage 0 and every stage's bit into the next. Operation is fully static."
  },
  {
   "topic": "Serial outputs",
   "page": 1,
   "text": "QS1 takes the stage-7 bit on the rising CP edge, which suits chaining with fast clock edges. QS2 presents the same bit after the following falling CP edge for chaining with slow clock edges."
  },
  {
   "topic": "Storage register",
   "page": 1,
   "text": "While STR is HIGH the storage register follows the shift register; while STR is LOW it holds, so the outputs stay put during shifting."
  },
  {
   "topic": "Output enable",
   "page": 1,
   "text": "OE HIGH lets the storage register drive QP0 to QP7; OE LOW puts them in the high-impedance OFF-state. OE changes neither register, and the serial outputs keep running with OE LOW."
  },
  {
   "topic": "Input clamps",
   "page": 1,
   "text": "Every input has clamp diodes, so with a series current-limiting resistor an input can be driven from a voltage above VDD."
  },
  {
   "topic": "Output characteristics",
   "page": 1,
   "text": "Outputs have standardized symmetrical drive; the part complies with JEDEC JESD 13-B. Limits are given for -40 °C, +25 °C, +85 °C and +125 °C."
  },
  {
   "topic": "Applications",
   "page": 10,
   "text": "Serial-to-parallel conversion; holding register for remote control."
  }
 ],
