 "title": "Single inverter, AHC (CMOS input) and AHCT (TTL input)",
 "source": {
  "revision": "Rev. 12, 8 September 2023",
  "pages": 12
 },
 "summary": "One CMOS inverter gate in a five- or six-terminal package. The 74AHC1G04 runs from 2.0 V to 5.5 V and switches at CMOS input thresholds; the 74AHCT1G04 runs from 4.5 V to 5.5 V and switches at TTL thresholds. The input accepts up to 5.5 V whatever the supply, so the gate can shift levels between two supply domains. Rated from -40 °C to +125 °C.",
 "key_figures": [
  [
   "Function",
   "Y = NOT A, one gate"
  ],
  [
   "Supply voltage",
   "2.0 V to 5.5 V (74AHC1G04); 4.5 V to 5.5 V (74AHCT1G04)"
  ],
  [
   "Input voltage",
   "0 V to 5.5 V, independent of VCC"
  ],
  [
   "Propagation delay",
   "4.5 ns typ, 7.5 ns max at VCC = 4.5 V to 5.5 V, CL = 50 pF, 25 °C (74AHC1G04)"
  ],
  [
   "Output drive",
   "VOH 3.94 V min at IO = -8.0 mA, VOL 0.36 V max at IO = 8.0 mA (VCC = 4.5 V, 25 °C); IO ±25 mA absolute maximum"
  ],
  [
   "Supply current",
   "1.0 µA max at 25 °C, 40 µA max over -40 °C to +125 °C, static, VCC = 5.5 V"
  ],
  [
   "ESD",
   "HBM above 2000 V (JS-001 class 2); CDM above 1000 V (JS-002 class C3)"
  ],
  [
   "Ambient temperature",
   "-40 °C to +125 °C"
  ],
  [
   "Packages",
   "TSSOP5 (SOT353-1), SC-74A (SOT753), XSON6 (SOT886)"
  ]
