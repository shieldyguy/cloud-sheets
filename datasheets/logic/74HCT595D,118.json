 "operation": [
  {
   "topic": "Shifting",
   "page": 1,
   "text": "On each rising SHCP edge the level at DS goes into stage 0 and every stage passes its bit to the next. Stage 7 appears on Q7S, which feeds DS of another device to build a longer chain."
  },
  {
   "topic": "Storage and outputs",
   "page": 1,
   "text": "A rising STCP edge copies the eight shift stages into the storage register. Its contents drive Q0 to Q7 while OE is LOW; OE HIGH floats them. OE leaves both registers unchanged."
  },
  {
   "topic": "Common clock",
   "page": 1,
   "text": "With SHCP and STCP tied together, the storage register always holds the data one clock behind the shift register."
  },
  {
   "topic": "Reset",
   "page": 1,
   "text": "MR LOW clears the shift register at once, independent of the clocks. The storage register keeps its contents until the next STCP edge."
  },
  {
   "topic": "Input clamps",
   "page": 1,
   "text": "Every input has clamp diodes, so a series current-limiting resistor lets an input be driven from a voltage above VCC."
  },
  {
   "topic": "Input levels",
   "page": 1,
   "text": "74HC595 inputs use CMOS levels; 74HCT595 inputs use TTL levels. The part meets JESD8C (2.7 V to 3.6 V) and JESD7A (2.0 V to 6.0 V)."
  },
  {
   "topic": "Applications",
   "page": 1,
   "text": "Serial-to-parallel conversion; holding register for remote control."
  }
 ],
