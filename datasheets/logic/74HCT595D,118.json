{
 "sheet": 1,
 "name": "74HCT595D,118",
 "kind": "logic",
 "manufacturer": "Nexperia",
 "title": "8-bit shift register with output latches and 3-state parallel outputs",
 "source": {
  "revision": "Rev. 12, 20 March 2024",
  "pages": 21
 },
 "summary": "The 74HC595 and 74HCT595 pair an 8-stage serial shift register with an 8-bit storage register that drives eight 3-state outputs Q0 to Q7, plus a serial output Q7S for chaining devices. Each register has its own rising-edge clock; an active-LOW reset clears the shift register and an active-LOW enable floats the parallel outputs. The 74HC595 runs from 2.0 V to 6.0 V with CMOS input levels, the 74HCT595 from 4.5 V to 5.5 V with TTL input levels.",
 "key_figures": [
  [
   "Supply",
   "2.0 V to 6.0 V (74HC595); 4.5 V to 5.5 V (74HCT595)"
  ],
  [
   "Shift clock",
   "100 MHz typical; fmax 91 MHz typ, 30 MHz min at VCC = 4.5 V, 25 °C (74HC595)"
  ],
  [
   "SHCP to Q7S delay",
   "19 ns typ, 32 ns max at VCC = 4.5 V, 25 °C (74HC595)"
  ],
  [
   "Output drive",
   "Qn: 6 mA at VCC = 4.5 V, 7.8 mA at 6.0 V; Q7S: 4 mA at 4.5 V"
  ],
  [
   "Quiescent current",
   "80 μA max to 85 °C, 160 μA max to 125 °C"
  ],
  [
   "ESD",
   "HBM above 2000 V; CDM above 1000 V"
  ],
  [
   "Latch-up",
   "above 100 mA, JESD 78 Class II Level B"
  ],
  [
   "Temperature",
   "-40 °C to +125 °C"
  ]
 ],
