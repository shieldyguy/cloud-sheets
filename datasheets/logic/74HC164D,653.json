{
 "sheet": 1,
 "name": "74HC164D,653",
 "kind": "logic",
 "manufacturer": "Nexperia",
 "title": "74HC164; 74HCT164: 8-bit serial-in, parallel-out shift register",
 "source": {
  "document": "74HC_HCT164",
  "revision": "Rev. 11, 28 May 2024",
  "pages": 16
 },
 "summary": "An eight-stage shift register with one serial input path and all eight stages brought out in parallel on Q0 to Q7. Two serial inputs, DSA and DSB, are ANDed, so either one can gate data arriving on the other; each rising edge on CP moves the data one stage along. A LOW on MR clears every stage at once with no clock. The 74HC164 runs from 2.0 V to 6.0 V with CMOS input thresholds; the 74HCT164 runs from 4.5 V to 5.5 V with TTL thresholds. Both come in SO14, TSSOP14 and DHVQFN14, rated -40 °C to +125 °C.",
 "key_figures": [
  [
   "Supply voltage",
   "2.0 V to 6.0 V (74HC164); 4.5 V to 5.5 V (74HCT164)"
  ],
  [
   "Propagation delay CP to Qn",
   "15 ns typ, 34 ns max at VCC = 4.5 V, CL = 50 pF, 25 °C (74HC164)"
  ],
  [
   "Maximum clock frequency",
   "71 MHz typ, 30 MHz min at VCC = 4.5 V, 25 °C (74HC164)"
  ],
  [
   "Output drive",
   "VOH 3.98 V min at IO = -4.0 mA, VCC = 4.5 V, 25 °C"
  ],
  [
   "Supply current",
   "8.0 µA max at VCC = 6.0 V, 25 °C"
  ],
  [
   "Ambient temperature",
   "-40 °C to +125 °C"
  ],
  [
   "ESD",
   "HBM above 2000 V (JS-001 class 2); CDM above 1000 V (JS-002 class C3)"
  ],
  [
   "Latch-up",
   "above 100 mA, JESD 78 Class II Level B"
  ]
 ],
