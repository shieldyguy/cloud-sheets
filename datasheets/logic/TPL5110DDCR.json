 "pins": [
  {
   "package": "DDC (SOT-23, 6 pins)",
   "page": 3,
   "pins": [
    {
     "pin": "1",
     "name": "VDD",
     "type": "power",
     "function": "Supply, 1.8 V to 5.5 V. A 0.1 µF X7R ceramic capacitor to GND is recommended."
    },
    {
     "pin": "2",
     "name": "GND",
     "type": "ground",
     "function": "Ground."
    },
    {
     "pin": "3",
     "name": "DELAY/M_DRV",
     "type": "input",
     "function": "Interval setting and manual power-on. A resistor REXT from this pin to GND (500 Ω to 170 kΩ) is read once after power-up to fix the interval; afterwards a logic high held on the pin (a switch to VDD) is a manual MOSFET power-on request."
    },
    {
     "pin": "4",
     "name": "DONE",
     "type": "input",
     "function": "Watchdog input from the microcontroller. A rising edge tells the timer the work is finished, and DRV goes high."
    },
    {
     "pin": "5",
     "name": "DRV",
     "type": "output",
     "function": "Power-gating output, driven low every tIP. It goes to the gate of a P-channel MOSFET, which conducts while DRV is low."
    },
    {
     "pin": "6",
     "name": "EN/ONE_SHOT",
     "type": "input",
     "function": "Mode select, tied to VDD or GND. High: timer mode, DRV pulses every interval. Low: one-shot mode, a single DRV pulse of the programmed length; further pulses only from a manual power-on."
    }
   ]
  }
 ],
