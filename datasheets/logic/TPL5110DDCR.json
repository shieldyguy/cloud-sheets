{
 "sheet": 1,
 "name": "TPL5110DDCR",
 "kind": "logic",
 "manufacturer": "Texas Instruments",
 "title": "35 nA supply-gating timer with MOSFET driver, 100 ms to 7200 s",
 "source": {
  "document": "SNAS650A",
  "revision": "SNAS650A, January 2015, revised September 2018",
  "pages": 27
 },
 "summary": "The TPL5110 is a 35 nA timer in a 6-pin SOT-23 (DDC) that switches a system's supply through an external P-channel MOSFET. Every programmed interval, set by one resistor between 100 ms and 7200 s, it pulls DRV low to power the load and releases it when the load's microcontroller signals DONE. A one-shot mode gives a single power-on, and a switch on the interval pin gives manual power-on. It runs from 1.8 V to 5.5 V over -40 °C to 105 °C.",
 "key_figures": [
  [
   "Supply voltage",
   "1.8 V to 5.5 V"
  ],
  [
   "Supply current",
   "35 nA typ, 50 nA max at 2.5 V"
  ],
  [
   "Supply current during REXT reading",
   "200 µA typ, 400 µA max"
  ],
  [
   "Time interval",
   "100 ms to 7200 s, 1650 steps"
  ],
  [
   "Interval setting accuracy",
   "±0.6 % typ, excluding Rext"
  ],
  [
   "Oscillator accuracy",
   "±0.5 % at 25 °C"
  ],
  [
