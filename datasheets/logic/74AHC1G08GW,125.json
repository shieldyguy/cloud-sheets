 "operation": [
  {
   "topic": "Logic function",
   "page": 3,
   "text": "Y goes HIGH only while A and B are both HIGH; with either input LOW, Y is LOW."
  },
  {
   "topic": "Input levels",
   "page": 1,
   "text": "74AHC1G08 switches at CMOS thresholds that scale with VCC (VIH 3.85 V, VIL 1.65 V at 5.5 V). 74AHCT1G08 switches at TTL thresholds, VIH 2.0 V and VIL 0.8 V, over its 4.5 V to 5.5 V supply."
  },
  {
   "topic": "Overvoltage-tolerant inputs",
   "page": 1,
   "text": "An input may sit at up to 5.5 V at any supply in range, above VCC, which lets either version translate between logic families running on different voltages."
  },
  {
   "topic": "Output",
   "page": 1,
   "text": "The output has matched source and sink impedance and the HIGH-to-LOW and LOW-to-HIGH delays are matched."
  },
  {
   "topic": "Input edge rate",
   "page": 3,
   "text": "Input edges must change no slower than 100 ns/V at VCC = 3.3 V ± 0.3 V (74AHC1G08) and 20 ns/V at VCC = 5.0 V ± 0.5 V (both versions)."
  },
  {
   "topic": "TTL-level drive on 74AHCT1G08",
   "page": 5,
   "text": "Holding an input of 74AHCT1G08 at 3.4 V rather than at a rail draws up to 1.35 mA more supply current per input at 25 °C, 1.5 mA over temperature."
  },
  {
   "topic": "Robustness",
   "page": 1,
   "text": "Human-body-model ESD withstand is above 2000 V (JS-001 class 2) and charged-device-model withstand above 1000 V (JS-002 class C3). Latch-up holds off beyond 100 mA, tested to JESD 78 Class II Level A."
  },
  {
   "topic": "Power dissipation",
   "page": 3,
   "text": "Total dissipation is limited to 250 mW, reduced linearly above a package knee: TSSOP5 loses 3.3 mW/K from 74 °C up, SC-74A 3.8 mW/K from 85 °C up, XSON5 3.2 mW/K from 72 °C up."
  }
 ],
