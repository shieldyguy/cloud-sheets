{
 "sheet": 1,
 "name": "74AHC1G08GW,125",
 "kind": "logic",
 "manufacturer": "Nexperia",
 "title": "74AHC1G08; 74AHCT1G08: single 2-input AND gate",
 "source": {
  "document": "74AHC_AHCT1G08",
  "revision": "Rev. 10, 15 July 2024",
  "pages": 12
 },
 "summary": "One 2-input AND gate in a five-pin package, in two versions: 74AHC1G08 with CMOS input thresholds, running from 2.0 V to 5.5 V, and 74AHCT1G08 with TTL input thresholds, running from 4.5 V to 5.5 V. Its inputs accept up to 5.5 V whatever the supply, so it can take in a higher-voltage logic signal than its own rail. Both come in TSSOP5 and SC-74A, 74AHC1G08 also in XSON5; all are rated from -40 °C to +125 °C. 74AHC1G08GW is the CMOS-input version in TSSOP5 (SOT353-1).",
 "key_figures": [
  [
   "Supply voltage",
   "2.0 V to 5.5 V (74AHC1G08); 4.5 V to 5.5 V (74AHCT1G08)"
  ],
  [
   "Input voltage",
   "0 V to 5.5 V at any VCC in range"
  ],
  [
   "Propagation delay tpd",
   "4.6 ns typ, 7.9 ns max at VCC = 4.5 V to 5.5 V, CL = 50 pF, 25 °C (74AHC1G08)"
  ],
  [
   "Output drive",
   "VOH 3.94 V min at -8.0 mA and VOL 0.36 V max at 8.0 mA, VCC = 4.5 V, 25 °C"
  ],
  [
   "Supply current ICC",
   "1.0 µA max at 25 °C, 40 µA max over -40 °C to +125 °C, VCC = 5.5 V"
  ],
  [
   "Ambient temperature",
   "-40 °C to +125 °C"
  ],
  [
   "ESD",
   "HBM above 2000 V (JS-001 class 2); CDM above 1000 V (JS-002 class C3)"
  ],
  [
   "Latch-up",
   "above 100 mA, JESD 78 Class II Level A"
  ]
 ],
