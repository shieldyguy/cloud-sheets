 "circuits": [
  {
   "id": "power-button",
   "title": "Power button circuit",
   "page": 9,
   "description": "A push-button power control. The button pulls a node to ground; R1 pulls it up to 3 V and C1 filters it, and buffer 1's Schmitt input turns it into a clean logic edge. Through R2 that edge clocks a D flip-flop wired with its inverted output back to D, so each press toggles Q, the line to the MCU. The flip-flop's clear input sits on R3 to 3 V and C4 to ground; preset is tied to 3 V. The second buffer's input is grounded and its output is left open.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "SN74LVC2G17"
    },
    {
     "ref": "U2",
     "type": "ic",
     "value": "SN74LVC1G74",
     "external": true,
     "note": "D-type flip-flop with preset and clear"
    },
    {
     "ref": "SW1",
     "type": "switch",
