{
 "sheet": 1,
 "name": "SN74LVC2G17DCKR",
 "kind": "logic",
 "manufacturer": "Texas Instruments",
 "title": "Dual Schmitt-trigger buffer, 1.65 V to 5.5 V",
 "source": {
  "revision": "SCES381N, January 2002, revised January 2015",
  "pages": 28
 },
 "summary": "SN74LVC2G17: two independent non-inverting buffers (Y = A) with Schmitt-trigger inputs, running from 1.65 V to 5.5 V. The inputs tolerate 5.5 V at any supply, so the part also shifts levels down, and the Ioff circuit turns the outputs off at VCC = 0 V for partial power-down and live insertion. Outputs drive ±24 mA at 3.3 V; tpd is 5.4 ns max at 3.3 V. Six-pin SOT-23, SC70, two SON sizes and a DSBGA, rated -40 °C to 125 °C (some order codes -40 °C to 85 °C).",
 "key_figures": [
  [
   "Function",
   "two buffers, Y = A, Schmitt-trigger inputs"
  ],
  [
   "Supply voltage",
   "1.65 V to 5.5 V"
  ],
  [
   "Input voltage",
   "0 V to 5.5 V at any VCC"
  ],
  [
   "Hysteresis",
   "0.4 V to 1.1 V at VCC = 3 V"
  ],
  [
   "Output drive",
   "±24 mA at VCC = 3 V; ±32 mA at 4.5 V"
  ],
  [
   "Propagation delay",
