 "equations": [
  {
   "name": "Dynamic power dissipation",
   "expr": "PD = CPD × VCC² × fi × N + Σ(CL × VCC² × fo)",
   "where": {
    "PD": "dynamic power dissipation, µW",
    "CPD": "power dissipation capacitance, pF (21 pF for 74HC04, 24 pF for 74HCT04)",
    "VCC": "supply voltage, V",
    "fi": "input frequency, MHz",
    "fo": "output frequency, MHz",
    "CL": "output load capacitance, pF",
    "N": "count of inputs switching",
    "Σ(CL × VCC² × fo)": "total over the outputs"
   },
   "note": "",
   "page": 7
  }
 ],
 "operation": [
  {
   "topic": "Function",
   "page": 4,
   "text": "Each of the six gates drives its output nY to the complement of its input nA: LOW in gives HIGH out, HIGH in gives LOW out."
  },
  {
   "topic": "Internal structure",
   "page": 2,
   "text": "From nA to nY each gate is three inverter stages in cascade."
  },
  {
   "topic": "Input clamp diodes",
   "page": 1,
   "text": "Clamp diodes on every input allow an input to be driven from a voltage above VCC through a series resistor that limits the current. The input and output voltage limits may be exceeded when the clamping current stays within ±20 mA."
  },
  {
   "topic": "HC and HCT",
   "page": 1,
   "text": "The 74HC04 has CMOS input thresholds (VIH 3.15 V min, VIL 1.35 V max at VCC = 4.5 V) and works from 2.0 V to 6.0 V. The 74HCT04 has TTL thresholds (VIH 2.0 V min, VIL 0.8 V max) and works from 4.5 V to 5.5 V. An HCT input held at VCC - 2.1 V adds up to 432 µA of supply current at 25 °C (ΔICC, per input)."
  },
  {
   "topic": "Input edge rate",
   "page": 4,
   "text": "Maximum input rise and fall rate for the 74HC04: 625 ns/V at VCC = 2.0 V, 139 ns/V at 4.5 V, 83 ns/V at 6.0 V. For the 74HCT04: 139 ns/V at VCC = 4.5 V."
  },
  {
   "topic": "Standards",
   "page": 1,
   "text": "Meets JEDEC JESD8C (2.7 V to 3.6 V) and JESD7A (2.0 V to 6.0 V)."
  },
  {
   "topic": "Robustness",
   "page": 1,
   "text": "Latch-up current over 100 mA (JESD 78, Class II, Level B). ESD: over 2000 V HBM, ANSI/ESDA/JEDEC JS-001 class 2; over 1000 V CDM, JS-002 class C3."
  },
  {
   "topic": "Exposed pad",
   "page": 3,
   "text": "On DHVQFN14 and DHXQFN14 the pad under the body is not a ground pin and need not be soldered; a soldered pad's land is left floating or joined to GND."
  },
  {
   "topic": "Switching measurement",
   "page": 8,
   "text": "Delays run between the VM crossings of input and output: half of VCC for the 74HC04, 1.3 V for the 74HCT04. The 74HC04 is driven GND to VCC and the 74HCT04 GND to 3.0 V, both with 6.0 ns edges, into 15 pF or 50 pF. RT matches the generator's output impedance and CL includes jig and probe."
  }
 ],
