 "title": "Hex inverter, HC (CMOS input) and HCT (TTL input)",
 "source": {
  "revision": "Rev. 10, 16 February 2024",
  "pages": 15
 },
 "summary": "Six independent CMOS inverters in one 14-pin package. The 74HC04 runs from 2.0 V to 6.0 V with CMOS input thresholds; the 74HCT04 runs from 4.5 V to 5.5 V with TTL thresholds. Each input has clamp diodes, so a series current-limiting resistor lets an input be driven above VCC. Characterised over -40 °C to +85 °C and -40 °C to +125 °C, in SO14, TSSOP14, DHVQFN14 and DHXQFN14.",
 "key_figures": [
  [
   "Function",
   "Y = NOT A, six gates"
  ],
  [
   "Supply voltage",
   "2.0 V to 6.0 V (74HC04); 4.5 V to 5.5 V (74HCT04)"
  ],
  [
   "Propagation delay",
   "9 ns typ, 17 ns max at VCC = 4.5 V, CL = 50 pF, 25 °C (74HC04); 10 ns typ, 19 ns max (74HCT04)"
  ],
  [
   "Output drive",
   "VOH 3.98 V min at IO = -4.0 mA, VOL 0.26 V max at IO = 4.0 mA (74HC04, VCC = 4.5 V, 25 °C); IO ±25 mA absolute maximum"
  ],
  [
   "Supply current",
   "2 µA max at 25 °C, 40 µA max over -40 °C to +125 °C, static"
  ],
  [
   "Latch-up",
   "over 100 mA, JESD 78 Class II Level B"
  ],
  [
   "ESD",
   "HBM above 2000 V (JS-001 class 2); CDM above 1000 V (JS-002 class C3)"
  ],
  [
   "Ambient temperature",
   "-40 °C to +125 °C"
  ],
  [
   "Packages",
   "SO14 (SOT108-1), TSSOP14 (SOT402-1), DHVQFN14 (SOT762-1), DHXQFN14 (SOT8014-1)"
  ]
 ],
