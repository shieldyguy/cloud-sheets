  {
   "id": "switching-test",
   "title": "Switching-time test circuit",
   "page": 8,
   "fixture": true,
   "description": "Delays and edge times of one gate are measured with a pulse generator driving its input nA, the generator line terminated to ground by RT, and its output nY loaded to ground by CL. VI and VO are the probe points at input and output; the device runs from VCC.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
