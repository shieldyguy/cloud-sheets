   "74AHC244: 2.0 V to 5.5 V; 74AHCT244: 4.5 V to 5.5 V"
  ],
  [
   "Input thresholds",
   "74AHC244 CMOS; 74AHCT244 TTL (VIH 2.0 V min, VIL 0.8 V max)"
  ],
  [
   "Propagation delay",
   "74AHCT244: 5.0 ns typ, 8.4 ns max at VCC 4.5 V to 5.5 V, CL = 50 pF, 25 °C"
  ],
  [
   "Output drive",
   "specified at ±8.0 mA, VCC = 4.5 V (VOL 0.36 V max, VOH 3.94 V min at 25 °C)"
  ],
  [
   "Supply current",
   "4.0 μA max at 25 °C, VCC = 5.5 V, inputs at VCC or GND, IO = 0 A"
