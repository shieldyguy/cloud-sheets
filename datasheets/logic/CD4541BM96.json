    },
    {
     "ref": "GND",
     "type": "terminal",
     "value": "ground"
    }
   ],
   "notes": [
    "The timing is as accurate as the oscillator; an external clock on pin 3 can replace the RC network for more accuracy.",
    "After the first power-up the output is high for one full timing period before the timer can be used."
   ]
  }
 ],
 "equations": [
  {
   "name": "Oscillator frequency",
   "expr": "f = 1 / (2.3 × RTC × CTC)",
   "where": {
    "f": "oscillator frequency, valid from 1 kHz to 100 kHz",
    "RTC": "timing resistor on pin 1",
    "CTC": "timing capacitor on pin 2"
   },
   "note": "RS on pin 3 is 10 kΩ or more and about 2 × RTC.",
   "page": 1
  },
  {
   "name": "Output frequency, recycle mode",
   "expr": "fOUT = f / 2^N",
   "where": {
    "f": "oscillator or external clock frequency",
    "N": "selected stage count: 8, 10, 13 or 16 (A, B)"
   },
   "note": "MODE high.",
   "page": 1
  },
  {
   "name": "Counts to output change, single-transition mode",
   "expr": "counts = 2^(N-1)",
   "where": {
    "N": "selected stage count: 8, 10, 13 or 16"
   },
   "note": "MODE low, counted from the end of a MASTER RESET.",
   "page": 1
  }
 ],
 "operation": [
  {
   "topic": "Structure",
   "page": 1,
   "text": "An RC oscillator using two outside resistors and one capacitor clocks a 16-stage binary counter built as two 8-stage halves. A one-of-three multiplexer, steered by A and B, takes the 2^8, 2^10, 2^13 or 2^16 tap to the output logic. The counter advances on rising clock edges."
  },
  {
   "topic": "RC oscillator and external clock",
   "page": 2,
   "text": "RTC on pin 1, CTC on pin 2 and RS on pin 3 meet at one common node. In place of the RC network, a clock driven into pin 3 runs the counter directly; the clock input accepts arbitrarily slow rise and fall times. The oscillator range is DC to 100 kHz."
  },
  {
   "topic": "Recycle mode",
   "page": 1,
   "text": "With MODE high the output is a continuous square wave at the oscillator frequency divided by 2^N."
  },
  {
   "topic": "Single-transition mode",
   "page": 1,
   "text": "With MODE low, after a MASTER RESET the output (Q selected) goes from low to high after 2^(N-1) counts and holds there until the next MASTER RESET pulse or until MODE is taken high. With Q-bar selected the output starts high and falls instead."
  },
  {
   "topic": "Power-on and master reset",
   "page": 1,
   "text": "With AUTO RESET (pin 5) low, timing starts from power-up. Taking pin 5 high disables the power-on reset; counting then waits until a positive pulse on MASTER RESET has come and gone. The power-on reset needs VDD above 5 V to work reliably and draws noticeable current (7 µA typ at 5 V up to 80 µA typ at 15 V), so it is to be avoided where power must be low. Either reset stops the oscillator while it lasts, saving power."
  },
  {
   "topic": "Output drive",
   "page": 1,
   "text": "Output sink and source are symmetrical, typically 100 Ω at VDD = 15 V. Across the rated temperature range the output can drive six HTL loads, six low-power TTL loads, or three low-power Schottky TTL loads."
  },
  {
   "topic": "Input protection",
   "page": 2,
   "text": "Every input has the CMOS protection network."
  },
  {
   "topic": "Ratings and testing",
   "page": 1,
   "text": "Parametric limits are given at 5 V, 10 V and 15 V; quiescent current is tested on every part at 20 V. The part meets JEDEC Standard No. 13B for B-series CMOS."
  }
 ],
