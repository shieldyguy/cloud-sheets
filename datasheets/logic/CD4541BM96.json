 "curves": [],
 "circuits": [
  {
   "id": "digital-timer",
   "title": "Digital timer",
   "page": 5,
   "description": "A one-shot timer. A rising pulse at INPUT on MASTER RESET clears the counter and latch, and with Q/Q SELECT tied high the output goes high at once. MODE is tied low for single-transition operation, so the output stays high until the stage picked by A and B has counted its pulses, then falls and holds. Another pulse restarts the timing, so it is retriggerable. RTC, CTC and RS set the oscillator; AUTO RESET is grounded, enabling power-on reset.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "CD4541B"
    },
    {
     "ref": "RTC",
     "type": "resistor",
     "value": "",
     "note": "timing resistor; sets the frequency with CTC"
    },
    {
     "ref": "CTC",
     "type": "capacitor",
     "value": "",
     "note": "timing capacitor"
    },
    {
     "ref": "RS",
     "type": "resistor",
     "value": "",
     "note": "10 kΩ or more, about 2 × RTC"
    },
    {
