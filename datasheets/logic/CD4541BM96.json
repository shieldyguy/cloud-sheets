{
 "sheet": 1,
 "name": "CD4541BM96",
 "kind": "logic",
 "manufacturer": "Texas Instruments",
 "title": "CD4541B CMOS programmable timer, 20 V rating",
 "source": {
  "revision": "SCHS085E, revised September 2003",
  "pages": 22
 },
 "summary": "A CD4000B-series CMOS timer holding an RC oscillator set by two outside resistors and one capacitor, a 16-stage binary counter, a power-on reset and output logic. Inputs A and B pick the 8th, 10th, 13th or 16th stage to drive the output, so the oscillator is divided by 256, 1024, 8192 or 65536. MODE chooses a continuous divided square wave or a one-shot that changes state once after 2^(N-1) counts; Q/Q SELECT sets the output polarity. It runs from 3 V to 18 V with a 20 V absolute rating.",
 "key_figures": [
  [
   "Supply VDD",
   "3 V to 18 V (operating); 20 V absolute maximum"
  ],
  [
   "Oscillator frequency",
   "DC to 100 kHz"
  ],
  [
   "Division ratios",
   "2^8, 2^10, 2^13, 2^16 (256, 1024, 8192, 65536)"
  ],
  [
   "Output resistance",
   "100 Ω typical at VDD = 15 V, symmetrical"
  ],
  [
   "Clock to Q delay, 2^8 stage",
   "3.5 µs typ at VDD = 5 V, CL = 50 pF"
  ],
  [
   "Maximum clock input frequency",
   "1.5 MHz typ at 5 V; 6 MHz typ at 15 V"
  ],
  [
   "Quiescent current",
   "0.04 µA typ at 5 V, 25 °C (AUTO RESET disabled)"
  ],
  [
   "Operating temperature",
   "-55 °C to 125 °C"
  ],
  [
   "Packages",
   "14-pin CDIP, PDIP, SOIC, SOP, TSSOP"
  ]
 ],
