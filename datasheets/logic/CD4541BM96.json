 "pins": [
  {
   "package": "J (CDIP), N (PDIP), D (SOIC), NS (SOP), PW (TSSOP), 14 pins",
   "page": 1,
   "pins": [
    {
     "pin": "1",
     "name": "RTC",
     "type": "analog",
     "function": "Oscillator timing-resistor pin; RTC connects between this pin and the node shared with CTC and RS."
    },
    {
     "pin": "2",
     "name": "CTC",
     "type": "analog",
     "function": "Oscillator timing-capacitor pin; CTC connects between this pin and the node shared with RTC and RS."
    },
    {
     "pin": "3",
     "name": "RS",
     "type": "input",
     "function": "Oscillator input; RS connects between this pin and the node shared with RTC and CTC. An external clock driven into this pin can replace the RC oscillator."
    },
    {
     "pin": "4",
     "name": "NC",
     "type": "no connect",
     "function": "Not connected inside the part."
    },
    {
     "pin": "5",
     "name": "AUTO RESET",
     "type": "digital input",
     "function": "Low: the power-on reset circuit is active and resets the counter when power comes up. High: power-on reset is disabled and counting waits for a MASTER RESET pulse."
    },
    {
     "pin": "6",
     "name": "MASTER RESET",
     "type": "digital input",
     "function": "High resets the counters and the output latch and stops the oscillator; counting begins when it returns low."
    },
    {
     "pin": "7",
     "name": "VSS",
     "type": "ground",
     "function": "Negative supply, normally ground."
    },
    {
     "pin": "8",
     "name": "OUTPUT",
     "type": "digital output",
     "function": "Q or Q-bar of the selected counter stage, chosen by pin 9."
    },
    {
     "pin": "9",
     "name": "Q/Q SELECT",
     "type": "digital input",
     "function": "Low: output starts low after reset (Q). High: output starts high after reset (Q-bar)."
    },
    {
     "pin": "10",
     "name": "MODE",
     "type": "digital input",
     "function": "Low: single-transition (one-shot) mode. High: recycle mode, a continuous square wave."
    },
    {
     "pin": "11",
     "name": "NC",
     "type": "no connect",
     "function": "Not connected inside the part."
    },
    {
     "pin": "12",
     "name": "A",
     "type": "digital input",
     "function": "Stage-select input A; with B picks the 8th, 10th, 13th or 16th counter stage."
    },
    {
     "pin": "13",
     "name": "B",
     "type": "digital input",
     "function": "Stage-select input B; with A picks the counter stage driving the output."
    },
    {
     "pin": "14",
     "name": "VDD",
     "type": "power",
     "function": "Positive supply, 3 V to 18 V above VSS."
    }
   ]
  }
 ],
