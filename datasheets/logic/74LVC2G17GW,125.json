{
 "sheet": 1,
 "name": "74LVC2G17GW,125",
 "kind": "logic",
 "manufacturer": "Nexperia",
 "title": "Dual Schmitt-trigger buffer, non-inverting, 5 V tolerant inputs",
 "source": {
  "revision": "Rev. 12, 21 August 2023",
  "pages": 17
 },
 "summary": "Two independent non-inverting buffers, each with a Schmitt-trigger input, in a six-pin package. It runs from 1.65 V to 5.5 V, its inputs tolerate up to 5.5 V and can be driven from 3.3 V or 5 V devices, so it translates between 3.3 V and 5 V logic. Hysteresis is 0.73 V typical at VCC = 3.0 V, and each output drives ±24 mA at 3.0 V. IOFF circuitry disables the outputs when the part is powered down, and it is specified for partial power-down use.",
 "key_figures": [
  [
   "Function",
   "two buffers, nY = nA, Schmitt-trigger inputs"
  ],
  [
   "Supply voltage",
   "1.65 V to 5.5 V"
  ],
  [
   "Input voltage",
   "0 V to 5.5 V; overvoltage tolerant inputs"
  ],
  [
   "Output drive",
   "±24 mA at VCC = 3.0 V"
  ],
  [
   "Propagation delay",
   "3.6 ns typ at VCC = 3.3 V; 2.7 ns typ at 5.0 V"
  ],
  [
   "Hysteresis",
   "0.73 V typ at VCC = 3.0 V"
  ],
  [
   "Supply current",
   "4 μA max, VCC = 5.5 V"
  ],
  [
   "Operating temperature",
   "-40 °C to +125 °C"
  ],
  [
   "ESD",
   "HBM above 2000 V (JS-001 class 2); CDM above 1000 V (JS-002 class C3)"
  ],
  [
   "Latch-up",
   "above 250 mA"
  ]
 ],
