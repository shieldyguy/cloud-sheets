 "equations": [
  {
   "name": "Dynamic power dissipation",
   "expr": "PD = CPD × VCC² × fi × N + Σ(CL × VCC² × fo)",
   "where": {
    "PD": "dynamic power dissipation, μW",
    "CPD": "power dissipation capacitance, pF (16.3 pF per buffer at VCC = 3.3 V)",
    "VCC": "supply voltage, V",
    "fi": "input frequency, MHz",
    "fo": "output frequency, MHz",
    "CL": "output load capacitance, pF",
    "N": "number of inputs switching",
    "Σ(CL × VCC² × fo)": "total over the outputs"
   },
   "note": "",
   "page": 6
  },
  {
   "name": "Hysteresis",
   "expr": "VH = VT+ - VT-",
   "where": {
    "VT+": "positive-going threshold voltage",
    "VT-": "negative-going threshold voltage"
   },
   "note": "",
   "page": 8
  }
 ],
 "operation": [
  {
   "topic": "Schmitt-trigger inputs",
   "page": 8,
   "text": "Each output follows its input with no inversion. The output switches HIGH when a rising input passes VT+ and LOW when a falling input passes VT-, the lower threshold; the gap between them is the hysteresis VH. The listed application is wave and pulse shaping in highly noisy environments."
  },
  {
   "topic": "5 V tolerant inputs",
   "page": 1,
   "text": "The inputs tolerate up to 5.5 V and accept drive from 3.3 V or 5 V devices, which lets the part translate between 3.3 V and 5 V logic. The inputs interface directly with TTL levels."
  },
  {
   "topic": "Partial power-down (IOFF)",
   "page": 1,
   "text": "With the part powered down the IOFF circuit disables the outputs, blocking backflow current through the device. Power-off leakage is ±2 μA max with 5.5 V on an input or output at VCC = 0 V."
  },
  {
   "topic": "Supply current during transitions",
   "page": 9,
   "text": "While the input sits between the rails the supply current rises: at VCC = 3.0 V it peaks near 13 mA just before the rising-input switch point. ΔICC is 500 μA max with the input held at VCC - 0.6 V. Average ICC with the input swept between 0.8 V and 2.0 V grows steeply with VCC."
  },
  {
   "topic": "Standards",
   "page": 1,
   "text": "The interface levels follow JEDEC JESD8-7 (1.65 V to 1.95 V), JESD8-5 (2.3 V to 2.7 V) and JESD-8B/JESD36 (2.7 V to 3.6 V)."
  },
  {
   "topic": "Timing measurement",
   "page": 7,
   "text": "Delays are taken from the input crossing VM to the output crossing VM, with VM at 0.5 × VCC except for VCC = 2.7 V and 3.0 V to 3.6 V, where it is 1.5 V. tPLH is the rising output case and tPHL the falling one."
  }
 ],
