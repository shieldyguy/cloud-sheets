{
 "sheet": 1,
 "name": "74HC14D,653",
 "kind": "logic",
 "manufacturer": "Nexperia",
 "title": "Hex inverter with Schmitt-trigger inputs, HC (CMOS) and HCT (TTL input)",
 "source": {
  "revision": "Rev. 10, 29 February 2024",
  "pages": 16
 },
 "summary": "Six inverters, each with a Schmitt-trigger input, in one 14-pin package. The hysteresis turns slow or noisy edges into clean output transitions, and one gate with an RC network makes an oscillator. The 74HC14 runs from 2.0 V to 6.0 V; the 74HCT14 runs from 4.5 V to 5.5 V with thresholds suited to TTL drive. Rated from -40 °C to +125 °C in SO14, TSSOP14 and DHVQFN14.",
 "key_figures": [
  [
   "Function",
   "6 inverters, Schmitt-trigger inputs"
  ],
  [
   "Supply voltage",
   "2.0 V to 6.0 V (74HC14); 4.5 V to 5.5 V (74HCT14)"
  ],
  [
   "Hysteresis",
   "0.98 V typ at VCC = 4.5 V (74HC14); 0.56 V typ at VCC = 4.5 V (74HCT14)"
  ],
  [
   "Propagation delay",
   "15 ns typ, 25 ns max at VCC = 4.5 V, CL = 50 pF, 25 °C (74HC14)"
  ],
  [
   "Output drive",
   "VOH 3.98 V min at IO = -4.0 mA, VOL 0.26 V max at IO = 4.0 mA (VCC = 4.5 V, 25 °C)"
  ],
  [
   "Supply current",
   "2.0 µA max at 25 °C, 40 µA max to 125 °C, static"
  ],
  [
   "Ambient temperature",
   "-40 °C to +125 °C"
  ],
  [
   "Packages",
   "SO14 (SOT108-1), TSSOP14 (SOT402-1), DHVQFN14 (SOT762-1)"
  ]
 ],
