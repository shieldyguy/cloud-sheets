 "equations": [
  {
   "name": "Dynamic power dissipation",
   "expr": "PD = CPD × VCC² × fi × N + Σ(CL × VCC² × fo)",
   "where": {
    "PD": "dynamic power dissipation, µW",
    "CPD": "power dissipation capacitance, pF (7 pF for 74HC14, 8 pF for 74HCT14)",
    "VCC": "supply voltage, V",
    "fi": "input frequency, MHz",
    "fo": "output frequency, MHz",
    "CL": "output load capacitance, pF",
    "N": "count of inputs switching",
    "Σ(CL × VCC² × fo)": "total over the outputs"
   },
   "note": "",
   "page": 5
  },
  {
   "name": "Extra dissipation from slow input edges",
   "expr": "Padd = fi × (tr × ΔICC(AV) + tf × ΔICC(AV)) × VCC",
   "where": {
    "Padd": "additional power dissipation, µW",
    "fi": "input frequency, MHz",
    "tr": "input rise time from 10 % to 90 %, ns",
    "tf": "input fall time from 90 % to 10 %, ns",
    "ΔICC(AV)": "average additional supply current, µA, from the ΔICC(AV) curves (different for rising and falling edges)",
