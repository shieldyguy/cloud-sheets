{
 "sheet": 1,
 "name": "CD74AC238M96",
 "kind": "logic",
 "manufacturer": "Texas Instruments",
 "title": "CD74AC238 3-line to 8-line decoder/demultiplexer with active-high outputs",
 "source": {
  "document": "SCHS331B",
  "revision": "February 2003, revised July 2024",
  "pages": 28
 },
 "summary": "An AC-family CMOS decoder that takes a 3-bit binary address on A, B and C and drives exactly one of eight outputs, Y0 to Y7, high while the rest stay low. Three enables, G1 (active high) and G2A, G2B (active low), must all be true or every output is low; one of them can carry data, so the part also serves as a 1-to-8 demultiplexer. It runs from 1.5 V to 5.5 V with ±24 mA outputs. CD74AC238M96 is the SOIC-16 (D) part on a reel of 2500; WQFN-16 (BQB) and TSSOP-16 (PW) versions are also covered.",
 "key_figures": [
  [
   "Function",
   "3-to-8 binary decoder, active-high outputs, three enables"
  ],
  [
   "Supply voltage VCC",
   "1.5 V to 5.5 V"
  ],
  [
   "Propagation delay A, B, C to Y",
   "15 ns max (-55 °C to 125 °C), 13.6 ns max (-40 °C to 85 °C) at VCC = 5 V ± 0.5 V, CL = 50 pF"
  ],
  [
   "Output current IOH / IOL",
   "-24 mA / 24 mA at VCC = 4.5 V to 5.5 V"
  ],
  [
   "Supply current ICC",
   "8 µA max at 25 °C, 80 µA max (-40 °C to 85 °C), VCC = 5.5 V"
  ],
  [
   "Input thresholds",
   "VIH 3.85 V min, VIL 1.65 V max at VCC = 5.5 V (30 % of supply)"
  ],
  [
   "Power dissipation capacitance Cpd",
   "110 pF typ"
  ],
  [
   "ESD (HBM)",
   "±2000 V"
  ],
  [
   "Operating temperature",
   "-55 °C to 125 °C"
  ],
  [
   "Packages",
   "SOIC-16 (D), TSSOP-16 (PW), WQFN-16 (BQB)"
  ]
 ],
