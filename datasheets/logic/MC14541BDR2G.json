    {
     "pin": "1",
     "name": "Rtc",
     "type": "analog out",
     "function": "Oscillator node for the timing resistor Rtc. With an external clock on pin 3 it is an output and is left open."
    },
    {
     "pin": "2",
     "name": "Ctc",
     "type": "analog out",
     "function": "Oscillator node for the timing capacitor Ctc. With an external clock on pin 3 it is an output and is left open."
    },
    {
     "pin": "3",
     "name": "RS",
     "type": "input",
     "function": "Oscillator input, taking the series resistor RS of the RC network; an external clock is applied to this pin instead when the oscillator is bypassed."
    },
    {
     "pin": "4",
     "name": "NC",
     "type": "no connect",
     "function": "Not connected inside."
    },
    {
     "pin": "5",
     "name": "AR",
     "type": "input",
     "function": "Auto reset. Low (VSS): the power-on reset clears the counter when supply comes up; needs VDD from 8.5 V. High (VDD): power-on reset off, lowest supply current, VDD from 3.0 V."
    },
    {
     "pin": "6",
     "name": "MR",
     "type": "input",
     "function": "Master reset, active high. Clears every counter stage at once whatever the count, and holds the oscillator stopped while high. Low for normal timing."
    },
    {
     "pin": "7",
     "name": "VSS",
     "type": "ground",
     "function": "Negative supply, the reference for all voltages."
    },
    {
     "pin": "8",
     "name": "Q",
     "type": "output",
     "function": "Timer output: the selected counter stage after the Q/Q select and mode logic."
    },
    {
     "pin": "9",
     "name": "Q/Q SEL",
     "type": "input",
     "function": "Output polarity. Low: Q is low after a reset. High: Q is high after a reset."
    },
    {
     "pin": "10",
     "name": "MODE",
     "type": "input",
     "function": "High: recycle mode, the selected stage is passed continuously to Q (frequency divider). Low: single-cycle mode, Q changes once and then holds."
    },
    {
     "pin": "11",
     "name": "NC",
     "type": "no connect",
     "function": "Not connected inside."
    },
    {
     "pin": "12",
     "name": "A",
     "type": "input",
     "function": "Stage select, bit A. High: B high gives 2^16, B low gives 2^8 (the ninth stage is then clocked straight from the oscillator)."
    },
    {
     "pin": "13",
     "name": "B",
     "type": "input",
     "function": "Stage select, bit B. With A low: B low gives 2^13, B high gives 2^10."
    },
    {
     "pin": "14",
     "name": "VDD",
     "type": "power in",
     "function": "Positive supply."
    }
   ]
  }
 ],
