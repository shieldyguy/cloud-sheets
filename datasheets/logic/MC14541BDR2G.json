{
 "sheet": 1,
 "name": "MC14541BDR2G",
 "kind": "logic",
 "manufacturer": "onsemi",
 "title": "MC14541B programmable timer: 16-stage counter with RC oscillator and power-on reset",
 "source": {
  "document": "MC14541B/D",
  "revision": "Rev. 16, October 2025",
  "pages": 12
 },
 "summary": "A timer built from an on-chip RC oscillator, a 16-stage binary counter, an automatic power-on reset and output logic. Two select pins pick which of four stages (2^8, 2^10, 2^13 or 2^16) drives the output; a mode pin makes it either a continuous divide-by-2^n or a one-shot that changes state once, and a polarity pin sets the output level after reset. The oscillator runs from two resistors and a capacitor, or pin 3 takes an external clock. It works from 3.0 V to 18 V with auto reset off and 8.5 V to 18 V with it on. MC14541BDR2G is the SOIC-14 part on tape and reel.",
 "key_figures": [
  [
   "Supply voltage, auto reset disabled (pin 5 = VDD)",
   "3.0 to 18 Vdc"
  ],
  [
   "Supply voltage, auto reset enabled (pin 5 = VSS)",
   "8.5 to 18 Vdc"
  ],
  [
   "Selectable outputs",
   "2^8, 2^10, 2^13 or 2^16"
  ],
  [
   "Oscillator frequency",
   "f = 1 / (2.3 Rtc Ctc), 1 kHz to 100 kHz, RS ≈ 2 Rtc, RS ≥ 10 kΩ"
  ],
  [
   "Oscillator accuracy",
   "±2% over temperature, ±20% supply, ±3% over processing, below 10 kHz"
  ],
  [
   "Quiescent current, auto reset disabled",
   "5.0 µA max at 5 V, 25 °C"
  ],
  [
   "Output drive at 5 V, 25 °C",
   "IOH −3.38 mA min at 2.5 V; IOL 1.56 mA min at 0.4 V"
  ],
  [
   "Ambient temperature",
   "−55 to +125 °C"
  ],
  [
   "Packages",
   "SOIC-14, TSSOP-14, SOEIAJ-14 (discontinued)"
  ]
 ],
