{
 "sheet": 1,
 "name": "74HCT74BQ,115",
 "kind": "logic",
 "manufacturer": "Nexperia",
 "title": "Dual rising-edge D flip-flop with asynchronous set and reset",
 "source": {
  "revision": "Rev. 9, 2 April 2024",
  "pages": 19
 },
 "summary": "The 74HC74 and 74HCT74 hold two independent D-type flip-flops, each with its own data, clock, active-LOW set and active-LOW reset inputs and both true and inverted outputs. A flip-flop stores its D level on the rising clock edge; set and reset override the clock at any time. The clock input has Schmitt-trigger action. The HC part runs from 2.0 V to 6.0 V with CMOS input thresholds, the HCT part from 4.5 V to 5.5 V with TTL thresholds; packages are SO14, TSSOP14, DHVQFN14 and DHXQFN14.",
 "key_figures": [
  [
   "Supply",
   "2.0 V to 6.0 V (74HC74); 4.5 V to 5.5 V (74HCT74)"
  ],
  [
   "nCP to nQ delay",
   "18 ns typ, 44 ns max at VCC = 4.5 V, CL = 50 pF (74HCT74)"
  ],
  [
   "Maximum clock frequency",
   "54 MHz typ, 22 MHz min at VCC = 4.5 V (74HCT74)"
  ],
  [
   "Output drive",
   "-4 mA / 4.0 mA at VCC = 4.5 V (VOH, VOL specified)"
  ],
  [
   "Quiescent current",
   "40 μA max to 85 °C, 80 μA max to 125 °C"
  ],
  [
   "ESD",
   "HBM above 2000 V; CDM above 1000 V"
  ],
  [
   "Latch-up",
   "above 100 mA, JESD 78 Class II Level B"
  ],
  [
   "Temperature",
   "-40 °C to +125 °C"
  ]
 ],
