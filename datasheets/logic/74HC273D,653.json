{
 "sheet": 1,
 "name": "74HC273D,653",
 "kind": "logic",
 "manufacturer": "Nexperia",
 "title": "Octal positive-edge D-type flip-flop with master reset",
 "source": {
  "revision": "Rev. 7, 6 September 2021",
  "pages": 17
 },
 "summary": "The 74HC273 and 74HCT273 hold eight D-type flip-flops sharing one rising-edge clock (CP) and one active-LOW master reset (MR). On each rising CP edge every Q output takes the level its D input held through the set-up and hold window; MR LOW drives all outputs LOW whatever the clock and data do. The HC part runs from 2.0 V to 6.0 V with CMOS input thresholds, the HCT part from 4.5 V to 5.5 V with TTL thresholds. They come in SO20, TSSOP20 and DHVQFN20.",
 "key_figures": [
  [
   "Supply",
   "2.0 V to 6.0 V (74HC273); 4.5 V to 5.5 V (74HCT273)"
  ],
  [
   "CP to Qn delay",
   "15 ns typ, 30 ns max at VCC = 4.5 V, CL = 50 pF, 25 °C (74HC273)"
  ],
  [
   "Maximum clock frequency",
   "103 MHz typ, 30 MHz min at VCC = 4.5 V, 25 °C (74HC273)"
  ],
  [
   "Output drive",
   "-4.0 mA / 4.0 mA at VCC = 4.5 V (VOH, VOL specified)"
  ],
  [
   "Quiescent current",
   "8.0 μA max at 25 °C, 160 μA max at 125 °C"
  ],
  [
   "ESD",
   "HBM above 2000 V (JESD22-A114F); MM above 200 V (JESD22-A115-A)"
  ],
  [
   "Latch-up",
   "above 100 mA, JESD 78 Class II Level B"
  ],
  [
   "Temperature",
   "-40 °C to +125 °C"
  ]
 ],
