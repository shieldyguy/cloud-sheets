{
 "sheet": 1,
 "name": "74HC85D,653",
 "kind": "logic",
 "manufacturer": "Nexperia",
 "title": "74HC85; 74HCT85: 4-bit magnitude comparator",
 "source": {
  "document": "74HC_HCT85",
  "revision": "Rev. 4, 2 April 2024",
  "pages": 17
 },
 "summary": "Compares two 4-bit words, A3..A0 against B3..B0, with A3 and B3 the most significant bits, and drives one of three outputs for A greater than, equal to or less than B. The words may be binary, BCD or any other monotonic code. Three cascade inputs take the result of a lower-order comparator, so words longer than 4 bits are compared by chaining parts; the least significant part has IA=B HIGH and the other two LOW. The 74HC85 runs from 2.0 V to 6.0 V with CMOS input levels; the 74HCT85 runs from 4.5 V to 5.5 V with TTL input levels. Both come in SO16 and TSSOP16 and are rated -40 °C to +125 °C.",
 "key_figures": [
  [
   "Supply voltage",
   "2.0 V to 6.0 V (74HC85); 4.5 V to 5.5 V (74HCT85)"
  ],
  [
   "Propagation delay An, Bn to QA>B / QA<B",
   "23 ns typ, 39 ns max at VCC = 4.5 V, CL = 50 pF, 25 °C (74HC85)"
  ],
  [
   "Propagation delay cascade inputs to outputs",
   "18 ns typ, 28 ns max at VCC = 4.5 V, CL = 50 pF, 25 °C (74HC85)"
  ],
  [
   "Output drive",
   "VOH 3.98 V min at IO = -4.0 mA, VCC = 4.5 V, 25 °C"
  ],
  [
   "Supply current",
   "8.0 µA max at VCC = 6.0 V, 25 °C"
  ],
  [
   "Ambient temperature",
   "-40 °C to +125 °C"
  ],
  [
   "ESD",
   "HBM above 2000 V (JS-001 class 2); CDM above 1000 V (JS-002 class C3)"
  ],
  [
   "Latch-up",
   "above 100 mA, JESD 78 Class II Level B"
  ]
 ],
