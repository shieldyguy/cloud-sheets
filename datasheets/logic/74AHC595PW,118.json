{
 "sheet": 1,
 "name": "74AHC595PW,118",
 "kind": "logic",
 "manufacturer": "Nexperia",
 "title": "8-bit shift register with storage latches and 3-state parallel outputs",
 "source": {
  "revision": "Rev. 8, 7 March 2024",
  "pages": 19
 },
 "summary": "The 74AHC595 and 74AHCT595 hold an 8-stage serial shift register feeding an 8-bit storage register that drives eight 3-state outputs, plus a serial output Q7S for chaining. The shift and storage registers each have their own rising-edge clock, the shift register has an asynchronous active-LOW clear, and an active-LOW enable floats the parallel outputs. The AHC part runs from 2.0 V to 5.5 V with CMOS input thresholds; the AHCT part runs from 4.5 V to 5.5 V with TTL thresholds. Inputs of both accept up to 5.5 V regardless of supply and have Schmitt-trigger action.",
 "key_figures": [
  [
   "Supply",
   "2.0 V to 5.5 V (74AHC595); 4.5 V to 5.5 V (74AHCT595)"
  ],
  [
   "Clock frequency",
   "170 MHz typ, 130 MHz min at VCC = 4.5 V to 5.5 V, 25 °C"
  ],
  [
   "SHCP to Q7S delay",
   "5.4 ns typ at VCC = 4.5 V to 5.5 V, CL = 50 pF (74AHC595)"
  ],
  [
   "Output drive",
   "±8 mA at VCC = 4.5 V (VOH, VOL specified)"
  ],
  [
   "Quiescent current",
   "4.0 μA max at 25 °C, 80 μA max at 125 °C"
  ],
  [
   "Input tolerance",
   "5.5 V on inputs at any VCC"
  ],
  [
   "ESD",
   "HBM above 2000 V (JS-001 class 2); CDM above 1000 V (JS-002 class C3)"
  ],
  [
   "Latch-up",
   "above 100 mA, JESD 78 Class II Level A"
  ],
  [
   "Temperature",
   "-40 °C to +125 °C"
  ]
 ],
