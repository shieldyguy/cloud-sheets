 "equations": [
  {
   "name": "REXT for a chosen interval",
   "expr": "REXT = 100 × ( (−b + √(b² − 4a(c − 100T))) / (2a) )",
   "where": {
    "REXT": "resistance from DELAY/M_RST to GND, Ω",
    "T": "wanted interval, s",
    "a, b, c": "coefficients for the range T falls in (coefficient table)"
   },
   "note": "Example: for T = 8 s, set 2 applies and REXT comes to 10.18 kΩ.",
   "page": 11
  },
  {
   "name": "Quantization error",
   "expr": "Err = 100 × (TDESIRED − TADC) / TDESIRED",
   "where": {
    "Err": "error, %",
    "TDESIRED": "wanted interval",
    "TADC": "interval the part actually produces"
   },
   "note": "",
   "page": 13
  },
  {
   "name": "Interval produced from REXT",
   "expr": "TADC = INT[ (1/100) × ( a × RD² / 100² + b × RD / 100 + c ) ],  RD = INT[ REXT / 100 ]",
   "where": {
    "REXT": "resistance from the REXT equation, Ω",
    "a, b, c": "coefficients from the coefficient table",
    "INT": "integer part"
   },
   "note": "Misprint: it should read TADC = (a × RD² + b × RD + c) / 100, the form that gives 586.85 s and 611.3 s in the 600 s example.",
   "page": 13
  },
  {
   "name": "Uncertainty of two resistors in parallel",
   "expr": "uR// = R// × √( (uR1/R1)² + (uR2/R2)² )",
   "where": {
    "R//": "parallel value of R1 and R2",
    "uRn": "uncertainty of resistor n"
   },
   "note": "",
   "page": 14
  },
  {
   "name": "Uncertainty of one resistor",
   "expr": "uRn = Rn × Tolerance / √3",
   "where": {
    "Rn": "nominal resistance",
    "Tolerance": "resistor tolerance as a fraction"
   },
   "note": "",
   "page": 14
  },
