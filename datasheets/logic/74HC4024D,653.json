{
 "sheet": 1,
 "name": "74HC4024D,653",
 "kind": "logic",
 "manufacturer": "Nexperia",
 "title": "74HC4024: 7-stage binary ripple counter",
 "source": {
  "document": "74HC4024",
  "revision": "Rev. 11, 16 February 2024",
  "pages": 13
 },
 "summary": "A seven-bit binary counter built as a chain of seven toggle flip-flops, each one clocking the next, with every stage brought out on Q0 to Q6. It counts on the falling edge of CP; the clock input has Schmitt-trigger hysteresis so slow edges are tolerated. MR, active HIGH, clears all stages at once whatever CP is doing. CMOS input levels, 2.0 V to 6.0 V supply, SO14 package, rated -40 °C to +125 °C.",
 "key_figures": [
  [
   "Supply voltage",
   "2.0 V to 6.0 V"
  ],
  [
   "Propagation delay CP to Q0",
   "17 ns typ, 35 ns max at VCC = 4.5 V, CL = 50 pF, 25 °C"
  ],
  [
   "Ripple delay Qn to Qn+1",
   "9 ns typ, 16 ns max at VCC = 4.5 V, 25 °C"
  ],
  [
   "Maximum clock frequency",
   "82 MHz typ, 30 MHz min at VCC = 4.5 V, 25 °C"
  ],
  [
   "Supply current",
   "8.0 µA max at VCC = 6.0 V, 25 °C"
  ],
  [
   "Output drive",
   "VOH 3.98 V min at IO = -4 mA, VCC = 4.5 V, 25 °C"
  ],
  [
   "Ambient temperature",
   "-40 °C to +125 °C"
  ],
  [
   "ESD",
   "HBM above 2000 V (JS-001 class 2); CDM above 1000 V (JS-002 class C3)"
  ]
 ],
