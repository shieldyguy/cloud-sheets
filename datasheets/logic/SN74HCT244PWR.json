{
 "sheet": 1,
 "name": "SN74HCT244PWR",
 "kind": "logic",
 "manufacturer": "Texas Instruments",
 "title": "SN54HCT244, SN74HCT244: octal buffer and line driver with 3-state outputs, TTL-level inputs",
 "source": {
  "document": "SCLS175D",
  "revision": "March 1984, revised August 2003",
  "pages": 22
 },
 "summary": "Eight non-inverting buffers in two groups of four, each group with an active-low output enable that floats its outputs when high. The inputs switch at TTL thresholds (2 V and 0.8 V) while the part runs from 4.5 V to 5.5 V. Outputs drive ±6 mA, up to 15 LSTTL loads. SN74HCT244PWR is the SN74HCT244 in TSSOP-20 (PW), -40 °C to 85 °C, reel of 2000.",
 "key_figures": [
  [
   "Supply voltage VCC",
   "4.5 V to 5.5 V"
  ],
  [
   "Function",
   "8 non-inverting buffers, 3-state, two enables of four"
  ],
  [
   "Input thresholds",
   "VIH 2 V min, VIL 0.8 V max"
  ],
  [
   "Propagation delay A to Y",
   "15 ns typ, 35 ns max (SN74HCT244, -40 °C to 85 °C) at VCC = 4.5 V, CL = 50 pF"
  ],
  [
   "Output drive",
   "±6 mA at VCC = 4.5 V; 15 LSTTL loads"
  ],
  [
   "Supply current ICC",
   "80 µA max (SN74HCT244) at 5.5 V"
  ],
