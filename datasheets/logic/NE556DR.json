 "pins": [
  {
   "package": "D (SOIC-14), N (PDIP-14), NS (SO-14), J (CDIP-14)",
   "page": 1,
   "pins": [
    {
     "pin": "1",
     "name": "1DISCH",
     "type": "output",
     "function": "Timer 1 discharge. While timer 1's output is low it is a low-impedance path to GND that empties the timing capacitor; while the output is high it is off."
    },
    {
     "pin": "2",
     "name": "1THRES",
     "type": "input",
     "function": "Timer 1 threshold. Above its level (nominally 2/3 VCC), with 1TRIG above its own level, timer 1's flip-flop resets: output low, discharge on."
    },
    {
     "pin": "3",
     "name": "1CONT",
     "type": "input/output",
     "function": "Timer 1 control voltage. Sits at the threshold level (nominally 2/3 VCC) when left open; driving it moves both the threshold and trigger levels and so modulates the timing."
    },
    {
     "pin": "4",
     "name": "1RESET",
     "type": "input",
     "function": "Timer 1 reset, active low. Low forces the output low and the discharge on, over every other input; it can start a new timing cycle."
    },
    {
     "pin": "5",
     "name": "1OUT",
     "type": "output",
     "function": "Timer 1 output, active pull-up and pull-down, sinks or sources up to 150 mA; TTL compatible."
    },
    {
     "pin": "6",
     "name": "1TRIG",
     "type": "input",
     "function": "Timer 1 trigger. Falling below its level (nominally 1/3 VCC) sets the flip-flop: output high, discharge off."
    },
    {
     "pin": "7",
     "name": "GND",
     "type": "ground",
     "function": "Ground for both timers."
    },
    {
     "pin": "8",
     "name": "2TRIG",
     "type": "input",
     "function": "Timer 2 trigger; acts as 1TRIG does for timer 1."
    },
    {
     "pin": "9",
     "name": "2OUT",
     "type": "output",
     "function": "Timer 2 output; acts as 1OUT does for timer 1."
    },
    {
     "pin": "10",
     "name": "2RESET",
     "type": "input",
     "function": "Timer 2 reset, active low; acts as 1RESET does for timer 1."
    },
    {
     "pin": "11",
     "name": "2CONT",
     "type": "input/output",
     "function": "Timer 2 control voltage; acts as 1CONT does for timer 1."
    },
    {
     "pin": "12",
     "name": "2THRES",
     "type": "input",
     "function": "Timer 2 threshold; acts as 1THRES does for timer 1."
    },
    {
     "pin": "13",
     "name": "2DISCH",
     "type": "output",
     "function": "Timer 2 discharge; acts as 1DISCH does for timer 1."
    },
    {
     "pin": "14",
     "name": "VCC",
     "type": "power",
     "function": "Supply for both timers, 4.5 V to 16 V (SE556 4.5 V to 18 V)."
    }
   ]
  }
 ],
