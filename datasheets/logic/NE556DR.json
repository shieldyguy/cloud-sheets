{
 "sheet": 1,
 "name": "NE556DR",
 "kind": "logic",
 "manufacturer": "Texas Instruments",
 "title": "NA556, NE556, SA556, SE556 dual precision timers",
 "source": {
  "revision": "SLFS023G, revised June 2006",
  "pages": 19
 },
 "summary": "Two independent bipolar 555-type timers in one 14-pin package, sharing VCC and GND. Each works as a one-shot or a free-running oscillator set by an external resistor and capacitor; its threshold and trigger sit near two thirds and one third of VCC and move with the CONT pin. Each output drives up to 150 mA in either direction from a 4.5 V to 16 V supply (SE556 18 V). NE556DR is the 0°C to 70°C grade in SOIC-14 on a 2500-piece reel.",
 "key_figures": [
  [
   "Timers",
   "2 per package"
  ],
  [
   "Supply voltage",
   "4.5 V to 16 V (SE556 4.5 V to 18 V)"
  ],
  [
   "Output current",
   "±200 mA recommended, ±225 mA absolute"
  ],
  [
   "Threshold / trigger level",
   "10 V / 5 V typ at VCC = 15 V"
  ],
  [
   "Supply current",
   "20 mA typ, output low, no load, VCC = 15 V"
  ],
  [
   "Monostable timing drift",
   "50 ppm/°C and 0.1 %/V typ"
  ],
  [
   "Rise and fall time",
