 "circuits": [
  {
   "id": "doubler-inverter",
   "title": "Voltage doubler and inverter",
   "page": 1,
   "description": "A single input makes both a positive and a negative rail. C1 pumps the input up to about twice VIN at +VOUT, where C3 stores it; C2 then flips that doubled voltage below ground at -VOUT, held up by C4. All four capacitors are 1 µF.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
