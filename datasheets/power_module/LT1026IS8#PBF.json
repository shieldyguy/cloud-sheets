{
 "sheet": 1,
 "name": "LT1026IS8#PBF",
 "kind": "power_module",
 "manufacturer": "Linear Technology (Analog Devices)",
 "title": "LT1026 switched-capacitor voltage doubler and inverter",
 "source": {
  "document": "1026fb",
  "revision": "Rev B",
  "pages": 8
 },
 "summary": "The LT1026 makes a positive and a negative rail from one 4 V to 10 V supply with no inductors: a charge pump doubles the input, and a second pump inverts the doubled voltage, for about ±7 V to ±18 V out and at least 10 mA. Its outputs are not regulated and follow the input and the load. It needs four capacitors, 1 µF nominal, and being bipolar it cannot latch up. LT1026IS8 is the S8 part for -40 °C to 85 °C.",
 "key_figures": [
  [
   "Input voltage",
   "4 V to 10 V"
  ],
  [
   "Output voltage",
   "±7 V to ±18 V, unregulated"
  ],
  [
   "Output current",
   "10 mA minimum"
  ],
  [
   "Output, VIN = 5 V, IL = ±15 mA",
   "6.25 V min / 7 V typ; -5.5 V min / -6.2 V typ"
  ],
  [
   "Supply current, no load",
   "7 mA typ, 12.5 mA max at VIN = 4 V; 15 mA typ, 30 mA max at VIN = 10 V"
  ],
  [
   "External parts",
   "four 1 µF capacitors"
  ],
  [
   "Operating temperature",
   "0 °C to 70 °C (C), -40 °C to 85 °C (I)"
  ]
 ],
