 "circuits": [
  {
   "id": "basic",
   "title": "Basic driver circuit",
   "page": 6,
   "description": "An NPN transistor (Q1) sinks the LED current: VCC feeds the LED anode through RLED, and Q1 pulls the cathode to the control return when CONTROL turns it on. On the line side, the output switch sits between the AC line, reached through series resistor R1, and the gate of a power triac (Q2) whose main terminals put the load across the line. RLED is sized from VCC, the LED forward drop and Q1's saturation voltage for the grade's IFT; R1 is the peak AC voltage over ITSM, holding the driver's surge current to its 1 A rating.",
   "parts": [
    {
     "ref": "U1",
     "type": "ic",
     "value": "MOC3023M"
    },
    {
