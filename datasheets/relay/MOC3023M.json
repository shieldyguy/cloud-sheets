{
 "sheet": 1,
 "name": "MOC3023M",
 "kind": "relay",
 "manufacturer": "onsemi",
 "title": "MOC301xM / MOC302xM: random-phase triac driver optocouplers, 250 V or 400 V peak, 6-pin DIP",
 "source": {
  "document": "MOC3023M/D",
  "revision": "Rev. 3, June 2023",
  "pages": 12
 },
 "summary": "Seven optocouplers in which an infrared GaAs LED, when lit, turns on a light-activated silicon bilateral switch that behaves like a triac. The output is random-phase, and the parts sit between electronic controls and a power triac that switches a resistive or inductive load on 115 VAC. The MOC301xM grades block 250 V peak and the MOC302xM grades 400 V; within each group the suffix digit sets the maximum LED trigger current, from 30 mA down to 5 mA. MOC3023M is the 400 V, 5 mA part. Isolation is 4170 VACrms for one minute (UL1577), with a DIN EN/IEC60747-5-5 option.",
 "key_figures": [
  [
   "Peak blocking voltage VDRM",
   "250 V (MOC301xM), 400 V (MOC302xM)"
  ],
  [
   "LED trigger current IFT max",
   "30 mA MOC3020M; 15 mA MOC3010M, MOC3021M; 10 mA MOC3011M, MOC3022M; 5 mA MOC3012M, MOC3023M"
  ],
