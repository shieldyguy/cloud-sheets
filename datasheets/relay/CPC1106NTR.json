{
 "sheet": 1,
 "name": "CPC1106NTR",
 "kind": "relay",
 "manufacturer": "Littelfuse (IXYS Integrated Circuits Division)",
 "title": "CPC1106N: 60 V, 75 mA single-pole normally closed (1-Form-B) OptoMOS solid-state relay, 4-lead SOP",
 "source": {
  "document": "DS-CPC1106N",
  "revision": "R03, 12/14/2012",
  "pages": 6
 },
 "summary": "A one-channel solid-state relay whose output is closed with no input current and opens when its infrared LED is driven. An infrared GaAlAs LED lights a photovoltaic die that biases a pair of MOSFETs, so the output conducts either polarity, up to 75 mA rms or DC with a blocking voltage of 60 VP, and the input and output are isolated to 1500 Vrms. It switches with 0.5 mA of LED current at most and comes in a small 4-lead SOP; CPC1106NTR is the 2000-piece reel, CPC1106N the 100-piece tube.",
 "key_figures": [
  [
   "Contact form",
   "1-Form-B (single pole, normally closed)"
  ],
  [
   "Blocking voltage",
   "60 VP"
  ],
  [
   "Load current",
   "75 mArms / mADC continuous; ±350 mAP for 10 ms"
  ],
  [
   "On-resistance",
   "3.85 Ω typ, 10 Ω max at IL = 75 mA, IF = 0 mA"
  ],
  [
   "LED current to operate",
   "0.16 mA typ, 0.5 mA max"
  ],
  [
   "Turn-on / turn-off time",
   "10 ms max each at IF = 2 mA, VL = 10 V"
  ],
  [
   "Isolation, input to output",
   "1500 Vrms"
  ],
  [
   "Operating temperature",
   "-40 to +85 °C"
  ]
 ],
