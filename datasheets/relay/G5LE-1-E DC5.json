 "operation": [
  {
   "topic": "Coil drive",
   "page": 2,
   "text": "The relay is certain to pull in once the coil has 75% of its rated voltage, and certain to drop out below 10%. The highest coil voltage falls with temperature: 170% of rated at 23°C down to 130% at 85°C for the -E types, 150% down to 120% for the -G types."
  },
  {
   "topic": "Maximum coil voltage",
   "page": 4,
   "text": "The maximum coil voltage is the top of the range a fluctuating supply may reach, not a level to hold continuously."
  },
  {
   "topic": "Switching limits",
   "page": 4,
   "text": "With resistive loads the -E types may switch up to 16 A at up to 250 V AC; the -G types up to 10 A at up to 35 V DC. The smallest load the contacts handle reliably is 100 mA at 5 VDC."
  }
 ],
