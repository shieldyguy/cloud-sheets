 "equations": [
  {
   "name": "Snubber charging time constant",
   "expr": "τ = (RL + R) × C",
   "where": {
    "RL": "load resistance",
    "R": "snubber resistor",
    "C": "snubber capacitor"
   },
   "note": "",
   "page": 12
  },
  {
   "name": "Snubber capacitor for a dv/dt limit",
   "expr": "C = 0.632 × VA / [(dv/dt) × (RL + R)]",
   "where": {
    "VA": "load supply voltage",
    "dv/dt": "rate of rise to stay under",
    "RL": "load resistance",
    "R": "snubber resistor"
   },
   "note": "C of 0.1 to 0.2 µF is the range given for holding dv/dt down.",
   "page": 12
  },
  {
   "name": "Snubber resistor dissipation",
   "expr": "P = C × VA² × f / 2",
   "where": {
    "C": "snubber capacitor",
    "VA": "load supply voltage",
    "f": "supply frequency"
   },
   "note": "Rate R for 1/2 W on a 100 V line and above 2 W on a 200 V line.",
   "page": 12
  },
