  {
   "id": "buffered-10v",
   "title": "Buffered reference using a single supply",
   "page": 8,
   "description": "A 10 V reference from one 15 V supply. A 7.5 kΩ resistor from the rail biases the reference; its 6.9 V goes to the op amp's non-inverting input. The op amp runs as a non-inverting amplifier with 9 kΩ feedback and 20 kΩ (1 %) to ground, a gain of 1.45, and its output is the 10 V rail.",
   "parts": [
    {
     "ref": "D1",
     "type": "zener",
     "value": "LM329",
     "note": "6.9 V"
    },
    {
     "ref": "U1",
     "type": "ic",
     "value": "LT1001",
     "external": true,
     "note": "pins: 2 -IN, 3 +IN, 6 OUT, 7 V+, 4 V-"
    },
    {
     "ref": "R1",
     "type": "resistor",
