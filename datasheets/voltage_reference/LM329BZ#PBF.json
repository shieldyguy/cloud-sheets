 "circuits": [
  {
   "id": "current-source-20ma",
   "title": "20 mA positive current source",
   "page": 1,
   "description": "A precision current source from a 20 V supply. The reference runs from the 20 V rail to a 4.3 kΩ resistor to ground. Two 0.1 % 20 kΩ resistors across the reference put the op amp's non-inverting input half a reference voltage below the rail. The op amp holds the lower end of the 174 Ω sense resistor at that voltage, setting the 20 mA output. It drives a P-channel JFET whose drain feeds the base of an NPN; the JFET and NPN together carry the sense current out of the OUT terminal, with 10 kΩ from base to emitter.",
   "parts": [
    {
     "ref": "D1",
     "type": "zener",
     "value": "LM329",
     "note": "6.95 V"
    },
    {
     "ref": "U1",
     "type": "ic",
     "value": "LT1001",
     "external": true,
     "note": "pins: 2 -IN, 3 +IN, 6 OUT, 7 V+, 4 V-"
    },
    {
     "ref": "R1",
     "type": "resistor",
     "value": "20 kΩ",
     "note": "0.1 %"
    },
    {
     "ref": "R2",
     "type": "resistor",
     "value": "20 kΩ",
     "note": "0.1 %"
    },
    {
     "ref": "R3",
     "type": "resistor",
     "value": "174 Ω",
     "note": "0.1 %, current-setting"
    },
    {
     "ref": "R4",
     "type": "resistor",
     "value": "4.3 kΩ"
    },
    {
     "ref": "R5",
     "type": "resistor",
     "value": "10 kΩ"
    },
    {
     "ref": "Q1",
