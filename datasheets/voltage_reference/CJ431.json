{
 "sheet": 1,
 "name": "CJ431",
 "kind": "voltage_reference",
 "manufacturer": "Jiangsu Changjing Electronics Technology Co., Ltd. (JSCJ)",
 "title": "CJ431 / CD431 adjustable 2.5 V shunt reference, 36 V, in SOT-23, SOT-89 and TO-92",
 "source": {
  "revision": "Rev. - 2.2",
  "pages": 12
 },
 "summary": "A three-terminal adjustable shunt regulator. The reference pin is held at 2.5 V above the anode; a resistor divider from cathode to reference sets the cathode voltage up to 36 V. The cathode carries 1 mA to 100 mA, the dynamic output impedance is 0.2 Ω typ, and the part can replace a zener diode. Listed uses are shunt regulators, high-current shunt regulators and precision current limiters. CJ431 comes in SOT-23, SOT-89 and TO-92; CD431 is a SOT-23 part with a different pin order.",
 "key_figures": [
  [
   "Reference voltage Vref",
   "2.5 V typ, 2.475 V to 2.525 V (1% rank); 2.488 V to 2.512 V in the 0.5% rank"
  ],
  [
   "Cathode voltage",
   "Vref to 36 V"
  ],
  [
   "Cathode current",
   "1 mA to 100 mA operating"
  ],
  [
   "Minimum cathode current for regulation",
   "0.45 mA typ, 1.0 mA max"
  ],
  [
   "Dynamic impedance ZKA",
   "0.15 Ω typ, 0.5 Ω max"
  ],
  [
   "Dynamic output impedance, headline figure",
   "0.2 Ω typ"
  ],
  [
   "Equivalent temperature coefficient",
   "50 ppm/°C typ"
  ],
  [
   "Reference input current",
   "1.5 µA typ, 4 µA max"
  ],
  [
   "Off-state cathode current",
   "0.05 µA typ, 1.0 µA max at 36 V"
  ],
