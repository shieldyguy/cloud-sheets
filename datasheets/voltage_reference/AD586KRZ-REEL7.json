   "Initial error",
   "±2.0 mV max (M grade); ±5 mV (K grade)"
  ],
  [
   "Drift",
   "2 ppm/°C max (M); 15 ppm/°C max (K), 0°C to 70°C"
  ],
  [
   "Output current",
   "±10 mA, source or sink"
  ],
  [
   "Noise",
   "4 µV p-p, 0.1 Hz to 10 Hz; 100 nV/√Hz"
  ],
  [
   "Supply",
   "10.8 V to 36 V"
  ],
  [
   "Quiescent current",
   "3 mA max"
  ]
 ],
