 "source": {
  "revision": "Rev. G, 3/05",
  "pages": 16
 },
 "summary": "The AD586 is a 5 V series voltage reference built on a buried Zener with a buffered output that sources or sinks 10 mA. Laser trimming sets initial error down to ±2.0 mV and drift down to 2 ppm/°C, by grade. A TRIM pin allows fine output adjustment and a NOISE REDUCTION pin takes a capacitor that filters the Zener's noise. Grades cover 0°C to 70°C, −40°C to +85°C and −55°C to +125°C in PDIP, SOIC and CERDIP.",
 "key_figures": [
  [
   "Output voltage",
   "5.000 V"
  ],
